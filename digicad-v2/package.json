{
  "name": "digicad-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "DigiCAD diş protez laboratuvarı yönetim yazılımı v2 (güvenli yeniden yazım)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-digicad \"vitest run --config vitest.rules.config.ts\"",
    "build:demo": "tsx demo/build.ts",
    "migrate": "tsx migration/src/cli.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "firebase-tools": "^13.20.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "firebase": "^10.13.0",
    "firebase-admin": "^12.4.0",
    "jszip": "^3.10.2"
  }
}
