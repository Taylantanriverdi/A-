{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"], "noUnusedLocals": true, "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests", "migration", "demo", "vite.config.ts", "vite.demo.config.ts", "vitest.config.ts", "vitest.rules.config.ts"]
}
