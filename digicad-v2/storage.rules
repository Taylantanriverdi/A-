rules_version = '2';
// DigiCAD v2 — Storage kuralları. Yol bazlı, boyut/MIME sınırlı, sahiplik denetimli. Silme YOK.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && 'role' in request.auth.token ? request.auth.token.role : ''; }
    function inLab(lab) { return signedIn() && 'lab' in request.auth.token && request.auth.token.lab == lab; }
    // Yönetici: rol + kendi laboratuvarı + TOTP ikinci faktör (Firestore kurallarıyla aynı).
    function hasMfa() { return 'firebase' in request.auth.token && 'sign_in_second_factor' in request.auth.token.firebase; }
    function isAdmin(lab) { return role() == 'admin' && inLab(lab) && hasMfa(); }
    function isDoctor(lab) {
      return role() == 'doctor' && inLab(lab) && 'doctorId' in request.auth.token && string(request.auth.token.doctorId).size() > 0;
    }
    function isTech(lab) {
      return role() == 'tech' && inLab(lab) && 'techId' in request.auth.token && string(request.auth.token.techId).size() > 0;
    }

    function maxMB(n) { return request.resource.size < n * 1024 * 1024; }
    function scanType() {
      return request.resource.contentType.matches('application/(octet-stream|zip|x-zip-compressed|pdf|sla)')
        || request.resource.contentType.matches('model/.*')
        || request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    function chatType() {
      return request.resource.contentType.matches('image/(png|jpeg|webp)')
        || request.resource.contentType == 'application/pdf';
    }
    // Dosya adı kara listesi: tarayıcıda etkin içerik/çalıştırılabilir olabilecek uzantılar (octet-stream her ada açık olduğundan zorunlu).
    // İstemci kontrolüyle (src/lib/files.ts DANGEROUS_EXT) aynı küme; son uzantı ya da çift uzantı ortasındaki ('x.html.zip') eşleşir.
    function safeName(file) {
      return !file.lower().matches('.*\\.(html?|xhtml|xht|svgz?|js|mjs|cjs|jsx|exe|dll|bat|cmd|com|msi|scr|jar|sh|bash|ps1|psm1|vbs|vbe|wsf|hta|lnk|apk|php[0-9]?|phtml|asp|aspx|jsp|cgi|swf|xml|xsl)(\\..*)?');
    }
    function jobDoc(lab, jobId) {
      return firestore.get(/databases/(default)/documents/labs/$(lab)/jobs/$(jobId));
    }
    // Çöpteki (deleted:true) işin dosyaları hekim/teknisyene kapalı (Firestore kurallarıyla tutarlı; alan yoksa false).
    function jobLive(lab, jobId) { return jobDoc(lab, jobId).data.get('deleted', false) == false; }
    // Eski iş sohbeti job_{işId}: o işin hekimi/atanmış teknisyeni.
    function jobThreadMember(lab, threadId) {
      return threadId.matches('job_[^/]+')
        && firestore.exists(/databases/(default)/documents/labs/$(lab)/jobs/$(threadId.replace('^job_', '')))
        && jobLive(lab, threadId.replace('^job_', ''))
        && ((isDoctor(lab) && jobDoc(lab, threadId.replace('^job_', '')).data.get('doctorId', '') == string(request.auth.token.doctorId))
            || (isTech(lab) && string(request.auth.token.techId) in jobDoc(lab, threadId.replace('^job_', '')).data.get('techIds', [])));
    }

    // Teknisyen: işe atanmış, işin çöpte olmaması ve Tamamlandı olmaması gerekir (Firestore kurallarıyla tutarlı).
    function techMayUpload(lab, jobId) {
      return isTech(lab)
        && string(request.auth.token.techId) in jobDoc(lab, jobId).data.techIds
        && jobLive(lab, jobId)
        && jobDoc(lab, jobId).data.status != 'Tamamlandı';
    }

    match /{allPaths=**} { allow read, write: if false; }

    // İş dosyaları: labs/{lab}/jobFiles/{jobId}/{dosya}
    match /labs/{lab}/jobFiles/{jobId}/{file} {
      allow read: if isAdmin(lab)
        || (isDoctor(lab) && jobDoc(lab, jobId).data.doctorId == string(request.auth.token.doctorId) && jobLive(lab, jobId))
        || (isTech(lab) && string(request.auth.token.techId) in jobDoc(lab, jobId).data.techIds && jobLive(lab, jobId));
      allow create: if resource == null && (isAdmin(lab) || techMayUpload(lab, jobId))
        && maxMB(200) && scanType() && safeName(file);
      allow update, delete: if false;
    }

    // Hekim gönderim dosyaları: labs/{lab}/submissions/{doctorId}/{dosya}
    match /labs/{lab}/submissions/{doctorId}/{file} {
      allow read: if isAdmin(lab) || (isDoctor(lab) && string(request.auth.token.doctorId) == doctorId);
      allow create: if resource == null && isDoctor(lab) && string(request.auth.token.doctorId) == doctorId
        && maxMB(200) && scanType() && safeName(file);
      allow update, delete: if false;
    }

    // Sohbet ekleri: labs/{lab}/chat/{threadId}/{dosya}
    match /labs/{lab}/chat/{threadId}/{file} {
      allow read: if isAdmin(lab)
        || (isDoctor(lab) && threadId == 'dr_' + string(request.auth.token.doctorId))
        || (isTech(lab) && threadId == 'tech_' + string(request.auth.token.techId))
        || jobThreadMember(lab, threadId);
      allow create: if resource == null && (isAdmin(lab)
        || (isDoctor(lab) && threadId == 'dr_' + string(request.auth.token.doctorId))
        || (isTech(lab) && threadId == 'tech_' + string(request.auth.token.techId))
        || jobThreadMember(lab, threadId))
        && maxMB(25) && chatType() && safeName(file);
      allow update, delete: if false;
    }
  }
}
