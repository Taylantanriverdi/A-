# Yeni Firebase projesi web yapılandırması (gizli değildir ama projeye özeldir). Değerleri konsoldan alın.
VITE_FIREBASE_API_KEY=YER_TUTUCU
VITE_FIREBASE_AUTH_DOMAIN=YENI-PROJE.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YENI-PROJE-ID
VITE_FIREBASE_STORAGE_BUCKET=YENI-PROJE.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YER_TUTUCU
VITE_FIREBASE_APP_ID=YER_TUTUCU
# App Check reCAPTCHA Enterprise site anahtarı (gizli değildir)
VITE_RECAPTCHA_SITE_KEY=YER_TUTUCU
# Gmail entegrasyonu için Google OAuth istemci kimliği (Web) — gizli anahtar DEĞİL, istemci kimliği
VITE_GOOGLE_CLIENT_ID=YER_TUTUCU
# Yerel emülatör kullanmak için true
VITE_USE_EMULATORS=false
# SIR YOK: OPENAI_API_KEY Secret Manager'da tutulur (firebase functions:secrets:set OPENAI_API_KEY)
