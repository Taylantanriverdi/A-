        function kaTahsilatTumunuDoldur(){
            const hekimId=Number(document.getElementById("kaTahsilatHekim").value||0);
            const currency=document.getElementById("kaTahsilatPara").value||"TRY";
            const row=kaListe.find(x=>Number(x.hekimId)===hekimId);
            const bakiye=Math.max(0,Number(row?.bakiye?.[currency]||0));

            document.getElementById("kaTahsilatTutar").value=bakiye>0
                ? bakiye.toFixed(2)
                : "";

            if(bakiye<=0){
                const warn=document.getElementById("kaTahsilatUyari");
                warn.innerText=`${currency} para biriminde açık alacak bulunmuyor.`;
                warn.style.display="block";
            }
