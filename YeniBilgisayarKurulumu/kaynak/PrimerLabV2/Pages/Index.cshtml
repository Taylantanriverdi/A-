            if (!container) {
                return;
            }

            if (!teknisyenler.length) {
                container.innerHTML =
                    '<div class="empty">Henüz teknisyen eklenmemiş.</div>';
                return;
            }

            container.innerHTML =
                teknisyenler
                    .slice()
                    .sort(function(a,b) {
                        if ((a.aktif !== false) !== (b.aktif !== false)) {
                            return a.aktif === false ? 1 : -1;
                        }

                        return String(a.adSoyad || "")
                            .localeCompare(
                                String(b.adSoyad || ""),
                                "tr"
                            );
                    })
                    .map(function(t) {
                        return `
                            <div class="technician-row editable-row"
                                 title="Teknisyen bilgilerini düzenlemek için tıkla"
                                 onclick="openTeknisyenDuzenleModal(${Number(t.id)})">
                                <div>
                                    <div class="technician-row-name">
                                        ${escapeHtml(t.adSoyad || "-")}
                                    </div>
                                    <div class="technician-row-status">
                                        ${t.aktif === false ? "Pasif" : "Aktif"} · Düzenlemek için tıkla
                                    </div>
                                </div>

                                <button type="button"
                                        class="button button-light"
                                        onclick="event.stopPropagation(); openTeknisyenDuzenleModal(${Number(t.id)})">
                                    Düzenle
                                </button>
                            </div>
                        `;
                    })
                    .join("");
        }

        function openTeknisyenDuzenleModal(id) {
            const t = teknisyenler.find(x => Number(x.id) === Number(id));
            if (!t) {
                showError("Teknisyen bulunamadı.");
                return;
            }

            document.getElementById("teknisyenDuzenleId").value = String(t.id);
            document.getElementById("teknisyenDuzenleAd").value = t.adSoyad || "";
            document.getElementById("teknisyenDuzenleAktif").checked = t.aktif !== false;
            const hata = document.getElementById("teknisyenDuzenleHata");
            hata.style.display = "none";
            hata.innerText = "";
            document.getElementById("teknisyenDuzenleModal").style.display = "flex";
        }

        function closeTeknisyenDuzenleModal() {
            const modal = document.getElementById("teknisyenDuzenleModal");
            if (modal) modal.style.display = "none";
        }

        async function teknisyenDuzenleKaydet(event) {
            event.preventDefault();

            const id = Number(document.getElementById("teknisyenDuzenleId").value || 0);
            const adSoyad = document.getElementById("teknisyenDuzenleAd").value.trim();
            const aktif = document.getElementById("teknisyenDuzenleAktif").checked;
            const hata = document.getElementById("teknisyenDuzenleHata");
            const button = document.getElementById("teknisyenDuzenleKaydetBtn");

            if (!id || !adSoyad) {
                hata.innerText = "Teknisyen adı boş bırakılamaz.";
                hata.style.display = "block";
                return;
            }

            button.disabled = true;
            button.innerText = "Kaydediliyor...";
            hata.style.display = "none";

            try {
                const r = await fetch("/api/teknisyenler/" + id, {
                    method: "PUT",
                    headers: {"Content-Type":"application/json"},
                    body: JSON.stringify({ adSoyad, aktif })
                });

                if (!r.ok) throw new Error((await r.text()) || "Teknisyen güncellenemedi.");

                closeTeknisyenDuzenleModal();
                await loadTeknisyenler();
                showSuccess("Teknisyen bilgileri güncellendi.");
            } catch (error) {
                hata.innerText = error.message || "Teknisyen güncellenemedi.";
                hata.style.display = "block";
            } finally {
                button.disabled = false;
                button.innerText = "Değişiklikleri Kaydet";
            }
        }

        async function teknisyenEkle() {
            const input =
                document.getElementById(
                    "yeniTeknisyenAdi"
                );

            const hata =
                document.getElementById(
                    "teknisyenHata"
                );

            const adSoyad =
                (input?.value || "").trim();

            if (!adSoyad) {
                if (hata) {
                    hata.innerText =
                        "Teknisyen adı boş bırakılamaz.";
                    hata.style.display = "block";
                }
                return;
            }

            try {
                if (hata) {
                    hata.style.display = "none";
                }

                const response =
                    await fetch(
                        "/api/teknisyenler",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                adSoyad: adSoyad
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "Teknisyen eklenemedi."
                    );
                }

                input.value = "";
                await loadTeknisyenler();
                showSuccess(
                    "Teknisyen eklendi."
                );
            }
            catch (error) {
                if (hata) {
                    hata.innerText =
                        error.message ||
                        "Teknisyen eklenemedi.";
                    hata.style.display = "block";
                }
            }
        }

        async function teknisyenSil(id) {
            id = Number(id || 0);
            const teknisyen = teknisyenler.find(t => Number(t.id) === id);
            if (!id || !teknisyen) return showError("Teknisyen bulunamadı.");
            const ad = teknisyen.adSoyad || teknisyen.ad || "Teknisyen";
            if (!confirm('"' + ad + '" teknisyen kaydı silinsin mi?\n\nGeçmiş veya atanmış işi varsa güvenlik nedeniyle silinmez; bunun yerine Pasife Al seçeneğini kullanabilirsin.')) return;
            try {
                const r = await fetch("/api/teknisyenler/" + id, { method: "DELETE" });
                if (!r.ok) throw new Error((await r.text()) || "Teknisyen silinemedi.");
                if (techCenterSelectedId === id) techCenterSelectedId = 0;
                closeTeknisyenDuzenleModal();
                await loadTeknisyenler();
                await loadTeknisyenAtamalari();
                showSuccess("Teknisyen kaydı silindi.");
            } catch (error) { showError(error.message || "Teknisyen silinemedi."); }
        }

        async function teknisyenAktifDegistir(
            id,
            aktif
        ) {
            const teknisyen =
                teknisyenler.find(function(t) {
                    return Number(t.id) === Number(id);
                });

            if (!teknisyen) return;

            try {
                const response =
                    await fetch(
                        "/api/teknisyenler/" +
                        Number(id),
                        {
                            method: "PUT",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                adSoyad:
                                    teknisyen.adSoyad,
                                aktif:
                                    !!aktif
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "Teknisyen güncellenemedi."
                    );
                }

                await loadTeknisyenler();
                showSuccess(
                    aktif
                        ? "Teknisyen aktif yapıldı."
                        : "Teknisyen pasif yapıldı."
                );
            }
            catch (error) {
                showError(
                    error.message ||
                    "Teknisyen güncellenemedi."
                );
            }
        }


        function operasyonFiltreDurumuOku() {
            return {
                search:
                    document.getElementById("opsSearch")?.value || "",
                durum:
                    document.getElementById("opsDurum")?.value || "",
                hekim:
                    document.getElementById("opsHekim")?.value || "",
                teknisyen:
                    document.getElementById("opsTeknisyen")?.value || "",
                termin:
                    document.getElementById("opsTermin")?.value || "",
                oncelik:
                    document.getElementById("opsOncelik")?.value || ""
            };
        }

        function operasyonFiltreleriniKaydet() {
            window.clearTimeout(
                operasyonFiltreKayitTimer
            );

            operasyonFiltreKayitTimer =
                window.setTimeout(function() {
                    try {
                        localStorage.setItem(
                            operasyonFiltreStorageKey,
                            JSON.stringify(
                                operasyonFiltreDurumuOku()
                            )
                        );

                        const badge =
                            document.getElementById(
                                "opsKayitliFiltreBilgi"
                            );

                        if (badge) {
                            badge.style.display =
                                "inline-flex";

                            window.setTimeout(function() {
                                badge.style.display =
                                    "none";
                            }, 1200);
                        }
                    }
                    catch {}
                }, 250);
        }

        function operasyonFiltreleriniYukle() {
            try {
                const raw =
                    localStorage.getItem(
                        operasyonFiltreStorageKey
                    );

                if (!raw) return;

                const saved =
                    JSON.parse(raw);

                const pairs = [
                    ["opsSearch", saved.search],
                    ["opsDurum", saved.durum],
                    ["opsHekim", saved.hekim],
                    ["opsTeknisyen", saved.teknisyen],
                    ["opsTermin", saved.termin],
                    ["opsOncelik", saved.oncelik]
                ];

                pairs.forEach(function(pair) {
                    const el =
                        document.getElementById(
                            pair[0]
                        );

                    if (!el) return;

                    const value =
                        String(pair[1] || "");

                    if (
                        el.tagName === "SELECT" &&
                        ![...el.options].some(function(o) {
                            return o.value === value;
                        })
                    ) {
                        return;
                    }

                    el.value = value;
                });
            }
            catch {}
        }

        function operasyonFiltreleriTemizle() {
            [
                "opsSearch",
                "opsDurum",
                "opsHekim",
                "opsTeknisyen",
                "opsTermin",
                "opsOncelik"
            ].forEach(function(id) {
                const el =
                    document.getElementById(id);

                if (el) {
                    el.value = "";
                }
            });

            try {
                localStorage.removeItem(
                    operasyonFiltreStorageKey
                );
            }
            catch {}

            renderOperasyonMerkezi();
        }

        function operasyonFiltreSecenekleriniDoldur() {
            const h=document.getElementById("opsHekim");
            if(h){
                const cur=h.value;
                h.innerHTML='<option value="">Tüm Hekimler</option>'+hekimler.filter(x=>x.aktif!==false).slice().sort((a,b)=>String(a.adSoyad||"").localeCompare(String(b.adSoyad||""),"tr")).map(x=>`<option value="${Number(x.id)}">${escapeHtml(x.adSoyad||"-")}</option>`).join("");
                if([...h.options].some(o=>o.value===cur))h.value=cur;
            }
            const t=document.getElementById("opsTeknisyen");
            if(t){
                const cur=t.value;
                t.innerHTML='<option value="">Tüm Teknisyenler</option><option value="unassigned">Atanmamış</option>'+teknisyenler.filter(x=>x.aktif!==false).slice().sort((a,b)=>String(a.adSoyad||"").localeCompare(String(b.adSoyad||""),"tr")).map(x=>`<option value="${Number(x.id)}">${escapeHtml(x.adSoyad||"-")}</option>`).join("");
                if([...t.options].some(o=>o.value===cur))t.value=cur;
            }
            const b=document.getElementById("opsTopluTeknisyen");
            if(b){
                const cur=b.value;
                b.innerHTML='<option value="">Teknisyen seç...</option><option value="unassigned">Atanmamış yap</option>'+teknisyenler.filter(x=>x.aktif!==false).slice().sort((a,c)=>String(a.adSoyad||"").localeCompare(String(c.adSoyad||""),"tr")).map(x=>`<option value="${Number(x.id)}">${escapeHtml(x.adSoyad||"-")}</option>`).join("");
                if([...b.options].some(o=>o.value===cur))b.value=cur;
            }
        }

        function operasyonTerminFiltreEslesiyor(item,filter){
            const f=String(filter||""); if(!f)return true;
            if(f==="none")return !item.terminTarihi;
            const g=terminGunFarki(item.terminTarihi); if(g===null)return false;
            if(f==="overdue")return g<0;
            if(f==="today")return g===0;
            if(f==="soon")return g===1||g===2;
            return true;
        }

        function operasyonFiltreliListe(){
            const q=String(document.getElementById("opsSearch")?.value||"").toLocaleLowerCase("tr-TR").trim();
            const d=document.getElementById("opsDurum")?.value||"";
            const h=document.getElementById("opsHekim")?.value||"";
            const t=document.getElementById("opsTeknisyen")?.value||"";
            const term=document.getElementById("opsTermin")?.value||"";
            const oncelik=document.getElementById("opsOncelik")?.value||"";
            return siparisler.filter(item=>{
                if(isArsiv(item.durum))return false;
                if(d&&standartDurum(item.durum)!==d)return false;
                if(h&&String(item.hekimId||"")!==h)return false;
                if(!isTeknisyenFiltreEslesiyor(item,t))return false;
                if(!operasyonTerminFiltreEslesiyor(item,term))return false;
                if(oncelik&&oncelikDegeri(item)!==oncelik)return false;
                if(q){
                    const hay=[item.id,item.hekimAdi,item.klinikAdi,item.hastaAdi,item.disRengi,item.oncelik,item.uretimNotu,item.uretimAsamasi,item.kaliteKontrolDurumu,item.kaliteKontrolNotu,item.durum,teknisyenAtamasi(item)?.teknisyenAdi].map(v=>String(v||"").toLocaleLowerCase("tr-TR")).join(" ");
                    if(!hay.includes(q))return false;
                }
                return true;
            }).slice().sort((a,b)=>{
                const ag=terminGunFarki(a.terminTarihi), bg=terminGunFarki(b.terminTarihi);
                if(ag!==null&&bg!==null&&ag!==bg)return ag-bg;
                if(ag!==null&&bg===null)return -1;
                if(ag===null&&bg!==null)return 1;
                return Number(b.id||0)-Number(a.id||0);
            });
        }

        function operasyonSatirClass(item) {
            const durum =
                standartDurum(item.durum);

            if (oncelikDegeri(item) === "Çok Acil") {
                return "priority-row";
            }

            if (durum === "Hazır") {
                return "ops-row-ready";
            }

            const gun =
                terminGunFarki(
                    item.terminTarihi
                );

            if (gun !== null && gun < 0) {
                return "ops-row-late";
            }

            if (gun === 0) {
                return "ops-row-today";
            }

            return "";
        }

        async function operasyonHizliDurum(
            id,
            yeniDurum
        ) {
            if (!id || !yeniDurum) return;

            if (
                yeniDurum === "Teslim" &&
                !confirm(
                    "İş doğrudan Tamamlanan İşler’e taşınacak. Devam edilsin mi?"
                )
            ) {
                return;
            }

            try {
                const response =
                    await fetch(
                        "/api/siparisler/" +
                        Number(id) +
                        "/durum",
                        {
                            method: "PATCH",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                durum: yeniDurum === "Teslim" ? "Tamamlandı" : yeniDurum
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "Durum değiştirilemedi."
                    );
                }

                await loadSiparisler();

                showSuccess(
                    "İş #" +
                    Number(id) +
                    " → " +
                    yeniDurum
                );
            }
            catch (error) {
                showError(
                    error.message ||
                    "Hızlı durum değişikliği başarısız."
                );
            }
        }

        function operasyonHizliDurumButonlari(item) {
            const d =
                standartDurum(item.durum);

            if (d === "Yeni") {
                return `
                    <div class="ops-quick-actions">
                        <button type="button"
                                class="button button-light"
                                onclick="operasyonHizliDurum(${Number(item.id)}, 'Devam Eden')">
                            Devama Al
                        </button>
                    </div>
                `;
            }

            if (d === "Devam Eden") {
                return `
                    <div class="ops-quick-actions">
                        <button type="button"
                                class="button button-light"
                                onclick="operasyonHizliDurum(${Number(item.id)}, 'Hazır')">
                            Hazır Yap
                        </button>
                    </div>
                `;
            }

            if (d === "Hazır") {
                return `
                    <div class="ops-quick-actions">
                        <button type="button"
                                class="button button-light"
                                onclick="operasyonHizliDurum(${Number(item.id)}, 'Teslim')">
                            Tamamlandı
                        </button>
                    </div>
                `;
            }

            return "-";
        }

