            if(!ilk)return;
            const kod=prompt("Son güvenlik onayı:\n\nDevam etmek için büyük harflerle SIFIRLA yaz:");
            if(kod!=="SIFIRLA")return showError("Sıfırlama iptal edildi. SIFIRLA onayı verilmedi.");
            if(!confirm("SON ONAY\n\nOtomatik güvenlik yedeği alındıktan sonra tüm veriler silinecek. Devam edilsin mi?"))return;
            const box=document.getElementById("backupStatusBox");
            if(box){box.className="backup-status-box";box.innerText="Güvenlik yedeği alınıyor ve sistem sıfırlanıyor...";}
            try{
                const r=await fetch("/api/backup/factory-reset",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({confirm:"SIFIRLA"})});
                const raw=await r.text();
                if(!r.ok)throw new Error(raw||"Sistem sıfırlanamadı.");
                let d={};try{d=JSON.parse(raw)}catch{}
                if(box){box.className="backup-status-box ok";box.innerText="Sıfırlama tamamlandı. Güvenlik yedeği: "+(d.safetyBackup||"oluşturuldu");}
                showSuccess("Primer Lab tamamen sıfırlandı.");
