        async function openHekimFiyatModal(hekimId) {
            const hekim =
                hekimler.find(function (h) {
                    return Number(h.id) === Number(hekimId);
                });

            if (!hekim) {
                showError("Hekim bulunamadı.");
                return;
            }

            hekimFiyatDuzenlenenId = Number(hekimId);
            const kopyaSecici = document.getElementById("hekimFiyatKopyaKaynak");
            if (kopyaSecici) delete kopyaSecici.dataset.hekimId;
            const yeniIsKutusu = document.getElementById("hekimFiyatYeniIs");
            if (yeniIsKutusu) yeniIsKutusu.value = "";
            hekimFiyatMesajRengi(document.getElementById("hekimFiyatHata"), false);

            document.getElementById(
                "hekimFiyatHekimId"
            ).value = hekimFiyatDuzenlenenId;

            document.getElementById(
                "hekimFiyatModalAltBaslik"
            ).innerText =
                (hekim.adSoyad || "-") +
                (hekim.klinikAdi
                    ? " — " + hekim.klinikAdi
                    : "");

            const hata =
                document.getElementById("hekimFiyatHata");

            hata.style.display = "none";
            hata.innerText = "";

            const container =
                document.getElementById("hekimFiyatSatirlari");

            container.innerHTML =
                '<div class="empty">Fiyat listesi yükleniyor...</div>';

            document.getElementById(
                "hekimFiyatModal"
            ).style.display = "flex";

            try {
                const sonuc = await Promise.all([
                    hekimIsOnerileriGetir(),
                    fiyatListesiGetir(hekimFiyatDuzenlenenId)
                ]);

                // Pencerede yalnız bu hekime tanımlı işler listelenir; liste hekime özeldir.
                hekimFiyatOneriler = sonuc[0];
                const fiyatlar = sonuc[1];

                container.innerHTML = "";

                fiyatlar.forEach(function (fiyat) {
                    hekimFiyatSatiriEkle(
                        fiyat.isTuru,
                        Number(fiyat.birimFiyat || 0),
                        String(fiyat.paraBirimi || "TRY").toUpperCase()
                    );
                });

                hekimFiyatListesiniYenile();
            }
            catch (error) {
                container.innerHTML = "";

                hata.innerText =
                    error.message ||
                    "Fiyat listesi yüklenemedi.";

                hata.style.display = "block";
            }
