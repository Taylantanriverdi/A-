            align-items:flex-start;
            justify-content:space-between;
            gap:10px;
            margin-bottom:12px;
        }
        .kanban-title{
            font-weight:800;
            color:#0f172a;
        }
        .kanban-subtitle{
            margin-top:3px;
            font-size:11px;
            color:#64748b;
        }
        .kanban-count{
            display:inline-flex;
            min-width:28px;
            height:28px;
            align-items:center;
            justify-content:center;
            border-radius:999px;
            background:#e2e8f0;
            color:#0f172a;
            font-weight:800;
            font-size:12px;
        }
        .kanban-list{
            display:flex;
            flex-direction:column;
            gap:10px;
            min-height:440px;
        }
        .kanban-card{
            background:#fff;
            border:1px solid #e2e8f0;
            border-radius:12px;
            padding:13px;
            cursor:grab;
            box-shadow:0 2px 8px rgba(15,23,42,.04);
        }
        .kanban-card:active{cursor:grabbing}
        .kanban-card:hover{
            border-color:#93c5fd;
            box-shadow:0 7px 18px rgba(15,23,42,.08);
        }
        .kanban-card-top{
            display:flex;
            align-items:flex-start;
            justify-content:space-between;
            gap:8px;
        }
        .kanban-job-no{
            font-weight:800;
            color:#1d4ed8;
            font-size:12px;
        }
        .kanban-patient{
            margin-top:5px;
            font-weight:800;
            color:#111827;
        }
        .kanban-doctor{
            margin-top:3px;
            color:#475569;
            font-size:12px;
        }
        .kanban-meta{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:7px;
            margin-top:11px;
            padding-top:10px;
            border-top:1px solid #f1f5f9;
            font-size:11px;
            color:#64748b;
        }
        .kanban-meta strong{
            display:block;
            color:#334155;
            font-size:12px;
            margin-top:2px;
        }
        .kanban-actions{
            display:flex;
            gap:7px;
            margin-top:11px;
        }
        .kanban-actions button{
            flex:1;
            border:0;
            border-radius:8px;
            min-height:34px;
            padding:0 8px;
            cursor:pointer;
            font-weight:700;
            font-size:11px;
        }
        .kanban-next{
            background:#dbeafe;
            color:#1d4ed8;
        }
        .kanban-deliver{
            background:#dcfce7;
            color:#166534;
        }
        .kanban-empty{
            padding:22px 10px;
            text-align:center;
            color:#94a3b8;
            font-size:12px;
            border:1px dashed #cbd5e1;
            border-radius:10px;
        }

        .termin-summary-cards{margin-top:14px}
        .termin-summary-card{
            border:0;
            text-align:left;
            cursor:pointer;
            font:inherit;
            transition:transform .15s ease, box-shadow .15s ease;
        }
        .termin-summary-card:hover{
            transform:translateY(-2px);
            box-shadow:0 10px 24px rgba(15,23,42,.10);
        }
        .termin-danger-card{
            border:1px solid #fecaca;
        }
        .termin-danger-card .card-value{
            color:#b91c1c;
        }

        .term-badge{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;font-size:11px;font-weight:700;white-space:nowrap}
        .term-normal{background:#e0f2fe;color:#075985}
        .term-soon{background:#fef3c7;color:#92400e}
        .term-late{background:#fee2e2;color:#991b1b}
        .term-none{color:#9ca3af;font-size:12px}

        .work-filter-bar{display:grid;grid-template-columns:minmax(240px,1.7fr) minmax(190px,1fr) auto;gap:10px;margin-bottom:12px;align-items:center}
        .work-filter-bar input,.work-filter-bar select{width:100%;min-height:42px;border:1px solid #d1d5db;border-radius:9px;background:#fff;padding:0 12px;color:#111827;font:inherit}
        .work-filter-count{margin:0 0 10px;color:#6b7280;font-size:12px}
        @@media (max-width: 900px) {
            .cari-summary {
                grid-template-columns: 1fr 1fr;
            }

            .cari-filter-row {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 1050px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 750px) {
            .sidebar {
                width: 190px;
            }

            .main {
                margin-left: 190px;
                width: calc(100% - 190px);
                padding: 15px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
            }

            .price-row,
            .job-line {
                grid-template-columns: 1fr;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    

        /* V32.16 - Primer Lab uyumlu Kasa/Arşiv iyileştirmeleri */
        .cari-table th{font-size:11px;color:#64748b;background:#f8fafc}
        .cari-table td{vertical-align:middle}
        .cari-table tbody tr{transition:background .12s ease}
        .cari-table tbody tr:hover{background:#f7faff}
        .cari-table .ops-mini{margin-top:3px;color:#94a3b8}
        .cari-actionbar .button{min-height:34px}
        .cari-chip .money-stack{display:inline-flex;flex-direction:row;gap:7px;margin-left:4px}
        .cari-period-note .button{white-space:nowrap}
        .cari-period-rolledback{opacity:.55;background:#f8fafc}
        .cari-danger-button{background:#fff1f2!important;color:#be123c!important;border-color:#fecdd3!important}
        .cari-muted{color:#94a3b8;font-size:11px}

        /* V32.15 - Kasa / Arşiv */
        .cari-toolbar{display:flex;gap:10px;align-items:end;flex-wrap:wrap;margin-bottom:16px}
        .cari-filter{display:flex;flex-direction:column;gap:4px}
        .cari-filter label{font-size:10px;font-weight:800;color:#64748b;text-transform:uppercase}
        .cari-filter input{height:36px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px;background:#fff}
        .cari-table tr{cursor:pointer}
        .cari-table tr:hover{background:#f5f9ff}
        .money-stack{display:flex;flex-direction:column;gap:2px;font-variant-numeric:tabular-nums}
        .money-try{color:#0f172a}.money-eur{color:#7c3aed}.money-usd{color:#2563eb}
        .money-positive{color:#059669}.money-negative{color:#dc2626;font-weight:800}
        .cari-modal-box{width:min(940px,94vw);max-height:88vh;overflow:hidden;display:flex;flex-direction:column}
        .cari-modal-body{padding:0 22px 22px;overflow:auto}
        .cari-tabs{display:flex;gap:14px;border-bottom:1px solid #dbe3ef;margin:16px 0}
        .cari-tab{border:0;background:transparent;padding:10px 12px;font-weight:800;color:#64748b;cursor:pointer;border-bottom:2px solid transparent}
        .cari-tab.active{color:#1565c0;border-color:#1565c0}
        .cari-actionbar{display:flex;gap:8px;flex-wrap:wrap}
        .cari-chip-row{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
        .cari-chip{padding:5px 10px;border-radius:999px;background:#eef4ff;font-size:11px;font-weight:800}
        .cari-chip.pay{background:#eafaf3;color:#047857}.cari-chip.balance{background:#fff0f0;color:#dc2626}
        .cari-period-note{display:flex;justify-content:space-between;gap:10px;align-items:center;background:#eff6ff;border:1px solid #bfdbfe;border-radius:9px;padding:10px 12px;margin:12px 0;color:#1d4ed8;font-size:12px}
        .cari-empty{text-align:center;padding:45px;color:#64748b}
        .cari-close-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .cari-balance-edit{display:grid;grid-template-columns:80px 1fr;gap:8px;align-items:center;margin-top:8px}
        .cari-balance-edit input{height:36px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px;text-align:right}
        .cari-notice-box{white-space:pre-wrap;background:#f8fafc;border:1px solid #dbe3ef;border-radius:10px;padding:16px;line-height:1.6}
        @@media(max-width:700px){.cari-close-grid{grid-template-columns:1fr}.cari-modal-box{width:98vw}}


        /* V32.17 - Baştan tasarlanan Primer Lab Kasa / Arşiv */
        .ka-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
        .ka-summary-card{background:#fff;border:1px solid #e3e8f0;border-radius:14px;padding:16px;box-shadow:0 3px 12px rgba(15,23,42,.04)}
        .ka-summary-label{font-size:11px;font-weight:800;color:#64748b;margin-bottom:5px}
        .ka-summary-value{font-size:24px;font-weight:900;color:#0f172a}
        .ka-summary-small{font-size:10px;color:#94a3b8;margin-top:4px}
        .ka-filter-panel{margin-bottom:16px}
        .ka-filter-row{display:grid;grid-template-columns:minmax(260px,1fr) 160px 160px auto auto;gap:10px;align-items:end}
        .ka-filter-row>div{display:flex;flex-direction:column;gap:5px}
        .ka-filter-row label,.ka-detail-filter label{font-size:10px;font-weight:800;color:#64748b;text-transform:uppercase}
        .ka-filter-row input,.ka-detail-filter input{height:38px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px;background:#fff}
        .ka-table tr{cursor:pointer}
        .ka-table tbody tr:hover{background:#f5f8ff}
        .ka-table td{vertical-align:middle}
        .ka-money{display:flex;flex-direction:column;gap:2px;font-variant-numeric:tabular-nums}
        .ka-money span{white-space:nowrap}
        .ka-positive{color:#059669}
        .ka-negative{color:#dc2626;font-weight:800}
        .ka-modal-wide{width:min(980px,95vw);max-height:90vh;overflow:hidden;display:flex;flex-direction:column}
        .ka-modal-body{padding:0 22px 22px;overflow:auto}
        .ka-top-actions{display:flex;gap:7px;flex-wrap:wrap}
        .ka-detail-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px 0}
        .ka-detail-summary>div{background:#f8fafc;border:1px solid #e5eaf2;border-radius:10px;padding:12px}
        .ka-detail-summary span{display:block;font-size:10px;color:#64748b;font-weight:800}
        .ka-detail-summary strong{display:block;font-size:18px;color:#0f172a;margin-top:4px}
        .ka-detail-filter{display:flex;gap:9px;align-items:end;flex-wrap:wrap;background:#f8fafc;border:1px solid #e5eaf2;border-radius:10px;padding:12px}
        .ka-detail-filter>div{display:flex;flex-direction:column;gap:4px}
        .ka-tabs{display:flex;gap:8px;border-bottom:1px solid #e2e8f0;margin:16px 0}
        .ka-tab{border:0;background:transparent;padding:10px 13px;font-weight:800;color:#64748b;cursor:pointer;border-bottom:2px solid transparent}
        .ka-tab.active{color:#2563eb;border-color:#2563eb}
        .ka-empty{text-align:center;padding:40px;color:#94a3b8}
        .ka-balance-editor{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
        .ka-balance-editor>div{display:flex;flex-direction:column;gap:4px}
        .ka-balance-editor label{font-size:10px;font-weight:800;color:#64748b}
        .ka-balance-editor input{height:38px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px;text-align:right}
        .ka-message-box{white-space:pre-wrap;background:#f8fafc;border:1px solid #dbe3ef;border-radius:10px;padding:18px;line-height:1.7;color:#0f172a}
        @@media(max-width:900px){
            .ka-summary-grid{grid-template-columns:repeat(2,1fr)}
            .ka-filter-row{grid-template-columns:1fr 1fr}
            .ka-detail-summary{grid-template-columns:repeat(2,1fr)}
        }
        @@media(max-width:620px){
            .ka-summary-grid{grid-template-columns:1fr}
            .ka-filter-row{grid-template-columns:1fr}
            .ka-detail-summary{grid-template-columns:1fr}
            .ka-balance-editor{grid-template-columns:1fr}
        }



        /* V32.18 - Tahsilat penceresi */
        .ka-payment-modal{width:min(600px,94vw);max-height:92vh;overflow:hidden;display:flex;flex-direction:column}
        .ka-payment-head{padding-bottom:14px}
        .ka-payment-body{padding:18px 22px 8px;overflow:auto}
        .ka-payment-section-label{font-size:10px;font-weight:900;letter-spacing:.04em;color:#64748b}
        .ka-payment-help{font-size:10px;color:#94a3b8;margin-top:2px}
        .ka-payment-doctor{margin-bottom:14px}
        .ka-payment-doctor select{margin-top:6px;width:100%;height:42px;border:1px solid #dbe3ef;border-radius:9px;padding:0 12px;background:#fff;font-weight:700}
        .ka-payment-balance-wrap{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px;margin-bottom:15px}
        .ka-payment-balance-title{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}
        .ka-payment-balance-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
        .ka-balance-card{border:1px solid #dbe3ef;background:#fff;border-radius:10px;padding:10px;text-align:left;cursor:pointer;transition:.15s}
        .ka-balance-card:hover{border-color:#93b4ef;background:#f7faff}
        .ka-balance-card.active{border-color:#2563eb;box-shadow:0 0 0 2px rgba(37,99,235,.10)}
        .ka-balance-card span{display:block;font-size:10px;font-weight:900;color:#64748b}
        .ka-balance-card strong{display:block;font-size:16px;color:#0f172a;margin-top:3px}
        .ka-payment-current-balance{font-size:11px;color:#64748b;margin-top:8px;min-height:16px}
        .ka-payment-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .ka-payment-grid .form-group{margin-bottom:0}
        .ka-payment-grid input,.ka-payment-grid select{height:42px}
        .ka-payment-note{min-height:78px;resize:vertical}
        .ka-optional{font-weight:500;color:#94a3b8}
        .ka-payment-warning{margin-top:10px;padding:10px 12px;border-radius:9px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;font-size:11px}
        .ka-payment-footer{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:14px 22px;border-top:1px solid #e5e7eb;background:#fff}
        .ka-payment-footer-actions{display:flex;gap:8px}
        .ka-receipt{border:1px solid #dbe3ef;border-radius:12px;padding:20px;background:#fff}
        .ka-receipt-logo{font-size:18px;font-weight:900;color:#0f172a}
        .ka-receipt-sub{font-size:11px;color:#64748b;margin-bottom:16px}
        .ka-receipt-amount{font-size:28px;font-weight:900;color:#0f172a;margin:10px 0 18px}
        .ka-receipt-row{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px solid #eef2f7;font-size:12px}
        .ka-receipt-row span:first-child{color:#64748b}
        .ka-receipt-row strong{text-align:right}
        @@media(max-width:620px){
            .ka-payment-grid{grid-template-columns:1fr}
            .ka-payment-balance-grid{grid-template-columns:1fr}
            .ka-payment-footer{align-items:stretch;flex-direction:column}
            .ka-payment-footer-actions{width:100%;flex-direction:column}
            .ka-payment-footer .btn-secondary,.ka-payment-footer .btn-primary{width:100%}
        }



        /* V32.19 - Tam yedek / restore */
        .backup-settings-body{padding:18px 22px;display:grid;gap:12px}
        .backup-action-card{display:flex;justify-content:space-between;align-items:center;gap:16px;border:1px solid #e2e8f0;background:#fff;border-radius:12px;padding:14px 15px}
        .backup-action-card strong{display:block;color:#0f172a;font-size:13px;margin-bottom:4px}
        .backup-action-card p{margin:0;color:#64748b;font-size:11px;line-height:1.55;max-width:720px}
        .backup-file-row{display:flex;align-items:center;gap:8px;min-width:390px}
        .backup-file-row input[type=file]{max-width:245px;font-size:11px}
        .legacy-import-card{background:#f8fafc}
        .backup-status-box{border-radius:10px;background:#eef6ff;border:1px solid #bfdbfe;padding:11px 13px;color:#334155;font-size:11px;line-height:1.5}
        .backup-status-box.ok{background:#ecfdf5;border-color:#a7f3d0;color:#065f46}
        .backup-status-box.error{background:#fff1f2;border-color:#fecdd3;color:#9f1239}
        @@media(max-width:800px){
            .backup-action-card{align-items:stretch;flex-direction:column}
            .backup-file-row{min-width:0;width:100%;flex-direction:column;align-items:stretch}
            .backup-file-row input[type=file]{max-width:none;width:100%}
        }



        /* V32.20 - Primer Lab Aylık Rapor */
        .ar-filter-panel{margin-bottom:16px}
        .ar-filter-grid{display:grid;grid-template-columns:160px 190px 160px minmax(200px,1fr);gap:12px;align-items:end}
        .ar-filter-grid>div:not(.ar-period-info){display:flex;flex-direction:column;gap:5px}
        .ar-filter-grid label{font-size:10px;font-weight:900;color:#64748b;text-transform:uppercase}
        .ar-filter-grid select{height:40px;border:1px solid #dbe3ef;border-radius:9px;background:#fff;padding:0 11px}
        .ar-period-info{min-height:40px;border-left:1px solid #e2e8f0;padding-left:16px;display:flex;flex-direction:column;justify-content:center}
        .ar-period-info span{font-size:10px;color:#94a3b8;font-weight:800;text-transform:uppercase}
        .ar-period-info strong{font-size:13px;color:#0f172a;margin-top:2px}
        .ar-summary-grid{display:grid;grid-template-columns:.8fr 1.25fr 1.25fr 1fr 1.25fr;gap:12px;margin-bottom:16px}
        .ar-summary-card{background:#fff;border:1px solid #e3e8f0;border-radius:14px;padding:16px;min-height:118px;box-shadow:0 3px 12px rgba(15,23,42,.035)}
        .ar-net-card{border-color:#cbd5e1;background:linear-gradient(180deg,#fff,#f8fafc)}
        .ar-card-label{font-size:10px;font-weight:900;color:#64748b;text-transform:uppercase;letter-spacing:.04em}
        .ar-card-value{font-size:25px;font-weight:900;color:#0f172a;margin-top:10px}
        .ar-card-sub{font-size:10px;color:#94a3b8;margin-top:7px}
        .ar-money-stack{display:flex;flex-direction:column;gap:2px;font-size:18px;font-weight:900;color:#0f172a;margin-top:9px}
        .ar-money-stack span{white-space:nowrap}
        .ar-money-stack .positive{color:#047857}.ar-money-stack .negative{color:#dc2626}
        .ar-two-column{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.75fr);gap:16px;margin-bottom:16px}
        .ar-bars{display:flex;flex-direction:column;gap:10px}
        .ar-bar-row{display:grid;grid-template-columns:64px minmax(0,1fr) auto;gap:10px;align-items:center}
        .ar-bar-label{font-size:11px;font-weight:800;color:#475569}
        .ar-bar-track{height:11px;background:#eef2f7;border-radius:99px;overflow:hidden;display:flex}
        .ar-bar-job{height:100%;background:#2563eb}
        .ar-bar-pay{height:100%;background:#0f9d8a}
        .ar-bar-values{font-size:10px;color:#64748b;text-align:right;white-space:nowrap}
        .ar-breakdown{display:flex;flex-direction:column;gap:9px}
        .ar-break-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:9px 0;border-bottom:1px solid #eef2f7}
        .ar-break-row:last-child{border-bottom:0}
        .ar-break-title{font-size:12px;font-weight:800;color:#334155}
        .ar-break-sub{font-size:10px;color:#94a3b8;margin-top:2px}
        .ar-break-value{font-size:12px;font-weight:900;text-align:right}
        .ar-table tbody tr.ar-selected-month{background:#eff6ff}
        .ar-table tbody tr:hover{background:#f8fafc}
        .ar-search{height:34px;min-width:210px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px}
        @@media(max-width:1150px){
            .ar-summary-grid{grid-template-columns:repeat(2,1fr)}
            .ar-two-column{grid-template-columns:1fr}
        }
        @@media(max-width:760px){
            .ar-filter-grid{grid-template-columns:1fr 1fr}
            .ar-summary-grid{grid-template-columns:1fr}
        }
        @@media(max-width:520px){
            .ar-filter-grid{grid-template-columns:1fr}
        }



        /* V32.21 - Gmail + AI Mail Merkezi */
        .mailv2-status-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}
        .mailv2-status-card{background:#fff;border:1px solid #e3e8f0;border-radius:13px;padding:14px 16px}
        .mailv2-status-card span{display:block;font-size:10px;font-weight:900;color:#64748b;text-transform:uppercase}
        .mailv2-status-card strong{display:block;margin-top:6px;font-size:16px;color:#0f172a}
        .mailv2-status-card strong.ok{color:#059669}.mailv2-status-card strong.bad{color:#dc2626}.mailv2-status-card strong.warn{color:#d97706}
        .mailv2-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
        .mailv2-settings-body{padding:16px}
        .mailv2-setting-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:end}
        .mailv2-oauth-help{font-size:10px;color:#64748b;line-height:1.5;margin-top:12px}
        .mailv2-search{height:34px;min-width:230px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px}
        .mailv2-review-filter{font-size:11px}
        .mailv2-table td{vertical-align:middle}
        .mailv2-sender{font-weight:800;color:#0f172a}.mailv2-sub{font-size:10px;color:#94a3b8;margin-top:2px}
