        async function anayasaSiparisYazdir(){
            if(!anayasaFormOnayaGonderildi){
                showError("Yazdırmadan önce siparişi Onaya Gönder.");
                return;
            }
            const paper=document.querySelector('#siparisFormu .ref-order-paper');
            if(!paper){ window.print(); return; }
            // Hekimin yüklediği taramalar (üst çene / alt çene / kapanış) forma resim olarak eklenir.
            if(anayasaYazdirIsId){
                try{ await stlGorselleriHazirla(anayasaYazdirIsId); }
                catch(e){ console.warn('Tarama görüntüleri hazırlanamadı', e); }
            }

            // Çıktı, ekrandaki formun birebir aynısı olarak tek bir A5 (148 x 210 mm) dikey
            // sayfaya basılır: form ekrandaki genişliğini korur, yalnız orantılı küçültülür.
            const sayfa=document.createElement('style');
            sayfa.id='a5YazdirmaSayfasi';
            sayfa.textContent='@@page{size:A5 portrait;margin:5mm}';
            document.head.appendChild(sayfa);

            // Ölçek: formun ekrandaki ölçüleri A5'in yazılabilir alanına (138 x 200 mm) sığacak kadar.
            const mm=96/25.4;
            const genislik=Math.max(1,paper.offsetWidth), yukseklik=Math.max(1,paper.offsetHeight);
            const olcek=Math.min(1,138*mm/genislik,200*mm/yukseklik)*0.98;
            paper.style.setProperty('--a5-width',genislik+'px');
            paper.style.setProperty('--a5-zoom',String(olcek));
            // Sayfa (veya içerik paneli) aşağı kaydırılmışsa formun üstü kesilmesin diye
            // yazdırma süresince başa alınır, sonra eski konuma dönülür.
            const kaydirmalar=[];
            for(let el=paper.parentElement; el; el=el.parentElement){
                if(el.scrollTop||el.scrollLeft){ kaydirmalar.push([el,el.scrollTop,el.scrollLeft]); el.scrollTop=0; el.scrollLeft=0; }
            }
            const pencereKaydirma=[window.scrollX,window.scrollY];
            window.scrollTo(0,0);
            document.body.classList.add('print-a5');

            const temizle=function(){
                kaydirmalar.forEach(function(k){ k[0].scrollTop=k[1]; k[0].scrollLeft=k[2]; });
                window.scrollTo(pencereKaydirma[0],pencereKaydirma[1]);
                document.body.classList.remove('print-a5');
                paper.style.removeProperty('--a5-zoom');
                paper.style.removeProperty('--a5-width');
                document.getElementById('a5YazdirmaSayfasi')?.remove();
                window.removeEventListener('afterprint',temizle);
            };
            window.addEventListener('afterprint',temizle);
            window.print();
        }

        function renderAnayasaFormHistory(){
            const body=document.getElementById('anFormHistoryBody');
            if(!body)return;
            const q=String(document.getElementById('anFormHistorySearch')?.value||'').trim().toLowerCase();
            const list=(siparisler||[])
                .filter(x=>!x.silindi)
                .filter(function(x){
                    if(!q)return true;
                    return [x.hekimAdi,x.hastaAdi,x.klinikAdi]
                        .some(v=>String(v||'').toLowerCase().includes(q));
                })
                .sort((a,b)=>Number(b.id||0)-Number(a.id||0))
                .slice(0,20);

