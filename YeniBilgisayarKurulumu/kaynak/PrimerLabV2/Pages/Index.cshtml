        function renderOperasyonMerkezi(){
            operasyonFiltreSecenekleriniDoldur();
            operasyonFiltreleriniKaydet();
            const aktif=siparisler.filter(x=>!isArsiv(x.durum));
            const geciken=aktif.filter(x=>{const g=terminGunFarki(x.terminTarihi);return g!==null&&g<0;});
            const atanmamis=aktif.filter(x=>{const a=teknisyenAtamasi(x);return !a||!a.teknisyenId;});
            const hazir=aktif.filter(x=>standartDurum(x.durum)==="Hazır");
            const set=(id,v)=>{const e=document.getElementById(id);if(e)e.innerText=v;};
            set("opsAktifSayisi",aktif.length);set("opsGecikenSayisi",geciken.length);set("opsAtanmamisSayisi",atanmamis.length);set("opsHazirSayisi",hazir.length);

            const liste=operasyonFiltreliListe(); operasyonSonFiltreliListe=liste;
            const body=document.getElementById("opsBody"); if(!body)return;
            if(!liste.length){body.innerHTML='<tr><td colspan="11" class="empty">Seçilen filtrelerde aktif iş bulunmuyor.</td></tr>';operasyonSecimBilgisiniGuncelle();return;}

            body.innerHTML=liste.map(item=>{
                const a=teknisyenAtamasi(item);
                const checked=operasyonSeciliIsler.has(Number(item.id))?" checked":"";
                return `<tr class="${operasyonSatirClass(item)}">
                    <td><input class="ops-checkbox" type="checkbox"${checked} onchange="operasyonIsSec(${Number(item.id)},this.checked)" /></td>
                    <td><strong>#${Number(item.id)}</strong></td>
                    <td>${escapeHtml(item.hekimAdi||"-")}<div class="ops-mini">${escapeHtml(item.klinikAdi||"-")}</div></td>
                    <td>
                        ${escapeHtml(item.hastaAdi||"-")}${dosyaSimge(item.id)}
                        <div style="margin-top:5px;">${disRengiRozeti(item)}</div>
                    </td>
                    <td>
                        <span class="status ${durumClass(item.durum)}">${escapeHtml(item.durum||"-")}</span>
                        <div style="margin-top:5px;">
                            ${uretimAsamasiRozeti(item)}
                            ${kaliteRozeti(item)}
                        </div>
                    </td>
                    <td>${teknisyenRozeti(item)}<div class="ops-mini">${escapeHtml(a?.teknisyenAdi||"Atanmamış")}</div></td>
                    <td>${terminBilgisi(item)}</td>
                    <td>${Number(item.toplamAdet||0)}</td>
                    <td>${paraBirimiFormat(item.toplamTutar, item.paraBirimi)}</td>
                    <td>${operasyonHizliDurumButonlari(item)}</td>
