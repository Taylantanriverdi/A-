    <!-- ANA JAVASCRIPT -->
    <script>
        let siparisler = [];
        let hekimler = [];
        let tahsilatlar = [];
        let teknisyenler = [];
        let teknisyenAtamalari = new Map();
        let dashboardTeknisyenFiltre = "";
        let operasyonSeciliIsler = new Set();
        let operasyonSonFiltreliListe = [];
        const operasyonFiltreStorageKey = "PrimerLabV22_OperasyonFiltreleri";
        let operasyonFiltreKayitTimer = null;
        let cariDetaySekme = "tum";
        let tahsilatDuzenlemeKaynakHekimId = 0;

        function showSection(id, button) {
            document.querySelectorAll(".section").forEach(function (section) {
                section.classList.remove("active");
            });

            document.querySelectorAll(".menu-item").forEach(function (menu) {
                menu.classList.remove("active");
            });

            const section = document.getElementById(id);

            if (section) {
                section.classList.add("active");
            }

            if (!button) {
                button = Array.from(document.querySelectorAll(".menu-item")).find(function(menu) {
                    return (menu.getAttribute("onclick") || "").includes("'" + id + "'");
                }) || null;
            }
            if (button) button.classList.add("active");

            if (id === "muhasebe") {
                renderMuhasebe();
            }

            if (id === "uretimPanosu") {
                renderUretimPanosu();
            }

            if (id === "ayarlar") {
                renderTeknisyenler();
            }

            if (id === "portalHesaplari") {
                portalHesaplariYukle();
            }

            if (id === "operasyon") {
                operasyonFiltreleriniYukle();
                renderOperasyonMerkezi();
            }

            if (id === "planlama") {
                planlamaFiltreSecenekleriniDoldur();
                planlamaVarsayilanTarih();
                renderPlanlama();
            }

            if (id === "kalite") {
                renderKaliteKontrol();
            }

            if (id === "teslimat") {
                teslimatHekimSecenekleriniDoldur();
                renderTeslimatMerkezi();
            }

            if ([
                "siparisFormu","hekimdenGelenler","mesajlar","onayBekleyen",
                "isDagitim","anayasaDevam","tamamlananIsler","anayasaDosyalar",
                "anayasaTeknisyenler","giderlerAnayasa","silinenlerAnayasa"
            ].includes(id)) {
                renderAnayasaAll();
            }
            if (id === "mailKutusu") {
                mailV2LoadAll();
            }
            if (id === "aylikRaporAnayasa") {
                arInit();
                arYukle();
            }

            if (id === "legacyArsiv") {
                loadLegacyArsiv();
            }
            if (id === "ayarlar") {
                loadSystemHealth();
            }
        }

        let primerToastSuccessTimer = null;
        let primerToastErrorTimer = null;

        function hideToastBox(box) {
            if (!box) return;
            box.classList.remove("toast-visible");
            window.setTimeout(function () {
                if (!box.classList.contains("toast-visible")) {
                    box.style.display = "none";
                    box.innerText = "";
                }
            }, 180);
        }

        function showError(message) {
            const box = document.getElementById("errorBox");
            if (!box) return;

            if (primerToastErrorTimer) window.clearTimeout(primerToastErrorTimer);
            box.innerText = message;
            box.style.display = "block";
            window.requestAnimationFrame(function () {
                box.classList.add("toast-visible");
            });

            primerToastErrorTimer = window.setTimeout(function () {
                hideToastBox(box);
            }, 4000);
        }

        function clearError() {
            const box = document.getElementById("errorBox");
            if (primerToastErrorTimer) window.clearTimeout(primerToastErrorTimer);
            primerToastErrorTimer = null;
            hideToastBox(box);
        }

        function showSuccess(message) {
            const box = document.getElementById("successBox");
            if (!box) return;

            if (primerToastSuccessTimer) window.clearTimeout(primerToastSuccessTimer);
            box.innerText = message;
            box.style.display = "block";
            window.requestAnimationFrame(function () {
                box.classList.add("toast-visible");
            });

            primerToastSuccessTimer = window.setTimeout(function () {
                hideToastBox(box);
            }, 1900);
        }

        function para(value) {
            return Number(value || 0).toLocaleString(
                "tr-TR",
                {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                }
            ) + " ₺";
        }

        function paraBirimiFormat(value, currency) {
            const c = String(currency || "TRY").toUpperCase();
            const symbol = c === "EUR" ? "€" : c === "USD" ? "$" : "₺";
            return Number(value || 0).toLocaleString("tr-TR", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }) + " " + symbol;
        }

        function tarihGoster(value) {
            if (!value) return "-";
            const raw = String(value).slice(0,10);
            const iso = /^(\d{4})-(\d{2})-(\d{2})$/.exec(raw);
            if (iso) return `${iso[3]}/${iso[2]}/${iso[1]}`;
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return "-";
            return `${String(d.getDate()).padStart(2,"0")}/${String(d.getMonth()+1).padStart(2,"0")}/${d.getFullYear()}`;
        }

        function tarihIsoGirdi(value) {
            const v=String(value||'').trim();
            if(!v)return null;
            if(/^\d{4}-\d{2}-\d{2}$/.test(v))return v;
            const m=/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-](\d{4})$/.exec(v);
            if(!m)return undefined;
            const d=Number(m[1]), mo=Number(m[2]), y=Number(m[3]);
            const dt=new Date(y,mo-1,d);
            if(dt.getFullYear()!==y||dt.getMonth()!==mo-1||dt.getDate()!==d)return undefined;
            return `${y}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        }

        function masterTerminDegisti(id, input) {
            const iso=tarihIsoGirdi(input.value);
            if(iso===undefined){ showError('Termin tarihi GG/AA/YYYY biçiminde olmalı. Örnek: 17/09/2026'); input.focus(); return; }
            input.value=iso?tarihGoster(iso):'';
            masterMark(id,'terminTarihi',iso);
        }


        function tarihSaatGoster(value) {
            if (!value) return "-";

            const d = new Date(value);

            if (Number.isNaN(d.getTime())) {
                return "-";
            }

            return d.toLocaleString("tr-TR");
        }


        function normalDurum(durum) {
            return String(durum || "")
                .trim()
                .toLocaleLowerCase("tr-TR");
        }

        function durumClass(durum) {
            const value = normalDurum(durum);

            if (value.includes("iptal")) {
                return "status-iptal";
            }

            if (value.includes("teslim")) {
                return "status-teslim";
            }

            if (value.includes("hazır")) {
                return "status-hazir";
            }

            if (
                value.includes("devam") ||
                value.includes("tasarım") ||
                value.includes("üretim") ||
                value.includes("kontrol")
            ) {
                return "status-devam";
            }

            return "status-yeni";
        }

        function isGelenIs(durum) {
            const value = normalDurum(durum);

            return (
                value === "" ||
                value === "yeni" ||
                value.includes("onay")
            );
        }

        function isDevamEden(durum) {
            const value = normalDurum(durum);

            return (
                value.includes("devam") ||
                value.includes("tasarım") ||
                value.includes("üretim") ||
                value.includes("kontrol") ||
                value.includes("hazır")
            );
        }

        function isArsiv(durum) {
            const value = normalDurum(durum);

            return (
                value.includes("teslim") ||
                value.includes("iptal") ||
                value.includes("tamamlandı") ||
                value.includes("tamamlandi") ||
                value.includes("arşiv") ||
                value.includes("arsiv")
            );
        }

        function toplamTutarHesapla(liste) {
            return liste.reduce(function (toplam, item) {
                return toplam + Number(item.toplamTutar || 0);
            }, 0);
        }

        function paraBirimiToplamMetni(liste) {
            const totals = new Map();

            (liste || []).forEach(function(item) {
                const currency =
                    String(item?.paraBirimi || "TRY").trim().toUpperCase() || "TRY";

                totals.set(
                    currency,
                    Number(totals.get(currency) || 0) +
                    Number(item?.toplamTutar || 0)
                );
            });

            const order = ["TRY", "EUR", "USD"];
            const currencies = [...totals.keys()].sort(function(a,b) {
                const ia = order.indexOf(a);
                const ib = order.indexOf(b);
                return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);
            });

            if (!currencies.length) return "0 ₺";

            return currencies
                .map(function(currency) {
                    return paraBirimiFormat(
                        totals.get(currency) || 0,
                        currency
                    );
                })
                .join(" + ");
        }

        function tarihInputDegeri(value) {
            if (!value) return "";
            const d = new Date(value);
            if (Number.isNaN(d.getTime())) return "";
            const local = new Date(d.getTime() - d.getTimezoneOffset() * 60000);
            return local.toISOString().slice(0, 10);
        }

        function terminBilgisi(item) {
            if (!item || !item.terminTarihi) {
                return '<span class="term-none">Termin yok</span>';
            }

            const term = new Date(item.terminTarihi);
            const today = new Date();
            term.setHours(0,0,0,0);
            today.setHours(0,0,0,0);

            const diff = Math.ceil((term - today) / 86400000);
            let cls = "term-normal";
            let label = tarihGoster(item.terminTarihi);

            if (diff < 0) {
                cls = "term-late";
                label += ` • ${Math.abs(diff)} gün gecikti`;
            } else if (diff === 0) {
                cls = "term-soon";
                label += " • Bugün";
            } else if (diff <= 2) {
                cls = "term-soon";
                label += ` • ${diff} gün kaldı`;
            }

            return `<span class="term-badge ${cls}">${escapeHtml(label)}</span>`;
        }

        function uretimAsamasiDegeri(itemOrValue) {
            const value =
                typeof itemOrValue === "object"
                    ? String(itemOrValue?.uretimAsamasi || "Bekliyor").trim()
                    : String(itemOrValue || "Bekliyor").trim();

            const allowed = [
                "Bekliyor",
                "Tasarım",
                "Üretim",
                "Bitim",
                "Kalite Kontrol",
                "Paketleme"
            ];

            return allowed.includes(value)
                ? value
                : "Bekliyor";
        }

        function kaliteDurumuDegeri(itemOrValue) {
            const value =
                typeof itemOrValue === "object"
                    ? String(itemOrValue?.kaliteKontrolDurumu || "Bekliyor").trim()
                    : String(itemOrValue || "Bekliyor").trim();

            if (value === "Onaylandı") return "Onaylandı";
            if (value === "Düzeltme Gerekli") return "Düzeltme Gerekli";
            return "Bekliyor";
        }

        function uretimAsamasiRozeti(itemOrValue) {
            return '<span class="stage-badge">' +
                escapeHtml(uretimAsamasiDegeri(itemOrValue)) +
