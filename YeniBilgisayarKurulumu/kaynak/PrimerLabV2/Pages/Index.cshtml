        // Taramalar kapanış konumunda mı: çenelerin dişleri birbirine bakar, orta hatları ve ön uçları
        // hizalıdır, diş uçları arasında boşluk yoktur (mm; ağız içi tarayıcılar mm yazar).
        function stlKapanisKonumunda(mu,eu,ma,ea){
            if(stlV.dot(eu.dik,ea.dik)>-0.8) return false;
            const d=[ea.c[0]-eu.c[0],ea.c[1]-eu.c[1],ea.c[2]-eu.c[2]];
            if(Math.abs(stlV.dot(d,eu.gen))>8 || Math.abs(stlV.dot(d,eu.der))>12) return false;
            const dd=stlV.dot(d,eu.dik); if(dd<3||dd>45) return false;
            const h=(m,yon)=>{ const p=m.p; let e=-Infinity; for(let i=0;i<p.length;i+=3){ const v=p[i]*yon[0]+p[i+1]*yon[1]+p[i+2]*yon[2]; if(v>e)e=v; } return e; };
            // eu.dik alt çeneye doğru: üst diş uçlarının o yöndeki en ileri noktası ile alt diş uçları arasındaki boşluk.
            const ustUc=h(mu,eu.dik), altUc=-h(ma,stlV.sc(eu.dik,-1));
