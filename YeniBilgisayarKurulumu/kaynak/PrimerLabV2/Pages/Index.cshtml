                <a href="/api/is-dosyalari/${Number(f.id)}/indir" download title="İndir">⬇ ${(Number(f.boyut||0)/1048576).toFixed(1)} MB</a></div>`).join('')||'<div class="ops-mini">Dosya yok.</div>';
