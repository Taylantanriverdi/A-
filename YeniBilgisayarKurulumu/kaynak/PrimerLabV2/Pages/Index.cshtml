        async function mailV2Process(){
            mailV2RunMessage("Sorgulama başlatıldı. Gmail → AI analiz → dosya indirme → kayıt adımlarını yukarıdaki çubuktan anlık izleyebilirsin.",false);
            mailV2StartProgressPolling();
            try{
                const r=await fetch("/api/mail-v2/process",{method:"POST"});
                let j={}; try{j=await r.json();}catch{}
                if(!r.ok||!j.success)throw new Error(j.message||"Mail işleme başarısız.");
                mailV2RunMessage(`Tamamlandı: ${j.found||0} yeni mail bulundu, ${j.imported||0} mail kaydedildi, ${j.skipped||0} mail atlandı.`,true);
                await mailV2LoadAll();
            }catch(e){mailV2RunMessage("Mail kontrol hatası: "+e.message,false);await mailV2PollProgress();}
            finally{mailV2StopProgressPolling();}
        }

