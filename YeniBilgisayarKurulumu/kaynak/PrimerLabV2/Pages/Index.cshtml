        async function loadLegacyArsivListe() {
            const body = document.getElementById("legacyArsivBody");
            if (!body) return;

            body.innerHTML = '<tr><td colspan="4" class="empty">Yükleniyor...</td></tr>';

            const tur = document.getElementById("legacyTur")?.value || "";
            const q = document.getElementById("legacySearch")?.value.trim() || "";

            const url = "/api/legacy-arsiv?limit=250&tur=" +
                encodeURIComponent(tur) +
                "&q=" +
                encodeURIComponent(q);

            try {
                const r = await fetch(url, { cache:"no-store" });
                if (!r.ok) throw new Error(await r.text());
                const rows = await r.json();

                if (!rows.length) {
                    body.innerHTML = '<tr><td colspan="4" class="empty">Kayıt bulunamadı.</td></tr>';
                    return;
                }

                body.innerHTML = rows.map(function(row) {
                    let obj = {};
                    try { obj = JSON.parse(row.jsonData || "{}"); } catch {}
                    return `<tr>
                        <td>${escapeHtml(row.tur || "-")}</td>
                        <td>${row.legacyId ?? "-"}</td>
                        <td>${legacyOzetMetni(row.tur, obj)}</td>
                        <td>${tarihSaatGoster(row.kayitTarihi)}</td>
                    </tr>`;
                }).join("");
            } catch (e) {
                body.innerHTML = `<tr><td colspan="4" class="empty">${escapeHtml(e.message || "Arşiv yüklenemedi.")}</td></tr>`;
            }
        }

