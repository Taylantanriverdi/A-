            grid-template-rows:auto auto;
            border:0;
            padding:0;
            background:#fff;
            gap:0;
        }
        .ref-tooth-mini::before{
            content:"";
            position:absolute;
            left:50%;
            top:0;
            bottom:0;
            width:1px;
            background:#26364d;
            transform:translateX(-.5px);
            pointer-events:none;
        }
        .ref-tooth-mini::after{
            content:"";
            position:absolute;
            left:0;
            right:0;
            top:50%;
            height:1px;
            background:#26364d;
            transform:translateY(-.5px);
            pointer-events:none;
        }
