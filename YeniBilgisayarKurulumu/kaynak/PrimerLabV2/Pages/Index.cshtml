            try {
                const r = await fetch("/api/legacy-arsiv/ozet", { cache:"no-store" });
                if (!r.ok) throw new Error(await r.text());
                const data = await r.json();

                const imp = data.sonImport;
                if (ozet) {
                    ozet.innerHTML = imp
                        ? `<strong>Son aktarım:</strong> ${tarihSaatGoster(imp.importTarihi)} •
                           ${Number(imp.doktorSayisi)} hekim •
                           ${Number(imp.teknisyenSayisi)} teknisyen •
                           ${Number(imp.isSayisi)} iş •
                           ${Number(imp.bekleyenIsSayisi)} onay bekleyen •
                           ${Number(imp.tahsilatSayisi)} tahsilat •
                           ${Number(imp.giderSayisi)} gider`
                        : "Henüz yedek aktarım kaydı yok.";
                }

                const gruplar = Array.isArray(data.gruplar) ? data.gruplar : [];
                if (cards) {
                    cards.innerHTML = gruplar.map(function(g) {
                        return `<div class="constitution-card">
                            <div class="constitution-label">${escapeHtml(g.tur)}</div>
                            <div class="constitution-value">${Number(g.kayitSayisi || 0)}</div>
                            <div class="page-subtitle">Arşiv kaydı</div>
                        </div>`;
                    }).join("");
                }

                await loadLegacyArsivListe();
            } catch (e) {
                if (ozet) ozet.textContent = "Yedek arşivi yüklenemedi: " + (e.message || e);
            }
