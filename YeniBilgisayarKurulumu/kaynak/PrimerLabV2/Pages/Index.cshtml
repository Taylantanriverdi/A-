        async function tahsilatKaydet(event) {
            event.preventDefault();

            const duzenlenenId =
                Number(
                    document.getElementById(
                        "tahsilatDuzenlenenId"
                    ).value || 0
                );

            const hekimId =
                Number(
                    document.getElementById(
                        "tahsilatHekim"
                    ).value
                );

            const tutar =
                Number(
                    document.getElementById(
                        "tahsilatTutar"
                    ).value || 0
                );

            const tarih =
                document.getElementById(
                    "tahsilatTarih"
                ).value;

            const odemeTuru =
                document.getElementById(
                    "tahsilatOdemeTuru"
                ).value;

            const islemNo =
                document.getElementById(
                    "tahsilatIslemNo"
                ).value.trim();

            const aciklama =
                document.getElementById(
                    "tahsilatAciklama"
                ).value.trim();

            const hata =
                document.getElementById("tahsilatHata");

            const button =
                document.getElementById(
                    "tahsilatKaydetBtn"
                );

            if (!hekimId) {
                hata.innerText =
                    "Hekim seçmelisin.";
                hata.style.display = "block";
                return;
            }

            if (!(tutar > 0)) {
                hata.innerText =
                    "Tahsilat tutarı 0'dan büyük olmalıdır.";
                hata.style.display = "block";
                return;
            }

            if (!tarih) {
                hata.innerText =
                    "Tahsilat tarihi zorunludur.";
                hata.style.display = "block";
                return;
            }

            hata.style.display = "none";
            button.disabled = true;

            const eskiButtonYazisi =
                button.innerText;

            button.innerText =
                "Kaydediliyor...";

            try {
                const url =
                    duzenlenenId
                        ? "/api/tahsilatlar/" +
                          duzenlenenId
                        : "/api/tahsilatlar";

                const method =
                    duzenlenenId
                        ? "PUT"
                        : "POST";

                const response =
                    await fetch(
                        url,
                        {
                            method: method,
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                hekimId: hekimId,
                                tutar: tutar,
                                tarih:
                                    tarih +
                                    "T12:00:00+03:00",
                                odemeTuru:
                                    odemeTuru,
                                islemNo:
                                    islemNo || null,
                                aciklama:
                                    aciklama || null
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "Tahsilat kaydedilemedi."
                    );
                }

                const geriDonulecekHekimId =
                    Number(
                        tahsilatDuzenlemeKaynakHekimId || 0
                    );

                closeTahsilatModal();

                await loadTahsilatlar();

                if (
                    duzenlenenId &&
                    geriDonulecekHekimId
                ) {
                    openCariDetayModal(
                        geriDonulecekHekimId
                    );
                }

                tahsilatDuzenlemeKaynakHekimId = 0;

                showSuccess(
                    duzenlenenId
                        ? "Tahsilat güncellendi."
                        : "Tahsilat kaydedildi."
                );
            }
            catch (error) {
                hata.innerText =
                    error.message ||
                    "Tahsilat kaydedilirken hata oluştu.";

                hata.style.display = "block";
            }
            finally {
                button.disabled = false;
                button.innerText =
                    eskiButtonYazisi;
            }
        }


        async function tahsilatSil(id) {
            const kayit =
                tahsilatlar.find(function (x) {
                    return Number(x.id) === Number(id);
                });

            if (!kayit) {
                return false;
            }

            const onayMetni =
                "SİL";

            const girilen =
                prompt(
                    tarihGoster(kayit.tarih) +
                    " tarihli " +
                    para(kayit.tutar) +
                    " tahsilat kaydı kalıcı olarak silinecek.\n\n" +
                    "Onaylamak için SİL yaz:"
                );

            if (
                String(girilen || "")
                    .trim()
                    .toLocaleUpperCase("tr-TR") !==
                onayMetni
            ) {
                return false;
            }

            try {
                const response =
                    await fetch(
                        "/api/tahsilatlar/" + id,
                        {
                            method: "DELETE"
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "Tahsilat silinemedi."
                    );
                }

                await loadTahsilatlar();

                showSuccess(
                    "Tahsilat kaydı silindi."
                );

                return true;
            }
            catch (error) {
                showError(
                    error.message ||
                    "Tahsilat silinirken hata oluştu."
                );

                return false;
            }
        }


        let seciliHekimFiyatlari = [];
        let hekimFiyatDuzenlenenId = null;

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function doldurHekimListesi() {
            const select = document.getElementById("yeniIsHekim");
            if (!select) return;

            const aktifler = hekimler.filter(function (h) {
                return h.aktif !== false;
            });

            const eskiDeger = select.value;

            select.innerHTML =
                '<option value="">Hekim seç...</option>' +
                aktifler.map(function (h) {
                    const klinik = h.klinikAdi
                        ? " - " + h.klinikAdi
                        : "";

                    return '<option value="' + h.id + '">' +
                        escapeHtml(h.adSoyad || "-") +
                        escapeHtml(klinik) +
                        '</option>';
                }).join("");

            if (eskiDeger) {
                select.value = eskiDeger;
            }
        }

        async function fiyatListesiGetir(hekimId) {
            if (!hekimId) {
                return [];
            }

            const response =
                await fetch("/api/hekim-fiyatlari/" + hekimId);

            if (!response.ok) {
                const mesaj = await response.text();

                throw new Error(
                    mesaj ||
                    "Hekim fiyat listesi alınamadı."
                );
            }

            const data = await response.json();

            return Array.isArray(data)
                ? data
                : [];
        }

        function openYeniIsModal() {
            const modal = document.getElementById("yeniIsModal");
            const hata = document.getElementById("yeniIsHata");

            if (!modal) {
                return;
            }

            document.getElementById("yeniIsHasta").value = "";
            document.getElementById("yeniIsNotlar").value = "";

            if (hata) {
                hata.style.display = "none";
                hata.innerText = "";
            }

            seciliHekimFiyatlari = [];

            doldurHekimListesi();

            const hekimSelect =
