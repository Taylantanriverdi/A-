        async function mailV2DownloadAll(mailId, button){
            const original=button?.innerHTML||"";

            try{
                if(button){
                    button.disabled=true;
                    button.innerHTML='<span class="mailv2-file-badge">Hazırlanıyor...</span>';
                }

                const r=await fetch(`/api/mail-v2/mail/${Number(mailId)}/download-all`,{
                    method:"GET",
                    cache:"no-store"
                });

                if(!r.ok){
                    const text=await r.text();
                    throw new Error(text||"Dosyalar indirilemedi.");
                }

                const blob=await r.blob();

                let fileName="";
                const disposition=r.headers.get("content-disposition")||"";
                const utf8Match=disposition.match(/filename\*=UTF-8''([^;]+)/i);
                const normalMatch=disposition.match(/filename="?([^";]+)"?/i);

                if(utf8Match){
                    try{fileName=decodeURIComponent(utf8Match[1]);}catch{fileName=utf8Match[1];}
                }else if(normalMatch){
                    fileName=normalMatch[1];
                }

                if(!fileName){
                    fileName=(blob.type==="application/zip")
                        ? `mail_${Number(mailId)}_dosyalari.zip`
                        : `mail_${Number(mailId)}_dosya`;
                }

                const url=URL.createObjectURL(blob);
                const a=document.createElement("a");
                a.href=url;
                a.download=fileName;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(()=>URL.revokeObjectURL(url),30000);

                if(button){
                    button.innerHTML='<span class="mailv2-file-badge">✓ İndirildi</span>';
                    setTimeout(()=>{button.innerHTML=original;button.disabled=false;},1200);
                }
            }catch(e){
                if(button){
                    button.innerHTML=original;
                    button.disabled=false;
                }
                showError("Dosyalar indirilemedi: "+(e.message||e));
            }
        }

        function mailV2Size(bytes){
            bytes=Number(bytes||0);
            if(bytes<1024)return bytes+" B";
            if(bytes<1024*1024)return (bytes/1024).toFixed(1)+" KB";
            return (bytes/1024/1024).toFixed(1)+" MB";
        }

