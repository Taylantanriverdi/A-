        async function anayasaSiparisKaydet() {
            const hekimId = Number(document.getElementById("anHekim")?.value || 0);
            const hastaAdi = document.getElementById("anHasta")?.value.trim() || "";
            const kalemler = anayasaKalemleriOku();

            if (!hekimId) return showError("Hekim seç.");
            if (!hastaAdi) return showError("Hasta adı gerekli.");
            if (!kalemler.length) return showError("En az bir iş kalemi ekle.");

            const currencies = [...new Set(kalemler.map(k => String(k.paraBirimi || "TRY").toUpperCase()))];

            const button = document.getElementById("anSiparisKaydetBtn");
            if (button) { button.disabled = true; button.innerText = "Gönderiliyor..."; }

            try {
                const r = await fetch("/api/anayasa/siparis", {
                    method:"POST",
                    headers:{"Content-Type":"application/json"},
                    body:JSON.stringify({
                        hekimId,
                        hastaAdi,
                        terminTarihi: document.getElementById("anTermin")?.value || null,
                        disRengi: document.getElementById("anDisRengi")?.value.trim() || null,
                        materyal: document.getElementById("anMateryal")?.value.trim() || null,
                        disSemasi: Array.from(anayasaSeciliDisler).join(","),
                        notlar: document.getElementById("anNot")?.value.trim() || null,
                        kaynak: anayasaAktarilanPortalSiparisId ? "Sipariş Formu (Hekim Portalı)" : "Sipariş Formu",
                        aktarilanSiparisId: anayasaAktarilanPortalSiparisId,
                        // Her iş kalemi kendi para birimini taşır.
                        // Sunucu farklı para birimlerini güvenli biçimde ayrı iş kayıtlarına böler.
                        paraBirimi: currencies.length === 1 ? currencies[0] : null,
                        kalemler: kalemler.map(k => ({
                            isTuru:k.isTuru,
                            adet:k.adet,
                            birimFiyat:k.birimFiyat,
                            paraBirimi:String(k.paraBirimi || "TRY").toUpperCase()
                        }))
                    })
                });
                if (!r.ok) {
                    const raw = await r.text();
                    let mesaj = raw || "Sipariş oluşturulamadı.";
                    try {
                        const problem = JSON.parse(raw);
                        mesaj = problem.detail || problem.title || mesaj;
                    } catch {}
                    throw new Error(mesaj);
                }
                const sonuc = await r.json().catch(() => null);
                const portalAktarimiydi = !!anayasaAktarilanPortalSiparisId;
                // Yazdırırken bu işin tarama (STL) dosyaları forma resim olarak eklenir.
                anayasaYazdirIsId = portalAktarimiydi ? anayasaAktarilanPortalSiparisId : Number(sonuc?.siparisler?.[0]?.id || sonuc?.aktarilanSiparisId || 0) || null;
                anayasaAktarilanPortalSiparisId = null;
                anayasaFormOnayaGonderildi = true;
                await loadAnayasaData();
                anayasaFormButonDurumu();
                renderAnayasaFormHistory();

                const adet = Number(sonuc?.olusturulanSiparisSayisi || sonuc?.siparisler?.length || 1);
                if (adet > 1) {
                    showSuccess(
                        `Sipariş onaya gönderildi. ${adet} farklı para birimi için ${adet} ayrı iş kaydı oluşturuldu. Yazdırabilirsin.`
                    );
                } else {
                    showSuccess(portalAktarimiydi
                        ? "Hekim Portalı işi aynı kayıt üzerinde Sipariş Formuna dönüştürüldü ve onaya gönderildi."
                        : "Sipariş onaya gönderildi. Artık Yazdır butonunu kullanabilirsin.");
                }
            } catch (e) {
                showError(e.message || "Sipariş oluşturulamadı.");
            } finally {
                if (button) button.innerText = "Onaya Gönder";
                anayasaFormButonDurumu();
            }
        }

        async function loadAnayasaData() {
            try {
                const [islerR,giderR] = await Promise.all([
                    fetch("/api/anayasa/isler", {cache:"no-store"}),
                    fetch("/api/anayasa/giderler", {cache:"no-store"})
                ]);
                if (!islerR.ok) throw new Error(await islerR.text());
                anayasaIsler = await islerR.json();
                anayasaGiderler = giderR.ok ? await giderR.json() : [];
                renderAnayasaAll();
            } catch (e) {
                console.error(e);
                showError("Anayasa verileri yüklenemedi: " + (e.message || e));
            }
        }

        // Farklı yerlerdeki hekim portalı ve teknisyen panelinden gelen değişiklikler (yeni iş,
        // yüklenen tasarım, tamamlanan iş, mesaj) ekranda kendiliğinden görünür. Sipariş formunu
        // bozmamak için yalnız listeler yeniden çizilir.
        let anayasaCanliImza = null;
        function anayasaImza(liste){ return JSON.stringify((liste||[]).map(x=>[x.id,x.durum,x.onayDurumu,x.silindi,x.dosyaSayisi,x.tasarimDosyaSayisi,x.tasarimIndirildi,x.disMesajSayisi])); }
        async function anayasaCanliYenile(){
            if(document.visibilityState!=="visible")return;
            try{
                const r=await fetch("/api/anayasa/isler",{cache:"no-store"}); if(!r.ok)return;
                const yeni=await r.json(); const imza=anayasaImza(yeni);
                if(anayasaCanliImza===null){anayasaCanliImza=imza;return;}
                if(imza===anayasaCanliImza)return;
                const eski=new Map((anayasaIsler||[]).map(x=>[x.id,x]));
                const bildirimler=[];
                yeni.forEach(function(x){
                    const o=eski.get(x.id);
                    if(!o){ if(x.onayDurumu==="Gelen Onay")bildirimler.push("🦷 Yeni iş geldi: #"+x.id+" "+(x.hastaAdi||"")+" ("+(x.hekimAdi||"")+")"); return; }
                    if(Number(x.tasarimDosyaSayisi||0)>Number(o.tasarimDosyaSayisi||0))bildirimler.push("📐 Tasarım yüklendi: #"+x.id+" "+(x.hastaAdi||""));
                    if(x.durum==="Tamamlama Onayı"&&o.durum!=="Tamamlama Onayı")bildirimler.push("✅ Teknisyen işi bitirdi: #"+x.id+" "+(x.hastaAdi||""));
                    if(Number(x.disMesajSayisi||0)>Number(o.disMesajSayisi||0))bildirimler.push("💬 Yeni mesaj: #"+x.id+" "+(x.hastaAdi||""));
                });
                anayasaIsler=yeni; anayasaCanliImza=imza;
                [renderAnayasaHekimGelen,renderAnayasaOnay,renderAnayasaDagitim,renderAnayasaDevam,renderAnayasaDone,renderAnayasaFiles,renderAnayasaTeknisyenler,renderAnayasaTrash,renderAnayasaMesajJobs,renderMenuSayaclari]
                    .forEach(function(f){ try{f();}catch(e){console.error(e);} });
