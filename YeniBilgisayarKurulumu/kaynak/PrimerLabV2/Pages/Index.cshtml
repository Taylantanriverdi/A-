        // ---------------- Otomatik yedek ----------------
        function otomatikYedekBoyut(b){ b=Number(b||0); return b>=1048576?(b/1048576).toFixed(1)+' MB':Math.max(1,Math.round(b/1024))+' KB'; }
        async function otomatikYedekYukle(){
            const durum=document.getElementById('otomatikYedekDurum'); if(!durum) return;
            const saat=document.getElementById('otomatikYedekSaat');
            if(saat && !saat.options.length){ for(let h=0;h<24;h++){ const o=document.createElement('option'); o.value=String(h); o.textContent=String(h).padStart(2,'0')+':00'; saat.appendChild(o);} }
            try{
                const r=await fetch('/api/otomatik-yedek',{cache:'no-store'});
                if(!r.ok) throw new Error((await r.text())||'Durum alınamadı.');
                const d=await r.json();
                document.getElementById('otomatikYedekAktif').checked=!!d.aktif;
                saat.value=String(d.saat??2);
                document.getElementById('otomatikYedekSakla').value=String(d.saklanacak??30);
                document.getElementById('otomatikYedekEk').value=d.ekKlasor||'';
                document.getElementById('otomatikYedekDosya').checked=!!d.dosyalariDaYedekle;
                const son=d.sonYedek?new Date(d.sonYedek).toLocaleString('tr-TR'):'henüz yok';
                durum.innerText=(d.aktif?'Açık · her gün '+String(d.saat).padStart(2,'0')+':00 sonrası':'KAPALI')+' · Son yedek: '+son+(d.sonDurum?' — '+d.sonDurum:'')+'\nKlasör: '+(d.klasor||'-');
                durum.style.color=d.sonBasarili===false?'#b91c1c':'';
                const liste=document.getElementById('otomatikYedekListe'); liste.innerHTML='';
                const yedekler=d.yedekler||[];
                if(!yedekler.length){ liste.innerHTML='<div style="color:#64748b">Henüz otomatik yedek yok.</div>'; return; }
                yedekler.forEach(y=>{
                    const row=document.createElement('div');
                    row.style.cssText='display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid #eef2f7';
                    const ad=document.createElement('span'); ad.textContent=new Date(y.tarih).toLocaleString('tr-TR')+' · '+otomatikYedekBoyut(y.boyut);
                    const a=document.createElement('a'); a.href='/api/otomatik-yedek/indir/'+encodeURIComponent(y.ad); a.textContent='İndir'; a.style.fontWeight='800';
                    row.appendChild(ad); row.appendChild(a); liste.appendChild(row);
                });
            }catch(e){ durum.innerText=e.message||'Durum alınamadı.'; }
        }
