            operasyonFiltreleriniYukle();
            renderOperasyonMerkezi();

            planlamaFiltreSecenekleriniDoldur();
            planlamaVarsayilanTarih();
            renderPlanlama();

            await loadAnayasaData();
            await primerAiDurumYukle();
            portalHesaplariYukle(true);
            otomatikYedekYukle();
            waYukle();
        }

        async function durumKaydet() {
            const id = Number(document.getElementById("detayIsId")?.value || 0);
            const durum = document.getElementById("detayDurum")?.value || "";
            const hata = document.getElementById("isDetayHata");
            const button = document.getElementById("durumKaydetBtn");
            if (!id || !durum) return;
            if (button) { button.disabled = true; button.innerText = "Kaydediliyor..."; }
            try {
                const response = await fetch("/api/anayasa/isler/" + id + "/durum", { method:"PATCH", headers:{"Content-Type":"application/json"}, body:JSON.stringify({durum}) });
                if (!response.ok) throw new Error((await response.text()) || "Durum değiştirilemedi.");
                closeIsDetayModal();
                await Promise.all([loadSiparisler(), loadAnayasaData()]);
                showSuccess(durum === "Tamamlandı" ? "İş tamamlandı ve Tamamlanan İşler’e taşındı." : "İş durumu güncellendi.");
            } catch (error) {
                if (hata) { hata.innerText = error.message || "Durum kaydedilirken hata oluştu."; hata.style.display = "block"; }
            } finally {
                if (button) { button.disabled = false; button.innerText = "Durumu Kaydet"; }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            loadAll();
        });
    </script>

    <!-- MODAL JAVASCRIPT DOSYALARI -->


    <script>
        function isoTarih(value) {
            if (!value) {
                return "";
            }

            const d = new Date(value);

            if (Number.isNaN(d.getTime())) {
                return "";
            }

            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, "0");
            const day = String(d.getDate()).padStart(2, "0");

            return `${y}-${m}-${day}`;
        }


        function tarihAraligindaMi(value, baslangic, bitis) {
            const iso = isoTarih(value);

            if (!iso) {
                return false;
            }

            if (baslangic && iso < baslangic) {
                return false;
            }

            if (bitis && iso > bitis) {
                return false;
            }

            return true;
        }


        function openCariDetayModal(hekimId) {
            const hekim =
                hekimler.find(function (h) {
                    return Number(h.id) === Number(hekimId);
                });

            if (!hekim) {
                showError("Hekim bulunamadı.");
                return;
            }

            document.getElementById(
                "cariDetayHekimId"
            ).value = hekim.id;

            document.getElementById(
                "cariDetayAltBaslik"
            ).innerText =
                (hekim.adSoyad || "-") +
                (hekim.klinikAdi
                    ? " — " + hekim.klinikAdi
                    : "");

            document.getElementById(
                "cariBaslangic"
            ).value = "";

            document.getElementById(
                "cariBitis"
            ).value = "";

            cariDetaySekme = "tum";
            cariSekmeButonlariniGuncelle();

            renderCariDetay();

            document.getElementById(
                "cariDetayModal"
            ).style.display = "flex";
        }


        function closeCariDetayModal() {
            const modal =
                document.getElementById("cariDetayModal");

            if (modal) {
                modal.style.display = "none";
            }
        }


        function cariTarihFiltresiniTemizle() {
            document.getElementById(
                "cariBaslangic"
            ).value = "";

            document.getElementById(
                "cariBitis"
            ).value = "";

            renderCariDetay();
        }


        function localDateInputValue(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, "0");
            const d = String(date.getDate()).padStart(2, "0");

            return `${y}-${m}-${d}`;
        }


        function cariBuAy() {
            const now = new Date();

            document.getElementById("cariBaslangic").value =
                localDateInputValue(
                    new Date(
                        now.getFullYear(),
                        now.getMonth(),
                        1
                    )
                );

            document.getElementById("cariBitis").value =
                localDateInputValue(
                    new Date(
                        now.getFullYear(),
                        now.getMonth() + 1,
                        0
                    )
                );

            renderCariDetay();
        }


        function cariSon30Gun() {
            const bitis = new Date();
            const baslangic = new Date();

            baslangic.setDate(
                baslangic.getDate() - 29
            );

            document.getElementById("cariBaslangic").value =
                localDateInputValue(baslangic);

            document.getElementById("cariBitis").value =
                localDateInputValue(bitis);

            renderCariDetay();
        }


        function cariBuYil() {
            const now = new Date();

            document.getElementById("cariBaslangic").value =
                `${now.getFullYear()}-01-01`;

            document.getElementById("cariBitis").value =
                `${now.getFullYear()}-12-31`;

            renderCariDetay();
        }


        function cariSekmeSec(sekme) {
            cariDetaySekme = sekme;
            cariSekmeButonlariniGuncelle();
            renderCariDetay();
        }


        function cariSekmeButonlariniGuncelle() {
            const map = {
                tum: "cariTabTum",
                isler: "cariTabIsler",
                tahsilat: "cariTabTahsilat"
            };

            Object.entries(map).forEach(
                function (entry) {
                    const sekme = entry[0];
                    const id = entry[1];
                    const button =
                        document.getElementById(id);

                    if (!button) {
                        return;
                    }

                    button.classList.toggle(
                        "active",
                        sekme === cariDetaySekme
                    );
                }
            );
        }


        function renderCariDetay() {
            const hekimId =
                Number(
                    document.getElementById(
                        "cariDetayHekimId"
                    )?.value || 0
                );

            if (!hekimId) {
                return;
            }

            const baslangic =
                document.getElementById(
                    "cariBaslangic"
                )?.value || "";

            const bitis =
                document.getElementById(
                    "cariBitis"
                )?.value || "";

            const tumHekimIsleri =
                siparisler.filter(function (item) {
                    return (
                        Number(item.hekimId) === hekimId &&
                        standartDurum(item.durum) !== "İptal"
                    );
                });

            const tumHekimTahsilatlari =
                tahsilatlar.filter(function (item) {
                    return Number(item.hekimId) === hekimId;
                });

            function isEsasTarihi(item) {
                // ANAYASA V32.30: İşin dönem/liste tarihi değişmez geliş-kayıt tarihidir.
                // Termin ve gerçek teslim tarihi yalnız operasyon bilgisidir.
                return item.olusturmaTarihi || item.gelisTarihi || item.kayitTarihi || null;
            }

            const isler =
                tumHekimIsleri.filter(function (item) {
                    const teslimMi =
                        standartDurum(item.durum) === "Teslim";

                    return tarihAraligindaMi(
                        isEsasTarihi(item),
                        baslangic,
                        bitis
                    );
                });

            const odemeler =
                tumHekimTahsilatlari.filter(function (item) {
                    return tarihAraligindaMi(
                        item.tarih,
                        baslangic,
                        bitis
                    );
                });

            const aktifIsler =
                isler.filter(function (item) {
                    return standartDurum(item.durum) !== "Teslim";
                });

            const teslimIsler =
                isler.filter(function (item) {
                    return standartDurum(item.durum) === "Teslim";
                });

            const aktifTutar =
                toplamTutarHesapla(aktifIsler);

            const teslimTutar =
                toplamTutarHesapla(teslimIsler);

            const tahsilatToplam =
                odemeler.reduce(function (sum, item) {
                    return sum + Number(item.tutar || 0);
                }, 0);

            // Seçilen tarih aralığının başından önceki gerçek cari bakiye.
            // Aktif işler açılış bakiyesine dahil edilmez.
            let acilisBakiyesi = 0;

            if (baslangic) {
                tumHekimIsleri.forEach(function (item) {
                    if (
                        standartDurum(item.durum) !== "Teslim" ||
                        !isEsasTarihi(item)
                    ) {
                        return;
                    }

                    const iso =
                        isoTarih(isEsasTarihi(item));

                    if (iso && iso < baslangic) {
                        acilisBakiyesi +=
                            Number(item.toplamTutar || 0);
                    }
                });

                tumHekimTahsilatlari.forEach(function (item) {
                    const iso =
                        isoTarih(item.tarih);

                    if (iso && iso < baslangic) {
                        acilisBakiyesi -=
                            Number(item.tutar || 0);
                    }
                });
            }

            const bakiye =
                acilisBakiyesi +
                teslimTutar -
                tahsilatToplam;

            document.getElementById(
                "cariAktifTutar"
            ).innerText = para(aktifTutar);

            document.getElementById(
                "cariTeslimTutar"
            ).innerText = para(teslimTutar);

            document.getElementById(
                "cariTahsilatToplam"
            ).innerText = para(tahsilatToplam);

            document.getElementById(
                "cariBakiye"
            ).innerText = para(bakiye);

            const hareketler = [];

            if (baslangic) {
                hareketler.push({
                    tarih: baslangic + "T00:00:00",
                    tip: "Açılış Bakiyesi",
                    odemeTuru: "-",
                    islemNo: "-",
                    aciklama:
                        "Seçilen dönem öncesinden devreden cari bakiye",
                    adet: "-",
                    tahsilatId: 0,
                    borc:
                        acilisBakiyesi > 0
                            ? acilisBakiyesi
                            : 0,
                    alacak:
                        acilisBakiyesi < 0
                            ? Math.abs(acilisBakiyesi)
                            : 0,
                    siralama:
                        new Date(
                            baslangic + "T00:00:00"
                        ).getTime(),
                    oncelik: -1000000,
                    sabitBakiye:
                        acilisBakiyesi
                });
            }

            if (
                cariDetaySekme === "tum" ||
                cariDetaySekme === "isler"
            ) {
                isler.forEach(function (item) {
                    const teslimMi =
                        standartDurum(item.durum) === "Teslim";

                    const esasTarih = isEsasTarihi(item);

                    hareketler.push({
                        tarih:
                            esasTarih,
                        tip:
                            teslimMi
                                ? "Teslim Edilmiş İş"
                                : "Aktif İş",
                        odemeTuru: "-",
                        islemNo: "-",
                        aciklama:
                            "#" +
                            item.id +
                            " — " +
                            (item.hastaAdi || "-"),
                        tahsilatId: 0,
                        adet:
                            Number(item.toplamAdet || 0),
                        borc:
                            teslimMi
                                ? Number(item.toplamTutar || 0)
                                : 0,
                        alacak:
                            0,
                        siralama:
                            new Date(
                                esasTarih ||
                                item.olusturmaTarihi
                            ).getTime(),
                        // Aynı milisaniyede deterministik sıra:
                        // teslim işi tahsilattan önce işlenir.
                        oncelik:
                            teslimMi
                                ? 10
                                : 5,
                        id:
                            Number(item.id || 0)
                    });
                });
            }

            if (
                cariDetaySekme === "tum" ||
                cariDetaySekme === "tahsilat"
            ) {
                odemeler.forEach(function (item) {
                    hareketler.push({
                        tarih:
                            item.tarih,
                        tip:
                            "Tahsilat",
                        odemeTuru:
                            item.odemeTuru || "Nakit",
                        islemNo:
                            item.islemNo || "-",
                        aciklama:
                            item.aciklama || "-",
                        tahsilatId:
                            Number(item.id || 0),
                        adet:
                            "-",
                        borc:
                            0,
                        alacak:
                            Number(item.tutar || 0),
                        siralama:
                            new Date(
                                item.tarih
                            ).getTime(),
                        oncelik:
                            20,
                        id:
                            Number(item.id || 0)
                    });
                });
            }

            const kronolojik =
                hareketler
                    .slice()
                    .sort(function (a, b) {
                        if (a.siralama !== b.siralama) {
                            return a.siralama - b.siralama;
                        }

                        if (
                            Number(a.oncelik || 0) !==
                            Number(b.oncelik || 0)
                        ) {
                            return (
                                Number(a.oncelik || 0) -
                                Number(b.oncelik || 0)
                            );
                        }

                        return (
                            Number(a.id || 0) -
                            Number(b.id || 0)
                        );
                    });

            let yuruyenBakiye = 0;

            kronolojik.forEach(function (h) {
                if (
                    typeof h.sabitBakiye === "number"
                ) {
                    yuruyenBakiye =
                        h.sabitBakiye;

                    h.bakiye =
                        yuruyenBakiye;

                    return;
                }

                yuruyenBakiye +=
                    Number(h.borc || 0) -
                    Number(h.alacak || 0);

                h.bakiye =
                    yuruyenBakiye;
            });

            const gosterilecek =
                kronolojik
                    .slice()
                    .reverse();

            const body =
                document.getElementById(
                    "cariHareketBody"
                );

            if (!gosterilecek.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="10" class="empty">
                            Seçilen tarihlerde hareket bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML =
                gosterilecek.map(function (h) {
                    const bakiyeClass =
                        h.bakiye > 0.009
                            ? "cari-balance-positive"
                            : h.bakiye < -0.009
                                ? "cari-balance-negative"
                                : "cari-balance-zero";

                    const isTahsilat =
                        Number(h.tahsilatId || 0) > 0;

                    return `
                        <tr>
                            <td>${tarihGoster(h.tarih)}</td>
                            <td>${escapeHtml(h.tip)}</td>
                            <td>${escapeHtml(h.odemeTuru || "-")}</td>
                            <td>${escapeHtml(h.islemNo || "-")}</td>
                            <td>${escapeHtml(h.aciklama)}</td>
                            <td>${h.adet}</td>
                            <td>${h.borc ? para(h.borc) : "-"}</td>
                            <td class="finance-positive">
                                ${h.alacak ? para(h.alacak) : "-"}
                            </td>
                            <td class="${bakiyeClass}">
                                ${para(h.bakiye)}
                            </td>
                            <td>
                                ${
                                    isTahsilat
                                        ? `
                                            <div class="button-group">
                                                <button type="button"
                                                        class="button button-light"
                                                        onclick="tahsilatMakbuzuYazdir(${Number(h.tahsilatId)})">
                                                    Makbuz
                                                </button>

                                                <button type="button"
                                                        class="button button-light"
                                                        onclick="cariTahsilatDuzenle(${Number(h.tahsilatId)})">
                                                    Düzenle
                                                </button>

                                                <button type="button"
                                                        class="button"
                                                        style="background:#fee2e2;color:#991b1b;"
                                                        onclick="cariTahsilatSil(${Number(h.tahsilatId)})">
                                                    Sil
                                                </button>
                                            </div>
                                        `
                                        : "-"
                                }
                            </td>
                        </tr>
                    `;
                }).join("");
        }


