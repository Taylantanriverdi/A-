        async function loadSiparisler() {
            try {
                clearError();

                const response = await fetch("/api/siparisler");

                if (!response.ok) {
                    throw new Error("İşler alınamadı.");
                }

                const data = await response.json();
                siparisler = Array.isArray(data) ? data : [];

                renderDashboard();
                renderGelenIsler();
                renderDevamEdenler();
                renderUretimPanosu();
                renderOperasyonMerkezi();
                renderPlanlama();
                renderKaliteKontrol();
                teslimatHekimSecenekleriniDoldur();
                renderTeslimatMerkezi();
                renderArsiv();
                renderMuhasebe();
            }
            catch (error) {
                console.error(error);
                showError(error.message || "İşler alınırken hata oluştu.");
            }
        }

