        }

        function disRengiRozeti(itemOrValue) {
            const value =
                typeof itemOrValue === "object"
                    ? String(itemOrValue?.disRengi || "").trim()
                    : String(itemOrValue || "").trim();

            if (!value) return "";

            return '<span class="shade-badge">' +
                escapeHtml(value) +
                '</span>';
        }

        function teknisyenAtamasi(itemOrId) {
            const id =
                typeof itemOrId === "object"
                    ? Number(itemOrId?.id || 0)
