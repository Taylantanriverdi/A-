        function legacyOzetMetni(tur, obj) {
            if (!obj || typeof obj !== "object") return "-";

            if (tur === "jobs" || tur === "pendingJobs") {
                return [
                    obj.patient || "İsimsiz",
                    obj.drName || "",
                    obj.type || obj.jobType || "",
                    obj.status || "",
                    obj.currency ? (String(obj.price || 0) + " " + obj.currency) : ""
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            if (tur === "payments") {
                return [
                    obj.drName || "",
                    String(obj.amount || 0) + " " + (obj.currency || "TRY"),
                    obj.date || "",
                    obj.note || ""
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            if (tur === "doctors" || tur === "technicians") {
                return escapeHtml(obj.name || "-");
            }

            if (tur === "expenses") {
                return [
                    obj.title || obj.category || "",
                    String(obj.amount || 0) + " " + (obj.currency || "TRY"),
                    obj.date || ""
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            if (tur === "orderForms" || tur === "doctorSubmissions") {
                return [
                    obj.patient || "",
                    obj.drName || obj.doctorName || "",
                    obj.jobType || obj.finalType || "",
                    obj.color || ""
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            if (tur === "statementClosures") {
                return [
                    obj.drName || "",
                    obj.closedAt || "",
                    "Dönem kapanışı"
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            if (tur === "sales") {
                return [
                    obj.customer || "",
                    obj.formNo || "",
                    String(obj.total || 0) + " " + (obj.currency || "")
                ].filter(Boolean).map(escapeHtml).join(" • ");
            }

            return escapeHtml(JSON.stringify(obj).slice(0, 220));
        }

        async function loadLegacyArsiv() {
