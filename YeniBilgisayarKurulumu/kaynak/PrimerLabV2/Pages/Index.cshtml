        function duzenleToplamlariniHesapla() {
            let toplam = 0;

            document
                .querySelectorAll(
                    "#duzenleKalemler .job-line"
                )
                .forEach(function (row) {
                    const adet =
                        Number(
                            row.querySelector(
                                ".edit-job-qty"
                            ).value || 0
                        );

                    const fiyat =
                        Number(
                            row.querySelector(
                                ".edit-job-price"
                            ).value || 0
                        );

                    const satirToplam =
                        adet * fiyat;

                    toplam += satirToplam;

                    row.querySelector(
                        ".edit-job-total"
                    ).value =
                        para(satirToplam);
                });

            const genel =
                document.getElementById(
                    "duzenleGenelToplam"
                );

            if (genel) {
                genel.innerText =
                    para(toplam);
            }
        }


        function duzenleKalemleriniOku() {
            const kalemler = [];

            document
                .querySelectorAll(
                    "#duzenleKalemler .job-line"
                )
                .forEach(function (row) {
                    const isTuru =
                        row.querySelector(
                            ".edit-job-type"
