        async function teknisyenAta(
            siparisId,
            teknisyenId
        ) {
            const id =
                Number(siparisId);

            const value =
                teknisyenId
                    ? Number(teknisyenId)
                    : null;

            if (!id) {
                throw new Error(
                    "Geçersiz iş numarası."
                );
            }

            if (
                teknisyenId &&
                (!Number.isInteger(value) || value <= 0)
            ) {
                throw new Error(
                    "Geçersiz teknisyen seçimi."
                );
            }

            const response =
                await fetch(
                    "/api/teknisyen-atamalari/" +
                    id,
                    {
                        method: "PATCH",
                        cache: "no-store",
                        headers: {
                            "Content-Type":
                                "application/json",
                            "Cache-Control":
                                "no-cache"
                        },
                        body: JSON.stringify({
                            teknisyenId: value
                        })
                    }
                );

            if (!response.ok) {
                const message =
                    await response.text();

                throw new Error(
                    message ||
                    "Teknisyen atanamadı."
                );
            }

            const saved =
                await response.json();

            teknisyenAtamalari.set(
                id,
                saved
            );

            const verifyResponse =
                await fetch(
                    "/api/teknisyen-atamalari/" +
                    id +
                    "?_=" +
                    Date.now(),
                    {
                        cache: "no-store",
                        headers: {
                            "Cache-Control":
                                "no-cache"
                        }
                    }
                );

            if (!verifyResponse.ok) {
                const message =
                    await verifyResponse.text();

                throw new Error(
                    message ||
                    "Teknisyen ataması doğrulanamadı."
                );
            }

            const verified =
                await verifyResponse.json();

            const verifiedId =
                verified.teknisyenId == null
                    ? null
                    : Number(verified.teknisyenId);

            if (verifiedId !== value) {
                throw new Error(
                    "Teknisyen değişikliği veritabanına kaydedilmedi."
                );
            }

            teknisyenAtamalari.set(
                id,
                verified
            );

            renderDashboard();
            renderGelenIsler();
            renderDevamEdenler();
            renderUretimPanosu();
            renderOperasyonMerkezi();

            return verified;
        }

