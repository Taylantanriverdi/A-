                box.className="backup-status-box error";
                box.innerText="Yedekleme sistemi kontrol edilemedi: "+(e?.message||e);
            }
        }

        async function tamYedekIndir(){
            try{
                const r=await fetch("/api/backup/export");
                if(!r.ok)throw new Error((await r.text())||"Yedek oluşturulamadı.");

                const blob=await r.blob();
                const cd=r.headers.get("content-disposition")||"";
                const m=/filename="?([^";]+)"?/i.exec(cd);
                const name=m?.[1]||`PrimerLab_Backup_${new Date().toISOString().slice(0,10)}.json`;

                const url=URL.createObjectURL(blob);
                const a=document.createElement("a");
                a.href=url;
                a.download=name;
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(()=>URL.revokeObjectURL(url),2000);

                showSuccess("Tam sistem yedeği indirildi.");
                loadBackupStatus();
            }catch(e){
                showError(e?.message||"Yedek indirilemedi.");
            }
        }

        async function tamYedekRestore(){
            const input=document.getElementById("tamRestoreFile");
            const file=input?.files?.[0];
            if(!file)return showError("Önce Primer Lab tam yedek JSON dosyasını seç.");

            const text=prompt(
                "Bu işlem mevcut verileri seçtiğin yedekle değiştirecek.\\n\\n"+
                "İşlem öncesinde otomatik güvenlik yedeği alınacak.\\n"+
                "Devam etmek için RESTORE yaz:"
            );
            if(text!=="RESTORE"){
                if(text!==null)showError("Geri yükleme iptal edildi. RESTORE yazılmadı.");
                return;
            }

            const fd=new FormData();
            fd.append("file",file);
            fd.append("confirm","RESTORE");

            const box=document.getElementById("backupStatusBox");
            box.className="backup-status-box";
            box.innerText="Geri yükleme yapılıyor. Pencereyi kapatma...";

            try{
                const r=await fetch("/api/backup/restore",{method:"POST",body:fd});
                const raw=await r.text();
                if(!r.ok)throw new Error(raw||"Geri yükleme başarısız.");

                let d={};
                try{d=JSON.parse(raw)}catch{}
                box.className="backup-status-box ok";
                box.innerText="Geri yükleme tamamlandı. Otomatik güvenlik yedeği: "+(d.safetyBackup||"oluşturuldu");
                showSuccess("Tam yedek geri yüklendi.");

                await Promise.all([
                    loadSiparisler(),
                    loadAnayasaData(),
                    loadTahsilatlar(),
                    loadHekimler(),
                    loadTeknisyenler(),
                    kaYenile(),
                    loadBackupStatus()
                ]);
            }catch(e){
                box.className="backup-status-box error";
                box.innerText="Geri yükleme hatası: "+(e?.message||e);
                showError(e?.message||"Geri yükleme başarısız.");
            }
        }

        async function tamSistemSifirla(){
