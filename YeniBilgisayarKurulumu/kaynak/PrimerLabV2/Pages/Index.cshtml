            hekimSelect.value = "";

            document.getElementById(
                "yeniIsKalemler"
            ).innerHTML = "";

            const warning =
                document.getElementById(
                    "doctorPriceWarning"
                );

            warning.style.display = "none";

            document.getElementById(
