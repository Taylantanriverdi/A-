        // Ayrı dışa aktarılmış iki çeneyi kapanışa oturtur: ortak eksen (x sağ-sol, y ön, z yukarı);
        // orta hatlar ve kesici uçlar hizalanır; üst kesiciler 1,5 mm önde ve 1,5 mm alt dişlerin önüne biner.
        function stlKapanisaOturt(mu,eu,ma,ea){
            const donustur=(m,e,ust)=>{
                const z=ust?stlV.sc(e.dik,-1):e.dik, y=e.der, x=stlV.cr(y,z), p=m.p, q=new Float32Array(p.length);
                for(let i=0;i<p.length;i+=3){ const d=[p[i]-e.c[0],p[i+1]-e.c[1],p[i+2]-e.c[2]]; q[i]=stlV.dot(d,x); q[i+1]=stlV.dot(d,y); q[i+2]=stlV.dot(d,z); }
                return {p:q, idx:m.idx};
            };
            const sinir=m=>{ const p=m.p, a=[Infinity,Infinity,Infinity], b=[-Infinity,-Infinity,-Infinity]; for(let i=0;i<p.length;i+=3) for(let k=0;k<3;k++){ if(p[i+k]<a[k])a[k]=p[i+k]; if(p[i+k]>b[k])b[k]=p[i+k]; } return {a,b}; };
            const u=donustur(mu,eu,true), l=donustur(ma,ea,false), su=sinir(u), sl=sinir(l);
            const kaydir=(m,dx,dy,dz)=>{ const p=m.p; for(let i=0;i<p.length;i+=3){ p[i]+=dx; p[i+1]+=dy; p[i+2]+=dz; } };
            kaydir(u, -(su.a[0]+su.b[0])/2, -su.b[1]+1.5, -su.a[2]-1.5);
            kaydir(l, -(sl.a[0]+sl.b[0])/2, -sl.b[1], -sl.b[2]);
            return {ust:u, alt:l};
        }
        function stlNormaller(m){
            const p=m.p, idx=m.idx, nor=new Float32Array(p.length);
            for(let i=0;i<idx.length;i+=3){
                const a=idx[i]*3,b=idx[i+1]*3,d=idx[i+2]*3;
                const ux=p[b]-p[a],uy=p[b+1]-p[a+1],uz=p[b+2]-p[a+2], vx=p[d]-p[a],vy=p[d+1]-p[a+1],vz=p[d+2]-p[a+2];
                const nx=uy*vz-uz*vy, ny=uz*vx-ux*vz, nz=ux*vy-uy*vx;
                for(const q of [a,b,d]){ nor[q]+=nx; nor[q+1]+=ny; nor[q+2]+=nz; }
            }
            return nor;
        }
        const STL_RENK_UST=[0.93,0.86,0.76], STL_RENK_ALT=[0.86,0.88,0.93], STL_RENK_KAPANIS=[0.80,0.83,0.90];
        async function stlGorselleriHazirla(isId){
            const kutu=document.getElementById('anStlGorseller'); if(!kutu) return;
            stlGorselAlaniTemizle();
            const r=await fetch('/api/is-dosyalari/siparis/'+Number(isId),{cache:'no-store'}); if(!r.ok) return;
            const dosyalar=(await r.json()).filter(f=>/\.(stl|ply|obj)$/i.test(f.orijinalDosyaAdi||'') && (f.dosyaTuru||'')!=='Tasarım');
            if(!dosyalar.length) return;
            showSuccess('Tarama görüntüleri hazırlanıyor...');
            const tur={ust:null,alt:null,kapanis:null}, diger=[];
            for(const f of dosyalar){ const t=stlTurBul(f.orijinalDosyaAdi); if(t && !tur[t]) tur[t]=f; else diger.push(f); }
            // Adı tanınmayan dosyalar sırayla boş yerlere (üst, alt) yerleşir; ad yine altta yazar.
            for(const f of diger){ if(!tur.ust) tur.ust=f; else if(!tur.alt) tur.alt=f; }
            const mesh={};
            for(const k of ['ust','alt','kapanis']) if(tur[k]){ try{ mesh[k]=await stlHamMesh(Number(tur[k].id)); }catch(e){ console.warn(e); } }
            const merkez=m=>{ const p=m.p; let c=[0,0,0]; for(let i=0;i<p.length;i+=3){ c[0]+=p[i]; c[1]+=p[i+1]; c[2]+=p[i+2]; } return stlV.sc(c,3/p.length); };
            const mU=mesh.ust?merkez(mesh.ust):null, mA=mesh.alt?merkez(mesh.alt):null;
            // Çene eksenleri: önce taramaların kapanış konumunda olup olmadığı karşı çeneye göre denetlenir.
            let eu=mesh.ust?stlCeneEksen(mesh.ust,mA):null, ea=mesh.alt?stlCeneEksen(mesh.alt,mU):null;
            const kapanisKonumu=!!(eu&&ea) && stlKapanisKonumunda(mesh.ust,eu,mesh.alt,ea);
            if(eu&&ea&&!kapanisKonumu){ eu=stlCeneEksen(mesh.ust); ea=stlCeneEksen(mesh.alt); }
            const resimler=[];
            // Tepeden (okluzal) görünüm, kesici dişler yukarıda.
            if(mesh.ust){ resimler.push({ad:'ÜST ÇENE',dosya:tur.ust.orijinalDosyaAdi,src:stlCizer.ciz([{m:mesh.ust,renk:STL_RENK_UST}],stlV.sc(eu.dik,-1),eu.der)}); }
            if(mesh.alt){ resimler.push({ad:'ALT ÇENE',dosya:tur.alt.orijinalDosyaAdi,src:stlCizer.ciz([{m:mesh.alt,renk:STL_RENK_ALT}],stlV.sc(ea.dik,-1),ea.der)}); }
            if(mesh.ust && mesh.alt){
                // Kapanış: iki çene dişleri birbirine oturmuş, önden; üst çene yukarıda.
                let pu=mesh.ust, pa=mesh.alt, yukari, ileri;
                if(kapanisKonumu){
                    yukari=stlV.ny([eu.c[0]-ea.c[0],eu.c[1]-ea.c[1],eu.c[2]-ea.c[2]]);
                    ileri=stlV.sc(eu.der,-1); ileri=stlV.ny(stlV.ad(ileri,stlV.sc(yukari,-stlV.dot(ileri,yukari))));
                } else {
                    const o=stlKapanisaOturt(mesh.ust,eu,mesh.alt,ea); pu=o.ust; pa=o.alt;
                    yukari=[0,0,1]; ileri=[0,-1,0];
                }
                resimler.push({ad:'KAPANIŞ',dosya:'Üst + alt çene kapanışta (önden)',src:stlCizer.ciz([{m:pu,renk:STL_RENK_UST},{m:pa,renk:STL_RENK_ALT}],ileri,yukari)});
            } else if(mesh.kapanis){
                const e=stlCeneEksen(mesh.kapanis);
                resimler.push({ad:'KAPANIŞ',dosya:tur.kapanis.orijinalDosyaAdi,src:stlCizer.ciz([{m:mesh.kapanis,renk:STL_RENK_KAPANIS}],stlV.sc(e.der,-1),e.dik)});
            }
            const gecerli=resimler.filter(x=>x.src);
            if(!gecerli.length) return;
            kutu.style.setProperty('--stl-adet',String(gecerli.length));
            kutu.innerHTML='<div class="ref-stl-baslik">TARAMA GÖRÜNTÜLERİ</div><div class="ref-stl-izgara">'+gecerli.map(x=>`<figure><img src="${x.src}" alt="${escapeHtml(x.ad)}" /><figcaption>${escapeHtml(x.ad)}<small>${escapeHtml(x.dosya||'')}</small></figcaption></figure>`).join('')+'</div>';
            kutu.style.display='block';
            // Resimler yüklenmeden ölçü alınmasın.
            await Promise.all([...kutu.querySelectorAll('img')].map(i=>i.complete?null:new Promise(ok=>{i.onload=ok;i.onerror=ok;})));
        }
        // Sunucunun sadeleştirilmiş ağ biçimi: "PLM1" | nokta | üçgen | float32 xyz | uint32 indeks
        function onzMeshCoz(buf){
            const dv=new DataView(buf);
            if(String.fromCharCode(dv.getUint8(0),dv.getUint8(1),dv.getUint8(2),dv.getUint8(3))!=='PLM1') throw new Error('Önizleme verisi okunamadı.');
            const vc=dv.getUint32(4,true), tc=dv.getUint32(8,true);
            const p=new Float32Array(buf,12,vc*3), idx=new Uint32Array(buf,12+vc*12,tc*3);
            let mn=[Infinity,Infinity,Infinity], mx=[-Infinity,-Infinity,-Infinity];
            for(let i=0;i<p.length;i+=3) for(let k=0;k<3;k++){ if(p[i+k]<mn[k])mn[k]=p[i+k]; if(p[i+k]>mx[k])mx[k]=p[i+k]; }
            const c=[(mn[0]+mx[0])/2,(mn[1]+mx[1])/2,(mn[2]+mx[2])/2];
            let r=0; for(let i=0;i<p.length;i+=3){ const dx=p[i]-c[0],dy=p[i+1]-c[1],dz=p[i+2]-c[2]; r=Math.max(r,dx*dx+dy*dy+dz*dz); }
            r=Math.sqrt(r)||1;
            const pos=new Float32Array(p.length); for(let i=0;i<p.length;i+=3){ pos[i]=(p[i]-c[0])/r; pos[i+1]=(p[i+1]-c[1])/r; pos[i+2]=(p[i+2]-c[2])/r; }
            const nor=new Float32Array(p.length);
            for(let i=0;i<idx.length;i+=3){
                const a=idx[i]*3,b=idx[i+1]*3,d=idx[i+2]*3;
                const ux=pos[b]-pos[a],uy=pos[b+1]-pos[a+1],uz=pos[b+2]-pos[a+2], vx=pos[d]-pos[a],vy=pos[d+1]-pos[a+1],vz=pos[d+2]-pos[a+2];
                const nx=uy*vz-uz*vy, ny=uz*vx-ux*vz, nz=ux*vy-uy*vx;
                for(const q of [a,b,d]){ nor[q]+=nx; nor[q+1]+=ny; nor[q+2]+=nz; }
            }
            return {pos,nor,idx,adet:idx.length};
        }
        // Bağımsız küçük WebGL görüntüleyici: otomatik döner, fareyle sürükleyerek çevrilir.
        const onzGL=(function(){
            let gl=null, prog=null, tuval=null, buf={}, adet=0, renk=[0.9,0.85,0.75], rx=-0.5, ry=0, anim=0, surukle=null, uintExt=null;
            const vs='attribute vec3 p;attribute vec3 n;uniform mat4 m;uniform mat3 r;varying vec3 vn;void main(){vn=r*n;gl_Position=m*vec4(p,1.0);}';
            const fs='precision mediump float;varying vec3 vn;uniform vec3 c;void main(){vec3 N=normalize(vn);float d=abs(dot(N,normalize(vec3(0.35,0.55,1.0))));float s=pow(max(d,0.0),24.0)*0.25;gl_FragColor=vec4(c*(0.28+0.72*d)+s,1.0);}';
            function derle(t,src){const sh=gl.createShader(t);gl.shaderSource(sh,src);gl.compileShader(sh);return sh;}
            // Tek tuval ve tek WebGL bağlamı yeniden kullanılır (tarayıcıların bağlam sınırı var).
            function baslat(kutu){
                dur(); rx=-0.5; ry=0;
                if(!tuval){
                    tuval=document.createElement('canvas'); tuval.width=680; tuval.height=500;
                    gl=tuval.getContext('webgl',{antialias:true});
                    if(gl){
                        uintExt=gl.getExtension('OES_element_index_uint');
                        prog=gl.createProgram(); gl.attachShader(prog,derle(gl.VERTEX_SHADER,vs)); gl.attachShader(prog,derle(gl.FRAGMENT_SHADER,fs)); gl.linkProgram(prog);
                        buf={p:gl.createBuffer(),n:gl.createBuffer(),i:gl.createBuffer()};
                    }
                    tuval.onmousedown=e=>{surukle={x:e.clientX,y:e.clientY,rx,ry};tuval.style.cursor='grabbing';};
                    window.addEventListener('mouseup',()=>{surukle=null;tuval.style.cursor='grab';});
                    tuval.onmousemove=e=>{ if(!surukle)return; ry=surukle.ry+(e.clientX-surukle.x)*0.01; rx=surukle.rx+(e.clientY-surukle.y)*0.01; };
                }
                if(kutu) kutu.insertBefore(tuval,kutu.firstChild);
                if(!gl){ onzDurum('Bu tarayıcı 3B önizlemeyi desteklemiyor.'); return; }
                gl.clearColor(0,0,0,0); gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);
            }
            function ciz(mesh,c){
                if(!gl) return; renk=c;
                if(!uintExt && mesh.pos.length/3>65535){ onzDurum('Bu tarayıcıda büyük model gösterilemiyor.'); return; }
                gl.bindBuffer(gl.ARRAY_BUFFER,buf.p); gl.bufferData(gl.ARRAY_BUFFER,mesh.pos,gl.STATIC_DRAW);
                gl.bindBuffer(gl.ARRAY_BUFFER,buf.n); gl.bufferData(gl.ARRAY_BUFFER,mesh.nor,gl.STATIC_DRAW);
                gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,buf.i); gl.bufferData(gl.ELEMENT_ARRAY_BUFFER,uintExt?mesh.idx:new Uint16Array(mesh.idx),gl.STATIC_DRAW);
                adet=mesh.adet; cancelAnimationFrame(anim); kare();
            }
            function kare(){
                if(!gl||!adet) return;
                if(!surukle) ry+=0.008;
                const cx=Math.cos(rx),sx=Math.sin(rx),cy=Math.cos(ry),sy=Math.sin(ry);
                // R = Rx * Ry (sütun düzeninde)
                const R=[cy,sx*sy,-cx*sy, 0,cx,sx, sy,-sx*cy,cx*cy];
                const a=tuval.width/tuval.height, f=1/Math.tan(0.45), near=0.1, far=10, z=-2.7;
                const P=[f/a,0,0,0, 0,f,0,0, 0,0,(far+near)/(near-far),-1, 0,0,2*far*near/(near-far),0];
                const MV=[R[0],R[1],R[2],0, R[3],R[4],R[5],0, R[6],R[7],R[8],0, 0,0,z,1];
                const M=new Float32Array(16);
                for(let i=0;i<4;i++)for(let j=0;j<4;j++){let s=0;for(let k=0;k<4;k++)s+=P[k*4+j]*MV[i*4+k];M[i*4+j]=s;}
                gl.viewport(0,0,tuval.width,tuval.height); gl.clearColor(0,0,0,0); gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT); gl.enable(gl.DEPTH_TEST);
                gl.useProgram(prog);
                const lp=gl.getAttribLocation(prog,'p'), ln=gl.getAttribLocation(prog,'n');
                gl.bindBuffer(gl.ARRAY_BUFFER,buf.p); gl.enableVertexAttribArray(lp); gl.vertexAttribPointer(lp,3,gl.FLOAT,false,0,0);
                gl.bindBuffer(gl.ARRAY_BUFFER,buf.n); gl.enableVertexAttribArray(ln); gl.vertexAttribPointer(ln,3,gl.FLOAT,false,0,0);
                gl.uniformMatrix4fv(gl.getUniformLocation(prog,'m'),false,M);
                gl.uniformMatrix3fv(gl.getUniformLocation(prog,'r'),false,new Float32Array(R));
                gl.uniform3fv(gl.getUniformLocation(prog,'c'),new Float32Array(renk));
                gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER,buf.i);
                gl.drawElements(gl.TRIANGLES,adet,uintExt?gl.UNSIGNED_INT:gl.UNSIGNED_SHORT,0);
                anim=requestAnimationFrame(kare);
            }
            function dur(){ cancelAnimationFrame(anim); adet=0; }
            return {baslat,ciz,dur};
        })();

        // ---------------- Portal Hesapları (kayıt olanlar, onay, aktif/pasif, şifre, e-posta) ----------------
        let portalVeri=null, portalSifreHedef=null;
        async function portalHesaplariYukle(sessiz){
            try{
                const r=await fetch('/api/portal-hesaplari',{cache:'no-store'});
                if(!r.ok) throw new Error((await r.text())||'Portal hesapları alınamadı.');
                portalVeri=await r.json();
                const onay=(portalVeri.hesaplar||[]).filter(h=>h.onayBekliyor).length;
                const rozet=document.getElementById('menuBadgePortal');
                if(rozet){ rozet.textContent=String(onay); rozet.style.display=onay>0?'':'none'; }
                if(!sessiz || document.getElementById('portalHesaplari')?.classList.contains('active')){ portalHesaplariCiz(); portalAyarlariDoldur(); }
            }catch(e){ if(!sessiz) showError(e.message||'Portal hesapları alınamadı.'); }
        }
        function phTarih(v){ if(!v) return '-'; const d=new Date(v); return isNaN(d)?'-':d.toLocaleDateString('tr-TR')+' '+d.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'}); }
        function portalHesaplariCiz(){
            const tb=document.getElementById('phTablo'); if(!tb||!portalVeri) return;
            const hes=portalVeri.hesaplar||[];
            const yediGun=Date.now()-7*864e5;
            const yeniMi=h=>h.kendiKaydi&&h.kayitTarihi&&new Date(h.kayitTarihi).getTime()>=yediGun;
            document.getElementById('phOzet').innerHTML=[
                ['Hekim hesabı',hes.filter(h=>h.tur==='hekim').length],
                ['Teknisyen hesabı',hes.filter(h=>h.tur==='teknisyen').length],
                ['Onay bekleyen',hes.filter(h=>h.onayBekliyor).length],
                ['Son 7 gün kayıt',hes.filter(yeniMi).length],
                ['Pasif',hes.filter(h=>!h.aktif&&!h.onayBekliyor).length]
            ].map(x=>'<div class="ph-kutu"><b>'+x[1]+'</b><span>'+x[0]+'</span></div>').join('');
            const tur=document.getElementById('phTur').value, durum=document.getElementById('phDurum').value;
            const ara=(document.getElementById('phAra').value||'').toLocaleLowerCase('tr-TR').trim();
            let liste=hes.filter(h=>(!tur||h.tur===tur)
                && (!durum || (durum==='onay'&&h.onayBekliyor) || (durum==='yeni'&&yeniMi(h)) || (durum==='kendi'&&h.kendiKaydi) || (durum==='aktif'&&h.aktif) || (durum==='pasif'&&!h.aktif))
                && (!ara || [h.adSoyad,h.klinik,h.kullaniciAdi,h.eposta,h.telefon].join(' ').toLocaleLowerCase('tr-TR').includes(ara)));
            liste.sort((a,b)=>(b.onayBekliyor-a.onayBekliyor)||(new Date(b.kayitTarihi||0)-new Date(a.kayitTarihi||0)));
            if(!liste.length){ tb.innerHTML='<tr><td colspan="10">Kayıt yok.</td></tr>'; return; }
            tb.innerHTML=liste.map(h=>{
                const k=h.tur+':'+h.id;
                const durumEt=h.onayBekliyor?'<span class="ph-etiket ph-onay">Onay bekliyor</span>':h.aktif?'<span class="ph-etiket ph-aktif">Aktif</span>':'<span class="ph-etiket ph-pasif">Pasif</span>';
                const yeni=yeniMi(h)?' <span class="ph-etiket ph-yeni">Yeni kayıt</span>':'';
                const kaynak=h.kendiKaydi?'Kendi kaydı':'Laboratuvar';
                const tip=h.tur==='teknisyen'?(h.tip==='ic'?' · iç':' · dış'):'';
                const isl=[];
                if(h.onayBekliyor) isl.push('<button class="button button-blue" onclick="portalDurum(\''+h.tur+'\','+h.id+',true)">Onayla</button>');
                else if(h.aktif) isl.push('<button class="button button-light" onclick="portalDurum(\''+h.tur+'\','+h.id+',false)">Pasif yap</button>');
                else isl.push('<button class="button button-light" onclick="portalDurum(\''+h.tur+'\','+h.id+',true)">Aktif yap</button>');
                isl.push('<button class="button button-light" onclick="portalEpostaDuzenle(\''+h.tur+'\','+h.id+')">E-posta</button>');
                isl.push('<button class="button button-light" onclick="portalTelefonDuzenle(\''+h.tur+'\','+h.id+')">Telefon</button>');
                if(h.tur==='hekim'&&h.kendiKaydi) isl.push('<button class="button button-light" title="Bu kişi laboratuvarda zaten kayıtlı bir hekimse onun kartına bağlayın" onclick="portalEslestir('+h.id+')">Hekime bağla</button>');
                return '<tr data-k="'+k+'">'
                    +'<td>'+(h.tur==='hekim'?'Hekim':'Teknisyen'+tip)+'</td>'
                    +'<td><b>'+escapeHtml(h.adSoyad||'-')+'</b>'+(h.klinik?'<div style="font-size:12px;color:#64748b">'+escapeHtml(h.klinik)+'</div>':'')+yeni+'</td>'
                    +'<td><b>'+escapeHtml(h.kullaniciAdi||'-')+'</b></td>'
                    +'<td>•••••• <button class="button button-light" style="padding:4px 8px;font-size:12px" onclick="portalSifreAc(\''+h.tur+'\','+h.id+')">Şifre belirle</button></td>'
                    +'<td>'+(h.eposta?escapeHtml(h.eposta)+(h.epostaDogrulandi?' <span title="Doğrulandı" style="color:#15803d">✓</span>':''):'<span style="color:#94a3b8">-</span>')+'</td>'
                    +'<td>'+escapeHtml(h.telefon||'-')+'</td>'
                    +'<td>'+phTarih(h.kayitTarihi)+'<div style="font-size:11px;color:#64748b">'+kaynak+'</div></td>'
                    +'<td>'+phTarih(h.sonGiris)+'</td>'
                    +'<td>'+durumEt+'</td>'
                    +'<td><div class="ph-islem">'+isl.join('')+'</div></td></tr>';
            }).join('');
        }
        function portalBul(tur,id){ return (portalVeri?.hesaplar||[]).find(h=>h.tur===tur&&Number(h.id)===Number(id)); }
        async function portalDurum(tur,id,aktif){
            const h=portalBul(tur,id);
            if(!aktif && !confirm((h?.adSoyad||'Hesap')+' pasif yapılsın mı? Portala giremez; işleri ve kayıtları silinmez.')) return;
            try{
                const r=await fetch('/api/portal-hesaplari/'+tur+'/'+id+'/durum',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({aktif})});
                if(!r.ok) throw new Error((await r.text())||'İşlem yapılamadı.');
                showSuccess(aktif?(h?.onayBekliyor?'Kayıt onaylandı; kişi artık giriş yapabilir.':'Hesap aktif.'):'Hesap pasif.');
                await portalHesaplariYukle();
                if(tur==='hekim' && typeof loadHekimler==='function') loadHekimler();
            }catch(e){ showError(e.message); }
        }
        function portalSifreAc(tur,id){
            const h=portalBul(tur,id); portalSifreHedef={tur,id};
            document.getElementById('psAlt').innerText=(h?.adSoyad||'-')+' · '+(h?.kullaniciAdi||'');
            document.getElementById('psYeni').value='';
            document.getElementById('psGiris').style.display=''; document.getElementById('psSonuc').style.display='none';
            document.getElementById('psHata').style.display='none';
            document.getElementById('psKaydet').style.display='';
            document.getElementById('portalSifreModal').style.display='flex';
            setTimeout(()=>document.getElementById('psYeni').focus(),50);
        }
        function portalSifreKapat(){ document.getElementById('portalSifreModal').style.display='none'; document.getElementById('psGoster').value=''; portalSifreHedef=null; }
        async function portalSifreKaydet(){
            if(!portalSifreHedef) return;
            const err=document.getElementById('psHata'); err.style.display='none';
            try{
                const r=await fetch('/api/portal-hesaplari/'+portalSifreHedef.tur+'/'+portalSifreHedef.id+'/sifre',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({yeniParola:document.getElementById('psYeni').value.trim()||null})});
                if(!r.ok) throw new Error((await r.text())||'Şifre belirlenemedi.');
                const d=await r.json();
                document.getElementById('psGoster').value=d.parola;
                document.getElementById('psGiris').style.display='none'; document.getElementById('psSonuc').style.display='';
                document.getElementById('psKaydet').style.display='none';
                showSuccess('Yeni şifre belirlendi.');
            }catch(e){ err.innerText=e.message; err.style.display='block'; }
        }
        async function portalEpostaDuzenle(tur,id){
            const h=portalBul(tur,id);
            const yeni=prompt((h?.adSoyad||'')+' — giriş kodlarının gideceği e-posta adresi (silmek için boş bırakın):', h?.eposta||'');
            if(yeni===null) return;
