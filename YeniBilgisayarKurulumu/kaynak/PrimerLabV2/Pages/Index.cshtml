@page

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Primer Lab V2</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f3f5f8;
            color: #1f2937;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        .app {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 245px;
            background: #111827;
            color: white;
            padding: 22px 15px;
            overflow-y: auto;
            z-index: 100;
        }

        .logo {
            font-size: 23px;
            font-weight: 700;
        }

        .logo-sub {
            margin-top: 4px;
            margin-bottom: 28px;
            font-size: 12px;
            color: #9ca3af;
        }

        .menu-title {
            margin: 22px 10px 8px;
            font-size: 10px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .menu-item {
            width: 100%;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #d1d5db;
            padding: 11px 13px;
            margin-bottom: 4px;
            text-align: left;
            transition: .15s;
        }

        .menu-item:hover {
            background: #1f2937;
            color: white;
        }

        .menu-item.active {
            background: #2563eb;
            color: white;
        }

        .menu-badge { margin-left:auto; min-width:20px; height:20px; padding:0 6px; border-radius:999px; display:none; align-items:center; justify-content:center; font-size:11px; font-weight:800; line-height:20px; background:#ef4444; color:#fff; box-shadow:0 2px 8px rgba(239,68,68,.28); }
        .menu-badge.blue { background:#2563eb; box-shadow:0 2px 8px rgba(37,99,235,.25); }
        .menu-badge.amber { background:#f59e0b; box-shadow:0 2px 8px rgba(245,158,11,.25); }
        .menu-badge.show { display:inline-flex; }
        .tech-foundation-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:14px; margin-bottom:16px; }
        .tech-type-pill { display:inline-flex; padding:5px 9px; border-radius:999px; font-size:11px; font-weight:800; background:#e8f0ff; color:#1d4ed8; }
        .tech-type-pill.external { background:#fff3df; color:#b45309; }


        .main {
            margin-left: 245px;
            width: calc(100% - 245px);
            min-height: 100vh;
            padding: 28px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            margin-bottom: 22px;
        }

        .page-title {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .page-subtitle {
            margin-top: 4px;
            color: #6b7280;
            font-size: 14px;
        }

        .button-group {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            align-items: center;
        }

        .button,
        .btn-primary,
        .btn-secondary {
            border: 0;
            border-radius: 8px;
            padding: 10px 15px;
            font-weight: 600;
            transition: .15s;
        }

        .button:hover,
        .btn-primary:hover,
        .btn-secondary:hover {
            opacity: .9;
        }

        .button-dark {
            background: #111827;
            color: white;
        }

        .button-blue,
        .btn-primary {
            background: #2563eb;
            color: white;
        }

        .button-light,
        .btn-secondary {
            background: #e5e7eb;
            color: #111827;
        }

        .btn-primary:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 22px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 19px;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .07);
        }

        .card-label {
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 9px;
        }

        .card-value {
            font-size: 28px;
            font-weight: 700;
        }

        .card-small {
            color: #9ca3af;
            font-size: 12px;
            margin-top: 5px;
        }

        .panel {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .07);
            margin-bottom: 22px;
        }

        .panel-header {
            padding: 17px 19px;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
        }

        .panel-title {
            font-size: 17px;
            font-weight: 700;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            background: #f9fafb;
            color: #6b7280;
            font-size: 12px;
            padding: 12px 14px;
            border-bottom: 1px solid #e5e7eb;
            white-space: nowrap;
        }

        td {
            padding: 13px 14px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
            vertical-align: middle;
        }

        tr:hover td {
            background: #fafafa;
        }

        .work-row {
            cursor: pointer;
        }

        .empty {
            padding: 35px !important;
            text-align: center !important;
            color: #9ca3af;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-yeni {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status-devam {
            background: #fef3c7;
            color: #92400e;
        }

        .status-hazir {
            background: #d1fae5;
            color: #065f46;
        }

        .status-teslim {
            background: #e5e7eb;
            color: #374151;
        }

        .status-iptal {
            background: #fee2e2;
            color: #991b1b;
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        .message {
            display: none;
            position: fixed;
            top: 82px;
            right: 24px;
            z-index: 10050;
            width: min(390px, calc(100vw - 32px));
            padding: 12px 16px;
            margin: 0;
            border: 1px solid transparent;
            border-radius: 12px;
            box-shadow: 0 14px 35px rgba(15, 23, 42, .16);
            font-size: 13px;
            font-weight: 700;
            line-height: 1.45;
            pointer-events: none;
            opacity: 0;
            transform: translateY(-10px);
            transition: opacity .16s ease, transform .16s ease;
        }

        .message.toast-visible {
            display: block;
            opacity: 1;
            transform: translateY(0);
        }

        .message-error {
            background: #fff1f2;
            border-color: #fecdd3;
            color: #9f1239;
        }

        .message-success {
            background: #ecfdf5;
            border-color: #a7f3d0;
            color: #065f46;
        }

        @@media (max-width: 720px) {
            .message {
                top: 72px;
                right: 16px;
                left: 16px;
                width: auto;
            }
        }

        .finance-positive {
            color: #047857;
            font-weight: 700;
        }

        .placeholder {
            background: white;
            padding: 35px;
            border-radius: 12px;
            color: #6b7280;
            box-shadow: 0 1px 4px rgba(0, 0, 0, .07);
            line-height: 1.7;
        }

        .modal-overlay {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            z-index: 2000;
            background: rgba(17, 24, 39, .65);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-box {
            width: 620px;
            max-width: 100%;
            max-height: 92vh;
            overflow-y: auto;
            background: white;
            border-radius: 14px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .28);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            padding: 20px 22px;
            border-bottom: 1px solid #e5e7eb;
        }

        .modal-header h2 {
            margin: 0;
            font-size: 21px;
        }

        .modal-header p {
            margin: 5px 0 0;
            color: #6b7280;
            font-size: 13px;
        }

        .modal-close {
            border: 0;
            background: transparent;
            color: #6b7280;
            font-size: 27px;
            line-height: 1;
            padding: 0;
            width: 32px;
            height: 32px;
        }

        .modal-close:hover {
            color: #111827;
        }

        #yeniIsForm,
        #yeniHekimForm {
            padding: 22px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 11px;
            background: white;
            outline: none;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 2px rgba(37, 99, 235, .10);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-error {
            background: #fee2e2;
            color: #991b1b;
            border-radius: 8px;
            padding: 11px;
            margin-bottom: 14px;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 9px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .price-manage-button {
            border: 0;
            border-radius: 7px;
            padding: 7px 10px;
            background: #eff6ff;
            color: #1d4ed8;
            font-weight: 700;
            font-size: 12px;
        }

        .price-manage-button:hover {
            background: #dbeafe;
        }

        .price-list-toolbar,
        .job-lines-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 8px 0 12px;
        }

        .price-list-note {
            color: #6b7280;
            font-size: 12px;
            line-height: 1.5;
        }

        .price-row {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) 160px 46px;
            gap: 9px;
            align-items: center;
            margin-bottom: 9px;
        }

        .doctor-price-add {
            display: flex;
            gap: 8px;
            margin: 4px 0 14px;
        }

        .doctor-price-add select,
        .doctor-price-add input {
            flex: 1;
            min-width: 0;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 11px;
            background: white;
        }

        .price-row input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 11px;
            outline: none;
        }

        .job-line {
            display: grid;
            grid-template-columns: minmax(220px, 2fr) 90px 140px 140px 46px;
            gap: 9px;
            align-items: center;
            margin-bottom: 9px;
        }

        .job-line select,
        .job-line input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 10px 11px;
            background: white;
            outline: none;
        }

        .job-line-total {
            background: #f9fafb !important;
        }

        .icon-delete-button {
            width: 42px;
            height: 42px;
            border: 0;
            border-radius: 8px;
            background: #fee2e2;
            color: #991b1b;
            font-size: 18px;
            font-weight: 800;
        }

        .doctor-price-warning {
            display: none;
            margin: 8px 0 14px;
            padding: 11px 13px;
            border-radius: 8px;
            background: #fff7ed;
            color: #9a3412;
            font-size: 12px;
            line-height: 1.5;
        }

        .new-job-total-box {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            padding: 13px 0 2px;
            font-size: 14px;
        }

        .new-job-total-box strong {
            font-size: 20px;
        }

        .workflow-box {
            margin: 14px 0 4px;
            padding: 14px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            background: #f9fafb;
        }

        .workflow-title {
            font-size: 12px;
            font-weight: 800;
            color: #374151;
            margin-bottom: 9px;
        }

        .workflow-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .workflow-button {
            border: 0;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 12px;
            font-weight: 800;
            cursor: pointer;
        }

        .workflow-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .workflow-next {
            background: #2563eb;
            color: white;
        }

        .workflow-ready {
            background: #7c3aed;
            color: white;
        }

        .workflow-deliver {
            background: #059669;
            color: white;
        }

        .workflow-current {
            color: #6b7280;
            font-size: 12px;
            line-height: 1.5;
        }

        .cari-summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .cari-summary-card {
            border: 1px solid #e5e7eb;
            background: #f9fafb;
            border-radius: 10px;
            padding: 14px;
        }

        .cari-summary-label {
            font-size: 11px;
            color: #6b7280;
            margin-bottom: 6px;
        }

        .cari-summary-value {
            font-size: 19px;
            font-weight: 800;
            color: #111827;
        }

        .cari-tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 14px 0;
        }

        .cari-tab {
            border: 1px solid #d1d5db;
            background: white;
            color: #374151;
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .cari-tab.active {
            background: #111827;
            border-color: #111827;
            color: white;
        }

        .cari-filter-row {
            display: grid;
            grid-template-columns: 1fr 1fr auto;
            gap: 10px;
            align-items: end;
            margin-bottom: 14px;
        }

        .cari-quick-filters {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px;
        }

        .cari-balance-positive {
            color: #b91c1c;
            font-weight: 800;
        }

        .cari-balance-negative {
            color: #047857;
            font-weight: 800;
        }

        .cari-balance-zero {
            color: #374151;
            font-weight: 800;
        }

        .cari-status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 72px;
            padding: 5px 9px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
        }

        .cari-status-debt {
            background: #fee2e2;
            color: #991b1b;
        }

        .cari-status-credit {
            background: #dcfce7;
            color: #166534;
        }

        .cari-status-closed {
            background: #e5e7eb;
            color: #374151;
        }

        .global-new-job{position:fixed;top:12px;right:18px;z-index:5000;border:none;border-radius:12px;padding:10px 16px;background:#1565c0;color:#fff;font-weight:900;font-size:12px;cursor:pointer;box-shadow:0 6px 18px rgba(21,101,192,.28)}
        .global-new-job:hover{filter:brightness(1.05)}
        .order-shell{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;align-items:start}
        .order-main{display:flex;flex-direction:column;gap:16px}
        .order-card{background:#fff;border:1px solid #dde3ec;border-radius:16px;box-shadow:0 2px 14px rgba(15,23,42,.04);overflow:hidden}
        .order-card-head{padding:15px 18px;border-bottom:1px solid #edf2f7;display:flex;align-items:center;justify-content:space-between;gap:10px}
        .order-card-title{font-size:14px;font-weight:900;color:#172033}.order-card-sub{font-size:11px;color:#6b7f99;margin-top:2px}.order-card-body{padding:18px}
        .order-summary{position:sticky;top:72px;background:#0c1a2e;color:#fff;border-radius:16px;padding:18px;box-shadow:0 12px 28px rgba(12,26,46,.18)}
        .order-summary h3{margin:0 0 14px;font-size:15px}.order-summary-row{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.08);font-size:12px}.order-summary-row:last-of-type{border-bottom:none}.order-summary-value{font-weight:900;font-size:15px}
        .order-submit{width:100%;margin-top:14px;min-height:44px;border:none;border-radius:10px;background:#16a34a;color:#fff;font-weight:900;cursor:pointer}.order-clear{width:100%;margin-top:8px;min-height:38px;border:1px solid rgba(255,255,255,.22);border-radius:10px;background:rgba(255,255,255,.07);color:#fff;font-weight:800;cursor:pointer}
        .order-line{display:grid;grid-template-columns:minmax(220px,1fr) 90px 130px 130px 42px;gap:8px;align-items:end;padding:12px;border:1px solid #e5e7eb;border-radius:12px;background:#f8fafc;margin-bottom:8px}.order-line-total{min-height:39px;border:1px solid #dbe3ef;background:#fff;border-radius:9px;padding:10px;font-weight:900;text-align:right}
        .tooth-board{display:grid;grid-template-columns:1fr 1fr;gap:0;max-width:650px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px}.tooth-quadrant{padding:8px}.tooth-quadrant:nth-child(1),.tooth-quadrant:nth-child(3){border-right:1px solid #94a3b8}.tooth-quadrant:nth-child(1),.tooth-quadrant:nth-child(2){border-bottom:1px solid #94a3b8}.tooth-row-v30{display:flex;flex-wrap:wrap;gap:5px;justify-content:center}.tooth-q-label{font-size:10px;font-weight:900;color:#64748b;text-align:center;margin-bottom:7px}
        .ai-fab{position:fixed;right:24px;bottom:24px;width:58px;height:58px;border:none;border-radius:50%;z-index:6000;background:linear-gradient(135deg,#1565c0,#00b4d8);color:#fff;font-size:25px;cursor:pointer;box-shadow:0 10px 28px rgba(21,101,192,.35)}
        .ai-panel{position:fixed;right:24px;bottom:94px;width:min(520px,calc(100vw - 32px));height:min(690px,calc(100vh - 120px));background:#fff;border:1px solid #dbe3ef;border-radius:18px;box-shadow:0 18px 55px rgba(15,23,42,.24);z-index:6001;display:none;flex-direction:column;overflow:hidden}.ai-panel.open{display:flex}.ai-panel-head{padding:11px 14px;color:#fff;background:#10233e;display:flex;justify-content:space-between;align-items:center;gap:10px}.ai-panel-title{font-weight:900;font-size:15px;display:flex;align-items:center;gap:8px}.ai-nokta{width:9px;height:9px;border-radius:50%;background:#94a3b8;display:inline-block}.ai-nokta.bagli{background:#22c55e}.ai-nokta.hata{background:#ef4444}.ai-yaziyor{display:inline-flex;gap:4px;padding:2px 0}.ai-yaziyor i{width:7px;height:7px;border-radius:50%;background:#94a3b8;animation:aiNokta 1s infinite ease-in-out}.ai-yaziyor i:nth-child(2){animation-delay:.15s}.ai-yaziyor i:nth-child(3){animation-delay:.3s}@@keyframes aiNokta{0%,80%,100%{opacity:.3;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}.ai-panel-sub{font-size:10px;opacity:.78;margin-top:2px}.ai-status{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:999px;font-size:10px;font-weight:900;background:rgba(255,255,255,.13)}
