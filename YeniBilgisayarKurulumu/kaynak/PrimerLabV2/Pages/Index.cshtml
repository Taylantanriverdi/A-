        // ---------------- Toplu dosya yükleme ----------------
        // Klasör seçilir; klasör/dosya adlarındaki hasta isimleri işlerle eşleştirilir,
        // dosya türü (Tarama/Tasarım) adından tahmin edilir; onaydan sonra dosyalar tek tek yüklenir.
        const TOPLU_UZANTILAR=['stl','obj','ply','dcm','zip','rar','7z','pdf','jpg','jpeg','png','webp','txt','xml','3ox','3oxz','dentalproject','constructioninfo'];
        const TOPLU_MAX_BOYUT=250*1024*1024;
        let topluGruplar=[];
        let topluYukleniyor=false;

        function topluNorm(s){
            return String(s||'').toLocaleLowerCase('tr-TR')
                .replace(/ı/g,'i').replace(/ğ/g,'g').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ö/g,'o').replace(/ç/g,'c')
                .normalize('NFD').replace(/[̀-ͯ]/g,'')
                .replace(/[^a-z0-9]+/g,' ').trim();
        }

        function topluTurTahmin(yol){
            const t=' '+topluNorm(yol)+' ';
            if(/ (tasarim|tasarimi|design|designs|cad|exocad|construction|constructioninfo|dentalproject|restorasyon|restoration) /.test(t)) return 'Tasarım';
            const ext=(yol.split('.').pop()||'').toLowerCase();
            if(/ (tarama|taramalar|scan|scans|trios|itero|medit|primescan|intraoral|upper|lower|ust|alt|bite|kapanis|preparation|prep) /.test(t)||['stl','ply','obj','dcm'].includes(ext)) return 'Tarama';
            return 'Diger';
        }

        function topluIsEtiketi(x){ return '#'+Number(x.id)+' · '+(x.hastaAdi||'-')+' · '+(x.hekimAdi||'-')+(x.durum?' · '+x.durum:''); }

        // Klasör yolundaki hasta adını bulur; aynı hastanın birden fazla işi varsa hekim adı yolda geçen,
        // yoksa en yeni iş önerilir.
        function topluEslestir(klasorYolu, dosyaAdlari){
            const segmentler=klasorYolu.split('/').map(topluNorm).filter(Boolean);
            const tumu=' '+topluNorm(klasorYolu+' '+dosyaAdlari.join(' '))+' ';
            const isler=(anayasaIsler||[]).filter(x=>!x.silindi && x.hastaAdi);
            const uyan=function(ad){
                const h=topluNorm(ad); if(!h) return 0;
                const p=h.split(' ');
                if(p.length>=2){
                    if(tumu.includes(' '+h+' ')) return h.length;
                    if(p.length===2 && tumu.includes(' '+p[1]+' '+p[0]+' ')) return h.length;
                    return 0;
                }
                return segmentler.includes(h)?h.length:0;   // tek kelimelik isimde klasör adı birebir olmalı
            };
            let enIyi=0; const puan=new Map();
            isler.forEach(x=>{const u=uyan(x.hastaAdi); if(u){puan.set(x.id,u); enIyi=Math.max(enIyi,u);}});
            let adaylar=isler.filter(x=>puan.get(x.id)===enIyi && enIyi>0);
            const hastalar=new Set(adaylar.map(x=>topluNorm(x.hastaAdi)));
            const hekimli=adaylar.filter(x=>x.hekimAdi && tumu.includes(' '+topluNorm(x.hekimAdi).replace(/^dr /,'')+' '));
            const oneri=(hekimli.length?hekimli:adaylar).slice().sort((a,b)=>Number(b.id)-Number(a.id))[0]||null;
            let not='';
            if(!oneri) not='Hasta adı eşleşmedi';
            else if(hastalar.size>1) not='Birden fazla hasta adı uyuyor — kontrol edin';
            else if(adaylar.length>1) not='Bu hastanın '+adaylar.length+' işi var; '+(hekimli.length?'hekim adı uyan':'en yeni')+' iş seçildi';
            return { adaylar: adaylar.sort((a,b)=>Number(b.id)-Number(a.id)), secilen: oneri?Number(oneri.id):0, not };
        }

