            }
        }

        async function yeniIsHekimDegisti() {
            const hekimId =
                Number(
                    document.getElementById(
                        "yeniIsHekim"
                    ).value
                );

            const kalemler =
                document.getElementById(
                    "yeniIsKalemler"
                );

            const warning =
                document.getElementById(
                    "doctorPriceWarning"
                );

            const addButton =
                document.getElementById(
                    "yeniKalemEkleBtn"
                );

            kalemler.innerHTML = "";
            seciliHekimFiyatlari = [];
            addButton.disabled = true;
            warning.style.display = "none";

            if (!hekimId) {
                yeniIsToplamlariniHesapla();
                return;
            }

            try {
                seciliHekimFiyatlari =
                    await fiyatListesiGetir(hekimId);

                if (!seciliHekimFiyatlari.length) {
                    warning.style.display = "block";
                    yeniIsToplamlariniHesapla();
                    return;
                }

                addButton.disabled = false;
                yeniIsKalemiEkle();
            }
            catch (error) {
                showError(
                    error.message ||
                    "Fiyat listesi yüklenemedi."
                );
            }
        }

        function yeniIsKalemiEkle() {
            if (!seciliHekimFiyatlari.length) {
                return;
            }

            const container =
                document.getElementById(
                    "yeniIsKalemler"
                );

            const row =
                document.createElement("div");

            row.className = "job-line";

            const options =
                seciliHekimFiyatlari
                    .map(function (fiyat) {
                        return (
                            '<option value="' +
                            escapeHtml(fiyat.isTuru) +
                            '" data-price="' +
                            Number(fiyat.birimFiyat || 0) +
                            '">' +
                            escapeHtml(fiyat.isTuru) +
                            ' — ' +
                            para(fiyat.birimFiyat) +
                            '</option>'
                        );
                    })
                    .join("");

            row.innerHTML = `
                <select class="job-type-select"
                        onchange="yeniIsKalemiDegisti(this)">
                    <option value="">İş seç...</option>
                    ${options}
                </select>

                <input class="job-qty"
                       type="number"
                       min="1"
                       step="1"
                       value="1"
                       title="Adet"
                       oninput="yeniIsKalemiDegisti(this)" />

                <input class="job-price"
                       type="number"
                       min="0"
                       step="0.01"
                       value="0"
                       title="Birim fiyat"
                       readonly />

                <input class="job-line-total"
                       type="text"
                       value="0 ₺"
                       title="Satır toplamı"
                       readonly />

                <button type="button"
                        class="icon-delete-button"
                        title="İş kalemini sil"
                        onclick="yeniIsKalemiSil(this)">
                    ×
                </button>
            `;

            container.appendChild(row);
            yeniIsToplamlariniHesapla();
        }

        function yeniIsKalemiDegisti(element) {
            const row =
                element.closest(".job-line");

            if (!row) {
                return;
            }

            const select =
                row.querySelector(
                    ".job-type-select"
                );

            const priceInput =
                row.querySelector(
                    ".job-price"
                );

            if (select) {
                const option =
                    select.options[
                        select.selectedIndex
                    ];

                const fiyat =
                    option
                        ? Number(
                            option.dataset.price || 0
                        )
                        : 0;

                priceInput.value =
                    Number.isFinite(fiyat)
                        ? fiyat
                        : 0;
            }

            yeniIsToplamlariniHesapla();
        }

        function yeniIsKalemiSil(button) {
            const row =
                button.closest(".job-line");

            if (row) {
                row.remove();
            }

            yeniIsToplamlariniHesapla();
        }

        function yeniIsToplamlariniHesapla() {
            let genelToplam = 0;

            document
                .querySelectorAll(
                    "#yeniIsKalemler .job-line"
                )
                .forEach(function (row) {
                    const adet =
                        Number(
                            row.querySelector(
                                ".job-qty"
                            ).value || 0
                        );

                    const fiyat =
                        Number(
                            row.querySelector(
                                ".job-price"
                            ).value || 0
                        );

                    const toplam =
                        adet * fiyat;

                    genelToplam += toplam;

                    row.querySelector(
                        ".job-line-total"
                    ).value =
                        para(toplam);
                });

            const genel =
                document.getElementById(
                    "yeniIsGenelToplam"
                );

            if (genel) {
                genel.innerText =
                    para(genelToplam);
            }
        }

        function yeniIsKalemleriniOku() {
            const kalemler = [];

            document
                .querySelectorAll(
                    "#yeniIsKalemler .job-line"
                )
                .forEach(function (row) {
                    const isTuru =
                        row.querySelector(
                            ".job-type-select"
                        ).value;

                    const adet =
                        Number(
                            row.querySelector(
                                ".job-qty"
                            ).value || 0
                        );

                    const birimFiyat =
                        Number(
                            row.querySelector(
                                ".job-price"
                            ).value || 0
                        );

                    if (isTuru) {
                        kalemler.push({
                            isTuru: isTuru,
                            adet: adet,
                            birimFiyat: birimFiyat
                        });
                    }
                });

            return kalemler;
        }

        async function yeniIsKaydet(event) {
            event.preventDefault();

            const hata =
                document.getElementById(
                    "yeniIsHata"
                );

            const button =
                document.getElementById(
                    "yeniIsKaydetBtn"
                );

            const hekimId =
                Number(
                    document.getElementById(
                        "yeniIsHekim"
                    ).value
                );

            const hastaAdi =
                document.getElementById(
                    "yeniIsHasta"
                ).value.trim();

            const notlar =
                document.getElementById(
                    "yeniIsNotlar"
                ).value.trim();

            const terminTarihi =
                document.getElementById(
                    "yeniIsTerminTarihi"
                ).value || null;

            const disRengi =
                document.getElementById(
                    "yeniIsDisRengi"
                )?.value.trim() || null;

            const oncelik =
                document.getElementById("yeniIsOncelik")?.value || "Normal";

            const uretimNotu =
                document.getElementById("yeniIsUretimNotu")?.value.trim() || null;

            const teknisyenId =
                document.getElementById(
                    "yeniIsTeknisyen"
                )?.value || "";

            const kalemler =
                yeniIsKalemleriniOku();

            if (!hekimId) {
                hata.innerText =
                    "Hekim seçmelisin.";
                hata.style.display =
                    "block";
                return;
            }

            if (!hastaAdi) {
                hata.innerText =
                    "Hasta adı boş bırakılamaz.";
                hata.style.display =
                    "block";
                return;
            }

            if (!kalemler.length) {
                hata.innerText =
                    "En az bir iş kalemi eklemelisin. " +
                    "Bu hekime fiyat listesi tanımlı değilse önce fiyat listesini oluştur.";
                hata.style.display =
                    "block";
                return;
            }

            for (const kalem of kalemler) {
                if (
                    kalem.adet <= 0 ||
                    kalem.birimFiyat < 0
                ) {
                    hata.innerText =
                        "İş kalemlerindeki adet ve fiyatları kontrol et.";
                    hata.style.display =
                        "block";
                    return;
                }
            }

            hata.style.display = "none";
            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const response =
                    await fetch(
                        "/api/siparisler/yeni-is-coklu",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                hekimId: hekimId,
                                hastaAdi: hastaAdi,
                                terminTarihi: terminTarihi,
                                disRengi: disRengi,
                                oncelik: oncelik,
                                uretimNotu: uretimNotu,
                                notlar:
                                    notlar || null,
                                kalemler: kalemler
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "İş ana kaydı oluşturulamadı."
                    );
                }

                const created =
                    await response.json();

                closeYeniIsModal();

                await loadSiparisler();

                if (
                    teknisyenId &&
                    created?.id
                ) {
                    try {
                        await teknisyenAta(
                            created.id,
                            teknisyenId
                        );

                        showSuccess(
                            "Yeni iş kaydedildi ve teknisyen atandı."
                        );
                    }
                    catch (assignmentError) {
                        showError(
                            "İş #" +
                            created.id +
                            " başarıyla kaydedildi; ancak teknisyen ataması yapılamadı. " +
                            (assignmentError.message || "")
                        );
                    }
                }
                else {
                    showSuccess(
                        "Yeni iş ve tüm iş kalemleri kaydedildi."
                    );
                }
            }
            catch (error) {
                hata.innerText =
                    error.message ||
                    "İş ana kaydı oluşturulurken hata oluştu.";

                hata.style.display =
                    "block";
            }
            finally {
                button.disabled = false;
                button.innerText = "İşi Kaydet";
            }
        }


        async function hekimSilOnay(id) {
            const hekim = hekimler.find(h => Number(h.id) === Number(id));
            if (!hekim) {
                showError("Hekim bulunamadı.");
                return;
            }

            const ad = hekim.adSoyad || hekim.klinikAdi || ("Hekim #" + id);
            const onay = confirm(
                `"${ad}" silinsin mi?\n\n` +
                "Bu işlem hekimin geçmiş işlerini ve muhasebe kayıtlarını silmez. " +
                "Hekim aktif listeden kaldırılır. Geçmiş iş ve muhasebe kayıtları korunur."
            );
            if (!onay) return;

            try {
                const r = await fetch("/api/hekimler/" + Number(id), { method: "DELETE" });
                if (!r.ok) throw new Error((await r.text()) || "Hekim silinemedi.");

                await loadHekimler();
                try { await loadAnayasaData(); } catch {}
                showSuccess(`"${ad}" hekim listesinden kaldırıldı.`);
            } catch (error) {
                showError(error.message || "Hekim silinemedi.");
            }
        }

