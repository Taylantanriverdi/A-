        function aktifTeknisyenSecenekleri(selectedId) {
            const selected = String(selectedId || "");

            return (
                '<option value="">Atanmamış</option>' +
                teknisyenler
                    .filter(function(t) {
                        return t.aktif !== false || String(t.id) === selected;
                    })
                    .sort(function(a,b) {
                        return String(a.adSoyad || "").localeCompare(
                            String(b.adSoyad || ""),
