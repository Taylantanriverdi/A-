        async function primerAiGonder(){
            const inp=document.getElementById('primerAiInput'),
                  btn=document.getElementById('primerAiSend'),
                  msg=inp?.value.trim()||'';

            if(!msg)return;

            // API'ye gönderilecek geçmiş, mevcut yeni mesaj eklenmeden önce hazırlanır.
            const historyForRequest=primerAiConversationHistory.slice(-24);

            primerAiAppend('user',msg);
            primerAiConversationHistory.push({role:'user',content:msg});
            if(primerAiConversationHistory.length>24)
                primerAiConversationHistory=primerAiConversationHistory.slice(-24);

            inp.value='';
            if(btn)btn.disabled=true;

            primerAiAppend('bot','');
            const host=document.getElementById('primerAiMessages'),
                  thinking=host?.lastElementChild;
            const tb=thinking?.querySelector('.ai-bubble-v30'); if(tb) tb.innerHTML='<span class="ai-yaziyor" title="Yanıt hazırlanıyor"><i></i><i></i><i></i></span>';

            try{
                const r=await fetch('/api/assistant/chat',{
                    method:'POST',
                    headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({
                        message:msg,
                        history:historyForRequest
                    })
                });

                if(!r.ok)
                    throw new Error((await r.text())||'Primer AI yanıt veremedi.');

                const d=await r.json();

                if(thinking?.parentNode)thinking.remove();

                primerAiLastActions=Array.isArray(d.actions)?d.actions:[];
                const answer=d.answer||'Yanıt oluşturulamadı.';

                primerAiAppend('bot',answer,primerAiLastActions,Array.isArray(d.steps)?d.steps:[]);
                primerAiConversationHistory.push({role:'assistant',content:answer});

                if(primerAiConversationHistory.length>24)
                    primerAiConversationHistory=primerAiConversationHistory.slice(-24);
            }catch(e){
                if(thinking?.parentNode)thinking.remove();

                // Başarısız istek, modelin görmediği kullanıcı mesajını bağlamda bırakmasın.
                if(primerAiConversationHistory.length &&
                   primerAiConversationHistory[primerAiConversationHistory.length-1]?.role==='user' &&
                   primerAiConversationHistory[primerAiConversationHistory.length-1]?.content===msg){
                    primerAiConversationHistory.pop();
                }

                primerAiAppend('bot','Hata: '+(e.message||e));
            }finally{
                if(btn)btn.disabled=false;
                inp?.focus();
            }
        }
