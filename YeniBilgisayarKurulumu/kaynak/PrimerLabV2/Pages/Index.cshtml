        async function kaTahsilatKaydet(event){
            event.preventDefault();

            const data=kaTahsilatFormVerisi();
            if(!kaTahsilatDogrula(data,true))return;

            const button=document.getElementById("kaTahsilatKaydetBtn");
            button.disabled=true;
            button.innerText="Kaydediliyor...";

            try{
                const payload={
                    hekimId:data.hekimId,
                    tutar:data.tutar,
                    paraBirimi:data.paraBirimi,
                    tarih:data.tarih,
                    odemeTuru:data.odemeTuru,
                    islemNo:data.islemNo||null,
                    aciklama:data.aciklama||null
                };

                const r=await fetch("/api/kasa-arsiv/tahsilat",{
                    method:"POST",
                    headers:{"Content-Type":"application/json"},
                    body:JSON.stringify(payload)
                });

                if(!r.ok){
                    const raw=await r.text();
                    let msg=raw||"Tahsilat kaydedilemedi.";
                    try{
                        const p=JSON.parse(raw);
                        msg=p.detail||p.title||msg;
                    }catch{}
                    throw new Error(msg);
                }

                kaTahsilatKapat();
                kaTahsilatOnizlemeKapat();

                await kaYenile();
                if(kaSeciliHekimId)await kaDetayYukle();

                showSuccess("Tahsilat başarıyla kaydedildi.");
            }catch(err){
                showError(err?.message||"Tahsilat kaydedilemedi.");
            }finally{
                button.disabled=false;
                button.innerText="💾 Tahsilatı Kaydet";
            }
        }

