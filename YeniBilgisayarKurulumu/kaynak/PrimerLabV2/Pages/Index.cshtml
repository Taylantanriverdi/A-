        const ANAYASA_DURUMLAR = [
            "Devam Ediyor",
            "Tasarımda",
            "Üretimde",
            "Makyajda",
            "Tamamlandı"
        ];

        function anayasaDurum(value) {
            const v = String(value || "").trim();
            if (ANAYASA_DURUMLAR.includes(v)) return v;
            if (v === "Yeni" || v === "Bekliyor" || v === "Devam Eden") return "Devam Ediyor";
            if (v === "Hazır") return "Makyajda";
            if (v === "Teslim") return "Tamamlandı";
            return v || "Devam Ediyor";
        }

        function anayasaDurumRozeti(value) {
            const v = anayasaDurum(value);
            const cls =
                v === "Tamamlandı"
                    ? "flow-done"
                    : v === "Tamamlama Onayı"
                        ? "flow-await"
                        : "";
            return '<span class="flow-badge ' + cls + '">' +
                escapeHtml(v) +
                '</span>';
        }

        function anayasaKalemOzet(item) {
            const list = Array.isArray(item?.kalemler) ? item.kalemler : [];
            if (!list.length) return "-";
            return list.map(function(k) {
                return escapeHtml(k.isTuru || "-") +
                    " × " +
                    Number(k.adet || 0);
            }).join("<br/>");
        }

        function anayasaIsSearch(item, q) {
            if (!q) return true;
            const hay = [
                item.id,
                item.hekimAdi,
                item.klinikAdi,
                item.hastaAdi,
                item.disRengi,
                item.materyal,
                item.durum,
                item.kaynak,
                teknisyenAtamasi(item)?.teknisyenAdi
            ].map(function(v) {
                return String(v || "").toLocaleLowerCase("tr-TR");
            }).join(" ");
            return hay.includes(q);
        }

