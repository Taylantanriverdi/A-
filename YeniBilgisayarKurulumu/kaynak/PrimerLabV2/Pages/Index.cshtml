        function teslimatTerminTipi(item) {
            if (!item?.terminTarihi) return "Termin Yok";

            const d = new Date(item.terminTarihi);
            if (Number.isNaN(d.getTime())) return "Termin Yok";

            const now = new Date();
            const today =
                new Date(
                    now.getFullYear(),
                    now.getMonth(),
                    now.getDate()
                );

            const target =
                new Date(
                    d.getFullYear(),
                    d.getMonth(),
                    d.getDate()
                );

            const diff =
                Math.round(
                    (target.getTime() - today.getTime()) /
                    86400000
                );

            if (diff < 0) return "Geciken";
            if (diff === 0) return "Bugün";
            if (diff <= 2) return "Yaklaşan";
            return "İleri";
        }

        function teslimatFiltreliListe() {
            const q =
                String(
                    document.getElementById("teslimatSearch")?.value || ""
                )
                .toLocaleLowerCase("tr-TR")
                .trim();

            const durum =
                document.getElementById("teslimatDurumFiltre")?.value || "";

            const hekim =
                document.getElementById("teslimatHekimFiltre")?.value || "";

            const termin =
                document.getElementById("teslimatTerminFiltre")?.value || "";

            return siparisler
                .filter(function(item) {
                    if (isArsiv(item.durum)) return false;

                    if (durum && String(item.durum || "") !== durum) {
                        return false;
                    }

                    if (
                        hekim &&
                        String(item.hekimId || item.hekimAdi || "") !== hekim
                    ) {
                        return false;
                    }

                    if (termin && teslimatTerminTipi(item) !== termin) {
                        return false;
                    }

                    if (q) {
                        const haystack = [
                            item.id,
                            item.hastaAdi,
                            item.hekimAdi,
                            item.klinikAdi,
                            item.disRengi,
                            item.durum,
                            item.oncelik,
                            item.uretimAsamasi,
                            item.kaliteKontrolDurumu,
                            teknisyenAtamasi(item)?.teknisyenAdi
                        ]
                        .map(function(v) {
                            return String(v || "")
                                .toLocaleLowerCase("tr-TR");
                        })
                        .join(" ");

                        if (!haystack.includes(q)) return false;
                    }

                    return true;
                })
                .slice()
                .sort(function(a,b) {
                    const readyA = a.durum === "Hazır" ? 0 : 1;
                    const readyB = b.durum === "Hazır" ? 0 : 1;

                    const lateA =
                        teslimatTerminTipi(a) === "Geciken" ? 0 : 1;
                    const lateB =
                        teslimatTerminTipi(b) === "Geciken" ? 0 : 1;

                    const ta =
                        a.terminTarihi
                            ? new Date(a.terminTarihi).getTime()
                            : Number.MAX_SAFE_INTEGER;

                    const tb =
                        b.terminTarihi
                            ? new Date(b.terminTarihi).getTime()
                            : Number.MAX_SAFE_INTEGER;

                    return readyA - readyB ||
                        lateA - lateB ||
                        ta - tb ||
                        Number(b.id || 0) -
                        Number(a.id || 0);
                });
        }

