                function anayasaHekimSecenekleriDoldur() {
            const select = document.getElementById("anHekim");
            if (!select) return;

            const current = select.value;

            const aktif = hekimler
                .filter(h => h.aktif !== false)
                .slice()
                .sort((a,b) =>
                    String(a.adSoyad || a.klinikAdi || "")
                        .localeCompare(
                            String(b.adSoyad || b.klinikAdi || ""),
                            "tr-TR",
                            { sensitivity:"base" }
                        )
                );

            select.innerHTML =
                '<option value="">Hekim seç...</option>' +
                aktif.map(function(h) {
                    const hekim = String(h.adSoyad || "").trim();
                    const klinik = String(h.klinikAdi || "").trim();

                    let gorunen = hekim || klinik || ("Hekim #" + Number(h.id));

                    // Hekim ve klinik aynıysa aynı bilgi iki kez yazılmaz.
                    if (hekim && klinik &&
                        hekim.toLocaleLowerCase("tr-TR") !== klinik.toLocaleLowerCase("tr-TR")) {
                        gorunen = hekim + " — " + klinik;
                    }

                    return '<option value="' + Number(h.id) + '">' +
                        escapeHtml(gorunen) +
                        '</option>';
                }).join("");

            if (current && aktif.some(h => String(h.id) === String(current))) {
                select.value = current;
            }
        }

