        function arMoney(map, net=false){
            const rows=[];
            ["TRY","EUR","USD"].forEach(c=>{
                const v=Number(map?.[c]||0);
                if(Math.abs(v)<0.0001)return;
                const cls=net?(v>0?"positive":v<0?"negative":""):"";
                rows.push(`<span class="${cls}">${paraBirimiFormat(v,c)}</span>`);
            });
            return rows.length?rows.join(""):'<span>0 ₺</span>';
        }

        function arMoneyText(map){
            const rows=[];
            ["TRY","EUR","USD"].forEach(c=>{
                const v=Number(map?.[c]||0);
                if(Math.abs(v)>=0.0001) rows.push(paraBirimiFormat(v,c));
            });
            return rows.length?rows.join(" + "):"0 ₺";
        }

