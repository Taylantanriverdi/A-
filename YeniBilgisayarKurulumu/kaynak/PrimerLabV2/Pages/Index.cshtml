        function cariAlacakBildirimi(){
            if(!cariDetayData)return;
            const d=cariDetayData;
            const lines=[
                "Sayın "+(d.hekim.adSoyad||"Hekim")+",",
                "",
                "Güncel cari hesap bakiyeniz:"
            ];
            let any=false;
            ["TRY","EUR","USD"].forEach(c=>{
                const v=Number(d.bakiyeler?.[c]||0);
                if(Math.abs(v)>0.0001){
                    any=true;
                    lines.push("- "+cariPara(v,c));
                }
            });
            if(!any) lines.push("- Açık bakiye bulunmuyor.");
            lines.push(
                "",
                "Cari dönemdeki tamamlanan iş sayısı: "+(d.isler?.length||0),
                "Primer Lab"
            );

            document.getElementById("cariBildirimMetni").innerText=lines.join("\n");
            const phone=String(d.hekim.telefon||"").replace(/\D/g,"");
            const wa=document.getElementById("cariBildirimWhatsAppBtn");
            if(wa) wa.style.display=phone?"inline-flex":"none";
            document.getElementById("cariBildirimModal").style.display="flex";
        }

        async function cariBildirimKopyala(){
            const text=document.getElementById("cariBildirimMetni").innerText;
            try{
                await navigator.clipboard.writeText(text);
                showSuccess("Bildirim metni kopyalandı.");
            }catch{
                showError("Metin panoya kopyalanamadı.");
            }
        }

        function cariBildirimWhatsApp(){
            if(!cariDetayData)return;
            let phone=String(cariDetayData.hekim.telefon||"").replace(/\D/g,"");
            if(!phone)return showError("Hekimin telefon bilgisi kayıtlı değil.");
            if(phone.startsWith("0")) phone="90"+phone.slice(1);
            if(!phone.startsWith("90") && phone.length===10) phone="90"+phone;
            const text=document.getElementById("cariBildirimMetni").innerText;
            window.open("https://wa.me/"+phone+"?text="+encodeURIComponent(text),"_blank","noopener");
        }

        function cariBildirimYazdir(){
            const text=document.getElementById("cariBildirimMetni").innerText;
            const w=window.open("","_blank","width=760,height=640");
            if(!w)return showError("Yazdırma penceresi açılamadı.");
            w.document.write(`<html><head><title>Alacak Bildirimi</title><style>body{font-family:Arial;padding:32px;white-space:pre-wrap;line-height:1.6;color:#0f172a}</style></head><body>${escapeHtml(text)}<script>window.onload=()=>window.print();<\/script></body></html>`);
            w.document.close();
        }

        function cariPdf(){
            if(!cariDetayData)return;
            const d=cariDetayData;
            const w=window.open("","_blank","width=900,height=750");
            w.document.write(`<html><head><title>Cari Hesap - ${escapeHtml(d.hekim.adSoyad||"")}</title><style>body{font-family:Arial;padding:28px}h1{margin-bottom:4px}.muted{color:#666}table{width:100%;border-collapse:collapse;margin-top:18px}th,td{padding:8px;border-bottom:1px solid #ddd;text-align:left}</style></head><body><h1>Primer Lab Cari Hesap</h1><div class="muted">${escapeHtml(d.hekim.adSoyad||"")} ${escapeHtml(d.hekim.klinikAdi||"")}</div><h3>Kalan Bakiye</h3><div>${cariMoneyStack(d.bakiyeler,true)}</div><table><thead><tr><th>Hasta</th><th>İş</th><th>Tutar</th><th>Geliş Tarihi</th></tr></thead><tbody>${(d.isler||[]).map(x=>`<tr><td>${escapeHtml(x.hastaAdi||"")}</td><td>${escapeHtml(x.isTuru||"")}</td><td>${cariPara(x.tutar,x.paraBirimi)}</td><td>${tarihGoster(x.teslimTarihi)}</td></tr>`).join("")}</tbody></table><script>window.onload=()=>window.print();<\/script></body></html>`);
            w.document.close();
        }


        let kaListe = [];
        let kaSeciliHekimId = 0;
        let kaDetay = null;
        let kaAktifTab = "isler";
        let kaDonemDetay = null;

        function kaPara(value, currency){
            return paraBirimiFormat(Number(value||0), currency||"TRY");
        }

        function kaMoneyStack(map, balance=false){
            const rows=[];
            ["TRY","EUR","USD"].forEach(c=>{
                const value=Number(map?.[c]||0);
                if(Math.abs(value)<0.0001)return;
                const cls=balance?(value>0?"ka-negative":value<0?"ka-positive":""):"";
                rows.push(`<span class="${cls}">${kaPara(value,c)}</span>`);
            });
            return rows.length?`<div class="ka-money">${rows.join("")}</div>`:'<span class="muted">0</span>';
        }

        async function kaYenile(){
            const q=new URLSearchParams();
            const b=document.getElementById("kaBaslangic")?.value;
            const e=document.getElementById("kaBitis")?.value;
            if(b)q.set("baslangic",b);
            if(e)q.set("bitis",e);

            const r=await fetch("/api/kasa-arsiv/ozet?"+q.toString(),{cache:"no-store"});
            if(!r.ok){
                showError((await r.text())||"Kasa / Arşiv verileri alınamadı.");
                return;
            }

            kaListe=await r.json();
            kaRenderOzet();
            kaRenderListe();
        }

        function kaRenderOzet(){
            const açık=kaListe.filter(x=>
                ["TRY","EUR","USD"].some(c=>Number(x.bakiye?.[c]||0)>0.0001)
            ).length;

            const toplam={TRY:0,EUR:0,USD:0};
            kaListe.forEach(x=>{
                ["TRY","EUR","USD"].forEach(c=>{
                    const v=Number(x.bakiye?.[c]||0);
                    if(v>0)toplam[c]+=v;
                });
            });

            document.getElementById("kaAcikCariSayisi").innerText=açık;
            document.getElementById("kaTryBakiye").innerText=kaPara(toplam.TRY,"TRY");
            document.getElementById("kaEurBakiye").innerText=kaPara(toplam.EUR,"EUR");
            document.getElementById("kaUsdBakiye").innerText=kaPara(toplam.USD,"USD");
        }

        function kaRenderListe(){
            const body=document.getElementById("kaListeBody");
            if(!body)return;

            const q=String(document.getElementById("kaArama")?.value||"")
                .trim().toLocaleLowerCase("tr-TR");

            const list=kaListe.filter(x=>
                [x.hekimAdi,x.klinikAdi]
                    .some(v=>String(v||"").toLocaleLowerCase("tr-TR").includes(q))
            );

            if(!list.length){
                body.innerHTML='<tr><td colspan="6" class="empty">Kayıt bulunamadı.</td></tr>';
                return;
            }

            body.innerHTML=list.map(x=>{
                const klinik=x.klinikAdi&&x.klinikAdi!==x.hekimAdi
                    ? `<div class="ops-mini">${escapeHtml(x.klinikAdi)}</div>`
                    : "";

                return `<tr onclick="kaDetayAc(${Number(x.hekimId)})">
                    <td><strong>${escapeHtml(x.hekimAdi||"-")}</strong>${klinik}</td>
                    <td>${Number(x.tamamlananIsSayisi||0)}</td>
                    <td>${kaMoneyStack(x.toplamlar)}</td>
                    <td>${kaMoneyStack(x.tahsilatlar)}</td>
                    <td>${kaMoneyStack(x.bakiye,true)}</td>
                    <td>${Number(x.arsivDonemSayisi||0)>0
                        ? `<span class="status">${Number(x.arsivDonemSayisi)} dönem</span>`
                        : '<span class="muted">Aktif dönem</span>'}</td>
                </tr>`;
            }).join("");
        }

        function kaFiltreTemizle(){
            document.getElementById("kaBaslangic").value="";
            document.getElementById("kaBitis").value="";
            document.getElementById("kaArama").value="";
            kaYenile();
        }

        async function kaDetayAc(hekimId){
            kaSeciliHekimId=Number(hekimId);
            kaAktifTab="isler";
            document.getElementById("kaDetayBaslangic").value="";
            document.getElementById("kaDetayBitis").value="";
            document.getElementById("kaDetayModal").style.display="flex";
            await kaDetayYukle();
        }

        function kaDetayKapat(){
            document.getElementById("kaDetayModal").style.display="none";
        }

        async function kaDetayYukle(){
            if(!kaSeciliHekimId)return;

            const q=new URLSearchParams();
            const b=document.getElementById("kaDetayBaslangic")?.value;
            const e=document.getElementById("kaDetayBitis")?.value;
            if(b)q.set("baslangic",b);
            if(e)q.set("bitis",e);

            const r=await fetch(`/api/kasa-arsiv/hekim/${kaSeciliHekimId}?${q.toString()}`,{cache:"no-store"});
            if(!r.ok){
                showError((await r.text())||"Cari hesap detayı alınamadı.");
                return;
            }

            kaDetay=await r.json();
            document.getElementById("kaDetayBaslik").innerText=kaDetay.hekim.adSoyad||"Cari Hesap";
            document.getElementById("kaDetayAlt").innerText=kaDetay.hekim.klinikAdi||"Hekim cari hesabı";
            document.getElementById("kaDetayIsSayisi").innerText=Number(kaDetay.isler?.length||0);
            document.getElementById("kaDetayTry").innerText=kaPara(kaDetay.bakiye?.TRY||0,"TRY");
            document.getElementById("kaDetayEur").innerText=kaPara(kaDetay.bakiye?.EUR||0,"EUR");
            document.getElementById("kaDetayUsd").innerText=kaPara(kaDetay.bakiye?.USD||0,"USD");

            kaRenderIsler();
            kaRenderOdemeler();
            kaRenderDonemler();
            kaTabAc(kaAktifTab);
        }

        function kaDetayFiltreTemizle(){
            document.getElementById("kaDetayBaslangic").value="";
            document.getElementById("kaDetayBitis").value="";
            kaDetayYukle();
        }

        function kaTabAc(tab){
            kaAktifTab=tab;

            const config={
                isler:["kaTabIsler","kaPaneIsler"],
                odemeler:["kaTabOdemeler","kaPaneOdemeler"],
                donemler:["kaTabDonemler","kaPaneDonemler"]
            };

            Object.entries(config).forEach(([key,[btn,pane]])=>{
                document.getElementById(btn).classList.toggle("active",key===tab);
                document.getElementById(pane).style.display=key===tab?"block":"none";
            });
        }

        function kaRenderIsler(){
            const host=document.getElementById("kaPaneIsler");
            const rows=[];

            if(["TRY","EUR","USD"].some(c=>Math.abs(Number(kaDetay.devir?.[c]||0))>0.0001)){
                rows.push(`<tr style="background:#fff9e6">
                    <td><strong>Devreden Bakiye</strong></td>
                    <td>Önceki dönemden</td>
                    <td>${kaMoneyStack(kaDetay.devir,true)}</td>
                    <td>${kaDetay.donemBaslangic?tarihGoster(kaDetay.donemBaslangic):"-"}</td>
                    <td>—</td>
                </tr>`);
            }

            (kaDetay.isler||[]).forEach(x=>{
                rows.push(`<tr>
                    <td>${escapeHtml(x.hastaAdi||"-")}</td>
                    <td>${escapeHtml(x.isTuru||"-")}</td>
                    <td>${kaPara(x.tutar,x.paraBirimi)}</td>
                    <td>${tarihGoster(x.teslimTarihi)}</td>
                    <td>#${Number(x.id)}</td>
                </tr>`);
            });

            host.innerHTML=`<div class="table-wrapper"><table>
                <thead><tr><th>Hasta</th><th>İş</th><th>Tutar</th><th>Geliş Tarihi</th><th>Kayıt</th></tr></thead>
                <tbody>${rows.length?rows.join(""):'<tr><td colspan="5" class="ka-empty">Bu dönemde tamamlanmış iş yok.</td></tr>'}</tbody>
            </table></div>`;
        }

        async function kaTahsilatSil(id){
            id=Number(id||0);
            if(!id)return showError("Tahsilat bulunamadı.");
            if(!confirm("Tahsilat kaydı silinsin mi?"))return;
            try{
                const r=await fetch("/api/kasa-arsiv/tahsilat/"+id,{method:"DELETE"});
                if(!r.ok){
                    if(r.status===404||r.status===405)throw new Error("Kasa Arşivi tahsilat silme servisi sunucuda bulunamadı.");
                    throw new Error((await r.text())||"Tahsilat silinemedi.");
                }
                await kaYenile();
                if(kaSeciliHekimId)await kaDetayYukle();
                showSuccess("Tahsilat silindi.");
            }catch(err){
                showError(err?.message||"Tahsilat silinemedi.");
            }
        }

        function kaRenderOdemeler(){
            const host=document.getElementById("kaPaneOdemeler");
            const rows=(kaDetay.odemeler||[]).map(x=>`<tr>
                <td>${tarihGoster(x.tarih)}</td>
                <td>${kaPara(x.tutar,x.paraBirimi)}</td>
                <td>${escapeHtml(x.odemeTuru||"-")}</td>
                <td>${escapeHtml(x.islemNo||"-")}</td>
                <td>${escapeHtml(x.aciklama||"-")}</td>
                <td>
                    <button class="button button-light" style="color:#b91c1c" onclick="event.stopPropagation();kaTahsilatSil(${Number(x.id)})">
                        Sil
                    </button>
                </td>
            </tr>`);

            host.innerHTML=`
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                    <div>${kaMoneyStack(kaDetay.tahsilatlar)}</div>
                    <button class="button button-blue" onclick="kaTahsilatAc(kaSeciliHekimId)">+ Yeni Tahsilat</button>
                </div>
                <div class="table-wrapper"><table>
                    <thead><tr><th>Tarih</th><th>Tutar</th><th>Tür</th><th>Referans</th><th>Not</th><th></th></tr></thead>
                    <tbody>${rows.length?rows.join(""):'<tr><td colspan="6" class="ka-empty">Henüz tahsilat kaydı yok.</td></tr>'}</tbody>
                </table></div>`;
        }

        function kaRenderDonemler(){
            const host=document.getElementById("kaPaneDonemler");
            const rows=(kaDetay.donemler||[]).map(x=>`<tr style="${x.geriAlindi?'opacity:.5':''}">
                <td>${tarihGoster(x.kapanisTarihi)}</td>
                <td>${Number(x.isSayisi||0)}</td>
                <td>${kaMoneyStack(x.toplamlar)}</td>
                <td>${kaMoneyStack(x.tahsilatlar)}</td>
                <td>${kaMoneyStack(x.bakiyeler,true)}</td>
                <td>${x.devirEklendi?"Devredildi":"Devredilmedi"}</td>
                <td>
                    <div class="button-group">
                        <button class="button button-light" onclick="event.stopPropagation();kaDonemDetayAc(${Number(x.id)})">Görüntüle</button>
                        ${!x.geriAlindi
                            ? `<button class="button button-light" style="color:#c2410c" onclick="event.stopPropagation();kaDonemGeriAl(${Number(x.id)})">Geri Al</button>`
                            : ""}
                    </div>
                </td>
            </tr>`);

            host.innerHTML=`<div class="table-wrapper"><table>
                <thead><tr><th>Kapanış</th><th>İş</th><th>Toplam İş</th><th>Tahsilat</th><th>Bakiye</th><th>Devir</th><th></th></tr></thead>
                <tbody>${rows.length?rows.join(""):'<tr><td colspan="7" class="ka-empty">Henüz kapatılmış dönem yok.</td></tr>'}</tbody>
            </table></div>`;
        }

        function kaTahsilatAc(hekimId){
            const select=document.getElementById("kaTahsilatHekim");
            select.innerHTML=kaListe.map(x=>{
                const klinik=x.klinikAdi&&x.klinikAdi!==x.hekimAdi
                    ? " — "+x.klinikAdi
                    : "";
                return `<option value="${Number(x.hekimId)}">${escapeHtml((x.hekimAdi||"-")+klinik)}</option>`;
            }).join("");

            const target=Number(hekimId||kaSeciliHekimId||kaListe[0]?.hekimId||0);
            if(target)select.value=String(target);

            document.getElementById("kaTahsilatTutar").value="";
            document.getElementById("kaTahsilatPara").value="TRY";
            document.getElementById("kaTahsilatTarih").value=new Date().toISOString().slice(0,10);
            document.getElementById("kaTahsilatTur").value="Nakit";
            document.getElementById("kaTahsilatIslemNo").value="";
            document.getElementById("kaTahsilatNot").value="";
