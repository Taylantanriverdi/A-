            const x=isDosyaKaydi((anahtar||'').split('|')[0])||{};
            const renk=(anahtar||'').endsWith('|Tasarım')?[0.55,0.62,0.95]:[0.93,0.86,0.76];
            let mesh=onzMeshOnbellek.get(fileId);
