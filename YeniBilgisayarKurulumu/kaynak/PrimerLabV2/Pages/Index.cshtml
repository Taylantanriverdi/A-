            onzAktif=anahtar;
            const x=isDosyaKaydi(id)||{};
            const turAd=tur==='Diger'?'Diğer dosyalar':tur+' dosyaları';
            p.innerHTML=`<div class="onz-bas"><span>#${Number(id)} · ${escapeHtml(x.hastaAdi||'')} — ${turAd}</span><button type="button" class="dsb" onclick="dosyaHepsiniIndir(${Number(id)},'${tur}')">⬇ Tümü</button></div>
                <div class="onz-govde"><div class="onz-tuval" id="onzTuvalKutu"><div class="onz-durum" id="onzDurum">Yükleniyor...</div></div>
                <div class="onz-liste" id="onzListe"></div></div>`;
            p.style.display='block';
            const g=p.getBoundingClientRect();
