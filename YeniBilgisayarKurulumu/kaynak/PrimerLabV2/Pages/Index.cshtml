        function kaTahsilatBakiyeGuncelle(){
            const hekimId=Number(document.getElementById("kaTahsilatHekim").value||0);
            const currency=document.getElementById("kaTahsilatPara").value||"TRY";
            const row=kaListe.find(x=>Number(x.hekimId)===hekimId);

            const values={
                TRY:Number(row?.bakiye?.TRY||0),
                EUR:Number(row?.bakiye?.EUR||0),
                USD:Number(row?.bakiye?.USD||0)
            };

            document.getElementById("kaBalanceTRYValue").innerText=kaPara(values.TRY,"TRY");
            document.getElementById("kaBalanceEURValue").innerText=kaPara(values.EUR,"EUR");
            document.getElementById("kaBalanceUSDValue").innerText=kaPara(values.USD,"USD");

            ["TRY","EUR","USD"].forEach(c=>{
                document.getElementById("kaBalance"+c).classList.toggle("active",c===currency);
            });

            const bakiye=values[currency];
            const box=document.getElementById("kaTahsilatBakiye");
            const warn=document.getElementById("kaTahsilatUyari");

            if(bakiye>0){
                box.innerHTML=`Seçili para birimindeki açık alacak: <strong>${kaPara(bakiye,currency)}</strong>`;
                warn.style.display="none";
            }else if(bakiye<0){
                box.innerHTML=`Seçili para biriminde hekim lehine bakiye: <strong>${kaPara(Math.abs(bakiye),currency)}</strong>`;
                warn.innerText="Bu para biriminde tahsilat girmek borç bakiyesini daha da artırabilir.";
                warn.style.display="block";
            }else{
                box.innerHTML=`${currency} para biriminde açık alacak bulunmuyor.`;
                warn.style.display="none";
            }
        }

        function kaTahsilatFormVerisi(){
            const hekimId=Number(document.getElementById("kaTahsilatHekim").value||0);
            const hekim=kaListe.find(x=>Number(x.hekimId)===hekimId);

            return {
                hekimId,
                hekimAdi:hekim?.hekimAdi||"",
                klinikAdi:hekim?.klinikAdi||"",
                tutar:Number(document.getElementById("kaTahsilatTutar").value||0),
                paraBirimi:document.getElementById("kaTahsilatPara").value||"TRY",
                tarih:document.getElementById("kaTahsilatTarih").value,
                odemeTuru:document.getElementById("kaTahsilatTur").value,
                islemNo:document.getElementById("kaTahsilatIslemNo").value||"",
                aciklama:document.getElementById("kaTahsilatNot").value||""
            };
        }

        function kaTahsilatDogrula(data, showMessage=true){
            const warn=document.getElementById("kaTahsilatUyari");

            if(!data.hekimId){
                if(showMessage) showError("Hekim seçilmelidir.");
                return false;
            }
            if(!Number.isFinite(data.tutar)||data.tutar<=0){
                if(showMessage) showError("Tahsilat tutarı sıfırdan büyük olmalıdır.");
                return false;
            }
            if(!data.tarih){
                if(showMessage) showError("Ödeme tarihi seçilmelidir.");
                return false;
            }

            const row=kaListe.find(x=>Number(x.hekimId)===data.hekimId);
            const bakiye=Number(row?.bakiye?.[data.paraBirimi]||0);

            if(bakiye>0 && data.tutar>bakiye){
                warn.innerText=`Uyarı: Girilen tahsilat ${kaPara(data.tutar,data.paraBirimi)}, açık alacak ise ${kaPara(bakiye,data.paraBirimi)}. Fazla tahsilat hekim lehine bakiye oluşturur.`;
                warn.style.display="block";
            }else{
                warn.style.display="none";
            }

            return true;
        }

