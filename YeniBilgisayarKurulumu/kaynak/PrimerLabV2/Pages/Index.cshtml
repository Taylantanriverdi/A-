        // Hekimin kendi iş listesi (kendi fiyatlarıyla). Merkezi katalog kullanılmaz.
        const hekimIsListesiOnbellek=new Map();
        async function hekimIsListesiGetir(hekimId){
            hekimId=Number(hekimId||0);
            if(hekimId && hekimIsListesiOnbellek.has(hekimId)) return hekimIsListesiOnbellek.get(hekimId);
            let fiyatlar=[];
            if(hekimId){
                const r=await fetch('/api/hekim-fiyatlari/'+hekimId,{cache:'no-store'});
                if(r.ok){ const d=await r.json(); fiyatlar=Array.isArray(d)?d:[]; }
            }
            const sonuc={
                bos:!fiyatlar.length,
                kalemler:fiyatlar.filter(x=>x&&x.isTuru).map(x=>({isTuru:x.isTuru,birimFiyat:Number(x.birimFiyat||0),paraBirimi:String(x.paraBirimi||'TRY').toUpperCase()}))
            };
            if(hekimId) hekimIsListesiOnbellek.set(hekimId,sonuc);
            return sonuc;
        }
