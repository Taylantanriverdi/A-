        // ---------------- Dosya simgeleri, tek tık indirme ve 3B önizleme ----------------
        let isDosyaHaritasiKaynak=null, isDosyaHaritasi=new Map();
        function isDosyaKaydi(id){
            if(isDosyaHaritasiKaynak!==anayasaIsler){ isDosyaHaritasi=new Map((anayasaIsler||[]).map(x=>[Number(x.id),x])); isDosyaHaritasiKaynak=anayasaIsler; }
            return isDosyaHaritasi.get(Number(id));
        }
        // Dosyası olan işin satırında: 🦷 tarama, 📐 tasarım, 📎 diğer. Tıkla: o türün tümünü indir; üzerine gel: önizleme.
        function dosyaSimge(id){
            const x=isDosyaKaydi(id); if(!x) return '';
            const t=Number(x.taramaDosyaSayisi||0), d=Number(x.tasarimDosyaSayisi||0), o=Math.max(0,Number(x.dosyaSayisi||0)-t-d);
            if(!t&&!d&&!o) return '';
            const b=(tur,cls,ikon,n,ad)=>`<button type="button" class="dsb ${cls}" title="${ad} (${n}) — tıkla: tümünü indir" onclick="event.stopPropagation();dosyaHepsiniIndir(${Number(id)},'${tur}')" onmouseenter="onizlemeGoster(this,${Number(id)},'${tur}')" onmouseleave="onizlemeGizleGecikmeli()">${ikon} ${n}</button>`;
            return '<span class="dsimge">'+(t?b('Tarama','dsb-tarama','🦷',t,'Tarama dosyaları'):'')+(d?b('Tasarım','dsb-tasarim','📐',d,'Tasarım dosyaları'):'')+(o?b('Diger','dsb-diger','📎',o,'Diğer dosyalar'):'')+'</span>';
        }

        function dosyaHepsiniIndir(id,tur){
            const a=document.createElement('a');
