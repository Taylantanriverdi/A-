        function cariDonemDuzenleKapat(){
            document.getElementById("cariDonemDuzenleModal").style.display="none";
        }

        async function cariDonemDuzenleKaydet(){
            const id=Number(document.getElementById("cariDonemDuzenleId").value||0);
            if(!id)return;

            const payload={
                devirEkle:document.getElementById("cariDonemDuzenleDevir").checked,
                bakiyeler:{
                    TRY:Number(document.getElementById("cariDonemDuzenleTRY").value||0),
                    EUR:Number(document.getElementById("cariDonemDuzenleEUR").value||0),
