                    const r=await fetch('/api/is-dosyalari/'+fileId+'/onizleme');
                    if(!r.ok) throw new Error((await r.text())||'Önizleme oluşturulamadı.');
                    mesh=onzMeshCoz(await r.arrayBuffer());
                    if(onzMeshOnbellek.size>=8) onzMeshOnbellek.delete(onzMeshOnbellek.keys().next().value);
                    onzMeshOnbellek.set(fileId,mesh);
                }catch(e){ if(onzAktif===anahtar) onzDurum(e.message||'Önizleme oluşturulamadı.'); return; }
            }
