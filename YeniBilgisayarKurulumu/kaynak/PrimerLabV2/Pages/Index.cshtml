            if(!confirm("En son kapatılan dönem geri alınsın mı? Kayıtlar tekrar güncel döneme dahil olacaktır."))return;
            const r=await fetch("/api/cari/donem/"+Number(id)+"/geri-al",{method:"POST"});
            if(!r.ok)return showError((await r.text())||"Dönem geri alınamadı.");
