        async function hizliTeknisyenOtomatikKaydet(select, id) {
            if (!select) return;

            const previous = select.dataset.previousValue || "";
            const next = String(select.value || "");
            select.disabled = true;

            try {
                await teknisyenAta(Number(id), next ? Number(next) : null);
                select.dataset.previousValue = next;
                showSuccess(next
                    ? "Teknisyen ataması kaydedildi."
                    : "İş Atanmamış olarak güncellendi.");
            } catch (error) {
                select.value = previous;
                showError(error.message || "Teknisyen kaydedilemedi.");
            } finally {
                select.disabled = false;
            }
        }

        async function hizliTeknisyenKaydet(
            button,
            id
        ) {
            const wrap =
                button?.closest(
                    ".quick-tech-wrap"
                );

            const select =
                wrap?.querySelector(
                    ".quick-tech-select"
                );

            if (!select) {
                showError(
                    "Teknisyen seçim alanı bulunamadı."
                );
                return;
            }

            const jobId =
                Number(
                    wrap?.dataset?.jobId ||
                    id
                );

            if (!jobId) {
                showError(
                    "İş numarası bulunamadı."
                );
                return;
            }

            const requestedValue =
                select.value;

            const oldDisabled =
                select.disabled;

            const oldButtonDisabled =
                button.disabled;

            const oldButtonText =
                button.innerText;

            select.disabled = true;
            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const saved =
                    await teknisyenAta(
                        jobId,
                        requestedValue
                    );

                showSuccess(
                    saved.teknisyenId
                        ? "Teknisyen değiştirildi: " +
                          (saved.teknisyenAdi || "Teknisyen")
                        : "İş Atanmamış olarak güncellendi."
                );
            }
            catch (error) {
                showError(
                    error.message ||
                    "Teknisyen ataması kaydedilemedi."
                );
            }
            finally {
                // Bu DOM parçası render sırasında değişmiş olabilir.
                // Hala ekrandaysa güvenli şekilde eski durumuna döndür.
                if (document.body.contains(select)) {
                    select.disabled = oldDisabled;
                }

                if (document.body.contains(button)) {
                    button.disabled = oldButtonDisabled;
                    button.innerText = oldButtonText;
                }
            }
        }

