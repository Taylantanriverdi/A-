                            title="Teknisyen seçildiğinde otomatik kaydedilir"
                            onchange="event.stopPropagation(); hizliTeknisyenOtomatikKaydet(this, ${Number(item.id)})">
                        ${aktifTeknisyenSecenekleri(selected)}
                    </select>
