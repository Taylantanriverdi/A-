        async function anayasaDagitimTopluKaydet(){ if(!masterDirty.size)return; const btn=document.getElementById('anDagitimTopluKaydet');if(btn)btn.disabled=true;let saved=0;try{for(const [id,d] of Array.from(masterDirty.entries())){const x=anayasaIsler.find(a=>Number(a.id)===Number(id));if(!x)continue;const hasDetailChange=['hastaAdi','terminTarihi','disRengi','kalemler'].some(k=>Object.prototype.hasOwnProperty.call(d,k));if(hasDetailChange){const payload={hastaAdi:d.hastaAdi??x.hastaAdi??'',durum:anayasaDurum(x.durum),terminTarihi:d.terminTarihi!==undefined?d.terminTarihi:(x.terminTarihi?String(x.terminTarihi).slice(0,10):null),disRengi:d.disRengi!==undefined?(d.disRengi||null):(x.disRengi||null),oncelik:x.oncelik||'Normal',uretimNotu:x.uretimNotu||null,uretimAsamasi:x.uretimAsamasi||'Bekliyor',kaliteKontrolDurumu:x.kaliteKontrolDurumu||'Bekliyor',kaliteKontrolNotu:x.kaliteKontrolNotu||null,kalemler:d.kalemler||(Array.isArray(x.kalemler)?x.kalemler:[])};if(!payload.hastaAdi)throw new Error(`#${id}: Hasta adı boş olamaz.`);if(!payload.kalemler.length)throw new Error(`#${id}: En az bir iş kalemi olmalı.`);if(payload.kalemler.some(k=>!String(k.isTuru||'').trim()))throw new Error(`#${id}: İş türü seçilmelidir.`);if(payload.kalemler.some(k=>Number(k.adet||0)<=0||Number(k.birimFiyat||0)<0))throw new Error(`#${id}: Adet ve fiyat bilgilerini kontrol et.`);const r=await fetch('/api/siparisler/'+id+'/lab-duzenle',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!r.ok)throw new Error(`#${id}: `+((await r.text())||'İş güncellenemedi.'));}if(d.durum!==undefined&&anayasaDurum(d.durum)!==anayasaDurum(x.durum)){const sr=await fetch('/api/siparisler/'+id+'/durum',{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({durum:d.durum})});if(!sr.ok)throw new Error(`#${id}: `+((await sr.text())||'Durum güncellenemedi.'));}if(d.teknisyenId!==undefined)await teknisyenAta(id,d.teknisyenId||'');masterDirty.delete(id);saved++;}await Promise.all([loadSiparisler(),loadAnayasaData()]);showSuccess(`${saved} işteki değişiklikler toplu olarak kaydedildi.`);}catch(e){await Promise.all([loadSiparisler(),loadAnayasaData()]);showError((saved?`${saved} iş kaydedildi. `:'')+(e.message||'Toplu kayıt tamamlanamadı.'));}finally{anayasaDagitimKaydetButonuGuncelle();}}

