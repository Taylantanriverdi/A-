        async function mailV2LoadStatus(){
            try{
                const r=await fetch("/api/mail-v2/status",{cache:"no-store"});
                if(!r.ok)throw new Error(await r.text());
                const s=await r.json();
                mailV2Status=s;

                const gmail=document.getElementById("mailV2GmailStatus");
                gmail.innerText=s.gmailConnected?"Bağlı":(s.credentialsConfigured?"İzin Bekliyor":"Kurulmadı");
                gmail.className=s.gmailConnected?"ok":(s.credentialsConfigured?"warn":"bad");

                const ai=document.getElementById("mailV2AiStatus");
                ai.innerText=s.aiConfigured?("Aktif · "+(s.aiModel||"")):"Pasif";
                ai.className=s.aiConfigured?"ok":"warn";

                document.getElementById("mailV2Count").innerText=Number(s.mailCount||0);
                document.getElementById("mailV2ReviewCount").innerText=Number(s.reviewCount||0);

                const st=s.settings||{};
                document.getElementById("mailV2Auto").checked=!!st.autoEnabled;
                document.getElementById("mailV2Interval").value=String(st.intervalMinutes||15);
                document.getElementById("mailV2Scope").value=st.timeScope||"month";
                document.getElementById("mailV2Max").value=String(st.maxResults||25);
                document.getElementById("mailV2Query").value=st.query||"";
                document.getElementById("mailV2Unread").checked=!!st.unreadOnly;
                document.getElementById("mailV2AttachmentsOnly").checked=!!st.attachmentsOnly;
                document.getElementById("mailV2KnownDoctors").checked=!!st.knownDoctorsOnly;
                document.getElementById("mailV2DownloadAttachments").checked=st.downloadAttachments!==false;
                document.getElementById("mailV2Threshold").value=String(Math.round(Number(st.reviewThreshold||0.65)*100));
                document.getElementById("mailV2ThresholdLabel").innerText=document.getElementById("mailV2Threshold").value+"%";
                document.getElementById("mailV2WorkingHours").checked=!!st.workingHoursOnly;
                document.getElementById("mailV2StartHour").value=String(st.startHour??7);
                document.getElementById("mailV2EndHour").value=String(st.endHour??23);
                document.getElementById("mailV2Weekends").checked=st.runOnWeekends!==false;
                mailV2WorkingToggle();

                const rt=s.runtime||{};
                mailV2RenderProgress(rt);
                document.getElementById("mailV2LastRun").innerText=rt.lastCompletedAt?tarihSaatGoster(rt.lastCompletedAt):(rt.lastStartedAt?tarihSaatGoster(rt.lastStartedAt):"—");
                document.getElementById("mailV2LastResult").innerText=rt.isRunning?"Çalışıyor...":(rt.lastResult||"Henüz çalışmadı");
                document.getElementById("mailV2LastStats").innerText=`${Number(rt.lastFound||0)} bulundu · ${Number(rt.lastImported||0)} kaydedildi · ${Number(rt.lastSkipped||0)} atlandı`;
                document.getElementById("mailV2NextRun").innerText=rt.nextRunAt?tarihSaatGoster(rt.nextRunAt):"—";
            }catch(e){
                showError("Mail durumu alınamadı: "+e.message);
            }
        }

