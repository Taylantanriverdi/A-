        async function yeniHekimKaydet(event) {
            event.preventDefault();

            const hata = document.getElementById("yeniHekimHata");
            const button = document.getElementById("yeniHekimKaydetBtn");
            const adSoyad = document.getElementById("hekimAdSoyad").value.trim();
            const klinikAdi = document.getElementById("hekimKlinik").value.trim();
            const telefon = document.getElementById("hekimTelefon").value.trim();
            let email = "";
            try { email = collectHekimEmails(); }
            catch (e) { hata.innerText = e.message; hata.style.display = "block"; return; }

            if (!adSoyad) {
                hata.innerText = "Hekim adı boş bırakılamaz.";
                hata.style.display = "block";
                return;
            }

            hata.style.display = "none";
            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const duzenleId = Number(document.getElementById("hekimDuzenleId").value || 0);
                const aktif = document.getElementById("hekimAktif").checked;

                const response = await fetch(
                    duzenleId ? ("/api/hekimler/" + duzenleId) : "/api/hekimler",
                    {
                        method: duzenleId ? "PUT" : "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            adSoyad: adSoyad,
                            klinikAdi: klinikAdi || null,
                            telefon: telefon || null,
                            email: email || null,
                            aktif: aktif
                        })
                    }
                );

                if (!response.ok) {
                    const message = await response.text();
                    throw new Error(message || "Hekim kaydedilemedi.");
                }

                closeYeniHekimModal();
                await loadHekimler();
                showSuccess(duzenleId ? "Hekim bilgileri güncellendi." : "Hekim başarıyla kaydedildi.");
            }
            catch (error) {
                hata.innerText = error.message || "Hekim kaydedilirken hata oluştu.";
                hata.style.display = "block";
            }
            finally {
                button.disabled = false;
                button.innerText = "Kaydet";
            }
        }

