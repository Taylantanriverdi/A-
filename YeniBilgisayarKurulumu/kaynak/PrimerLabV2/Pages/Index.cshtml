                        <td>${escapeHtml(m.hastaAdi||"-")}</td>
                        <td>${escapeHtml(m.isTuru||"-")}</td>
                        <td>${escapeHtml(m.disRengi||"-")}</td>
                        <td>${escapeHtml(m.materyal||"-")}</td>
                        <td>${mailV2FileAction(m)}</td>
                        <td><span class="mailv2-confidence ${review?'warn':''}">${review?'İncele':'%'+Math.round(conf*100)}</span><div class="mailv2-sub">${escapeHtml(m.analizKaynagi||"")}</div></td>
                        <td><div class="button-group">
                            <button class="button button-blue" onclick="mailV2ToForm(${Number(m.id)})">Forma Aktar</button>
                            ${mailV2TransferButton(m)}
