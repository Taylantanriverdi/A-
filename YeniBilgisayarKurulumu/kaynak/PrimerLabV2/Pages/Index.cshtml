        let dashboardTerminFilter =
            localStorage.getItem("primer.dashboardTerminFilter") || "priority";

        function terminGunFarki(value) {
            if (!value) return null;

            const term = new Date(value);
            if (Number.isNaN(term.getTime())) return null;

            const today = new Date();
            today.setHours(0,0,0,0);
            term.setHours(0,0,0,0);

            return Math.round((term - today) / 86400000);
        }

        function aktifTerminliIsler() {
            return siparisler.filter(function(item) {
                return !isArsiv(item.durum) && !!item.terminTarihi;
            });
        }

        function dashboardTerminFiltrele(filter) {
            dashboardTerminFilter = filter || "priority";
            localStorage.setItem(
                "primer.dashboardTerminFilter",
                dashboardTerminFilter
            );
            renderDashboardTermin();
            renderAnayasaFormHistory();
        }

        function dashboardOnayDurumu(item) {
            return String(item?.onayDurumu || "").trim().toLocaleLowerCase("tr-TR");
        }

        function dashboardGelenOnayMi(item) {
            return dashboardOnayDurumu(item) === "gelen onay";
        }

        function dashboardTamamlamaOnayiMi(item) {
            const d = normalDurum(item?.durum);
            return d.includes("tamamlama onayı") || d.includes("tamamlama onayi");
        }

        function dashboardAktifOperasyonMu(item) {
            if (!item || item.silindi || isArsiv(item.durum)) return false;
            if (dashboardGelenOnayMi(item)) return false;
            if (dashboardOnayDurumu(item) === "reddedildi") return false;
            return true;
        }

        function dashboardOnayBekliyorMu(item) {
            if (!item || item.silindi || isArsiv(item.durum)) return false;
            return dashboardGelenOnayMi(item) || dashboardTamamlamaOnayiMi(item);
        }

        function renderDashboardTermin() {
            const body = document.getElementById("dashboardTerminBody");
            const baslik = document.getElementById("dashboardTerminBaslik");
            if (!body) return;

            const aktifTum = siparisler.filter(dashboardAktifOperasyonMu);
            const aktif = aktifTum.filter(item => !!item.terminTarihi);
            const bugun = aktif.filter(item => terminGunFarki(item.terminTarihi) === 0);
            const yaklasan = aktif.filter(item => { const g=terminGunFarki(item.terminTarihi); return g!==null && g>=1 && g<=2; });
            const geciken = aktif.filter(item => { const g=terminGunFarki(item.terminTarihi); return g!==null && g<0; });
            const atanmamis = aktifTum.filter(item => { const a=teknisyenAtamasi(item); return !a || !a.teknisyenId; });
            const acil = aktifTum.filter(item => { const p=oncelikDegeri(item); return p==="Acil" || p==="Çok Acil"; });
            const terminsiz = aktifTum.filter(item => !item.terminTarihi);
            const onayBekleyen = siparisler.filter(dashboardOnayBekliyorMu);
            const setText=(id,value)=>{const el=document.getElementById(id);if(el)el.innerText=value;};
            setText("bugunTerminSayisi",bugun.length); setText("yaklasanTerminSayisi",yaklasan.length);
            setText("gecikenTerminSayisi",geciken.length); setText("terminliAktifSayisi",aktif.length);
            setText("dashboardOnayBekleyen",onayBekleyen.length); setText("dashboardAtanmamis",atanmamis.length);
            setText("dashboardAcil",acil.length); setText("dashboardTerminsiz",terminsiz.length);

            let liste=[], aciklama="";
            switch(dashboardTerminFilter){
                case "today": liste=bugun; aciklama="Bugün terminli aktif işler"; break;
                case "soon": liste=yaklasan; aciklama="Önümüzdeki 2 gün içinde terminli işler"; break;
                case "late": liste=geciken; aciklama="Termini geçmiş aktif işler"; break;
                case "all": liste=aktif; aciklama="Tüm terminli aktif işler"; break;
                case "unassigned": liste=atanmamis; aciklama="Teknisyen ataması bekleyen aktif işler"; break;
                case "urgent": liste=acil; aciklama="Acil ve Çok Acil aktif işler"; break;
                case "withoutDue": liste=terminsiz; aciklama="Termin tarihi girilmemiş aktif işler"; break;
                default: liste=aktif.filter(item=>{const g=terminGunFarki(item.terminTarihi);return g!==null&&g<=2;}); aciklama="Geciken, bugün ve önümüzdeki 2 gün terminli işler";
            }
            liste=liste.slice().sort(function(a,b){
                const at=a.terminTarihi?new Date(a.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                const bt=b.terminTarihi?new Date(b.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                const pa=oncelikDegeri(a)==="Çok Acil"?0:oncelikDegeri(a)==="Acil"?1:2;
                const pb=oncelikDegeri(b)==="Çok Acil"?0:oncelikDegeri(b)==="Acil"?1:2;
                return pa-pb || at-bt || Number(b.id||0)-Number(a.id||0);
            });
            if(baslik) baslik.innerText=aciklama+" • "+liste.length+" iş";
            if(!liste.length){body.innerHTML='<tr><td colspan="9" class="empty">Bu filtrede aktif iş bulunmuyor.</td></tr>';return;}
            body.innerHTML=liste.map(createWorkRow).join("");
        }


        let kanbanSuruklenenIsId = 0;

        function kanbanListeId(durum) {
            const d = standartDurum(durum);

            if (d === "Yeni") return "kanbanYeni";
            if (d === "Devam Eden") return "kanbanDevam";
            if (d === "Hazır") return "kanbanHazir";

            return "";
        }

        function kanbanSonrakiDurum(durum) {
            const d = standartDurum(durum);

            if (d === "Yeni") return "Devam Eden";
            if (d === "Devam Eden") return "Hazır";
            if (d === "Hazır") return "Teslim";

            return "";
        }

        function kanbanCardHtml(item) {
            const sonraki = kanbanSonrakiDurum(item.durum);
            const teslim = sonraki === "Teslim";

            return `
                <div class="kanban-card"
                     draggable="true"
                     data-is-id="${Number(item.id)}"
                     onclick="kanbanKartTikla(event, ${Number(item.id)})"
                     ondragstart="kanbanDragStart(event, ${Number(item.id)})"
                     ondragend="kanbanDragEnd(event)">

                    <div class="kanban-card-top">
                        <div>
                            <div class="kanban-job-no">#${Number(item.id)}</div>
                            <div class="kanban-patient">${escapeHtml(item.hastaAdi || "-")}${dosyaSimge(item.id)}</div>
                            <div class="kanban-doctor">
                                ${escapeHtml(item.hekimAdi || "-")}
                                ${item.klinikAdi ? " • " + escapeHtml(item.klinikAdi) : ""}
                            </div>
                            <div class="technician-mini">
                                Teknisyen: ${teknisyenRozeti(item)}
                            </div>
                            <div style="margin-top:8px;"
                                 onclick="event.stopPropagation()">
                                ${hizliTeknisyenKontrolu(item)}
                            </div>
                        </div>

                        <span class="status ${durumClass(item.durum)}">
                            ${escapeHtml(anayasaDurum(item.durum))}
                        </span>
                    </div>

                    <div style="margin-top:10px;">
                        ${terminBilgisi(item)}
                    </div>

                    <div class="kanban-meta">
                        <div>
                            Adet
                            <strong>${Number(item.toplamAdet || 0)}</strong>
                        </div>
                        <div>
                            Tutar
                            <strong>${para(item.toplamTutar)}</strong>
                        </div>
                    </div>

                    ${
                        sonraki
                            ? `
                                <div class="kanban-actions">
                                    <button type="button"
                                            class="${teslim ? "kanban-deliver" : "kanban-next"}"
                                            onclick="kanbanHizliDurum(event, ${Number(item.id)}, '${sonraki}')">
                                        ${teslim ? "Teslim Et" : sonraki + " →"}
                                    </button>
                                </div>
