        function mailV2RenderProgress(rt){
            rt=rt||{};
            const running=!!rt.isRunning;
            const pct=Math.max(0,Math.min(100,Number(rt.progressPercent||0)));
            const total=Number(rt.totalToProcess||0), processed=Number(rt.processed||0);
            const phase=rt.phase||"Bekliyor", subject=rt.currentSubject||"";
            const bar=document.getElementById("mailV2ProgressBar"); if(!bar)return;
            bar.style.width=pct+"%";
            bar.classList.toggle("running",running);
            bar.classList.toggle("error",String(phase).toLocaleLowerCase("tr-TR")==="hata");
            document.getElementById("mailV2ProgressTitle").innerText=running?("● "+phase):phase;
            document.getElementById("mailV2ProgressSub").innerText=subject?("İşlenen mail: "+subject):(running?"Gmail ve AI işlemi devam ediyor...":"Sorgulama başlatmak için “Sorgulamayı Başlat” düğmesine bas.");
            document.getElementById("mailV2ProgressPercent").innerText=Math.round(pct)+"%";
            document.getElementById("mailV2ProgressCount").innerText=`${processed} / ${total} mail`;
            const btn=document.getElementById("mailV2StartButton"); btn.disabled=running; btn.innerText=running?"Çalışıyor...":"▶ Sorgulamayı Başlat";
        }
        async function mailV2Stop(){
            const btn=document.getElementById("mailV2StopButton");
            if(btn){
                btn.disabled=true;
                btn.innerText="Durduruluyor...";
            }

            mailV2RunMessage("Durdurma isteği gönderiliyor...",false);

            try{
                const controller=new AbortController();
                const timeout=setTimeout(()=>controller.abort(),10000);

                const r=await fetch("/api/mail-v2/stop",{
                    method:"POST",
                    cache:"no-store",
                    signal:controller.signal
                });
                clearTimeout(timeout);

                let j={};
                try{j=await r.json();}catch{}

                if(!r.ok)
                    throw new Error(j.message||("HTTP "+r.status));

                if(j.stopped){
                    mailV2RunMessage("Durdurma isteği alındı. Aktif Gmail / AI / dosya işlemi güvenli şekilde kesiliyor...",true);
                    mailV2StartProgressPolling();

                    // En fazla 12 sn boyunca gerçekten durduğunu doğrula.
                    for(let i=0;i<12;i++){
                        await new Promise(resolve=>setTimeout(resolve,1000));
                        const sr=await fetch("/api/mail-v2/status",{cache:"no-store"});
                        if(!sr.ok)continue;
                        const st=await sr.json();
                        mailV2RenderProgress(st.runtime||{});
                        if(!st.runtime?.isRunning){
                            mailV2RunMessage("Mail sorgusu durduruldu.",true);
                            break;
                        }
                    }
                }else{
                    mailV2RunMessage(j.message||"Şu anda çalışan bir mail sorgusu yok.",true);
                }
            }catch(e){
                const msg=e?.name==="AbortError"
                    ?"Durdur isteği 10 saniye içinde yanıt vermedi."
                    :(e.message||String(e));
                mailV2RunMessage("Sorgu durdurulamadı: "+msg,false);
            }finally{
                await mailV2PollProgress();
            }
        }

        async function mailV2PollProgress(){
            try{const r=await fetch("/api/mail-v2/status",{cache:"no-store"});if(!r.ok)return;const s=await r.json();mailV2RenderProgress(s.runtime||{});const rt=s.runtime||{};document.getElementById("mailV2LastRun").innerText=rt.lastCompletedAt?tarihSaatGoster(rt.lastCompletedAt):(rt.lastStartedAt?tarihSaatGoster(rt.lastStartedAt):"—");document.getElementById("mailV2LastResult").innerText=rt.isRunning?"Çalışıyor...":(rt.lastResult||"Henüz çalışmadı");document.getElementById("mailV2LastStats").innerText=`${Number(rt.lastFound||0)} bulundu · ${Number(rt.lastImported||0)} kaydedildi · ${Number(rt.lastSkipped||0)} atlandı`;document.getElementById("mailV2NextRun").innerText=rt.nextRunAt?tarihSaatGoster(rt.nextRunAt):"—";}catch{}
        }
        function mailV2StartProgressPolling(){if(mailV2ProgressTimer)clearInterval(mailV2ProgressTimer);mailV2PollProgress();mailV2ProgressTimer=setInterval(mailV2PollProgress,1000);}
        function mailV2StopProgressPolling(){if(mailV2ProgressTimer){clearInterval(mailV2ProgressTimer);mailV2ProgressTimer=null;}mailV2PollProgress();}

        async function mailV2FetchJson(url,options={}){
            const controller=new AbortController();
            const timeoutMs=Number(options.timeoutMs||30000);
            const timeout=setTimeout(()=>controller.abort(),timeoutMs);

            try{
                const r=await fetch(url,{
                    ...options,
                    signal:controller.signal,
                    cache:"no-store"
                });

                let body=null;
                const text=await r.text();
                if(text){
                    try{body=JSON.parse(text);}catch{body={message:text};}
                }else body={};

                if(!r.ok){
                    throw new Error(body?.message||body?.detail||("HTTP "+r.status));
                }

                return body;
            }catch(e){
                if(e?.name==="AbortError")
                    throw new Error("İşlem zaman aşımına uğradı.");
                throw e;
            }finally{
                clearTimeout(timeout);
            }
        }

