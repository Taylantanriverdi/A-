        async function cariDonemDuzenleAc(id){
            const r=await fetch("/api/cari/donem/"+Number(id),{cache:"no-store"});
            if(!r.ok)return showError((await r.text())||"Dönem alınamadı.");
            const d=await r.json();

            document.getElementById("cariDonemDuzenleId").value=String(d.id||id);
