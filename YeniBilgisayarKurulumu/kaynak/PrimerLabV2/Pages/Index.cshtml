        function kaliteFiltreliListe() {
            const q =
                String(
                    document.getElementById("qcSearch")?.value || ""
                )
                .toLocaleLowerCase("tr-TR")
                .trim();

            const asama =
                document.getElementById("qcAsamaFiltre")?.value || "";

            const kalite =
                document.getElementById("qcDurumFiltre")?.value || "";

            return siparisler
                .filter(function(item) {
                    if (isArsiv(item.durum)) return false;

                    if (
                        asama &&
                        uretimAsamasiDegeri(item) !== asama
                    ) {
                        return false;
                    }

                    if (
                        kalite &&
                        kaliteDurumuDegeri(item) !== kalite
                    ) {
                        return false;
                    }

                    if (q) {
                        const haystack = [
                            item.id,
                            item.hastaAdi,
                            item.hekimAdi,
                            item.klinikAdi,
                            item.disRengi,
                            item.oncelik,
                            item.uretimAsamasi,
                            item.kaliteKontrolDurumu,
                            item.kaliteKontrolNotu
                        ]
                        .map(function(v) {
                            return String(v || "")
                                .toLocaleLowerCase("tr-TR");
                        })
                        .join(" ");

                        if (!haystack.includes(q)) {
                            return false;
                        }
                    }

                    return true;
                })
                .slice()
                .sort(function(a,b) {
                    const ka =
                        kaliteDurumuDegeri(a) === "Düzeltme Gerekli"
                            ? 0
                            : kaliteDurumuDegeri(a) === "Bekliyor"
                                ? 1
                                : 2;

                    const kb =
                        kaliteDurumuDegeri(b) === "Düzeltme Gerekli"
                            ? 0
                            : kaliteDurumuDegeri(b) === "Bekliyor"
                                ? 1
                                : 2;

                    return ka - kb ||
                        Number(b.id || 0) -
                        Number(a.id || 0);
                });
        }

