        function topluDosyaKlasorSecildi(liste){
            const dosyalar=Array.from(liste||[]);
            const gruplar=new Map();
            dosyalar.forEach(f=>{
                const yol=(f.webkitRelativePath||f.name).replace(/\\/g,'/');
                const kes=yol.lastIndexOf('/');
                const klasor=kes>0?yol.slice(0,kes):'(seçilen dosyalar)';
                if(/^(thumbs\.db|desktop\.ini|\.ds_store)$/i.test(f.name)||f.name.startsWith('~$')) return;
                const ext=(f.name.split('.').pop()||'').toLowerCase();
                const neden=!TOPLU_UZANTILAR.includes(ext)?'desteklenmeyen tür':(f.size<=0?'boş dosya':(f.size>TOPLU_MAX_BOYUT?'250 MB üstü':''));
                if(!gruplar.has(klasor)) gruplar.set(klasor,[]);
                gruplar.get(klasor).push({ dosya:f, yol, tur:topluTurTahmin(yol), neden, durum:'' });
            });
            topluGruplar=Array.from(gruplar.entries()).sort((a,b)=>a[0].localeCompare(b[0],'tr')).map(function([klasor,list]){
                const e=topluEslestir(klasor, list.map(x=>x.dosya.name));
                return { klasor, dosyalar:list, adaylar:e.adaylar, secilen:e.secilen, not:e.not, durum:'' };
            });
            topluDosyaCiz();
        }

        function topluDosyaCiz(){
            const govde=document.getElementById('topluDosyaGovde');
            if(!topluGruplar.length){ govde.innerHTML='<tr><td colspan="5" class="empty">Henüz klasör seçilmedi.</td></tr>'; topluOzetGuncelle(); return; }
            govde.innerHTML=topluGruplar.map(function(g,i){
                const uygun=g.dosyalar.filter(x=>!x.neden);
                const boyut=uygun.reduce((t,x)=>t+x.dosya.size,0);
                const atla=g.dosyalar.length-uygun.length;
                const turler={}; uygun.forEach(x=>{turler[x.tur]=(turler[x.tur]||0)+1;});
                const secenek=['<option value="0">— Yükleme —</option>']
                    .concat(g.adaylar.map(x=>'<option value="'+Number(x.id)+'">'+escapeHtml(topluIsEtiketi(x))+'</option>'));
                if(g.secilen && !g.adaylar.some(x=>Number(x.id)===g.secilen)){
                    const x=(anayasaIsler||[]).find(y=>Number(y.id)===g.secilen);
                    if(x) secenek.push('<option value="'+Number(x.id)+'">'+escapeHtml(topluIsEtiketi(x))+'</option>');
                }
                secenek.push('<option value="elle">Başka iş numarası…</option>');
                return '<tr>'
                    +'<td style="max-width:280px;word-break:break-all;font-size:12px;">'+escapeHtml(g.klasor)+'</td>'
                    +'<td style="font-size:12px;white-space:nowrap;">'+uygun.length+' dosya · '+(boyut/1048576).toFixed(1)+' MB'+(atla?'<br><span style="color:#b45309">'+atla+' atlanacak</span>':'')+'</td>'
                    +'<td><select data-grup="'+i+'" onchange="topluIsSecildi('+i+',this)" '+(topluYukleniyor?'disabled':'')+' style="width:100%">'+secenek.join('')+'</select>'
                    +(g.not?'<div style="font-size:11px;margin-top:3px;color:'+(g.secilen?'#64748b':'#b91c1c')+'">'+escapeHtml(g.not)+'</div>':'')+'</td>'
                    +'<td style="font-size:12px;white-space:nowrap;">'+(Object.keys(turler).map(t=>(t==='Diger'?'Diğer':t)+' '+turler[t]).join('<br>')||'-')+'</td>'
                    +'<td style="font-size:12px;" id="topluDurum'+i+'">'+(g.durum||'')+'</td>'
                    +'</tr>';
            }).join('');
            govde.querySelectorAll('select[data-grup]').forEach(s=>{ s.value=String(topluGruplar[Number(s.dataset.grup)].secilen||0); });
            topluOzetGuncelle();
        }

        function topluIsSecildi(i,sel){
            const g=topluGruplar[i]; if(!g) return;
            if(sel.value==='elle'){
                const v=prompt('İş numarasını yazın (ör. 125):');
                const no=Number(String(v||'').replace(/[^0-9]/g,''));
                const is=(anayasaIsler||[]).find(x=>Number(x.id)===no && !x.silindi);
                if(v!==null && !is) showError('#'+(no||v)+' numaralı iş bulunamadı.');
                if(is){ g.secilen=no; g.not='Elle seçildi'; }
                topluDosyaCiz(); return;
            }
            g.secilen=Number(sel.value)||0;
            g.not=g.secilen?'':'Yüklenmeyecek';
            topluOzetGuncelle();
        }

        function topluOzetGuncelle(){
            const secili=topluGruplar.filter(g=>g.secilen);
            const n=secili.reduce((t,g)=>t+g.dosyalar.filter(x=>!x.neden).length,0);
            const eslesmeyen=topluGruplar.filter(g=>!g.secilen).length;
            const oz=document.getElementById('topluDosyaOzet');
            if(oz) oz.innerText=topluGruplar.length?(topluGruplar.length+' klasör · '+n+' dosya yüklenecek'+(eslesmeyen?' · '+eslesmeyen+' klasör eşleşmedi/atlanacak':'')):'';
            const b=document.getElementById('topluDosyaYukleBtn');
            if(b){ b.disabled=topluYukleniyor||n===0; b.innerText=topluYukleniyor?'Yükleniyor...':(n?n+' Dosyayı Yükle':'Yükle'); }
        }

        async function topluDosyaYukle(){
            const isler=topluGruplar.filter(g=>g.secilen);
            const toplamDosya=isler.reduce((t,g)=>t+g.dosyalar.filter(x=>!x.neden).length,0);
            if(!toplamDosya||topluYukleniyor) return;
            if(!confirm(toplamDosya+' dosya '+new Set(isler.map(g=>g.secilen)).size+' işe yüklenecek. Devam edilsin mi?')) return;
            topluYukleniyor=true; topluDosyaCiz();
            const ilerleme=document.getElementById('topluDosyaIlerleme'), cubuk=document.getElementById('topluDosyaCubuk'), metin=document.getElementById('topluDosyaIlerlemeMetin');
            ilerleme.style.display='block';
            const mevcut=new Map(); let yuklenen=0, atlanan=0, hatali=0, sira=0;
            for(let i=0;i<topluGruplar.length && topluYukleniyor;i++){
                const g=topluGruplar[i]; if(!g.secilen) continue;
                const hucre=()=>document.getElementById('topluDurum'+i);
                let gy=0, ga=0, gh=0, sonHata='';
                if(!mevcut.has(g.secilen)){
                    try{ const r=await fetch('/api/is-dosyalari/siparis/'+g.secilen,{cache:'no-store'}); mevcut.set(g.secilen, r.ok?(await r.json()):[]); }catch{ mevcut.set(g.secilen,[]); }
                }
                const varolan=mevcut.get(g.secilen);
                for(const x of g.dosyalar){
                    if(!topluYukleniyor) break;
                    if(x.neden) continue;
                    sira++;
                    metin.innerText=sira+' / '+toplamDosya+' · '+x.yol;
                    cubuk.style.width=Math.round(sira*100/toplamDosya)+'%';
                    if(varolan.some(v=>(v.orijinalDosyaAdi||v.OrijinalDosyaAdi)===x.dosya.name && Number(v.boyut??v.Boyut)===x.dosya.size)){ ga++; atlanan++; continue; }
                    const fd=new FormData(); fd.append('dosya',x.dosya,x.dosya.name); fd.append('dosyaTuru',x.tur);
                    try{
                        const r=await fetch('/api/is-dosyalari/siparis/'+g.secilen,{method:'POST',body:fd});
                        if(!r.ok) throw new Error((await r.text())||('HTTP '+r.status));
                        const kayit=await r.json(); varolan.push(kayit); gy++; yuklenen++;
                    }catch(e){ gh++; hatali++; sonHata=e.message||String(e); }
                    if(hucre()) hucre().innerHTML='⏳ '+gy+' yüklendi';
                }
                g.durum=(gy?'<span style="color:#15803d">✓ '+gy+' yüklendi</span>':'')+(ga?'<br><span style="color:#64748b">'+ga+' zaten vardı</span>':'')+(gh?'<br><span style="color:#b91c1c" title="'+escapeHtml(sonHata)+'">✗ '+gh+' hata: '+escapeHtml(sonHata.slice(0,80))+'</span>':'');
                if(hucre()) hucre().innerHTML=g.durum;
            }
            const yarim=!topluYukleniyor;
            topluYukleniyor=false;
            metin.innerText=(yarim?'Durduruldu. ':'Tamamlandı. ')+yuklenen+' dosya yüklendi'+(atlanan?', '+atlanan+' dosya zaten vardı':'')+(hatali?', '+hatali+' dosyada hata':'')+'.';
            topluDosyaCiz();
            try{ await loadAnayasaData(); }catch{}
            if(hatali) showError(hatali+' dosya yüklenemedi; Durum sütununa bakın.'); else showSuccess(yuklenen+' dosya yüklendi.');
        }

