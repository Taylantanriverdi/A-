            const oldText = button.innerText;
            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const response =
                    await fetch(
                        "/api/siparisler/" +
                        Number(id) +
                        "/uretim-kalite",
                        {
                            method: "PATCH",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                uretimAsamasi: asama,
                                kaliteKontrolDurumu: kalite,
                                kaliteKontrolNotu: not
                            })
                        }
                    );

                if (!response.ok) {
                    throw new Error(
                        (await response.text()) ||
                        "Üretim / kalite bilgisi kaydedilemedi."
                    );
                }

                await loadSiparisler();

                showSuccess(
                    "İş #" +
                    Number(id) +
                    " üretim ve kalite bilgisi güncellendi."
                );
            }
            catch (error) {
                showError(
                    error.message ||
                    "Kalite kontrol güncellenemedi."
                );
            }
            finally {
                if (document.body.contains(button)) {
                    button.disabled = false;
                    button.innerText = oldText;
                }
            }
        }

        function renderKaliteKontrol() {
            const aktif =
                siparisler.filter(function(item) {
                    return !isArsiv(item.durum);
                });

            const uretimde =
                aktif.filter(function(item) {
                    return [
                        "Tasarım",
                        "Üretim",
                        "Bitim",
                        "Kalite Kontrol",
                        "Paketleme"
                    ].includes(
                        uretimAsamasiDegeri(item)
                    );
                });

            const bekliyor =
                aktif.filter(function(item) {
                    return kaliteDurumuDegeri(item) === "Bekliyor";
                });

            const onaylandi =
                aktif.filter(function(item) {
                    return kaliteDurumuDegeri(item) === "Onaylandı";
                });

            const duzeltme =
                aktif.filter(function(item) {
                    return kaliteDurumuDegeri(item) === "Düzeltme Gerekli";
                });

            const setText = function(id, value) {
                const el = document.getElementById(id);
                if (el) el.innerText = value;
            };

            setText("qcUretimde", uretimde.length);
            setText("qcBekliyor", bekliyor.length);
            setText("qcOnaylandi", onaylandi.length);
            setText("qcDuzeltme", duzeltme.length);

            const liste =
                kaliteFiltreliListe();

            const body =
                document.getElementById("qcBody");

            if (!body) return;

            if (!liste.length) {
                body.innerHTML =
                    '<tr><td colspan="7" class="empty">Filtreye uygun aktif iş bulunmuyor.</td></tr>';
                return;
            }

            const stageOptions = function(selected) {
                return [
                    "Bekliyor",
                    "Tasarım",
                    "Üretim",
                    "Bitim",
                    "Kalite Kontrol",
                    "Paketleme"
                ].map(function(v) {
                    return '<option value="' +
                        escapeHtml(v) +
                        '"' +
                        (v === selected ? " selected" : "") +
                        '>' +
                        escapeHtml(v) +
                        '</option>';
                }).join("");
            };

            const qualityOptions = function(selected) {
                return [
                    "Bekliyor",
                    "Onaylandı",
                    "Düzeltme Gerekli"
                ].map(function(v) {
                    return '<option value="' +
                        escapeHtml(v) +
                        '"' +
                        (v === selected ? " selected" : "") +
                        '>' +
                        escapeHtml(v) +
                        '</option>';
                }).join("");
            };

            body.innerHTML =
                liste.map(function(item) {
                    const asama =
                        uretimAsamasiDegeri(item);

                    const kalite =
                        kaliteDurumuDegeri(item);

                    return `
                        <tr>
                            <td>
                                <strong>#${Number(item.id)}</strong>
                                <div style="margin-top:5px;">
                                    ${uretimAsamasiRozeti(item)}
                                    ${kaliteRozeti(item)}
                                </div>
                            </td>

                            <td>
                                ${escapeHtml(item.hastaAdi || "-")}${dosyaSimge(item.id)}
                                <div class="ops-mini">
                                    ${escapeHtml(item.hekimAdi || "-")}
                                    ${item.klinikAdi
                                        ? " • " + escapeHtml(item.klinikAdi)
                                        : ""}
                                </div>
                            </td>

                            <td>
                                ${disRengiRozeti(item)}
                                ${oncelikRozeti(item)}
                            </td>

                            <td>
                                <select class="qc-stage">
                                    ${stageOptions(asama)}
                                </select>
                            </td>

                            <td>
                                <select class="qc-status">
                                    ${qualityOptions(kalite)}
                                </select>
                            </td>

                            <td>
                                <input class="qc-note-input"
                                       type="text"
                                       maxlength="1000"
                                       value="${escapeHtml(item.kaliteKontrolNotu || "")}"
                                       placeholder="Kalite notu..." />
                            </td>

                            <td>
                                <div class="qc-inline">
                                    <button type="button"
                                            class="button button-blue"
                                            onclick="kaliteHizliKaydet(this, ${Number(item.id)})">
                                        Kaydet
                                    </button>

                                    <button type="button"
                                            class="button button-light"
                                            onclick="openIsDetayModal(${Number(item.id)})">
                                        Aç
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                })
