        }

        function kaliteRozeti(itemOrValue) {
            const value = kaliteDurumuDegeri(itemOrValue);
            const cls =
                value === "Onaylandı"
                    ? "quality-approved"
                    : value === "Düzeltme Gerekli"
                        ? "quality-fix"
                        : "quality-wait";

            return '<span class="quality-badge ' +
                cls +
                '">' +
                escapeHtml(value) +
                '</span>';
        }

        function oncelikDegeri(itemOrValue) {
            const value =
                typeof itemOrValue === "object"
                    ? String(itemOrValue?.oncelik || "Normal").trim()
                    : String(itemOrValue || "Normal").trim();

            if (value === "Çok Acil") return "Çok Acil";
            if (value === "Acil") return "Acil";
            return "Normal";
        }

        function oncelikRozeti(itemOrValue) {
            const value = oncelikDegeri(itemOrValue);
            if (value === "Normal") return "";

            const cls =
                value === "Çok Acil"
                    ? "priority-critical"
