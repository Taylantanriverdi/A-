        .tech-directory-head{padding:15px;border-bottom:1px solid #edf2f7}.tech-directory-title{font-size:15px;font-weight:900;color:var(--tech-navy);margin-bottom:10px}
        .tech-search-wrap{display:flex;align-items:center;gap:8px;border:1px solid #d7e0eb;border-radius:10px;padding:0 11px;background:#fff}.tech-search-wrap:focus-within{border-color:#93b4ff;box-shadow:0 0 0 3px #eff6ff}.tech-search-wrap input{border:0!important;outline:0!important;box-shadow:none!important;padding:10px 0!important;width:100%;font-size:13px}
        .tech-center-list{max-height:610px;overflow:auto;padding:6px}.tech-list-row{appearance:none;width:100%;display:grid;grid-template-columns:42px minmax(0,1fr) 55px;gap:10px;align-items:center;text-align:left;border:1px solid transparent;background:#fff;padding:10px;border-radius:10px;cursor:pointer;color:var(--tech-navy);margin-bottom:3px}.tech-list-row:hover{background:#f8fbff}.tech-list-row.selected{background:#eff6ff;border-color:#bfdbfe}
        .tech-avatar{width:38px;height:38px;border-radius:11px;display:grid;place-items:center;background:linear-gradient(145deg,#2563eb,#1d4ed8);color:#fff;font-weight:900;font-size:12px;box-shadow:0 4px 10px rgba(37,99,235,.16)}
        .tech-person strong,.tech-person small{display:block}.tech-person strong{font-size:13px;line-height:1.2}.tech-person small{font-size:10px;color:#16a34a;margin-top:4px;font-weight:800}.tech-person small.tech-passive{color:#94a3b8}.tech-row-numbers{text-align:right}.tech-row-numbers b{display:block;font-size:14px}.tech-row-numbers small{font-size:9px;color:var(--tech-muted)}
        .tech-stat,.tech-load,.tech-row-action{display:none}
        .tech-profile-shell{min-height:520px}.tech-profile-empty{min-height:520px;display:grid;place-items:center;text-align:center;padding:30px;color:var(--tech-muted)}.tech-profile-empty strong{display:block;color:var(--tech-navy);font-size:17px;margin-bottom:5px}
        .tech-detail{margin:0;border:0;border-radius:0;background:#fff;overflow:hidden}.tech-detail-hero{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;background:#fff;color:var(--tech-navy);border-bottom:1px solid #edf2f7}.tech-detail-hero .page-subtitle{color:var(--tech-muted)}.tech-detail-name{font-size:22px;font-weight:900}.tech-detail-identity{display:flex;align-items:center;gap:13px}.tech-detail-avatar{width:54px;height:54px;border-radius:15px;display:grid;place-items:center;background:linear-gradient(145deg,#2563eb,#1d4ed8);color:#fff;font-size:17px;font-weight:900}.tech-status-pill{display:inline-flex;align-items:center;gap:5px;padding:4px 8px;border-radius:999px;background:#dcfce7;color:#15803d;font-size:10px;font-weight:900;margin-top:5px}.tech-status-pill.passive{background:#f1f5f9;color:#64748b}
        .tech-detail-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:15px 18px;background:#f8fafc;border-bottom:1px solid #edf2f7}.tech-detail-kpis>div{background:#fff;border:1px solid #e5eaf1;border-radius:11px;padding:11px 13px}.tech-detail-kpis span{font-size:10px;color:var(--tech-muted);font-weight:800;text-transform:uppercase;letter-spacing:.03em}.tech-detail-kpis b{display:block;font-size:20px;margin-top:3px;color:var(--tech-navy)}
        .tech-detail-title{padding:15px 18px 9px;font-weight:900;color:var(--tech-navy);font-size:14px}.tech-detail .table-wrap{padding:0 18px 18px}.tech-detail table{border:1px solid #e8edf3;border-radius:10px;overflow:hidden}.tech-detail th{background:#f8fafc;font-size:10px;text-transform:uppercase;letter-spacing:.03em}.tech-detail td{font-size:12px}
        .tech-manage-shell{margin-top:14px}.tech-manage-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;border:0;background:#fff;padding:14px 16px;cursor:pointer;text-align:left}.tech-manage-toggle strong{font-size:14px;color:var(--tech-navy)}.tech-manage-toggle span{font-size:11px;color:var(--tech-muted);display:block;margin-top:3px}.tech-manage-body{display:none;border-top:1px solid #edf2f7;padding:15px}.tech-manage-shell.open .tech-manage-body{display:block}.tech-manage-shell.open .tech-manage-chevron{transform:rotate(180deg)}.tech-manage-chevron{transition:.2s;color:#64748b}
        .technician-settings-grid{display:grid;grid-template-columns:300px minmax(0,1fr);gap:15px}.technician-add-box{background:#f8fafc;border:1px solid #e5eaf1;border-radius:11px;padding:13px}.technician-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.technician-row{border:1px solid #e5eaf1;border-radius:10px;padding:10px 12px;background:#fff}.technician-row.editable-row:hover{background:#f8fbff;border-color:#bfdbfe}
        @@media(max-width:1100px){.tech-kpi-grid{grid-template-columns:repeat(2,1fr)}.tech-workspace{grid-template-columns:290px minmax(0,1fr)}.technician-settings-grid{grid-template-columns:1fr}.technician-list{grid-template-columns:1fr}}
        @@media(max-width:820px){.tech-workspace{grid-template-columns:1fr}.tech-center-list{max-height:330px}.tech-detail-kpis{grid-template-columns:1fr}.tech-page-head{flex-direction:column}.tech-head-actions{width:100%}}
            .ph-ozet{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:14px}
