        let cariOzetListe = [];
        let cariSeciliHekimId = 0;
        let cariDetayData = null;
        let cariAktifTab = "isler";

        function cariPara(v,c){
            return paraBirimiFormat(Number(v||0), c || "TRY");
        }

        function cariMoneyStack(map, balanceMode=false){
            const m=map||{};
            const rows=["TRY","EUR","USD"]
                .filter(c=>Math.abs(Number(m[c]||0))>0.0001)
                .map(c=>{
                    const value=Number(m[c]||0);
                    const cls=balanceMode?(value>0?"money-negative":value<0?"money-positive":""):"";
                    return `<span class="${cls}">${cariPara(value,c)}</span>`;
                });
            return rows.length?`<div class="money-stack">${rows.join("")}</div>`:'<span class="muted">0</span>';
        }

        async function loadCariArsiv(){
            const q=new URLSearchParams();
            const b=document.getElementById("cariArsivBaslangic")?.value;
            const e=document.getElementById("cariArsivBitis")?.value;
            if(b)q.set("baslangic",b);
            if(e)q.set("bitis",e);
            const r=await fetch("/api/cari/ozet?"+q.toString(),{cache:"no-store"});
            if(!r.ok) return showError((await r.text())||"Cari hesaplar yüklenemedi.");
            cariOzetListe=await r.json();
            renderCariOzet();
        }

        function renderCariOzet(){
            const body=document.getElementById("cariOzetBody"); if(!body)return;
            const q=String(document.getElementById("cariHekimAra")?.value||"").toLocaleLowerCase("tr-TR");
            const list=cariOzetListe.filter(x=>[x.hekimAdi,x.klinikAdi].some(v=>String(v||"").toLocaleLowerCase("tr-TR").includes(q)));
            if(!list.length){body.innerHTML='<tr><td colspan="5" class="empty">Cari hareket bulunamadı.</td></tr>';return;}
            body.innerHTML=list.map(x=>`<tr onclick="cariDetayAc(${Number(x.hekimId)})">
                <td><strong>${escapeHtml(x.hekimAdi||"-")}</strong>${x.klinikAdi&&x.klinikAdi!==x.hekimAdi?`<div class="ops-mini">${escapeHtml(x.klinikAdi)}</div>`:""}</td>
                <td>${Number(x.toplamIs||0)}</td>
                <td>${cariMoneyStack(x.tahsilatlar)}</td>
                <td>${cariMoneyStack(x.kalanBakiye,true)}</td>
                <td>${x.eskiDonemSayisi?`${Number(x.eskiDonemSayisi)} arşiv dönem`:"Aktif dönem"}</td>
            </tr>`).join("");
        }

        function cariFiltreTemizle(){
            document.getElementById("cariArsivBaslangic").value="";
            document.getElementById("cariArsivBitis").value="";
            loadCariArsiv();
        }

        async function cariDetayAc(hekimId){
            cariSeciliHekimId=Number(hekimId);
            cariAktifTab="isler";
            document.getElementById("cariDetayBas").value="";
            document.getElementById("cariDetayBit").value="";
            document.getElementById("cariDetayV2Modal").style.display="flex";
            await cariDetayYukle();
        }

        function cariDetayKapat(){document.getElementById("cariDetayV2Modal").style.display="none";}

        async function cariDetayYukle(){
            if(!cariSeciliHekimId)return;
            const q=new URLSearchParams();
            const b=document.getElementById("cariDetayBas")?.value;
            const e=document.getElementById("cariDetayBit")?.value;
            if(b)q.set("baslangic",b);if(e)q.set("bitis",e);
            const r=await fetch(`/api/cari/${cariSeciliHekimId}/detay?${q.toString()}`,{cache:"no-store"});
            if(!r.ok)return showError((await r.text())||"Cari detay alınamadı.");
            cariDetayData=await r.json();
            document.getElementById("cariDetayV2Baslik").innerText=cariDetayData.hekim.adSoyad||"Cari Hesap";
            document.getElementById("cariDetayV2Alt").innerText=cariDetayData.hekim.klinikAdi||"Cari hesap detayı";
            renderCariDetayV2();
        }

        function cariDetayFiltreTemizle(){
            document.getElementById("cariDetayBas").value="";
            document.getElementById("cariDetayBit").value="";
            cariDetayYukle();
        }

        function cariTab(tab){
            cariAktifTab=tab;
            ["isler","odemeler","donemler"].forEach(x=>{
                document.getElementById("cariTab"+(x==="isler"?"Isler":x==="odemeler"?"Odemeler":"Donemler")).classList.toggle("active",x===tab);
                document.getElementById("cariPane"+(x==="isler"?"Isler":x==="odemeler"?"Odemeler":"Donemler")).style.display=x===tab?"block":"none";
            });
        }

        function renderCariDetayV2(){
            const d=cariDetayData;if(!d)return;
            const note=document.getElementById("cariEskiDonemNotu");
            const activePeriods=(d.donemler||[]).filter(x=>!x.geriAlindi);
            note.innerHTML=activePeriods.length?`<div class="cari-period-note"><span>ℹ️ Bu hekimin ${activePeriods.length} kapatılmış eski dönemi var — silinmedi, arşivde duruyor.</span><button class="button button-light" onclick="cariTab('donemler')">Geçmiş Dönemleri Gör</button></div>`:"";

            document.getElementById("cariOzetChipleri").innerHTML=
                `<span class="cari-chip">Toplam: ${cariMoneyStack(d.toplamlar)}</span>`+
                `<span class="cari-chip pay">Tahsilat: ${cariMoneyStack(d.tahsilatToplamlari)}</span>`+
                `<span class="cari-chip balance">Kalan: ${cariMoneyStack(d.bakiyeler,true)}</span>`;

            const isRows=[];
            if(Object.values(d.devir||{}).some(v=>Math.abs(Number(v||0))>0.0001)){
                isRows.push(`<tr style="background:#fff9e6"><td>📋 <strong>Devreden Bakiye</strong></td><td>Önceki dönemden devir</td><td>${cariMoneyStack(d.devir,true)}</td><td>${d.donemBaslangic?tarihGoster(d.donemBaslangic):"-"}</td><td>—</td></tr>`);
            }
            (d.isler||[]).forEach(x=>isRows.push(`<tr>
                <td>${escapeHtml(x.hastaAdi||"-")}</td>
                <td>${escapeHtml(x.isTuru||"-")}</td>
                <td>${cariPara(x.tutar,x.paraBirimi)}</td>
                <td>${tarihGoster(x.teslimTarihi)}</td>
                <td>#${Number(x.id)}</td>
            </tr>`));
            document.getElementById("cariPaneIsler").innerHTML=`<div class="table-wrapper"><table><thead><tr><th>Hasta</th><th>İş</th><th>Tutar</th><th>Geliş Tarihi</th><th>Kayıt</th></tr></thead><tbody>${isRows.length?isRows.join(""):'<tr><td colspan="5" class="empty">Bu dönemde iş yok.</td></tr>'}</tbody></table></div>`;

            const pays=(d.tahsilatlar||[]);
            document.getElementById("cariPaneOdemeler").innerHTML=
                `<div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0 12px;"><div>${cariMoneyStack(d.tahsilatToplamlari)}</div><button class="button" style="background:#16a34a;color:white" onclick="cariTahsilatAc(cariSeciliHekimId)">+ Yeni Tahsilat</button></div>
                <div class="table-wrapper"><table><thead><tr><th>Tarih</th><th>Tutar</th><th>Tür</th><th>Açıklama</th><th></th></tr></thead><tbody>
                ${pays.length?pays.map(x=>`<tr><td>${tarihGoster(x.tarih)}</td><td>${cariPara(x.tutar,x.paraBirimi)}</td><td>${escapeHtml(x.odemeTuru||"-")}</td><td>${escapeHtml(x.aciklama||"-")}</td><td><button class="button" style="background:#fee2e2;color:#991b1b" onclick="cariArsivTahsilatSil(${Number(x.id)})">Sil</button></td></tr>`).join(""):'<tr><td colspan="5" class="empty">Ödeme kaydı yok.</td></tr>'}
                </tbody></table></div>`;

            const periods=d.donemler||[];
            document.getElementById("cariPaneDonemler").innerHTML=
                `<div class="table-wrapper"><table><thead><tr><th>Kapanış Tarihi</th><th>İş Sayısı</th><th>Toplam İş</th><th>Tahsilat</th><th>Kapanış Bakiyesi</th><th>Devir</th><th></th></tr></thead><tbody>
                ${periods.length?periods.map(x=>`<tr class="${x.geriAlindi?'cari-period-rolledback':''}">
                    <td>${tarihGoster(x.kapanisTarihi)}</td><td>${Number(x.isSayisi||0)}</td><td>${cariMoneyStack(x.toplamlar)}</td><td>${cariMoneyStack(x.tahsilatlar)}</td><td>${cariMoneyStack(x.bakiyeler,true)}</td><td>${x.devirEklendi?'✓ Aktarıldı':'—'}</td>
                    <td><div class="button-group">
                        <button class="button button-light" onclick="cariDonemGor(${Number(x.id)})">👁 Gör</button>
                        ${!x.geriAlindi?`<button class="button button-light" onclick="cariDonemDuzenleAc(${Number(x.id)})">✏ Düzenle</button><button class="button cari-danger-button" onclick="cariDonemGeriAl(${Number(x.id)})">↩ Geri Al</button>`:""}
                    </div></td>
                </tr>`).join(""):'<tr><td colspan="7" class="empty">Geçmiş dönem yok.</td></tr>'}
                </tbody></table></div>`;
            cariTab(cariAktifTab);
        }

        function cariTahsilatAc(hekimId){
            const sel=document.getElementById("cariTahsilatHekim");
            sel.innerHTML=hekimler.filter(h=>h.aktif!==false).map(h=>`<option value="${Number(h.id)}">${escapeHtml(h.adSoyad||h.klinikAdi||"-")}</option>`).join("");
            if(hekimId||cariSeciliHekimId)sel.value=String(hekimId||cariSeciliHekimId);
            document.getElementById("cariTahsilatTutar").value="";
            document.getElementById("cariTahsilatTarih").value=new Date().toISOString().slice(0,10);
            document.getElementById("cariTahsilatNot").value="";
            document.getElementById("cariTahsilatModal").style.display="flex";
            cariTahsilatBakiyeGuncelle();
            sel.onchange=cariTahsilatBakiyeGuncelle;
            document.getElementById("cariTahsilatPara").onchange=cariTahsilatBakiyeGuncelle;
        }

        function cariTahsilatKapat(){document.getElementById("cariTahsilatModal").style.display="none";}

        function cariTahsilatBakiyeGuncelle(){
            const id=Number(document.getElementById("cariTahsilatHekim")?.value||0);
            const c=document.getElementById("cariTahsilatPara")?.value||"TRY";
            const row=cariOzetListe.find(x=>Number(x.hekimId)===id);
            const v=Number(row?.kalanBakiye?.[c]||0);
            const box=document.getElementById("cariTahsilatBakiye");
            box.innerHTML=v>0?`Kalan Alacak (${c}): <strong>${cariPara(v,c)}</strong> <button type="button" class="button button-light" style="float:right" onclick="document.getElementById('cariTahsilatTutar').value='${v}'">Tümünü Al</button>`:`✅ ${c} biriminden açık alacak yok`;
        }

        async function cariTahsilatKaydet(e){
            e.preventDefault();
            const payload={
                hekimId:Number(document.getElementById("cariTahsilatHekim").value),
                tutar:Number(document.getElementById("cariTahsilatTutar").value),
                paraBirimi:document.getElementById("cariTahsilatPara").value,
                tarih:document.getElementById("cariTahsilatTarih").value,
                odemeTuru:document.getElementById("cariTahsilatTur").value,
                aciklama:document.getElementById("cariTahsilatNot").value||null
            };
            const r=await fetch("/api/cari/tahsilat",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
            if(!r.ok)return showError((await r.text())||"Tahsilat kaydedilemedi.");
            cariTahsilatKapat();
