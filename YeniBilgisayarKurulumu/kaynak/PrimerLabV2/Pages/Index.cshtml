        function planlamaVarsayilanTarih() {
            const input =
                document.getElementById(
                    "planlamaTarih"
                );

            if (!input || input.value) {
                return;
            }

            input.value =
                localDateInputValue(
                    new Date()
                );
        }

        function planlamaBuguneDon() {
            const input =
                document.getElementById(
                    "planlamaTarih"
                );

            if (input) {
                input.value =
                    localDateInputValue(
                        new Date()
                    );
            }

            renderPlanlama();
        }

        function planlamaFiltreSecenekleriniDoldur() {
            const tek =
                document.getElementById(
                    "planlamaTeknisyen"
                );

            if (tek) {
                const current = tek.value;

                tek.innerHTML =
                    '<option value="">Tüm Teknisyenler</option>' +
                    '<option value="unassigned">Atanmamış</option>' +
                    teknisyenler
                        .filter(function(t) {
                            return t.aktif !== false;
                        })
                        .slice()
                        .sort(function(a,b) {
                            return String(a.adSoyad || "")
                                .localeCompare(
                                    String(b.adSoyad || ""),
                                    "tr"
                                );
                        })
                        .map(function(t) {
                            return (
                                '<option value="' +
                                Number(t.id) +
                                '">' +
                                escapeHtml(t.adSoyad || "-") +
                                '</option>'
                            );
                        })
                        .join("");

                if ([...tek.options].some(function(o) {
                    return o.value === current;
                })) {
                    tek.value = current;
                }
            }

            const hek =
                document.getElementById(
                    "planlamaHekim"
                );

            if (hek) {
                const current = hek.value;

                hek.innerHTML =
                    '<option value="">Tüm Hekimler</option>' +
                    hekimler
                        .filter(function(h) {
                            return h.aktif !== false;
                        })
                        .slice()
                        .sort(function(a,b) {
                            return String(a.adSoyad || "")
                                .localeCompare(
                                    String(b.adSoyad || ""),
                                    "tr"
                                );
                        })
                        .map(function(h) {
                            return (
                                '<option value="' +
                                Number(h.id) +
                                '">' +
                                escapeHtml(h.adSoyad || "-") +
                                '</option>'
                            );
                        })
                        .join("");

                if ([...hek.options].some(function(o) {
                    return o.value === current;
                })) {
                    hek.value = current;
                }
            }
        }

        function planlamaBazTarih() {
            const value =
                document.getElementById(
                    "planlamaTarih"
                )?.value;

            if (!value) {
                const now = new Date();
                now.setHours(0,0,0,0);
                return now;
            }

            const parts =
                value.split("-")
                    .map(Number);

            const date =
                new Date(
                    parts[0],
                    parts[1] - 1,
                    parts[2]
                );

            date.setHours(0,0,0,0);
            return date;
        }

        function planlamaGunFarki(
            terminTarihi,
            bazTarih
        ) {
            if (!terminTarihi) {
                return null;
            }

            const t =
                new Date(terminTarihi);

            if (Number.isNaN(t.getTime())) {
                return null;
            }

            t.setHours(0,0,0,0);

            return Math.round(
                (t - bazTarih) /
                86400000
            );
        }

        function planlamaFiltreliAktifIsler() {
            planlamaVarsayilanTarih();

            const tek =
                document.getElementById(
                    "planlamaTeknisyen"
                )?.value || "";

            const hek =
                document.getElementById(
                    "planlamaHekim"
                )?.value || "";

            const oncelik =
                document.getElementById("planlamaOncelik")?.value || "";

            const q =
                String(
                    document.getElementById(
                        "planlamaArama"
                    )?.value || ""
                )
                .toLocaleLowerCase("tr-TR")
                .trim();

            return siparisler
                .filter(function(item) {
                    if (isArsiv(item.durum)) {
                        return false;
                    }

                    if (
                        hek &&
                        String(item.hekimId || "") !==
                        hek
                    ) {
                        return false;
                    }

                    if (
                        !isTeknisyenFiltreEslesiyor(
                            item,
                            tek
                        )
                    ) {
                        return false;
                    }

                    if (oncelik && oncelikDegeri(item) !== oncelik) {
                        return false;
                    }

                    if (q) {
                        const haystack = [
                            item.id,
                            item.hastaAdi,
                            item.hekimAdi,
                            item.klinikAdi,
                            item.disRengi,
                            item.oncelik,
                            item.uretimNotu,
                            item.uretimAsamasi,
                            item.kaliteKontrolDurumu,
                            item.kaliteKontrolNotu,
                            item.durum,
                            teknisyenAtamasi(item)
                                ?.teknisyenAdi
                        ]
                        .map(function(v) {
                            return String(v || "")
                                .toLocaleLowerCase(
                                    "tr-TR"
                                );
                        })
                        .join(" ");

                        if (!haystack.includes(q)) {
                            return false;
                        }
                    }

                    return true;
                });
        }

        function planlamaKartClass(
            item,
            fark
        ) {
            if (
                standartDurum(item.durum) ===
                "Hazır"
            ) {
                return "planning-card-ready";
            }

            if (fark !== null && fark < 0) {
                return "planning-card-late";
            }

            if (fark === 0) {
                return "planning-card-today";
            }

            return "";
        }

        function planlamaKartHtml(
            item,
            fark
        ) {
            const atama =
                teknisyenAtamasi(item);

            let terminText =
                "Termin yok";

            if (fark !== null) {
                if (fark < 0) {
                    terminText =
                        Math.abs(fark) +
                        " gün gecikti";
                }
                else if (fark === 0) {
                    terminText = "Bugün";
                }
                else if (fark === 1) {
                    terminText = "Yarın";
                }
                else {
                    terminText =
                        fark +
                        " gün kaldı";
                }
            }

            const durum =
                standartDurum(item.durum);

            let nextAction = "";

            if (durum === "Yeni") {
                nextAction = `
                    <button type="button"
                            class="button button-light"
                            onclick="event.stopPropagation(); operasyonHizliDurum(${Number(item.id)}, 'Devam Eden')">
                        Devama Al
                    </button>
                `;
            }
            else if (
                durum === "Devam Eden"
            ) {
                nextAction = `
                    <button type="button"
                            class="button button-light"
                            onclick="event.stopPropagation(); operasyonHizliDurum(${Number(item.id)}, 'Hazır')">
                        Hazır Yap
                    </button>
                `;
            }
            else if (durum === "Hazır") {
                nextAction = `
                    <button type="button"
                            class="button button-light"
                            onclick="event.stopPropagation(); operasyonHizliDurum(${Number(item.id)}, 'Teslim')">
                        Teslim Et
                    </button>
                `;
            }

            return `
                <div class="planning-card ${planlamaKartClass(item, fark)}"
                     onclick="openIsDetayModal(${Number(item.id)})">
                    <div class="planning-card-head">
                        <div>
                            <div class="planning-card-id">
                                #${Number(item.id)}
                            </div>
                            <div class="planning-card-name">
                                ${escapeHtml(item.hastaAdi || "-")}${dosyaSimge(item.id)}
                            </div>
                        </div>

                        <span class="status ${durumClass(item.durum)}">
                            ${escapeHtml(anayasaDurum(item.durum))}
                        </span>
                    </div>

                    <div class="planning-card-meta">
                        ${escapeHtml(item.hekimAdi || "-")}
                        ${item.klinikAdi
                            ? " • " + escapeHtml(item.klinikAdi)
                            : ""}
                        <br/>
                        Teknisyen:
                        ${escapeHtml(atama?.teknisyenAdi || "Atanmamış")}
                        <br/>
                        Diş Rengi:
                        ${escapeHtml(item.disRengi || "Belirtilmemiş")}
                        <br/>
                        Öncelik:
                        ${escapeHtml(oncelikDegeri(item))}
                        <br/>
                        Üretim:
                        ${escapeHtml(uretimAsamasiDegeri(item))}
                        • Kalite:
                        ${escapeHtml(kaliteDurumuDegeri(item))}
                        <br/>
                        Termin:
                        ${escapeHtml(terminText)}
                        • Adet:
                        ${Number(item.toplamAdet || 0)}
                    </div>

                    <div class="planning-card-actions"
                         onclick="event.stopPropagation()">
                        ${nextAction}

                        <button type="button"
                                class="button button-light"
                                onclick="isEmriYazdir(${Number(item.id)})">
                            İş Emri
                        </button>
                    </div>
                </div>
            `;
        }

        function planlamaListeBas(
            id,
            liste,
            bazTarih
        ) {
            const el =
                document.getElementById(id);

            if (!el) return;

            if (!liste.length) {
                el.innerHTML =
                    '<div class="planning-empty">İş bulunmuyor.</div>';
                return;
            }

            el.innerHTML =
                liste
                    .slice()
                    .sort(function(a,b) {
                        const af =
                            planlamaGunFarki(
                                a.terminTarihi,
                                bazTarih
                            );

                        const bf =
                            planlamaGunFarki(
                                b.terminTarihi,
                                bazTarih
                            );

                        if (
                            af !== null &&
                            bf !== null &&
                            af !== bf
                        ) {
                            return af - bf;
                        }

                        return Number(a.id) -
                            Number(b.id);
                    })
                    .map(function(item) {
                        return planlamaKartHtml(
                            item,
                            planlamaGunFarki(
                                item.terminTarihi,
                                bazTarih
                            )
                        );
                    })
                    .join("");
        }

        function planlamaHizliFiltre(type) {
            const tek =
                document.getElementById(
                    "planlamaTeknisyen"
                );

            if (
                type === "unassigned" &&
                tek
            ) {
                tek.value = "unassigned";
            }

            if (type === "today") {
                planlamaBuguneDon();
                return;
            }

            if (type === "urgent") {
                const p = document.getElementById("planlamaOncelik");
                if (p) p.value = "Acil";
            }

            renderPlanlama();
        }

        function renderPlanlama() {
            planlamaFiltreSecenekleriniDoldur();
            planlamaVarsayilanTarih();

            const bazTarih =
                planlamaBazTarih();

            const aktif =
                planlamaFiltreliAktifIsler();

            const geciken =
                aktif.filter(function(item) {
                    const fark =
                        planlamaGunFarki(
                            item.terminTarihi,
                            bazTarih
                        );

                    return fark !== null &&
                        fark < 0;
                });

            const bugun =
                aktif.filter(function(item) {
                    return planlamaGunFarki(
                        item.terminTarihi,
                        bazTarih
                    ) === 0;
                });

            const yaklasan =
                aktif.filter(function(item) {
                    const fark =
                        planlamaGunFarki(
                            item.terminTarihi,
                            bazTarih
                        );

                    return fark !== null &&
                        fark >= 1 &&
                        fark <= 3;
                });

            const terminYok =
                aktif.filter(function(item) {
                    return !item.terminTarihi;
                });

            const atanmamis =
                aktif.filter(function(item) {
                    const a =
                        teknisyenAtamasi(item);

                    return !a ||
                        !a.teknisyenId;
                });

            const hazir =
                aktif.filter(function(item) {
                    return standartDurum(
                        item.durum
                    ) === "Hazır";
                });

            const acil =
                aktif.filter(function(item) {
                    const p = oncelikDegeri(item);
                    return p === "Acil" || p === "Çok Acil";
                });

            const yarin =
                aktif.filter(function(item) {
                    return planlamaGunFarki(
                        item.terminTarihi,
                        bazTarih
                    ) === 1;
                });

            const setText = function(id, value) {
                const el =
                    document.getElementById(id);

                if (el) {
                    el.innerText = value;
                }
            };

            setText(
                "planlamaGeciken",
                geciken.length
            );

            setText(
                "planlamaBugun",
                bugun.length
            );

            setText(
                "planlamaYarin",
                yarin.length
            );

            setText(
                "planlamaAtanmamis",
                atanmamis.length
            );

            setText(
                "planlamaHazir",
                hazir.length
            );

            setText(
                "planlamaAcil",
                acil.length
            );

            setText(
                "planLateCount",
                geciken.length
            );

            setText(
                "planTodayCount",
                bugun.length
            );

            setText(
                "planSoonCount",
                yaklasan.length
            );

            setText(
                "planNoTermCount",
                terminYok.length
            );

            planlamaListeBas(
                "planLateList",
                geciken,
                bazTarih
            );

            planlamaListeBas(
                "planTodayList",
                bugun,
                bazTarih
            );

            planlamaListeBas(
                "planSoonList",
                yaklasan,
                bazTarih
            );

            planlamaListeBas(
                "planNoTermList",
                terminYok,
                bazTarih
            );

            renderPlanlamaTeknisyenYuk(
                aktif
            );

            renderPlanlamaDikkat(
                aktif,
                bazTarih
            );
        }

        function renderPlanlamaTeknisyenYuk(
            aktif
        ) {
            const el =
                document.getElementById(
                    "planTeknisyenYuk"
                );

            if (!el) return;

            const rows = [];

            const unassigned =
                aktif.filter(function(item) {
                    const a =
                        teknisyenAtamasi(item);

                    return !a ||
                        !a.teknisyenId;
                }).length;

            rows.push({
                ad: "Atanmamış",
                adet: unassigned
            });

            teknisyenler
                .filter(function(t) {
                    return t.aktif !== false;
                })
                .forEach(function(t) {
                    rows.push({
                        ad: t.adSoyad || "-",
                        adet:
                            aktif.filter(function(item) {
                                return Number(
                                    teknisyenAtamasi(item)
                                        ?.teknisyenId || 0
                                ) === Number(t.id);
                            }).length
                    });
                });

            el.innerHTML =
                rows
                    .sort(function(a,b) {
                        return b.adet - a.adet;
                    })
                    .map(function(row) {
                        return `
                            <div class="planning-alert-item">
                                <strong>${escapeHtml(row.ad)}</strong>
                                <span style="float:right;">
                                    ${row.adet} aktif iş
                                </span>
                            </div>
                        `;
                    })
                    .join("");
        }

        function renderPlanlamaDikkat(
            aktif,
            bazTarih
        ) {
            const el =
                document.getElementById(
                    "planDikkatListesi"
                );

            if (!el) return;

            const kritik =
                aktif.filter(function(item) {
                    const fark =
                        planlamaGunFarki(
                            item.terminTarihi,
                            bazTarih
                        );

                    const atama =
                        teknisyenAtamasi(item);

                    return (
                        (fark !== null && fark <= 1) ||
                        !atama ||
                        !atama.teknisyenId
                    );
                })
                .slice()
                .sort(function(a,b) {
                    const af =
                        planlamaGunFarki(
                            a.terminTarihi,
                            bazTarih
                        );

                    const bf =
                        planlamaGunFarki(
                            b.terminTarihi,
                            bazTarih
                        );

                    return (
                        (af ?? 9999) -
                        (bf ?? 9999)
                    );
                })
                .slice(0, 12);

            if (!kritik.length) {
                el.innerHTML =
                    '<div class="planning-empty">Kritik iş bulunmuyor.</div>';
                return;
            }

            el.innerHTML =
                kritik.map(function(item) {
                    const fark =
                        planlamaGunFarki(
                            item.terminTarihi,
                            bazTarih
                        );

                    const atama =
                        teknisyenAtamasi(item);

                    const neden = [];

                    if (
                        fark !== null &&
                        fark < 0
                    ) {
                        neden.push(
                            Math.abs(fark) +
                            " gün gecikmiş"
                        );
                    }
                    else if (fark === 0) {
                        neden.push(
                            "bugün termin"
                        );
                    }
                    else if (fark === 1) {
                        neden.push(
                            "yarın termin"
                        );
                    }

                    if (
                        !atama ||
                        !atama.teknisyenId
                    ) {
                        neden.push(
                            "teknisyen atanmamış"
                        );
                    }

                    return `
                        <div class="planning-alert-item"
                             onclick="openIsDetayModal(${Number(item.id)})">
                            <strong>#${Number(item.id)} — ${escapeHtml(item.hastaAdi || "-")}${dosyaSimge(item.id)}</strong>
                            <br/>
                            ${escapeHtml(neden.join(" • ") || "Kontrol et")}
                        </div>
                    `;
                })
                .join("");
        }

        function planlamaYazdir() {
            const bazTarih =
                planlamaBazTarih();

            const liste =
                planlamaFiltreliAktifIsler()
                    .filter(function(item) {
                        const fark =
                            planlamaGunFarki(
                                item.terminTarihi,
                                bazTarih
                            );

                        return (
                            fark === null ||
                            fark <= 3
                        );
                    })
                    .slice()
                    .sort(function(a,b) {
                        const af =
                            planlamaGunFarki(
                                a.terminTarihi,
                                bazTarih
                            );

                        const bf =
                            planlamaGunFarki(
                                b.terminTarihi,
                                bazTarih
                            );

                        return (
                            (af ?? 9999) -
                            (bf ?? 9999)
                        );
                    });

