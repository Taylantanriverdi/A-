        function renderUretimPanosu() {
            const atanmamisSayisi =
                siparisler.filter(function(item) {
                    if (isArsiv(item.durum)) {
                        return false;
                    }

                    const atama =
                        teknisyenAtamasi(item);

                    return !atama ||
                        !atama.teknisyenId;
                }).length;

            const atanmamisEl =
                document.getElementById(
                    "atanmamisAktifSayisi"
                );

            if (atanmamisEl) {
                atanmamisEl.innerText =
                    atanmamisSayisi;
            }

            const teknisyenFiltre =
                document.getElementById(
                    "kanbanTechnician"
                )?.value || "";

            const aktif = siparisler.filter(function(item) {
                return !isArsiv(item.durum) &&
                    isTeknisyenFiltreEslesiyor(
                        item,
                        teknisyenFiltre
                    );
            });

            const gruplar = {
                "Yeni": [],
                "Devam Eden": [],
                "Hazır": []
            };

            aktif.forEach(function(item) {
                const durum = standartDurum(item.durum);

                if (gruplar[durum]) {
                    gruplar[durum].push(item);
                }
            });

            Object.keys(gruplar).forEach(function(durum) {
                gruplar[durum].sort(function(a,b) {
                    const ta = a.terminTarihi
                        ? new Date(a.terminTarihi).getTime()
                        : Number.MAX_SAFE_INTEGER;

                    const tb = b.terminTarihi
                        ? new Date(b.terminTarihi).getTime()
                        : Number.MAX_SAFE_INTEGER;

                    return ta - tb || Number(b.id || 0) - Number(a.id || 0);
                });
            });

            const countMap = {
                "Yeni": "kanbanYeniCount",
                "Devam Eden": "kanbanDevamCount",
                "Hazır": "kanbanHazirCount"
            };

            Object.entries(gruplar).forEach(function(entry) {
                const durum = entry[0];
                const liste = entry[1];
                const id = kanbanListeId(durum);
                const container = document.getElementById(id);
                const count = document.getElementById(countMap[durum]);

                if (count) count.innerText = liste.length;
                if (!container) return;

                if (!liste.length) {
                    container.innerHTML = `
                        <div class="kanban-empty">
                            Bu aşamada iş yok.
                        </div>
                    `;
                    return;
                }

                container.innerHTML =
                    liste.map(kanbanCardHtml).join("");
            });
        }

        function kanbanKartTikla(event, id) {
            if (
                event.target.closest("button") ||
                event.target.closest("a")
            ) {
                return;
            }

            openIsDetayModal(id);
        }

        function kanbanDragStart(event, id) {
            kanbanSuruklenenIsId = Number(id || 0);

            try {
                event.dataTransfer.effectAllowed = "move";
                event.dataTransfer.setData(
                    "text/plain",
                    String(kanbanSuruklenenIsId)
                );
            } catch {}
        }

        function kanbanDragEnd() {
            kanbanSuruklenenIsId = 0;

            document
                .querySelectorAll(".kanban-column")
                .forEach(function(col) {
                    col.classList.remove("kanban-drag-over");
                });
        }

        function kanbanDragOver(event) {
            event.preventDefault();

            const col = event.currentTarget;

            document
                .querySelectorAll(".kanban-column")
                .forEach(function(item) {
                    item.classList.remove("kanban-drag-over");
                });

            if (col) {
                col.classList.add("kanban-drag-over");
            }
        }

        async function kanbanDrop(event, yeniDurum) {
            event.preventDefault();

            const id =
                Number(
                    event.dataTransfer?.getData("text/plain") ||
                    kanbanSuruklenenIsId ||
                    0
                );

            kanbanDragEnd();

            if (!id || !yeniDurum) {
                return;
            }

            const item =
                siparisler.find(function(x) {
                    return Number(x.id) === id;
                });

            if (!item) {
                return;
            }

            const mevcut =
                standartDurum(item.durum);

            if (mevcut === yeniDurum) {
                return;
            }

            await kanbanDurumDegistir(
                id,
                yeniDurum,
                false
            );
        }

        async function kanbanHizliDurum(
            event,
            id,
            yeniDurum
        ) {
            event.stopPropagation();

            if (yeniDurum === "Teslim") {
                const item =
                    siparisler.find(function(x) {
                        return Number(x.id) === Number(id);
                    });

                const onay =
                    confirm(
                        "#" +
                        id +
                        " numaralı " +
                        (item?.hastaAdi || "") +
                        " işini teslim etmek istediğine emin misin?"
                    );

                if (!onay) {
                    return;
                }
            }

            await kanbanDurumDegistir(
                id,
                yeniDurum,
                true
            );
        }

        async function kanbanDurumDegistir(
            id,
            yeniDurum,
            butondan
        ) {
            try {
                const response =
                    await fetch(
                        "/api/siparisler/" +
                        Number(id) +
                        "/durum",
                        {
                            method: "PATCH",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                durum: yeniDurum
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "İş durumu değiştirilemedi."
                    );
                }

                await loadSiparisler();
                renderUretimPanosu();

                if (yeniDurum === "Teslim") {
                    showSuccess(
                        "İş teslim edildi ve Arşiv'e taşındı."
                    );
                }
                else {
                    showSuccess(
                        "İş '" +
                        yeniDurum +
                        "' aşamasına taşındı."
                    );
                }
            }
            catch (error) {
                showError(
                    error.message ||
                    "Üretim panosu güncellenemedi."
                );

                renderUretimPanosu();
            }
        }


        function teknisyenFiltreSecenekleriniDoldur() {
            const targets = [
                "incomingTechnician",
                "progressTechnician",
                "kanbanTechnician"
            ];

            targets.forEach(function(id) {
                const el = document.getElementById(id);
                if (!el) return;

                const current = el.value;

                el.innerHTML =
                    '<option value="">Tüm Teknisyenler</option>' +
                    '<option value="unassigned">Atanmamış</option>' +
                    teknisyenler
                        .filter(function(t) {
                            return t.aktif !== false;
                        })
                        .sort(function(a,b) {
                            return String(a.adSoyad || "").localeCompare(
                                String(b.adSoyad || ""),
                                "tr"
                            );
                        })
                        .map(function(t) {
                            return (
                                '<option value="' +
                                Number(t.id) +
                                '">' +
                                escapeHtml(t.adSoyad || "-") +
                                '</option>'
                            );
                        })
                        .join("");

                if ([...el.options].some(function(o) {
                    return o.value === current;
                })) {
                    el.value = current;
                }
            });
        }

        function isTeknisyenFiltreEslesiyor(item, filterValue) {
            const filter = String(filterValue || "");
            if (!filter) return true;

            const atama = teknisyenAtamasi(item);

            if (filter === "unassigned") {
                return !atama || !atama.teknisyenId;
            }

            return Number(atama?.teknisyenId || 0) === Number(filter);
        }

        function teknisyenDashboardFiltrele(value) {
            dashboardTeknisyenFiltre = String(value || "");
            renderTeknisyenIsYuku();

            const incoming =
                document.getElementById("incomingTechnician");

            const progress =
                document.getElementById("progressTechnician");

            const kanban =
                document.getElementById("kanbanTechnician");

            [incoming, progress, kanban].forEach(function(el) {
                if (!el) return;

                if ([...el.options].some(function(o) {
                    return o.value === dashboardTeknisyenFiltre;
                })) {
                    el.value = dashboardTeknisyenFiltre;
                }
            });

            renderGelenIsler();
            renderDevamEdenler();
            renderUretimPanosu();
        }

        function renderTeknisyenIsYuku() {
            const container =
                document.getElementById("teknisyenIsYuku");

            if (!container) return;

            const aktifIsler =
                siparisler.filter(function(item) {
                    return !isArsiv(item.durum);
                });

            const kartlar = [];

            const atanmamis =
                aktifIsler.filter(function(item) {
                    const atama = teknisyenAtamasi(item);
                    return !atama || !atama.teknisyenId;
                });

            kartlar.push({
                id: "unassigned",
                adSoyad: "Atanmamış",
                liste: atanmamis,
                aktif: true
            });

            teknisyenler
                .filter(function(t) {
                    return t.aktif !== false;
                })
                .forEach(function(t) {
                    kartlar.push({
                        id: String(t.id),
                        adSoyad: t.adSoyad || "-",
                        aktif: true,
                        liste: aktifIsler.filter(function(item) {
                            const atama = teknisyenAtamasi(item);

                            return Number(atama?.teknisyenId || 0) ===
                                Number(t.id);
                        })
                    });
                });

            if (!kartlar.length) {
                container.innerHTML =
                    '<div class="tech-workload-empty">Teknisyen bulunmuyor.</div>';
                return;
            }

            container.innerHTML =
                kartlar.map(function(kart) {
                    const yeni =
                        kart.liste.filter(function(item) {
                            return standartDurum(item.durum) === "Yeni";
                        }).length;

                    const devam =
                        kart.liste.filter(function(item) {
                            return standartDurum(item.durum) === "Devam Eden";
                        }).length;

                    const hazir =
                        kart.liste.filter(function(item) {
                            return standartDurum(item.durum) === "Hazır";
                        }).length;

                    const geciken =
                        kart.liste.filter(function(item) {
                            const gun =
                                terminGunFarki(item.terminTarihi);

                            return gun !== null && gun < 0;
                        }).length;

                    const active =
                        dashboardTeknisyenFiltre === String(kart.id)
                            ? " active"
                            : "";

                    return `
                        <div class="tech-workload-card${active}"
                             onclick="teknisyenDashboardFiltrele('${escapeHtml(String(kart.id))}')">
                            <div class="tech-workload-name">
                                ${escapeHtml(kart.adSoyad)}
                            </div>

                            <div class="tech-workload-total">
                                ${kart.liste.length}
                            </div>

                            <div class="page-subtitle">
                                aktif iş
                            </div>

                            <div class="tech-workload-meta">
                                <div>
                                    Yeni
                                    <strong>${yeni}</strong>
                                </div>
                                <div>
                                    Devam
                                    <strong>${devam}</strong>
                                </div>
                                <div>
                                    Hazır
                                    <strong>${hazir}</strong>
                                </div>
                                <div>
                                    Geciken
                                    <strong>${geciken}</strong>
                                </div>
                            </div>
                        </div>
                    `;
                }).join("");
        }


        function renderDashboard() {
            const gelen = siparisler.filter(item => !item?.silindi && dashboardGelenOnayMi(item) && !isArsiv(item.durum));
            const devam = siparisler.filter(dashboardAktifOperasyonMu);
            const finansListe = devam;
            const gelenEl=document.getElementById("gelenIsSayisi"); const devamEl=document.getElementById("devamIsSayisi");
            const hekimEl=document.getElementById("hekimSayisi"); const tutarEl=document.getElementById("toplamTutar");
            if(gelenEl) gelenEl.innerText=gelen.length;
            if(devamEl) devamEl.innerText=devam.length;
            if(hekimEl) hekimEl.innerText=hekimler.filter(h=>h.aktif!==false).length;
            if(tutarEl){ tutarEl.innerText=paraBirimiToplamMetni(finansListe); tutarEl.style.fontSize=finansListe.some(x=>String(x.paraBirimi||"TRY").toUpperCase()!=="TRY")?"22px":""; }
            renderDashboardTermin(); renderTeknisyenIsYuku();
            const body=document.getElementById("dashboardIsBody"); if(!body)return;
            const liste=devam.slice().sort((a,b)=>Number(b.id||0)-Number(a.id||0)).slice(0,10);
            if(!liste.length){body.innerHTML='<tr><td colspan="9" class="empty">Henüz aktif iş bulunmuyor.</td></tr>';return;}
            body.innerHTML=liste.map(createWorkRow).join("");
        }

        function normalizeWorkSearch(value){return String(value??"").toLocaleLowerCase("tr-TR").trim();}
        function workMatchesSearch(item,query){
            const q=normalizeWorkSearch(query); if(!q)return true;
            return [item.id,item.hekimAdi,item.klinikAdi,item.hastaAdi,item.durum,...(item.kalemler||[]).map(k=>k.isTuru)]
                .map(normalizeWorkSearch).join(" ").includes(q);
        }
        function filterWorkList(items,prefix){
            const q=document.getElementById(prefix+"Search")?.value??"";
            const d=document.getElementById(prefix+"Doctor")?.value??"";
            const t=document.getElementById(prefix+"Technician")?.value??"";

            return items.filter(function(x){
                return workMatchesSearch(x,q) &&
                    (!d || String(x.hekimId??"")===d) &&
                    isTeknisyenFiltreEslesiyor(x,t);
            });
        }
        function fillWorkDoctorFilter(id){
            const s=document.getElementById(id); if(!s)return; const cur=s.value;
            s.innerHTML='<option value="">Tüm Hekimler</option>'+hekimler.filter(h=>h.aktif!==false)
                .map(h=>`<option value="${Number(h.id)}">${escapeHtml(h.adSoyad??"-")}${h.klinikAdi?" - "+escapeHtml(h.klinikAdi):""}</option>`).join("");
            if([...s.options].some(o=>o.value===cur))s.value=cur;
        }
        function clearWorkFilters(prefix){
            const q=document.getElementById(prefix+"Search"); if(q)q.value="";
            const d=document.getElementById(prefix+"Doctor"); if(d)d.value="";
            const t=document.getElementById(prefix+"Technician"); if(t)t.value="";
            if(prefix==="incoming")renderGelenIsler();
            if(prefix==="progress")renderDevamEdenler();
        }

        function renderGelenIsler() {
            fillWorkDoctorFilter("incomingDoctor");
            const tumListe=siparisler.filter(function(item){return isGelenIs(item.durum);});
            const liste=filterWorkList(tumListe,"incoming").slice().sort(function(a,b){
                const ta=a.terminTarihi?new Date(a.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                const tb=b.terminTarihi?new Date(b.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                return ta-tb || Number(b.id||0)-Number(a.id||0);
            });
            const fc=document.getElementById("incomingFilterCount");
            if(fc)fc.innerText=`${liste.length} / ${tumListe.length} iş gösteriliyor`;

            const body = document.getElementById("gelenIsBody");

            if (!body) {
                return;
            }

            if (!liste.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty">
                            Gelen yeni iş bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML = liste.map(createWorkRow).join("");
        }

        function renderDevamEdenler() {
            fillWorkDoctorFilter("progressDoctor");
            const tumListe=siparisler.filter(function(item){return isDevamEden(item.durum);});
            const liste=filterWorkList(tumListe,"progress").slice().sort(function(a,b){
                const ta=a.terminTarihi?new Date(a.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                const tb=b.terminTarihi?new Date(b.terminTarihi).getTime():Number.MAX_SAFE_INTEGER;
                return ta-tb || Number(b.id||0)-Number(a.id||0);
            });
            const fc=document.getElementById("progressFilterCount");
            if(fc)fc.innerText=`${liste.length} / ${tumListe.length} iş gösteriliyor`;

            const body = document.getElementById("devamIsBody");

            if (!body) {
                return;
            }

            if (!liste.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="9" class="empty">
                            Devam eden iş bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML = liste.map(createWorkRow).join("");
        }

        function renderArsiv() {
            const tumArsiv = siparisler.filter(function (item) {
                return isArsiv(item.durum);
            });

            const teslimler = tumArsiv.filter(function (item) {
                return standartDurum(item.durum) === "Teslim";
            });

            const iptaller = tumArsiv.filter(function (item) {
                return standartDurum(item.durum) === "İptal";
            });

            const teslimSayisi =
                document.getElementById("arsivTeslimSayisi");

            const iptalSayisi =
                document.getElementById("arsivIptalSayisi");

            const teslimTutari =
                document.getElementById("arsivTeslimTutari");

            if (teslimSayisi) {
                teslimSayisi.innerText =
                    teslimler.length;
            }

            if (iptalSayisi) {
                iptalSayisi.innerText =
                    iptaller.length;
            }

            if (teslimTutari) {
                teslimTutari.innerText =
                    para(
                        toplamTutarHesapla(
                            teslimler
                        )
                    );
            }

            const hekimSelect =
                document.getElementById(
                    "arsivHekimFiltre"
                );

            if (hekimSelect) {
                const eskiDeger =
                    hekimSelect.value;

                const arsivHekimler =
                    Array.from(
                        new Map(
                            tumArsiv
                                .filter(function (item) {
                                    return item.hekimId != null;
                                })
                                .map(function (item) {
                                    return [
                                        String(item.hekimId),
                                        {
                                            id: String(item.hekimId),
                                            ad:
                                                item.hekimAdi ||
                                                "-"
                                        }
                                    ];
                                })
                        ).values()
                    )
                    .sort(function (a, b) {
                        return a.ad.localeCompare(
                            b.ad,
                            "tr"
                        );
                    });

                hekimSelect.innerHTML =
                    '<option value="">Tüm Hekimler</option>' +
                    arsivHekimler
                        .map(function (h) {
                            return (
                                '<option value="' +
                                escapeHtml(h.id) +
                                '">' +
                                escapeHtml(h.ad) +
                                '</option>'
                            );
                        })
                        .join("");

                hekimSelect.value =
                    eskiDeger;
            }

            const durumFiltre =
                document.getElementById(
                    "arsivDurumFiltre"
                )?.value || "tum";

            const hekimFiltre =
                document.getElementById(
                    "arsivHekimFiltre"
                )?.value || "";

            let liste = tumArsiv.filter(function (item) {
                const durum =
                    standartDurum(item.durum);

                if (
                    durumFiltre === "teslim" &&
                    durum !== "Teslim"
                ) {
                    return false;
                }

                if (
                    durumFiltre === "iptal" &&
                    durum !== "İptal"
                ) {
                    return false;
                }

                if (
                    hekimFiltre &&
                    String(item.hekimId) !==
                        hekimFiltre
                ) {
                    return false;
                }

                return true;
            });

            liste = liste
                .slice()
                .sort(function (a, b) {
                    return Number(b.id || 0) -
                        Number(a.id || 0);
                });

            const body =
                document.getElementById(
                    "arsivBody"
                );

            if (!body) {
                return;
            }

            if (!liste.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="7" class="empty">
                            Seçilen filtrelerde arşiv kaydı bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML =
                liste.map(function (item) {
                    return `
                        <tr class="work-row"
                            onclick="openIsDetayModal(${Number(item.id)})"
                            title="İş detayını aç">

                            <td>${item.id ?? "-"}</td>
                            <td>${escapeHtml(item.hekimAdi ?? "-")}</td>
                            <td>
                                ${escapeHtml(item.hastaAdi ?? "-")}${dosyaSimge(item.id)}
                                <div style="margin-top:5px;">
                            ${disRengiRozeti(item)}
                            ${oncelikRozeti(item)}
                        </div>
                            </td>
                            <td>${escapeHtml(item.klinikAdi ?? "-")}</td>

                            <td>
                                <span class="status ${durumClass(item.durum)}">
                                    ${escapeHtml(anayasaDurum(item.durum))}
                                </span>
                            </td>

                            <td>${item.olusturmaTarihi ? tarihGoster(item.olusturmaTarihi) : "-"}</td>
                            <td>${item.toplamAdet ?? 0}</td>
                            <td>${paraBirimiFormat(item.toplamTutar, item.paraBirimi)}</td>
                        </tr>
                    `;
                }).join("");
        }

