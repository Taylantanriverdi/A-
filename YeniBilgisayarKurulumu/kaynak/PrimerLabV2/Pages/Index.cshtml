        async function teslimatTekIsTeslimEt(id) {
            const item =
                siparisler.find(function(x) {
                    return Number(x.id) === Number(id);
                });

            if (!item) {
                showError("İş bulunamadı.");
                return;
            }

            if (item.durum !== "Hazır") {
                showError("Teslim edebilmek için işin durumu Hazır olmalı.");
                return;
            }

            if (
                !confirm(
                    "#" +
                    Number(id) +
                    " numaralı işi teslim etmek istediğine emin misin?"
                )
            ) {
                return;
            }

            try {
                const response =
                    await fetch(
                        "/api/siparisler/" +
                        Number(id) +
                        "/durum",
                        {
                            method: "PATCH",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                durum: "Teslim"
                            })
                        }
                    );

                if (!response.ok) {
                    throw new Error(
                        (await response.text()) ||
                        "İş teslim edilemedi."
                    );
                }

                teslimatSeciliIsler.delete(Number(id));
                await loadSiparisler();
                showSuccess("İş teslim edildi ve arşive taşındı.");
            }
            catch (error) {
                showError(error.message || "İş teslim edilemedi.");
            }
        }

        async function teslimatTopluTeslimEt() {
            const ids =
                Array.from(teslimatSeciliIsler);

            if (!ids.length) {
                showError("Önce teslim edilecek işleri seç.");
                return;
            }

            const hazirlar =
                ids
                    .map(function(id) {
                        return siparisler.find(function(x) {
                            return Number(x.id) === Number(id);
                        });
                    })
                    .filter(function(item) {
                        return item && item.durum === "Hazır";
                    });

            if (!hazirlar.length) {
                showError("Seçili işler içinde durumu Hazır olan iş yok.");
                return;
            }

            const uygunOlmayan = ids.length - hazirlar.length;

            let message =
                hazirlar.length +
                " hazır işi Teslim durumuna geçirmek istediğine emin misin?";

            if (uygunOlmayan > 0) {
                message +=
                    "\n\n" +
                    uygunOlmayan +
                    " iş Hazır olmadığı için teslim edilmeyecek.";
            }

            if (!confirm(message)) return;

            let basarili = 0;
            const hatalar = [];

            for (const item of hazirlar) {
                try {
                    const response =
                        await fetch(
                            "/api/siparisler/" +
                            Number(item.id) +
                            "/durum",
                            {
                                method: "PATCH",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify({
                                    durum: "Teslim"
                                })
                            }
                        );

                    if (!response.ok) {
                        throw new Error(
                            (await response.text()) ||
                            "Teslim edilemedi."
                        );
                    }

                    basarili++;
                    teslimatSeciliIsler.delete(Number(item.id));
                }
                catch (error) {
                    hatalar.push(
                        "#" +
                        Number(item.id) +
                        ": " +
                        (error.message || "Hata")
                    );
                }
            }

            await loadSiparisler();

            if (hatalar.length) {
                showError(
                    basarili +
                    " iş teslim edildi. " +
                    hatalar.length +
                    " işte hata oluştu: " +
                    hatalar.join(" | ")
                );
            }
            else {
                showSuccess(
                    basarili +
                    " iş toplu olarak teslim edildi ve arşive taşındı."
                );
            }
        }

