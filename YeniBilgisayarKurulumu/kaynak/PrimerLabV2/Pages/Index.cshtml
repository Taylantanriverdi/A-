        async function legacyYedekImport(){
            const input=document.getElementById("legacyRestoreFile");
            const file=input?.files?.[0];
            if(!file)return showError("Önce eski JSON yedek dosyasını seç.");

            if(!confirm(
                "Eski JSON yedeğindeki hekim, iş, ödeme, gider ve cari dönem kayıtları "+
                "mevcut veriler silinmeden sisteme eklenecek. Devam edilsin mi?"
            ))return;

            const fd=new FormData();
            fd.append("file",file);

            const box=document.getElementById("backupStatusBox");
            box.className="backup-status-box";
            box.innerText="Eski yedek analiz edilip içeri aktarılıyor...";

            try{
                const r=await fetch("/api/backup/legacy-import",{method:"POST",body:fd});
                const raw=await r.text();
                if(!r.ok)throw new Error(raw||"Eski yedek aktarılamadı.");

                box.className="backup-status-box ok";
                box.innerText="Eski yedek başarıyla aktarıldı.";
                showSuccess("Eski JSON yedeği içeri aktarıldı.");

                await Promise.all([
                    loadSiparisler(),
                    loadAnayasaData(),
                    loadTahsilatlar(),
                    loadHekimler(),
                    loadTeknisyenler(),
                    kaYenile(),
                    loadBackupStatus()
                ]);
            }catch(e){
                box.className="backup-status-box error";
                box.innerText="Eski yedek aktarım hatası: "+(e?.message||e);
                showError(e?.message||"Eski yedek aktarılamadı.");
            }
        }

        function renderMuhasebe() {
            const finansListe =
                siparisler.filter(function (item) {
                    return standartDurum(item.durum) !== "İptal";
                });

            const aktif =
                finansListe.filter(function (item) {
                    return standartDurum(item.durum) !== "Teslim";
                });

            const teslim =
                finansListe.filter(function (item) {
                    return standartDurum(item.durum) === "Teslim";
                });

            const teslimToplam =
                toplamTutarHesapla(teslim);

            const aktifToplam =
                toplamTutarHesapla(aktif);

            const tahsilatToplam =
                tahsilatlar.reduce(function (sum, item) {
                    return sum + Number(item.tutar || 0);
                }, 0);

            const bakiyeToplam =
                teslimToplam -
                tahsilatToplam;

            const aktifTutarEl =
                document.getElementById("muhasebeAktifTutar");

            const teslimTutarEl =
                document.getElementById("muhasebeTeslimTutar");

            const tahsilatEl =
                document.getElementById("muhasebeTahsilat");

            const bakiyeEl =
                document.getElementById("muhasebeBakiye");

            if (aktifTutarEl) {
                aktifTutarEl.innerText =
                    para(aktifToplam);
            }

            if (teslimTutarEl) {
                teslimTutarEl.innerText =
                    para(teslimToplam);
            }

            if (tahsilatEl) {
                tahsilatEl.innerText =
                    para(tahsilatToplam);
            }

            if (bakiyeEl) {
                bakiyeEl.innerText =
                    para(bakiyeToplam);
            }

            const gruplar = {};

            hekimler.forEach(function (h) {
                gruplar[String(h.id)] = {
                    hekimId: h.id,
                    hekimAdi: h.adSoyad || "-",
                    klinikAdi: h.klinikAdi || "-",
                    aktifIs: 0,
                    teslimIs: 0,
                    aktifTutar: 0,
                    teslimTutar: 0,
                    tahsilat: 0
                };
            });

            finansListe.forEach(function (item) {
                const id =
                    String(item.hekimId ?? "0");

                if (!gruplar[id]) {
                    gruplar[id] = {
                        hekimId: item.hekimId,
                        hekimAdi: item.hekimAdi || "-",
                        klinikAdi: item.klinikAdi || "-",
                        aktifIs: 0,
                        teslimIs: 0,
                        aktifTutar: 0,
                        teslimTutar: 0,
                        tahsilat: 0
                    };
                }

                const grup =
                    gruplar[id];

                const tutar =
                    Number(item.toplamTutar || 0);

                if (
                    standartDurum(item.durum) === "Teslim"
                ) {
                    grup.teslimIs++;
                    grup.teslimTutar += tutar;
                }
                else {
                    grup.aktifIs++;
                    grup.aktifTutar += tutar;
                }
            });

            tahsilatlar.forEach(function (item) {
                const id =
                    String(item.hekimId ?? "0");

                if (!gruplar[id]) {
                    gruplar[id] = {
                        hekimId: item.hekimId,
                        hekimAdi: item.hekimAdi || "-",
                        klinikAdi: item.klinikAdi || "-",
                        aktifIs: 0,
                        teslimIs: 0,
                        aktifTutar: 0,
                        teslimTutar: 0,
                        tahsilat: 0
                    };
                }

                gruplar[id].tahsilat +=
                    Number(item.tutar || 0);
            });

            const liste =
                Object.values(gruplar)
                    .filter(function (g) {
                        return (
                            g.aktifIs > 0 ||
                            g.teslimIs > 0 ||
                            g.tahsilat > 0
                        );
                    })
                    .sort(function (a, b) {
                        const bakiyeA =
                            a.teslimTutar -
                            a.tahsilat;

                        const bakiyeB =
                            b.teslimTutar -
                            b.tahsilat;

                        return bakiyeB - bakiyeA;
                    });

            const body =
                document.getElementById("muhasebeBody");

            if (!body) {
                return;
            }

            if (!liste.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="10" class="empty">
                            Muhasebe hareketi bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML =
                liste.map(function (item) {
                    const bakiye =
                        item.teslimTutar -
                        item.tahsilat;

                    return `
                        <tr>
                            <td>${escapeHtml(item.hekimAdi)}</td>
                            <td>${escapeHtml(item.klinikAdi)}</td>
                            <td>${item.aktifIs}</td>
                            <td>${item.teslimIs}</td>
                            <td>${para(item.aktifTutar)}</td>
                            <td>${para(item.teslimTutar)}</td>
                            <td>${para(item.tahsilat)}</td>
                            <td class="${bakiye > 0 ? "finance-negative" : "finance-positive"}">
                                ${para(bakiye)}
                            </td>
                            <td>
                                ${
                                    bakiye > 0.009
                                        ? '<span class="cari-status-badge cari-status-debt">Borçlu</span>'
                                        : bakiye < -0.009
                                            ? '<span class="cari-status-badge cari-status-credit">Alacaklı</span>'
                                            : '<span class="cari-status-badge cari-status-closed">Kapalı</span>'
                                }
                            </td>
                            <td>
                                <button type="button"
                                        class="button button-light"
                                        onclick="openCariDetayModal(${Number(item.hekimId)})">
                                    Cari Detay
                                </button>
                            </td>
                        </tr>
                    `;
                }).join("");
        }


        function renderTahsilatlar() {
            const filtre =
                document.getElementById(
                    "tahsilatHekimFiltre"
                );

            if (filtre) {
                const eskiDeger =
                    filtre.value;

                filtre.innerHTML =
                    '<option value="">Tüm Hekimler</option>' +
                    hekimler
                        .filter(function (h) {
                            return h.aktif !== false;
                        })
                        .map(function (h) {
                            return (
                                '<option value="' +
                                h.id +
                                '">' +
                                escapeHtml(h.adSoyad || "-") +
                                '</option>'
                            );
                        })
                        .join("");

                filtre.value =
                    eskiDeger;
            }

            const seciliHekim =
                filtre?.value || "";

            const liste =
                tahsilatlar
                    .filter(function (item) {
                        return (
                            !seciliHekim ||
                            String(item.hekimId) ===
                                seciliHekim
                        );
                    })
                    .slice()
                    .sort(function (a, b) {
                        const tarihFarki =
                            new Date(b.tarih).getTime() -
                            new Date(a.tarih).getTime();

                        if (tarihFarki !== 0) {
                            return tarihFarki;
                        }

                        return Number(b.id || 0) -
                            Number(a.id || 0);
                    });

            const body =
                document.getElementById("tahsilatBody");

            if (!body) {
                return;
            }

            if (!liste.length) {
                body.innerHTML = `
                    <tr>
                        <td colspan="8" class="empty">
                            Tahsilat kaydı bulunmuyor.
                        </td>
                    </tr>
                `;
                return;
            }

            body.innerHTML =
                liste.map(function (item) {
                    return `
                        <tr>
                            <td>${tarihGoster(item.tarih)}</td>
                            <td>${escapeHtml(item.hekimAdi || "-")}</td>
                            <td>${escapeHtml(item.klinikAdi || "-")}</td>
                            <td class="finance-positive">${para(item.tutar)}</td>
                            <td>${escapeHtml(item.odemeTuru || "Nakit")}</td>
                            <td>${escapeHtml(item.islemNo || "-")}</td>
                            <td>${escapeHtml(item.aciklama || "-")}</td>
                            <td>
                                <div class="button-group">
                                    <button type="button"
                                            class="button button-light"
                                            onclick="tahsilatMakbuzuYazdir(${Number(item.id)})">
                                        Makbuz
                                    </button>

                                    <button type="button"
                                            class="button button-light"
                                            onclick="tahsilatDuzenle(${Number(item.id)})">
                                        Düzenle
                                    </button>

                                    <button type="button"
                                            class="button"
                                            style="background:#fee2e2;color:#991b1b;"
                                            onclick="tahsilatSil(${Number(item.id)})">
                                        Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join("");
        }



