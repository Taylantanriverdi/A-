ke_to_production')r=await fetch('/api/anayasa/isler/'+Number(a.jobId)+'/uretime-al',{method:'PATCH'});else if(type==='send_message')r=await fetch('/api/anayasa/mesajlar/'+Number(a.jobId),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mesaj:a.message||''})});else if(type==='portal_account'){r=await fetch('/api/portal-hesaplari/'+(a.accountType==='hekim'?'hekim':'teknisyen')+'/'+Number(a.accountId)+'/durum',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({aktif:!!a.active})});if(typeof portalHesaplariYukle==='function')setTimeout(()=>portalHesaplariYukle(true),300);}else if(type==='run_backup'){r=await fetch('/api/otomatik-yedek/simdi',{method:'POST'});if(typeof otomatikYedekYukle==='function')setTimeout(otomatikYedekYukle,300);}else throw new Error('Bu AI işlemi desteklenmiyor.');if(r&&!r.ok)throw new Error((await r.text())||'İşlem başarısız.');await Promise.all([loadSiparisler(),loadAnayasaData(),loadTahsilatlar()]);primerAiAppend('bot','İşlem uygulandı: '+primerAiActionLabel(a));showSuccess('Primer AI işlemi uygulandı.');}catch(e){primerAiAppend('bot','İşlem uygulanamadı: '+(e.message||e));showError(e.message||'AI işlemi uygulanamadı.');}}


