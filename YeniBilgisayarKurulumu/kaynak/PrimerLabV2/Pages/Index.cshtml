        function closeHekimFiyatModal() {
            const modal =
                document.getElementById("hekimFiyatModal");

            if (modal) {
                modal.style.display = "none";
            }

            hekimFiyatDuzenlenenId = null;
        }


        function hekimFiyatSatiriEkle(
            isTuru = "",
            birimFiyat = null,
            paraBirimi = "TRY"
        ) {
            const container = document.getElementById("hekimFiyatSatirlari");
            container.querySelector(".empty")?.remove();
            const row = document.createElement("div");
            row.className = "price-row";
            row.style.gridTemplateColumns = "minmax(220px,1fr) 150px 100px 46px";

            const fiyatDegeri = birimFiyat === null || birimFiyat === undefined
                ? ""
                : Number(birimFiyat);
            const currency = ["TRY","EUR","USD"].includes(String(paraBirimi).toUpperCase())
                ? String(paraBirimi).toUpperCase()
                : "TRY";

            row.innerHTML = `
                <input type="text" class="doctor-price-name"
                       maxlength="200" list="hekimIsOnerileri"
                       value="${escapeHtml(isTuru)}"
                       oninput="hekimFiyatListesiniYenile()" />
                <input type="number" class="doctor-price-value"
                       min="0" step="0.01" placeholder="Fiyat"
                       value="${fiyatDegeri}" />
                <select class="doctor-price-currency">
                    <option value="TRY"${currency==='TRY'?' selected':''}>TRY ₺</option>
                    <option value="EUR"${currency==='EUR'?' selected':''}>EUR €</option>
                    <option value="USD"${currency==='USD'?' selected':''}>USD $</option>
                </select>
                <button type="button"
                        class="icon-delete-button"
                        title="Bu işi hekimin listesinden çıkar"
                        onclick="hekimFiyatSatiriSil(this)">×</button>`;

            container.appendChild(row);
            return row;
        }

        let hekimFiyatOneriler = [];

        function hekimFiyatAnahtar(value) {
            return String(value || "").trim().toLocaleLowerCase("tr-TR");
        }

        // Diğer hekimlerde kullanılan iş adları (yazarken öneri; aynı iş farklı yazılmasın).
        async function hekimIsOnerileriGetir() {
            try {
                const r = await fetch("/api/hekim-fiyatlari/is-turleri", { cache: "no-store" });
                if (!r.ok) return [];
                const d = await r.json();
                return Array.isArray(d) ? d.filter(Boolean) : [];
            } catch {
                return [];
            }
        }

        function hekimFiyatMevcutAnahtarlar() {
            const container = document.getElementById("hekimFiyatSatirlari");
            return new Set(
                Array.from(container ? container.querySelectorAll(".doctor-price-name") : [])
                    .map(function (input) { return hekimFiyatAnahtar(input.value); })
                    .filter(Boolean)
            );
        }

        // Öneri listesini, kopyalanabilecek hekim listesini ve boş liste mesajını günceller.
        function hekimFiyatListesiniYenile() {
            const container = document.getElementById("hekimFiyatSatirlari");
            const datalist = document.getElementById("hekimIsOnerileri");
            const kopya = document.getElementById("hekimFiyatKopyaKaynak");
            if (!container) return;

            const mevcut = hekimFiyatMevcutAnahtarlar();
            if (datalist) {
                datalist.innerHTML = hekimFiyatOneriler
                    .filter(function (ad) { return !mevcut.has(hekimFiyatAnahtar(ad)); })
                    .map(function (ad) { return '<option value="' + escapeHtml(ad) + '"></option>'; })
                    .join("");
            }

            if (kopya && !kopya.dataset.hekimId || (kopya && Number(kopya.dataset.hekimId) !== Number(hekimFiyatDuzenlenenId))) {
                const digerleri = hekimler
                    .filter(function (h) { return h.aktif !== false && Number(h.id) !== Number(hekimFiyatDuzenlenenId); })
                    .slice()
                    .sort(function (a, b) { return String(a.adSoyad || "").localeCompare(String(b.adSoyad || ""), "tr"); });
                kopya.innerHTML = '<option value="">Başka hekimin listesinden kopyala...</option>' +
                    digerleri.map(function (h) {
                        return '<option value="' + Number(h.id) + '">' + escapeHtml(h.adSoyad || "-") + '</option>';
                    }).join("");
                kopya.dataset.hekimId = String(hekimFiyatDuzenlenenId || "");
            }

            if (!container.querySelector(".price-row") && !container.querySelector(".empty")) {
                container.innerHTML =
                    '<div class="empty">Bu hekime henüz iş eklenmedi. Yukarıya iş adını yazıp "İş Ekle"ye basın veya başka bir hekimin listesini kopyalayın.</div>';
            }
        }

        // Bilgi (yeşil) / hata (varsayılan kırmızı) mesaj görünümü.
        function hekimFiyatMesajRengi(kutu, basarili) {
            if (!kutu) return;
            kutu.style.color = basarili ? "#047857" : "";
            kutu.style.background = basarili ? "#ecfdf5" : "";
            kutu.style.borderColor = basarili ? "#a7f3d0" : "";
        }

        function hekimFiyatYeniIsEkle() {
            const input = document.getElementById("hekimFiyatYeniIs");
            const hata = document.getElementById("hekimFiyatHata");
            const isTuru = String(input ? input.value : "").trim();
            if (!isTuru) {
                input?.focus();
                return;
            }

            if (hekimFiyatMevcutAnahtarlar().has(hekimFiyatAnahtar(isTuru))) {
                hekimFiyatMesajRengi(hata, false);
                hata.innerText = "\"" + isTuru + "\" bu hekimin listesinde zaten var.";
                hata.style.display = "block";
                return;
            }

            hata.style.display = "none";
            hekimFiyatMesajRengi(hata, false);
            const row = hekimFiyatSatiriEkle(isTuru, null, "TRY");
            input.value = "";
            hekimFiyatListesiniYenile();
            row.querySelector(".doctor-price-value")?.focus();
        }

        // Başka bir hekimin listesindeki, bu hekimde olmayan işleri fiyatlarıyla ekler.
        async function hekimFiyatBaskaHekimdenKopyala() {
            const select = document.getElementById("hekimFiyatKopyaKaynak");
            const hata = document.getElementById("hekimFiyatHata");
            const kaynakId = Number(select ? select.value : 0);
            if (!kaynakId) return;

            try {
                const liste = await fiyatListesiGetir(kaynakId);
                const mevcut = hekimFiyatMevcutAnahtarlar();
                let eklenen = 0;
                liste.forEach(function (x) {
                    if (!x || !x.isTuru || mevcut.has(hekimFiyatAnahtar(x.isTuru))) return;
                    hekimFiyatSatiriEkle(x.isTuru, Number(x.birimFiyat || 0), String(x.paraBirimi || "TRY").toUpperCase());
                    mevcut.add(hekimFiyatAnahtar(x.isTuru));
                    eklenen++;
                });
                hekimFiyatListesiniYenile();
                hata.innerText = eklenen
                    ? eklenen + " iş kopyalandı. Fiyatları kontrol edip \"Fiyat Listesini Kaydet\"e basın."
                    : "Seçilen hekimin listesinde eklenecek yeni iş yok.";
                hata.style.display = "block";
                hekimFiyatMesajRengi(hata, eklenen > 0);
            } catch (error) {
                hata.innerText = error.message || "Liste kopyalanamadı.";
                hata.style.display = "block";
            }
        }

        function hekimFiyatSatiriSil(button) {
            button.closest(".price-row")?.remove();
            hekimFiyatListesiniYenile();
        }

        function hekimFiyatSatirlariniOku() {
            const fiyatlar = [];

            document
                .querySelectorAll(
                    "#hekimFiyatSatirlari .price-row"
                )
                .forEach(function (row, index) {
                    const isTuru =
                        row.querySelector(
                            ".doctor-price-name"
                        ).value.trim();

                    const priceInput =
                        row.querySelector(
                            ".doctor-price-value"
                        );

                    const raw =
                        String(priceInput.value || "").trim();

                    if (!isTuru) {
                        return;
                    }

                    // Listede olan işin fiyatı boşsa kaydetmeden önce uyarılır
                    // (önceden boş fiyatlı iş sessizce listeden düşüyordu).
                    const birimFiyat = raw === "" ? NaN : Number(raw);

                    fiyatlar.push({
                        isTuru: isTuru,
                        birimFiyat: birimFiyat,
                        paraBirimi: row.querySelector(".doctor-price-currency")?.value || "TRY",
                        sira: index
                    });
                });

            return fiyatlar;
        }


        async function hekimFiyatlariniKaydet() {
            const hekimId =
                Number(
                    document.getElementById(
                        "hekimFiyatHekimId"
                    ).value
                );

            const fiyatlar =
                hekimFiyatSatirlariniOku();

            const hata =
                document.getElementById("hekimFiyatHata");

            const button =
                document.getElementById("hekimFiyatKaydetBtn");

            if (!hekimId) {
                return;
            }

            hekimFiyatMesajRengi(hata, false);
            const gorulen = new Set();
            for (const fiyat of fiyatlar) {
                const anahtar = hekimFiyatAnahtar(fiyat.isTuru);
                if (gorulen.has(anahtar)) {
                    hata.innerText = "\"" + fiyat.isTuru + "\" listede iki kez var.";
                    hata.style.display = "block";
                    return;
                }
                gorulen.add(anahtar);
            }
            for (const fiyat of fiyatlar) {
                if (!Number.isFinite(fiyat.birimFiyat)) {
                    hata.innerText =
                        "\"" + fiyat.isTuru + "\" için fiyat girin (ücretsizse 0 yazın) veya × ile listeden çıkarın.";
                    hata.style.display = "block";
                    return;
                }

                if (fiyat.birimFiyat < 0) {
                    hata.innerText =
                        "Fiyat 0'dan küçük olamaz.";
                    hata.style.display = "block";
                    return;
                }
            }

            hata.style.display = "none";
            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const response =
                    await fetch(
                        "/api/hekim-fiyatlari/" + hekimId,
                        {
                            method: "PUT",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify(fiyatlar)
                        }
                    );

                if (!response.ok) {
                    const message = await response.text();

                    throw new Error(
                        message ||
                        "Fiyat listesi kaydedilemedi."
                    );
                }

                hekimIsListesiOnbellek.delete(hekimId);
                closeHekimFiyatModal();
                if (Number(document.getElementById("anHekim")?.value || 0) === hekimId) {
                    anayasaHekimDegisti();
                }

                showSuccess(
                    "Hekime özel fiyat listesi kaydedildi."
                );
            }
            catch (error) {
                hata.innerText =
                    error.message ||
                    "Fiyat listesi kaydedilirken hata oluştu.";

                hata.style.display = "block";
            }
            finally {
                button.disabled = false;
                button.innerText = "Fiyat Listesini Kaydet";
            }
        }


