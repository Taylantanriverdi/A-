        function standartDurum(durum) {
            const value =
                String(durum || "")
                    .trim()
                    .toLocaleLowerCase("tr-TR");

            // Eski panoların V32 anayasa durumlarıyla geriye dönük uyumluluğu.
            if (!value || value === "yeni" || value === "bekliyor" || value === "tasarımda" || value === "tasarimda") {
                return "Yeni";
            }

            if (value.includes("devam") || value === "üretimde" || value === "uretimde" || value === "makyajda") {
                return "Devam Eden";
            }

            if (value.includes("hazır") || value.includes("hazir") || value === "tamamlama onayı" || value === "tamamlama onayi") {
                return "Hazır";
            }

            if (value.includes("teslim") || value === "tamamlandı" || value === "tamamlandi") {
                return "Teslim";
            }

            if (value.includes("iptal") || value.includes("redded")) {
                return "İptal";
            }

            return durum || "Yeni";
        }


        function sonrakiIsDurumu(durum) {
            const mevcut = standartDurum(durum);

            if (mevcut === "Yeni") {
                return "Devam Eden";
            }

            if (mevcut === "Devam Eden") {
                return "Hazır";
            }

            if (mevcut === "Hazır") {
                return "Teslim";
            }

            return null;
        }


        function renderIsAkisi(durum) {
            const mevcut = standartDurum(durum);
            const sonraki = sonrakiIsDurumu(mevcut);

            const bilgi =
                document.getElementById("isAkisBilgi");

            const butonlar =
                document.getElementById("isAkisButonlari");

            if (!bilgi || !butonlar) {
                return;
            }

            if (mevcut === "İptal") {
                bilgi.innerText =
                    "Bu iş iptal edilmiş. İş akışı ilerletilemez.";

                butonlar.innerHTML = "";
                return;
            }

            if (mevcut === "Teslim") {
                bilgi.innerText =
                    "Bu iş teslim edilmiş ve Arşiv bölümüne taşınmıştır.";

                butonlar.innerHTML = "";
                return;
            }

            const aciklama = {
                "Yeni":
                    "İş henüz üretime alınmamış.",
                "Devam Eden":
                    "İş laboratuvar üretim sürecinde.",
                "Hazır":
                    "İş tamamlandı ve teslim edilmeye hazır."
            };

            bilgi.innerText =
                (aciklama[mevcut] || "") +
                " Sonraki adım: " +
                (sonraki || "-");

            let buttonClass = "workflow-next";
            let buttonText = "Devam Edene Al";

            if (sonraki === "Hazır") {
                buttonClass = "workflow-ready";
                buttonText = "Hazır Olarak İşaretle";
            }

            if (sonraki === "Teslim") {
                buttonClass = "workflow-deliver";
                buttonText = "Teslim Et";
            }

            butonlar.innerHTML = `
                <button type="button"
                        class="workflow-button ${buttonClass}"
                        onclick="isAkisIlerle('${sonraki}')">
                    ${buttonText}
                </button>
            `;
        }


        async function isAkisIlerle(yeniDurum) {
            const id =
                Number(
                    document.getElementById(
                        "detayIsId"
                    ).value
                );

            if (!id || !yeniDurum) {
                return;
            }

            let onayMesaji =
                "#" + id +
                " numaralı iş '" +
                yeniDurum +
                "' durumuna geçirilsin mi?";

            if (yeniDurum === "Teslim") {
                onayMesaji =
                    "#" + id +
                    " numaralı iş Tamamlama Onayı kuyruğuna gönderilecek. " +
                    "Yönetici onayından sonra tamamlanacak. Devam edilsin mi?";
            }

            if (!confirm(onayMesaji)) {
                return;
            }

            const hata =
                document.getElementById(
                    "isDetayHata"
                );

            try {
                const response =
                    await fetch(
                        "/api/siparisler/" +
                        id +
                        "/durum",
                        {
                            method: "PATCH",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body: JSON.stringify({
                                durum: yeniDurum === "Teslim" ? "Tamamlandı" : yeniDurum
                            })
                        }
                    );

                if (!response.ok) {
                    const message =
                        await response.text();

                    throw new Error(
                        message ||
                        "İş durumu değiştirilemedi."
                    );
                }

                document.getElementById(
                    "detayDurum"
                ).value = yeniDurum;

                renderIsAkisi(yeniDurum);

                await loadSiparisler();

                if (yeniDurum === "Teslim") {
                    closeIsDetayModal();
                    showSuccess(
                        "İş tamamlandı ve Tamamlanan İşler’e taşındı."
                    );
                }
                else {
                    closeIsDetayModal();

                    if (yeniDurum === "Devam Eden") {
                        showSection("devam");
                    }

                    showSuccess(
                        "İş durumu '" +
                        yeniDurum +
                        "' olarak güncellendi."
                    );
                }
            }
            catch (error) {
                hata.innerText =
                    error.message ||
                    "İş akışı güncellenirken hata oluştu.";

                hata.style.display = "block";
            }
        }


        function dosyaBoyutuGoster(bytes) {
            const n = Number(bytes || 0);
            if (n < 1024) return n + " B";
            if (n < 1024 * 1024) return (n / 1024).toFixed(1) + " KB";
            return (n / (1024 * 1024)).toFixed(1) + " MB";
        }

        async function detayDosyalariYukle(id) {
            const body = document.getElementById("detayDosyalarBody");
            const sayi = document.getElementById("detayDosyaSayisi");
            if (!body || !id) return;

            try {
                const response = await fetch(
                    "/api/is-dosyalari/siparis/" + Number(id),
                    { cache: "no-store" }
                );

                if (!response.ok) {
                    throw new Error(
                        (await response.text()) ||
                        "İş dosyaları alınamadı."
                    );
                }

                const files = await response.json();
                const liste = Array.isArray(files) ? files : [];

                if (sayi) {
                    sayi.innerText = liste.length + " dosya";
                }

                if (!liste.length) {
                    body.innerHTML =
                        '<tr><td colspan="5" class="empty">Bu işe bağlı dosya yok.</td></tr>';
                    return;
                }

                body.innerHTML = liste.map(function(f) {
                    return `
                        <tr>
                            <td><span class="file-pill">${escapeHtml(f.dosyaTuru || "Diger")}</span></td>
                            <td>
                                <div class="file-name">${escapeHtml(f.orijinalDosyaAdi || "-")}</div>
                                <div class="file-meta">${escapeHtml(f.uzanti || "")}</div>
                            </td>
                            <td>${dosyaBoyutuGoster(f.boyut)}</td>
                            <td>${tarihSaatGoster(f.yuklemeTarihi)}</td>
                            <td>
                                <div class="button-group">
                                    <button type="button"
                                            class="button button-light"
                                            onclick="event.stopPropagation();detayDosyaIndir(${Number(f.id)})">
                                        İndir
                                    </button>
                                    <button type="button"
                                            class="button"
                                            style="background:#dc2626;color:white;"
                                            onclick="event.stopPropagation();detayDosyaSil(${Number(f.id)})">
                                        Sil
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join("");
            }
            catch (error) {
                body.innerHTML =
                    '<tr><td colspan="5" class="empty">' +
                    escapeHtml(error.message || "Dosyalar alınamadı.") +
                    '</td></tr>';
            }
        }

        async function detayDosyaYukle() {
            const siparisId =
                Number(document.getElementById("detayIsId")?.value || 0);

            const input =
                document.getElementById("detayDosyaInput");

            const tur =
                document.getElementById("detayDosyaTuru")?.value || "Diger";

            const button =
                document.getElementById("detayDosyaYukleBtn");

            if (!siparisId) {
                showError("İş numarası bulunamadı.");
                return;
            }

            if (!input?.files?.length) {
                showError("Yüklenecek dosyayı seç.");
                return;
            }

            const file = input.files[0];

            if (file.size > 250 * 1024 * 1024) {
                showError("Dosya en fazla 250 MB olabilir.");
                return;
            }

            const form = new FormData();
            form.append("dosya", file);
            form.append("dosyaTuru", tur);

            const oldText = button?.innerText || "Dosya Yükle";
            if (button) {
                button.disabled = true;
                button.innerText = "Yükleniyor...";
            }

            try {
                const response = await fetch(
                    "/api/is-dosyalari/siparis/" + siparisId,
                    {
                        method: "POST",
                        body: form
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        (await response.text()) ||
                        "Dosya yüklenemedi."
                    );
                }

                input.value = "";
                await detayDosyalariYukle(siparisId);
                showSuccess("Dosya işe bağlandı.");
            }
            catch (error) {
                showError(error.message || "Dosya yüklenemedi.");
            }
            finally {
                if (button) {
                    button.disabled = false;
                    button.innerText = oldText;
                }
            }
        }

        function detayDosyaIndir(id) {
            window.location.href =
                "/api/is-dosyalari/" +
                Number(id) +
                "/indir";
        }

        async function detayDosyaSil(id) {
            if (!confirm("Bu dosyayı kalıcı olarak silmek istediğine emin misin?")) {
                return;
            }

            const siparisId =
                Number(document.getElementById("detayIsId")?.value || 0);

            try {
                const response = await fetch(
                    "/api/is-dosyalari/" + Number(id),
                    { method: "DELETE" }
                );

                if (!response.ok) {
                    throw new Error(
                        (await response.text()) ||
                        "Dosya silinemedi."
                    );
                }

                await detayDosyalariYukle(siparisId);
                showSuccess("Dosya silindi.");
            }
            catch (error) {
                showError(error.message || "Dosya silinemedi.");
            }
        }


        async function openIsDetayModal(id) {
            const modal = document.getElementById("isDetayModal");
            const hata = document.getElementById("isDetayHata");

            if (!modal) return;

            if (hata) {
                hata.style.display = "none";
                hata.innerText = "";
            }

            try {
                const response = await fetch("/api/siparisler/" + id);
                if (!response.ok) throw new Error("İş bilgileri alınamadı.");

                const item = await response.json();

                document.getElementById("detayIsId").value = item.id;
                document.getElementById("detayIsNo").value = item.id;
                document.getElementById("detayDurum").value = anayasaDurum(item.durum || "Bekliyor");
                renderIsAkisi(item.durum || "Yeni");

                document.getElementById("detayHekim").value =
                    item.klinikAdi ? (item.hekimAdi + " - " + item.klinikAdi) : (item.hekimAdi || "-");

                document.getElementById("detayHasta").value = item.hastaAdi || "-";

                document.getElementById("detayDisRengi").value =
                    item.disRengi || "Belirtilmemiş";

                document.getElementById("detayOncelik").value =
                    item.oncelik || "Normal";

                document.getElementById("detayUretimNotu").innerText =
                    item.uretimNotu || "Not yok.";

                document.getElementById("detayUretimAsamasi").value =
                    item.uretimAsamasi || "Bekliyor";

                document.getElementById("detayKaliteDurumu").value =
                    item.kaliteKontrolDurumu || "Bekliyor";

                document.getElementById("detayKaliteNotu").innerText =
                    item.kaliteKontrolNotu || "Not yok.";

                document.getElementById("detayTerminTarihi").value =
                    item.terminTarihi
                        ? tarihGoster(item.terminTarihi)
                        : "Termin yok";

                const detayAtama =
                    teknisyenAtamasi(item.id);

                const detayTeknisyen =
                    document.getElementById(
                        "detayTeknisyen"
                    );

                if (detayTeknisyen) {
                    detayTeknisyen.innerHTML =
                        aktifTeknisyenSecenekleri(
                            detayAtama?.teknisyenId || ""
                        );

                    detayTeknisyen.value =
                        detayAtama?.teknisyenId
                            ? String(detayAtama.teknisyenId)
                            : "";
                }

                document.getElementById("detayAdet").value = item.toplamAdet ?? 0;
                document.getElementById("detayTutar").value = paraBirimiFormat(item.toplamTutar, item.paraBirimi);

                const body = document.getElementById("detayKalemlerBody");
                const kalemler = Array.isArray(item.kalemler) ? item.kalemler : [];

                if (!kalemler.length) {
                    body.innerHTML =
                        '<tr><td colspan="4" class="empty">İş kalemi bulunamadı.</td></tr>';
                }
                else {
                    body.innerHTML = kalemler.map(function (k) {
                        return '<tr>' +
                            '<td>' + escapeHtml(k.isTuru ?? "-") + '</td>' +
                            '<td>' + (k.adet ?? 0) + '</td>' +
                            '<td>' + para(k.birimFiyat) + '</td>' +
                            '<td>' + para(k.toplam) + '</td>' +
                            '</tr>';
                    }).join("");
                }

                const historyBody =
                    document.getElementById("detayDurumGecmisiBody");

                const history =
                    Array.isArray(item.durumGecmisi)
                        ? item.durumGecmisi
                        : [];

                if (!history.length) {
                    historyBody.innerHTML = `
                        <tr>
                            <td colspan="4" class="empty">
                                Bu iş V10 öncesinde oluşturulmuş olabilir.
                                Kayıtlı durum geçmişi bulunmuyor.
                            </td>
                        </tr>
                    `;
                }
                else {
                    historyBody.innerHTML = history.map(function (h) {
                        return `
                            <tr>
                                <td>${tarihSaatGoster(h.degisimTarihi)}</td>
                                <td>${escapeHtml(h.eskiDurum || "-")}</td>
                                <td>${escapeHtml(h.yeniDurum || "-")}</td>
                                <td>${escapeHtml(h.aciklama || "-")}</td>
                            </tr>
                        `;
                    }).join("");
                }

                const teslimBilgi =
                    document.getElementById("detayTeslimTarihiBilgi");

                teslimBilgi.innerText =
                    item.teslimTarihi
                        ? "Gerçek teslim tarihi: " +
                          tarihSaatGoster(item.teslimTarihi)
                        : "Gerçek teslim tarihi henüz oluşmamış.";

                await detayDosyalariYukle(item.id);
                modal.style.display = "flex";
            }
            catch (error) {
                showError(error.message || "İş detayı açılırken hata oluştu.");
            }
        }


        function closeIsDetayModal() {
            const modal = document.getElementById("isDetayModal");
            if (modal) modal.style.display = "none";
        }

        async function durumKaydetLegacy() {
            const id = Number(document.getElementById("detayIsId").value);
            const durum = document.getElementById("detayDurum").value;
            const hata = document.getElementById("isDetayHata");
            const button = document.getElementById("durumKaydetBtn");

            if (!id || !durum) return;

            button.disabled = true;
            button.innerText = "Kaydediliyor...";

            try {
                const response = await fetch("/api/siparisler/" + id + "/durum", {
                    method: "PATCH",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ durum: durum })
                });

                if (!response.ok) {
                    const message = await response.text();
                    throw new Error(message || "Durum değiştirilemedi.");
                }

                closeIsDetayModal();
                await loadSiparisler();
                showSuccess("İş durumu güncellendi.");
            }
            catch (error) {
                hata.innerText = error.message || "Durum kaydedilirken hata oluştu.";
                hata.style.display = "block";
            }
            finally {
                button.disabled = false;
                button.innerText = "Durumu Kaydet";
            }
        }

        async function isIptalEt() {
            const id = Number(document.getElementById("detayIsId").value);
            if (!id) return;

            if (!confirm("#" + id + " numaralı işi iptal etmek istediğine emin misin?")) {
                return;
            }

            try {
                const response = await fetch("/api/anayasa/isler/" + id + "/sil", {
                    method: "PATCH"
                });

                if (!response.ok) {
                    const message = await response.text();
                    throw new Error(message || "İş iptal edilemedi.");
                }

                closeIsDetayModal();
                await loadSiparisler();
                showSuccess("İş Silinenler bölümüne taşındı.");
            }
            catch (error) {
                showError(error.message || "İş iptal edilirken hata oluştu.");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const yeniIsForm = document.getElementById("yeniIsForm");
            if (yeniIsForm) yeniIsForm.addEventListener("submit", yeniIsKaydet);

            const yeniHekimForm = document.getElementById("yeniHekimForm");
            if (yeniHekimForm) yeniHekimForm.addEventListener("submit", yeniHekimKaydet);

            const tahsilatForm =
                document.getElementById("tahsilatForm");

            if (tahsilatForm) {
                tahsilatForm.addEventListener(
                    "submit",
                    tahsilatKaydet
                );
            }


            const detayDurum =
                document.getElementById("detayDurum");

            if (detayDurum) {
                detayDurum.addEventListener(
                    "change",
                    function () {
                        renderIsAkisi(
                            detayDurum.value
                        );
                    }
                );
            }


            ["yeniIsModal", "yeniHekimModal", "hekimPortalModal", "teknisyenDuzenleModal", "kaDetayModal", "kaTahsilatModal", "kaTahsilatOnizlemeModal", "kaDonemModal", "kaDonemDetayModal", "kaBildirimModal", "cariDetayModal", "cariDetayV2Modal", "cariTahsilatModal", "cariDonemModal", "cariDonemDetayModal", "cariDonemDuzenleModal", "cariBildirimModal", "tahsilatModal", "hekimFiyatModal", "isKatalogModal", "isDuzenleModal", "isDetayModal"].forEach(function (id) {
                const modal = document.getElementById(id);
                if (!modal) return;

                modal.addEventListener("click", function (event) {
                    if (event.target !== modal) return;

                    if (id === "yeniIsModal") closeYeniIsModal();
                    if (id === "yeniHekimModal") closeYeniHekimModal();
                    if (id === "kaDetayModal") kaDetayKapat();
                    if (id === "kaTahsilatModal") kaTahsilatKapat();
                    if (id === "kaTahsilatOnizlemeModal") kaTahsilatOnizlemeKapat();
                    if (id === "kaDonemModal") kaDonemKapat();
                    if (id === "kaDonemDetayModal") kaDonemDetayKapat();
                    if (id === "kaBildirimModal") kaBildirimKapat();
                    if (id === "teknisyenDuzenleModal") closeTeknisyenDuzenleModal();
                    if (id === "cariDetayModal") closeCariDetayModal();
                    if (id === "cariDetayV2Modal") cariDetayKapat();
                    if (id === "cariTahsilatModal") cariTahsilatKapat();
                    if (id === "cariDonemModal") cariDonemKapatModal();
                    if (id === "cariDonemDetayModal") cariDonemDetayKapat();
                    if (id === "cariDonemDuzenleModal") cariDonemDuzenleKapat();
                    if (id === "cariBildirimModal") document.getElementById("cariBildirimModal").style.display="none";
                    if (id === "tahsilatModal") closeTahsilatModal();
                    if (id === "hekimFiyatModal") closeHekimFiyatModal();
                    if (id === "isKatalogModal") closeIsKatalogModal();
                    if (id === "isDuzenleModal") closeIsDuzenleModal();
                    if (id === "isDetayModal") closeIsDetayModal(); else if (id === "hekimPortalModal") closeHekimPortalModal();
                });
            });
        });
    </script>

</body>

