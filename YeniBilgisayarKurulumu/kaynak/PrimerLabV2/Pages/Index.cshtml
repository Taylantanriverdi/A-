        function addHekimEmailBar(value = "") {
            const host = document.getElementById("hekimEmailBars");
            if (!host) return;
            if (host.querySelectorAll(".hekim-email-bar").length >= 10) {
                showError("Bir hekim / klinik için en fazla 10 e-posta adresi eklenebilir.");
                return;
            }
            const row = document.createElement("div");
            row.className = "hekim-email-bar";
            row.style.cssText = "display:flex;gap:8px;align-items:center;";
            const input = document.createElement("input");
            input.type = "email";
            input.className = "hekim-email-input";
            input.maxLength = 150;
            input.placeholder = "doktor@klinik.com";
            input.value = value || "";
            input.style.cssText = "flex:1;min-width:0;";
            const remove = document.createElement("button");
            remove.type = "button";
            remove.className = "btn-secondary";
            remove.title = "E-posta adresini kaldır";
            remove.setAttribute("aria-label", "E-posta adresini kaldır");
            remove.textContent = "×";
            remove.style.cssText = "width:38px;min-width:38px;height:38px;padding:0;color:#b91c1c;font-size:20px;font-weight:800;";
            remove.onclick = () => {
                row.remove();
                if (!host.querySelector(".hekim-email-bar")) addHekimEmailBar();
            };
            row.append(input, remove);
            host.appendChild(row);
        }

        function setHekimEmailBars(raw) {
            const host = document.getElementById("hekimEmailBars");
            if (!host) return;
            host.innerHTML = "";
            const emails = String(raw || "").split(/[,;\n\r]+/).map(x => x.trim()).filter(Boolean);
            if (!emails.length) addHekimEmailBar();
            else emails.slice(0, 10).forEach(addHekimEmailBar);
        }

        function collectHekimEmails() {
            const inputs = Array.from(document.querySelectorAll("#hekimEmailBars .hekim-email-input"));
            const emails = inputs.map(x => x.value.trim().toLowerCase()).filter(Boolean);
            const unique = [...new Set(emails)];
            if (unique.length !== emails.length) throw new Error("Aynı e-posta adresi birden fazla kez eklenemez.");
            if (unique.length > 10) throw new Error("Bir hekim / klinik için en fazla 10 e-posta adresi eklenebilir.");
            if (unique.join(";").length > 250) throw new Error("E-posta adreslerinin toplam uzunluğu 250 karakteri geçemez.");
            return unique.join(";");
        }

