        let mn=Infinity,mx=-Infinity; for(const i of secim){ const t=(p[i*3]-c[0])*der[0]+(p[i*3+1]-c[1])*der[1]+(p[i*3+2]-c[2])*der[2]; if(t<mn)mn=t; if(t>mx)mx=t; }
