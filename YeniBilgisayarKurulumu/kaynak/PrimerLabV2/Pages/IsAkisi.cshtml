        try { await post(`/api/is-akisi/isler/${id}/${ad}`); toast(ad === "onayla" ? "İş onaylandı." : "İş reddedildi."); if (ad === "reddet") cekmeceKapat(); await yukle(); }
        catch (err) { toast(err.message, true); }
