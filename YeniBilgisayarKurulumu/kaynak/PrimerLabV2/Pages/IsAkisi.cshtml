    async function onizle(el, id, ad) {
        clearTimeout(onizGizleZ);
        const k = $("oniz"), r = el.getBoundingClientRect();
        k.classList.remove("hidden");
        const x = Math.max(8, Math.min(r.left - 352, window.innerWidth - 356)), y = Math.max(8, Math.min(r.top - 120, window.innerHeight - 380));
        k.style.left = (x < 8 || r.left < 360 ? Math.min(r.right + 8, window.innerWidth - 356) : x) + "px"; k.style.top = y + "px";
        $("onizAd").textContent = "⏳ " + ad; onizAktif = id;
        try {
            let m = onizOnbellek.get(id);
            if (!m) {
                const resp = await fetch("/api/is-akisi/dosya/" + id + "/onizleme", { credentials: "same-origin" });
                if (!resp.ok) throw new Error((await resp.text()) || "Önizleme hazırlanamadı.");
                const buf = await resp.arrayBuffer(), dv = new DataView(buf);
                if (String.fromCharCode(dv.getUint8(0), dv.getUint8(1), dv.getUint8(2), dv.getUint8(3)) !== "PLM1") throw new Error("Önizleme verisi okunamadı.");
                const vc = dv.getUint32(4, true), tc = dv.getUint32(8, true);
                m = { p: new Float32Array(buf.slice(12, 12 + vc * 12)), idx: new Uint32Array(buf.slice(12 + vc * 12, 12 + vc * 12 + tc * 12)) };
                onizOnbellek.set(id, m);
            }
            if (onizAktif !== id) return;
            $("onizAd").textContent = "🧊 " + ad + " — sürükleyerek çevirin";
            onizHazirla(m);
        } catch (err) { if (onizAktif === id) $("onizAd").textContent = "⚠ " + err.message; }
    }
    function onizHazirla(m) {
        const c = $("onizTuval");
        if (!onizGl) {
            onizGl = c.getContext("webgl", { antialias: true }); const gl = onizGl; if (!gl) { $("onizAd").textContent = "Bu tarayıcı 3B önizlemeyi desteklemiyor."; return; }
            gl.getExtension("OES_element_index_uint");
            const sh = (t, src) => { const x = gl.createShader(t); gl.shaderSource(x, src); gl.compileShader(x); return x; };
            onizProg = gl.createProgram();
            gl.attachShader(onizProg, sh(gl.VERTEX_SHADER, "attribute vec3 p;attribute vec3 n;uniform mat4 m;uniform mat3 r;varying vec3 vn;void main(){vn=r*n;gl_Position=m*vec4(p,1.0);}"));
            gl.attachShader(onizProg, sh(gl.FRAGMENT_SHADER, "precision mediump float;varying vec3 vn;void main(){vec3 N=normalize(vn);if(N.z<0.0)N=-N;float k=max(dot(N,normalize(vec3(-0.5,0.6,0.6))),0.0);float f=max(dot(N,normalize(vec3(0.6,-0.3,0.75))),0.0);float e=pow(1.0-N.z,2.2);vec3 c=vec3(0.86,0.76,0.62)*(0.15+0.75*k+0.25*f)*(1.0-0.55*e);gl_FragColor=vec4(c,1.0);}"));
            gl.linkProgram(onizProg);
            c.addEventListener("mousedown", e => { onizSurukle = { x: e.clientX, y: e.clientY, a: { ...onizAci } }; c.style.cursor = "grabbing"; });
            window.addEventListener("mouseup", () => { onizSurukle = null; c.style.cursor = "grab"; });
            window.addEventListener("mousemove", e => { if (!onizSurukle) return; onizAci.y = onizSurukle.a.y + (e.clientX - onizSurukle.x) * 0.01; onizAci.x = onizSurukle.a.x + (e.clientY - onizSurukle.y) * 0.01; });
        }
        const gl = onizGl; if (!gl) return;
        if (!m.nor) {
            const p = m.p, ix = m.idx, nor = new Float32Array(p.length);
            for (let i = 0; i < ix.length; i += 3) { const a = ix[i] * 3, b = ix[i + 1] * 3, d = ix[i + 2] * 3;
                const ux = p[b] - p[a], uy = p[b + 1] - p[a + 1], uz = p[b + 2] - p[a + 2], vx = p[d] - p[a], vy = p[d + 1] - p[a + 1], vz = p[d + 2] - p[a + 2];
                const nx = uy * vz - uz * vy, ny = uz * vx - ux * vz, nz = ux * vy - uy * vx; for (const q of [a, b, d]) { nor[q] += nx; nor[q + 1] += ny; nor[q + 2] += nz; } }
            let mn = [Infinity, Infinity, Infinity], mx = [-Infinity, -Infinity, -Infinity];
            for (let i = 0; i < p.length; i += 3) for (let k = 0; k < 3; k++) { mn[k] = Math.min(mn[k], p[i + k]); mx[k] = Math.max(mx[k], p[i + k]); }
            m.nor = nor; m.mrk = [0, 1, 2].map(k => (mn[k] + mx[k]) / 2); m.r = Math.max(1e-6, Math.hypot(mx[0] - mn[0], mx[1] - mn[1], mx[2] - mn[2]) / 2);
            m.bp = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, m.bp); gl.bufferData(gl.ARRAY_BUFFER, m.p, gl.STATIC_DRAW);
            m.bn = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, m.bn); gl.bufferData(gl.ARRAY_BUFFER, m.nor, gl.STATIC_DRAW);
            m.bi = gl.createBuffer(); gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, m.bi); gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, m.idx, gl.STATIC_DRAW);
        }
        onizMesh = m; onizAci = { x: -0.5, y: 0 };
        cancelAnimationFrame(onizAnim);
        const kare = () => { if (!onizSurukle) onizAci.y += 0.012; onizCiz(); onizAnim = requestAnimationFrame(kare); };
        kare();
    }
    function onizCiz() {
        const gl = onizGl, m = onizMesh; if (!gl || !m) return;
        const cx = Math.cos(onizAci.x), sx = Math.sin(onizAci.x), cy = Math.cos(onizAci.y), sy = Math.sin(onizAci.y);
