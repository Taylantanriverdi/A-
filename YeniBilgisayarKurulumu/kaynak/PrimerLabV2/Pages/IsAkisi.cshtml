        gl.viewport(0, 0, gl.canvas.width, gl.canvas.height); gl.clearColor(0.97, 0.98, 0.99, 1); gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT); gl.enable(gl.DEPTH_TEST);
