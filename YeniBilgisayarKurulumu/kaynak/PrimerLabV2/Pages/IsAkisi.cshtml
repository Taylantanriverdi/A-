    }
    function stlTurBul(ad){
        const a=String(ad||'').toLocaleLowerCase('tr').replace(/ü/g,'u').replace(/ı/g,'i').replace(/ş/g,'s').replace(/ç/g,'c').replace(/ğ/g,'g').replace(/ö/g,'o');
        if(/(bite|kapanis|occlus|okluz|buccal|bukkal|registr)/.test(a)) return 'kapanis';
        if(/(upper|maxill|(^|[^a-z])ust|(^|[^a-z])max([^a-z]|$)|(^|[^a-z])u([^a-z]|$))/.test(a)) return 'ust';
        if(/(lower|mandib|(^|[^a-z])alt|(^|[^a-z])mand([^a-z]|$)|(^|[^a-z])l([^a-z]|$))/.test(a)) return 'alt';
        return null;
