@page "/is-akisi"
@inject PrimerLabV2.Infrastructure.FirmaServisi Firma
@{
    Layout = null;
    // İş Akışı Paneli: tüm gelen işlerin akışı (fiyatsız). Ana programla aynı veritabanını kullanır.
    var firmaAd = Firma.Ad;
    var firmaLogo = Firma.LogoDataUrl();
    var firmaKisa = PrimerLabV2.Infrastructure.FirmaServisi.Kisaltma(firmaAd);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#10233e" />
    <title>@firmaAd — İş Akışı</title>
    <style>
        :root{--ink:#10233e;--muted:#64748b;--line:#dbe3ef;--bg:#eef2f7;--card:#fff;--blue:#1565c0;--blue-soft:#eff6ff;--green:#15803d;--green-soft:#ecfdf5;--red:#dc2626;--red-soft:#fef2f2;--amber:#b45309;--amber-soft:#fffbeb;--violet:#6d28d9;--violet-soft:#f5f3ff}
        *{box-sizing:border-box}
        html,body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,"Segoe UI",Roboto,Arial,sans-serif;font-size:14px}
        button,input,select,textarea{font:inherit;color:inherit}
        .hidden{display:none!important}
        .btn{height:38px;border:0;border-radius:10px;padding:0 14px;font-weight:800;cursor:pointer;background:var(--blue);color:#fff;white-space:nowrap}
        .btn:disabled{opacity:.5;cursor:default}
        .btn-light{background:#fff;color:var(--ink);border:1px solid var(--line)}
        .btn-green{background:var(--green)}
        .btn-red{background:#fff;color:var(--red);border:1px solid #fecaca}
        .inp{width:100%;height:38px;border:1px solid var(--line);border-radius:10px;padding:0 11px;background:#fff;outline:none}
        .inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(21,101,192,.15)}
        textarea.inp{height:70px;padding:8px 11px;resize:vertical}
        /* giriş */
        .giris{min-height:100vh;display:grid;place-items:center;padding:16px}
        .giris-kutu{width:100%;max-width:380px;background:#fff;border-radius:18px;padding:26px;box-shadow:0 20px 50px rgba(15,23,42,.12)}
        .giris-kutu h1{font-size:20px;margin:12px 0 4px}
        .giris-kutu p{color:var(--muted);margin:0 0 16px;font-size:13px}
        .giris-kutu label{display:block;font-size:12px;font-weight:800;color:#475569;margin:10px 0 4px}
        .msg{border-radius:10px;padding:9px 11px;font-size:13px;font-weight:700;margin-top:10px}
        .msg.err{background:var(--red-soft);color:var(--red)}
        .logo-img{max-height:56px;max-width:200px;display:block}
        .logo-kisa{width:46px;height:46px;border-radius:12px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:900}
        /* üst bar */
        .ust{background:#10233e;color:#fff;position:sticky;top:0;z-index:20}
        .ust-ic{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 16px}
        .marka{display:flex;align-items:center;gap:10px}
        .marka img{max-height:34px;max-width:120px;background:#fff;border-radius:8px;padding:3px}
        .marka b{display:block;font-size:15px}
        .marka small{opacity:.7;font-size:11px;font-weight:800;letter-spacing:.5px}
        .ust .btn-light{background:transparent;color:#fff;border-color:rgba(255,255,255,.3);height:34px}
        .arac{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:10px 16px;background:#fff;border-bottom:1px solid var(--line);position:sticky;top:54px;z-index:15}
        .arac .inp{max-width:280px}
        .cip{height:32px;border-radius:999px;border:1px solid var(--line);background:#fff;padding:0 12px;font-weight:800;font-size:12px;cursor:pointer}
        .cip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
        .cip .say{opacity:.7;margin-left:3px}
        .ayrac{width:1px;height:24px;background:var(--line);margin:0 2px}
        /* pano */
        .pano{display:grid;grid-template-columns:repeat(5,minmax(240px,1fr));gap:10px;padding:12px 16px;overflow-x:auto;align-items:start}
        .sutun{background:#e2e8f0;border-radius:14px;padding:8px;min-height:120px}
        .sutun-baslik{display:flex;justify-content:space-between;align-items:center;font-weight:900;font-size:13px;padding:4px 6px 8px}
        .sutun-baslik span{background:#fff;border-radius:999px;padding:1px 9px;font-size:12px}
        .kart{background:#fff;border-radius:12px;padding:10px 11px;margin-bottom:8px;border:1px solid transparent;box-shadow:0 1px 2px rgba(15,23,42,.06);cursor:pointer}
        .kart:hover{border-color:#93c5fd}
        .kart.gec{border-left:4px solid var(--red)}
        .kart.acil{box-shadow:0 0 0 2px #fecaca}
        .k-ust{display:flex;justify-content:space-between;gap:6px;font-size:11px;color:var(--muted);font-weight:800}
        .k-hasta{font-weight:900;font-size:14px;margin:3px 0 1px}
        .k-hekim{font-size:12px;color:#475569}
        .k-is{font-size:12px;margin-top:4px}
        .k-alt{display:flex;flex-wrap:wrap;gap:4px;margin-top:7px}
        .rozet{display:inline-flex;align-items:center;gap:3px;border-radius:999px;padding:2px 8px;font-size:11px;font-weight:800;background:#f1f5f9;color:#334155;white-space:nowrap}
        .rozet.mavi{background:var(--blue-soft);color:var(--blue)}
        .rozet.yesil{background:var(--green-soft);color:var(--green)}
        .rozet.kirmizi{background:var(--red-soft);color:var(--red)}
        .rozet.sari{background:var(--amber-soft);color:var(--amber)}
        .rozet.mor{background:var(--violet-soft);color:var(--violet)}
        .bos{color:var(--muted);text-align:center;padding:14px 4px;font-size:12px}
        /* liste */
        .liste{padding:12px 16px}
        .liste table{width:100%;border-collapse:collapse;background:#fff;border-radius:12px;overflow:hidden}
        .liste th,.liste td{padding:9px 10px;border-bottom:1px solid #edf2f7;text-align:left;font-size:13px;vertical-align:top}
        .liste th{background:#f8fafc;font-size:11px;color:var(--muted);text-transform:uppercase}
        .liste tr{cursor:pointer}
        .liste tr:hover td{background:#f8fbff}
        /* çekmece */
        .perde{position:fixed;inset:0;background:rgba(15,23,42,.35);z-index:40}
        .cekmece{position:fixed;top:0;right:0;bottom:0;width:min(560px,100%);background:#fff;z-index:41;overflow:auto;box-shadow:-10px 0 40px rgba(15,23,42,.2)}
        .c-ust{position:sticky;top:0;background:#fff;border-bottom:1px solid var(--line);padding:14px 16px;display:flex;justify-content:space-between;gap:10px;z-index:2}
        .c-ust h2{margin:0;font-size:18px}
        .c-ic{padding:14px 16px}
        .bolum{border:1px solid var(--line);border-radius:12px;padding:12px;margin-bottom:12px}
        .bolum h3{margin:0 0 8px;font-size:13px;color:#334155}
        .bilgi{display:grid;grid-template-columns:110px 1fr;gap:5px 10px;font-size:13px}
        .bilgi div:nth-child(odd){color:var(--muted);font-weight:700}
        .satir{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
        .satir select{flex:1;min-width:160px}
        .dosya{display:flex;justify-content:space-between;gap:8px;padding:7px 9px;border:1px solid #e2e8f0;border-radius:9px;margin-top:5px;text-decoration:none;color:inherit;font-size:13px}
        .dosya:hover{border-color:var(--blue)}
        .dosya span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .mesajlar{max-height:300px;overflow:auto;display:flex;flex-direction:column;gap:6px}
        .m{border-radius:10px;padding:7px 10px;font-size:13px;background:#f1f5f9;max-width:90%}
        .m.lab{background:var(--blue-soft);align-self:flex-end}
        .m small{display:block;color:var(--muted);font-size:11px;font-weight:700;margin-bottom:2px}
        .not{white-space:pre-wrap;background:#f8fafc;border-radius:9px;padding:8px 10px;font-size:13px}
        .oniz{position:fixed;z-index:70;width:340px;background:#fff;border-radius:14px;box-shadow:0 18px 50px rgba(15,23,42,.3);padding:8px;border:1px solid var(--line)}
        .oniz canvas{width:324px;height:324px;display:block;border-radius:10px;background:#f8fafc;cursor:grab}
        .oniz div{font-size:12px;font-weight:800;padding:6px 4px 2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .toast{position:fixed;left:50%;bottom:18px;transform:translateX(-50%);background:#10233e;color:#fff;padding:10px 16px;border-radius:10px;font-weight:800;z-index:60;font-size:13px}
        .toast.err{background:var(--red)}
        @@media(max-width:700px){.arac{top:54px}.arac .inp{max-width:none}.pano{grid-template-columns:repeat(5,82vw)}}
    </style>
    <style>
        /* ===== Ana programdaki Sipariş Takip Formu stilleri (Index.cshtml'den aynen) ===== */
        .form-error{background: #fee2e2; color: #991b1b; border-radius: 8px; padding: 11px; margin-bottom: 14px;}
        .order-line-total{min-height:39px;border:1px solid #dbe3ef;background:#fff;border-radius:9px;padding:10px;font-weight:900;text-align:right}
        .tooth-board{display:grid;grid-template-columns:1fr 1fr;gap:0;max-width:650px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:12px}
        .tooth-quadrant{padding:8px}
        .tooth-quadrant:nth-child(1),.tooth-quadrant:nth-child(3){border-right:1px solid #94a3b8}
        .tooth-quadrant:nth-child(1),.tooth-quadrant:nth-child(2){border-bottom:1px solid #94a3b8}
        .tooth-row-v30{display:flex;flex-wrap:wrap;gap:5px;justify-content:center}
        .tooth-q-label{font-size:10px;font-weight:900;color:#64748b;text-align:center;margin-bottom:7px}
        @@media(max-width:1000px){
            .order-line-total{grid-column:1 / 3}
        }
        .ref-order-brand{grid-template-columns:180px minmax(0,1fr); gap:22px; padding-bottom:12px; margin-bottom:14px;}
        .ref-order-logo{font-size:31px; line-height:.95; letter-spacing:-1.5px;}
        .ref-order-logo small{font-size:7.5px; line-height:1.25; letter-spacing:.2px; margin-top:3px;}
        .ref-tooth-mini{position:relative; display:grid; grid-template-columns:1fr 1fr; grid-template-rows:auto auto; border:0; padding:0; background:#fff; gap:0;}
        .ref-tooth-mini::before{content:""; position:absolute; left:50%; top:0; bottom:0; width:1px; background:#26364d; transform:translateX(-.5px); pointer-events:none;}
        .ref-tooth-mini::after{content:""; position:absolute; left:0; right:0; top:50%; height:1px; background:#26364d; transform:translateY(-.5px); pointer-events:none;}
        .ref-tooth-quadrant{display:flex; align-items:center; justify-content:center; gap:2px; padding:4px 10px 5px; min-width:0;}
        .ref-tooth-quadrant.left{padding-right:18px}
        .ref-tooth-quadrant.right{padding-left:18px}
        .ref-tooth-cell{display:flex; flex-direction:column; align-items:center; gap:1px;}
        .ref-tooth-cell .tooth-number-top{font-size:5.8px; line-height:1; font-weight:800; color:#475569;}
        .ref-tooth-cell .tooth-btn{width:18px; min-width:18px; height:18px; padding:0; border:1px solid #b8c4d2; background:#fff; color:#334155; border-radius:1px; font-size:6.2px; line-height:16px; font-weight:800; cursor:pointer;}
        .ref-tooth-cell .tooth-btn.selected{background:#1565c0; color:#fff; border-color:#1565c0;}
        .ref-form-title{font-size:11px; letter-spacing:4px; margin-top:7px;}
        .ref-tooth-mini{display:block; border:1px solid #26364d; padding:5px 6px; background:#fff;}
        .ref-tooth-mini .tooth-unified-row{display:flex; align-items:center; justify-content:center; gap:2px; flex-wrap:nowrap; min-width:0;}
        .ref-tooth-mini .tooth-unified-row + .tooth-unified-row{margin-top:3px;}
        .ref-tooth-mini .tooth-row-label{width:22px; flex:0 0 22px; font-size:6.5px; line-height:1; font-weight:900; color:#64748b; text-align:center; letter-spacing:.1px;}
        .ref-tooth-mini .tooth-btn{width:19px; min-width:19px; height:19px; border-radius:2px; padding:0; border:1px solid #cbd5e1; background:#fff; color:#334155; cursor:pointer; font-weight:800; font-size:6.7px; line-height:17px;}
        .ref-tooth-mini .tooth-btn.selected{background:#1565c0; color:#fff; border-color:#1565c0;}
        .ref-tooth-mini .tooth-mid-gap{width:3px; flex:0 0 3px;}
        .ref-tooth-quadrant{gap:3px; padding:5px 8px;}
        .ref-tooth-quadrant.left{padding-right:14px}
        .ref-tooth-quadrant.right{padding-left:14px}
        .ref-tooth-cell{gap:0;}
        .ref-tooth-cell .tooth-number-top{display:none!important;}
        .ref-tooth-cell .tooth-btn{width:24px; min-width:24px; height:24px; font-size:8.5px; line-height:22px; font-weight:900;}
        .ref-tooth-mini{display:grid!important;grid-template-columns:1fr 1fr!important;border:0!important;padding:0!important}
        .ref-tooth-mini .tooth-unified-row{display:none!important}
        .ref-order-page{max-width:1180px;margin:0 auto}
        .ref-order-top{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:18px}
        .ref-order-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
        .ref-stl{padding:10px 12px}
        .ref-stl-baslik{font-size:11px;font-weight:900;letter-spacing:.6px;color:#23354d;margin-bottom:8px}
        .ref-stl-izgara{display:grid;grid-template-columns:repeat(var(--stl-adet,3),1fr);gap:10px}
        .ref-stl figure{margin:0;border:1px solid #cbd5e1;border-radius:8px;padding:6px;text-align:center;background:#fff;break-inside:avoid}
        .ref-stl img{width:100%;max-width:var(--stl-max,100%);aspect-ratio:1/1;object-fit:contain;height:auto;display:block;margin:0 auto}
        .ref-stl figcaption{font-size:11px;font-weight:900;color:#23354d;margin-top:4px;letter-spacing:.4px}
        .ref-stl-ara{height:10px}
        .ref-stl-dosyalar{font-size:9.5px;color:#334155;margin-top:8px;line-height:1.45;word-break:break-word}
        .ref-stl figcaption small{display:block;font-weight:600;color:#64748b;font-size:9px;letter-spacing:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .ref-order-paper{max-width:760px;margin:0 auto;background:#fff;border:1px solid #dbe3ef;box-shadow:0 8px 28px rgba(15,23,42,.08);padding:24px}
        .ref-order-brand{display:grid;grid-template-columns:150px 1fr;align-items:center;gap:20px;border-bottom:2px solid #172033;padding-bottom:14px;margin-bottom:14px}
        .ref-order-logo{font-size:34px;font-weight:1000;letter-spacing:-2px;text-align:center;color:#0b1d36}
        .ref-order-logo small{display:block;font-size:9px;letter-spacing:.4px;font-weight:800;margin-top:2px}
        .ref-order-logo .ref-firma-img{display:block;max-width:100%;max-height:72px;object-fit:contain;margin:0 auto 4px}
        .ref-order-logo small.ref-firma-ad{font-size:11.5px;letter-spacing:.1px;font-weight:1000}
        .ref-firma-il{text-align:center;font-size:9.5px;color:#334155;margin-top:6px;line-height:1.45;font-weight:600}
        .ref-firma-alt{margin-top:10px;padding-top:6px;border-top:1px solid #cbd5e1;font-size:9.5px;color:#475569;text-align:center;white-space:pre-wrap}
        .an-mail-bant{max-width:760px;margin:0 auto 10px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a;border-radius:12px;padding:10px 14px;font-size:13px;font-weight:700;display:flex;justify-content:space-between;gap:10px;align-items:center}
        .an-mail-bant button{border:0;background:none;color:#1e40af;font-weight:900;cursor:pointer}
        .ref-tooth-mini{display:grid;grid-template-columns:1fr 1fr;border-left:1px solid #26364d;border-right:1px solid #26364d}
        .ref-tooth-mini .quad{padding:5px;display:flex;gap:3px;justify-content:center;flex-wrap:wrap}
        .ref-tooth-mini .quad:nth-child(1),.ref-tooth-mini .quad:nth-child(2){border-bottom:1px solid #26364d}
        .ref-tooth-mini .quad:nth-child(1),.ref-tooth-mini .quad:nth-child(3){border-right:1px solid #26364d}
        .ref-tooth-mini button{width:25px;height:25px;padding:0;border:1px solid #cbd5e1;background:#fff;font-size:9px;font-weight:800;cursor:pointer}
        .ref-tooth-mini button.selected{background:#1565c0;color:#fff;border-color:#1565c0}
        .ref-form-title{text-align:center;font-size:13px;letter-spacing:4px;font-weight:1000;color:#0b1d36;margin:8px 0 0}
        .ref-box{border:1.5px solid #23354d;margin-top:10px}
        .ref-grid-2{display:grid;grid-template-columns:1fr 1fr}
        .ref-grid-2>*:first-child{border-right:1px solid #23354d}
        .ref-field{padding:9px 12px;min-height:58px}
        .ref-field label,.ref-section-label{display:block;font-size:10px;font-weight:1000;letter-spacing:.35px;color:#10233e;margin-bottom:5px}
        .ref-field input,.ref-field select,.ref-field textarea{width:100%;border:0;border-bottom:1px dotted #8b9bb0;border-radius:0;background:transparent;padding:5px 2px;font-weight:800;color:#10233e;outline:none}
        .ref-field textarea{border:0;min-height:80px;resize:vertical;font-weight:600}
        .ref-job-box{padding:9px 12px}
        .ref-job-row{display:grid;grid-template-columns:minmax(0,1fr) 70px 34px;gap:7px;margin-bottom:7px;align-items:center}
        .ref-job-row select,.ref-job-row input{height:34px;border:1px solid #cbd5e1;border-radius:7px;padding:5px 9px;background:#fff;font-weight:800}
        .ref-job-row button{height:34px;border:1px solid #fecaca;background:#fff;color:#ef4444;border-radius:7px;font-size:18px;cursor:pointer}
        .ref-add-line{border:1px dashed #93c5fd;background:#eff6ff;color:#1565c0;border-radius:7px;padding:7px 10px;font-size:11px;font-weight:900;cursor:pointer}
        .ref-help{font-size:9px;color:#718096;margin-top:6px}
        .ref-materials{display:grid;gap:6px;padding-top:2px}
        .ref-materials label{display:flex;align-items:center;gap:7px;font-size:11px;font-weight:900;color:#172033;margin:0}
        .ref-materials input{width:auto;margin:0}
        .ref-selected-teeth{margin-top:10px;background:#f1f5f9;padding:8px 10px;font-size:10px;font-weight:800;color:#475569}
        .ref-history{max-width:760px;margin:18px auto 0;background:#fff;border:1px solid #dbe3ef;border-radius:14px;padding:14px}
        .ref-history-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
        .ref-history-head strong{font-size:13px}
        .ref-history-search{max-width:220px;height:34px;border:1px solid #dbe3ef;border-radius:8px;padding:0 10px}
        .ref-member-count{font-size:15px;font-weight:1000;text-align:center;padding:5px;border-bottom:1px dotted #8b9bb0;color:#10233e}
        @@media(max-width:800px){
            .ref-order-top{flex-direction:column}
            .ref-order-actions{justify-content:flex-start}
            .ref-order-paper{padding:12px}
            .ref-order-brand{grid-template-columns:1fr}
            .ref-grid-2{grid-template-columns:1fr}
            .ref-grid-2>*:first-child{border-right:0;border-bottom:1px solid #23354d}
        }
        body.a5-olcum #siparisFormu .ref-order-paper{width:760px!important;max-width:none!important;padding:24px!important}
        body.a5-olcum .ref-order-paper .ref-order-brand{grid-template-columns:150px 1fr!important}
        body.a5-olcum .ref-order-paper .ref-grid-2{grid-template-columns:1fr 1fr!important}
        body.a5-olcum .ref-order-paper .ref-grid-2>*:first-child{border-right:1px solid #23354d!important;border-bottom:0!important}
        @@media print{
            #siparisFormu,#siparisFormu *{visibility:visible!important}
            #siparisFormu{position:absolute;left:0;top:0;width:100%;background:#fff}
            .sidebar,.ref-order-top,.ref-history,.global-new-job,.ai-fab,.ai-panel{display:none!important}
            .ref-order-paper{box-shadow:none;border:0;max-width:100%;padding:0}
            body.print-a5,body.print-a5 .app,body.print-a5 .main{background:#fff!important}
            body.print-a5 #siparisFormu{padding:0!important;margin:0!important}
            body.print-a5 #siparisFormu .ref-order-paper{zoom:var(--a5-zoom,1);width:var(--a5-width,760px)!important;max-width:none!important;margin:0 auto!important;padding:24px!important;border:1px solid #dbe3ef!important;box-shadow:none!important}
            body.print-a5 .ref-order-paper .ref-order-brand{grid-template-columns:150px 1fr!important}
            body.print-a5 .ref-order-paper .ref-grid-2{grid-template-columns:1fr 1fr!important}
            body.print-a5 .ref-order-paper .ref-grid-2>*:first-child{border-right:1px solid #23354d!important;border-bottom:0!important}
            body.print-a5 .ref-order-paper, body.print-a5 .ref-order-paper *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
            body.print-a5 .ref-order-paper .ref-box{break-inside:avoid}
            body.print-a5 .ref-order-paper textarea{resize:none;overflow:hidden!important}
            body.print-a5 .ref-order-paper .ref-add-line, body.print-a5 .ref-order-paper .ref-help, body.print-a5 .ref-order-paper .an-kalem-sil{display:none!important}
            body.print-a5 .ref-order-paper select{-webkit-appearance:none!important;appearance:none!important;background-image:none!important}
            body.print-a5 .ref-order-paper input[type=date]::-webkit-calendar-picker-indicator{display:none!important}
            body.print-a5 .job-slip, body.print-a5 .delivery-slip{display:none!important}
        }
        .tooth-grid{display:grid; grid-template-columns:repeat(8,36px); gap:5px; justify-content:start; margin-top:8px;}
        .tooth-btn{width:36px; height:36px; border-radius:8px; border:1px solid #cbd5e1; background:#fff; color:#334155; cursor:pointer; font-weight:800; font-size:11px;}
        .tooth-btn.selected{background:#0f172a; color:#fff; border-color:#0f172a;}
        @@media(max-width:900px){
            .tooth-grid{grid-template-columns:repeat(4,36px)}
        }
        /* İş Akışı: sipariş formu düzeni, kayıtlı (salt okunur) form ve yazdırma */
        #siparisFormu .ref-order-paper{background:#fff}
        .sf-bant{max-width:760px;margin:0 auto 10px;background:var(--blue-soft);border:1px solid #bfdbfe;color:#1e3a8a;border-radius:12px;padding:9px 12px;font-size:13px;font-weight:700;display:flex;justify-content:space-between;gap:10px;align-items:center;flex-wrap:wrap}
        .ref-order-paper.sf-salt select,.ref-order-paper.sf-salt input,.ref-order-paper.sf-salt textarea,.ref-order-paper.sf-salt .tooth-btn{pointer-events:none}
        .ref-order-paper.sf-salt .ref-add-line,.ref-order-paper.sf-salt .ref-help,.ref-order-paper.sf-salt .an-kalem-sil{display:none!important}
        #anFormHistoryBody tr{cursor:pointer}
        @@media print{
            html,body{background:#fff!important}
            body *{visibility:hidden!important}
            .ust,.arac,.sf-bant,.toast,.perde,.cekmece,.oniz{display:none!important}
        }
    </style>
    <script>window.FIRMA_FORM = @Html.Raw(Firma.IstemciJson());</script>
</head>
<body>

<section id="girisEkrani" class="giris hidden">
    <form class="giris-kutu" onsubmit="girisYap(event)">
        @if (firmaLogo != null) { <img class="logo-img" src="@firmaLogo" alt="@firmaAd" /> } else { <div class="logo-kisa">@firmaKisa</div> }
        <h1>İş Akışı Paneli</h1>
        <p>@firmaAd · gelen işlerin takibi ve organizasyonu</p>
        <label for="gKullanici">Kullanıcı adı</label>
        <input id="gKullanici" class="inp" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        <label for="gParola">Şifre</label>
        <input id="gParola" class="inp" type="password" autocomplete="current-password" required />
        <label style="display:flex;gap:8px;align-items:center;font-weight:700;color:var(--ink)"><input id="gHatirla" type="checkbox" /> Bu cihazda beni hatırla (30 gün)</label>
        <button class="btn" type="submit" style="width:100%;margin-top:14px;height:44px">Giriş Yap</button>
        <div id="gMesaj" class="msg err hidden"></div>
        <p style="margin-top:14px;font-size:12px">Hesabınızı laboratuvar yöneticisi açar (ana program › Ayarlar › İş Akışı Paneli Hesapları).</p>
    </form>
</section>

<section id="uygulama" class="hidden">
    <header class="ust"><div class="ust-ic">
        <div class="marka">
            @if (firmaLogo != null) { <img src="@firmaLogo" alt="" /> }
            <div><b>@firmaAd</b><small>İŞ AKIŞI PANELİ</small></div>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
            <span id="kimAd" style="font-weight:800;font-size:13px"></span>
            <button class="btn btn-light" type="button" onclick="yukle()" title="Yenile">⟳</button>
            <button class="btn btn-light" type="button" onclick="cikis()">Çıkış</button>
        </div>
    </div></header>

    <div class="arac">
        <input id="ara" class="inp" placeholder="🔍 Hasta, hekim, iş no, iş türü..." oninput="ciz()" />
        <span class="ayrac"></span>
        <div id="kaynakCipler" style="display:flex;gap:6px;flex-wrap:wrap"></div>
        <span class="ayrac"></span>
        <div id="hizliCipler" style="display:flex;gap:6px;flex-wrap:wrap"></div>
        <span class="ayrac"></span>
        <button class="cip" id="gorunumBtn" type="button" onclick="gorunumDegis()">☰ Liste</button>
        <span style="flex:1"></span>
        <button class="cip" type="button" onclick="formlarAc('tamam')" title="Tamamlanan işler (panoda gösterilmez)">🏁 Tamamlananlar <span class="say" id="tamamSay"></span></button>
        <button class="cip" type="button" onclick="formlarAc('hepsi')" title="Geçmişte açılmış tüm sipariş formları">📄 Sipariş Formları</button>
        <button class="cip" type="button" onclick="window.open('/hekim-portal?mod=akis','_blank')" title="Tarama dosyası / link ekleyerek sipariş (hekim portalı formu)">📎 Dosyalı Sipariş</button>
        <button class="btn" type="button" style="height:32px" onclick="sfYeni()" title="Ana programdaki Sipariş Formu ile aynı form">＋ Yeni Sipariş</button>
    </div>

    <div id="pano" class="pano"></div>
    <div id="liste" class="liste hidden"></div>

    <!-- Sipariş formları / tamamlananlar (ihtiyaç olunca açılır) -->
    <div id="formlar" class="hidden" style="padding:12px 16px">
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px">
            <button class="btn btn-light" type="button" onclick="formlarKapat()">← Panoya dön</button>
            <b style="font-size:16px" id="formlarBaslik">📄 Sipariş Formları</b>
            <span style="flex:1"></span>
            <input id="fAra" class="inp" style="max-width:260px" placeholder="🔍 Hasta, hekim, iş no..." oninput="formlarCiz()" />
            <select id="fDurum" class="inp" style="max-width:170px" onchange="formlarCiz()"><option value="hepsi">Tüm durumlar</option><option value="devam">Devam eden</option><option value="tamam">Tamamlanan</option><option value="onay">Onay bekleyen</option></select>
            <select id="fKaynak" class="inp" style="max-width:170px" onchange="formlarCiz()"><option value="hepsi">Tüm kaynaklar</option><option value="Hekim">🦷 Hekim Portalı</option><option value="Mail">📧 Mail</option><option value="Manuel">✍️ Manuel</option><option value="Teknisyen">🛠 Teknisyen</option></select>
            <input id="fBas" class="inp" type="date" style="max-width:150px" title="Başlangıç" onchange="formlarCiz()" />
            <input id="fBit" class="inp" type="date" style="max-width:150px" title="Bitiş" onchange="formlarCiz()" />
        </div>
        <div id="formlarListe" class="liste" style="padding:0"></div>
    </div>

    <!-- Sipariş Takip Formu: ana programdaki (admin) Sipariş Formu ile aynı şablon, aynı A5 çıktı -->
    <div id="siparisFormu" class="hidden" style="padding:12px 16px">
        <div class="ref-order-page">
            <div class="ref-order-top">
                <div>
                    <h1 class="page-title" style="margin:0;font-size:22px">📝 Sipariş Takip Formu</h1>
                    <div class="page-subtitle" id="sfAltBaslik" style="color:var(--muted);font-size:13px;margin-top:4px">Yeni gelen iş için sipariş formu doldurun — onay bekleyen işlere otomatik atanacaktır.</div>
                </div>
                <div class="ref-order-actions">
                    <button type="button" class="btn btn-light" onclick="sfKapat()">← Panoya Dön</button>
                    <button type="button" class="btn btn-light" onclick="sfYeni()">▣ Yeni Form</button>
                    <button id="sfTemizleBtn" type="button" class="btn btn-light" onclick="sfTemizle(false)">🗑 Temizle</button>
                    <button id="sfYazdirBtn" type="button" class="btn btn-light" onclick="sfYazdir()" disabled>▣ Yazdır</button>
                    <button id="sfKaydetBtn" type="button" class="btn" onclick="sfKaydet()">☁ Onaya Gönder</button>
                </div>
            </div>
            <div id="sfBant" class="sf-bant hidden"></div>
                <div class="ref-order-paper">
                    <div class="ref-order-brand">
                        <div class="ref-order-logo" id="anFirmaLogo"></div>
                        <div>
                            <div id="anDisSemasi" class="ref-tooth-mini"></div>
                            <div class="ref-form-title">SİPARİŞ TAKİP FORMU</div>
                            <div id="anFirmaIletisim" class="ref-firma-il"></div>
                        </div>
                    </div>

                    <div class="ref-box ref-grid-2">
                        <div class="ref-field">
                            <label>KLİNİK / HEKİM</label>
                            <select id="anHekim" onchange="sfHekimDegisti()">
                                <option value="">— HEKİM SEÇİN —</option>
                            </select>
                        </div>
                        <div class="ref-field">
                            <label>HASTA ADI - SOYADI</label>
                            <input id="anHasta" type="text" maxlength="150" autocomplete="off" />
                        </div>
                    </div>

                    <div class="ref-box ref-job-box">
                        <span class="ref-section-label">İŞ TÜRÜ / KALEMLERİ</span>
                        <div id="anKalemler"></div>
                        <button type="button" class="ref-add-line" onclick="sfKalemEkle()">+ Kalem Ekle</button>
                        <div class="ref-help">TL, EUR ve USD aynı formda birlikte kullanılabilir. Sistem para birimlerine göre ayrı iş kayıtları oluşturur; hekim, hasta, termin, renk, diş ve not bilgilerini aynen korur.</div>
                    </div>

                    <div class="ref-box ref-grid-2">
                        <div>
                            <div class="ref-field">
                                <label>RENK</label>
                                <input id="anDisRengi" type="text" maxlength="50" list="disRengiSecenekleri" placeholder="A2 / A3.5 / BL1" />
                            </div>
                            <div class="ref-field">
                                <label>ÜYE SAYISI</label>
                                <div id="anUyeSayisi" class="ref-member-count">—</div>
                            </div>
                            <div class="ref-field">
                                <label>TESLİM TARİHİ</label>
                                <input id="anTermin" type="date" />
                            </div>
                        </div>
                        <div class="ref-field">
                            <label>MATERYAL</label>
                            <input id="anMateryal" type="hidden" />
                            <div class="ref-materials">
                                <label><input type="radio" name="anMateryalRadio" value="Zirkonyum" onchange="sfMateryalSec(this)"> ZİRKONYA</label>
                                <label><input type="radio" name="anMateryalRadio" value="Metal Destekli Porselen" onchange="sfMateryalSec(this)"> METAL DESTEKLİ PORSELEN</label>
                                <label><input type="radio" name="anMateryalRadio" value="E.max" onchange="sfMateryalSec(this)"> EMAX</label>
                                <label><input type="radio" name="anMateryalRadio" value="Lamine" onchange="sfMateryalSec(this)"> LAMİNE</label>
                                <label><input type="radio" name="anMateryalRadio" value="PMMA" onchange="sfMateryalSec(this)"> PMMA</label>
                                <label><input type="radio" name="anMateryalRadio" value="Titanyum" onchange="sfMateryalSec(this)"> TİTANYUM</label>
                            </div>
                        </div>
                    </div>

                    <div class="ref-box">
                        <div class="ref-field">
                            <label>NOTLAR</label>
                            <textarea id="anNot" maxlength="2000"></textarea>
                        </div>
                    </div>

                    <div id="anStlGorseller" class="ref-box ref-stl" style="display:none"></div>

                    <div id="anSelectedTeeth" class="ref-selected-teeth">Seçilen Dişler: —</div>
                    <div id="anFirmaAltNot" class="ref-firma-alt" style="display:none"></div>
                </div>

            <div class="ref-history">
                <div class="ref-history-head">
                    <strong>📋 Geçmiş Sipariş Formları</strong>
                    <input id="anFormHistorySearch" class="ref-history-search" type="text" placeholder="🔍 Hekim / hasta / iş no ara..." oninput="sfGecmisCiz()" />
                </div>
                <div class="liste" style="padding:0">
                    <table>
                        <thead><tr><th>İş</th><th>Tarih</th><th>Hekim</th><th>Hasta</th><th>İş</th><th>Üye</th><th>İşlem</th></tr></thead>
                        <tbody id="anFormHistoryBody"></tbody>
                    </table>
                </div>
                <div style="text-align:right;margin-top:8px"><button type="button" class="btn btn-light" style="height:32px" onclick="formlarAc('hepsi')">📄 Tüm sipariş formları →</button></div>
            </div>
        </div>
    </div>
    <datalist id="disRengiSecenekleri">
        <option value="A1"></option><option value="A2"></option>
        <option value="A3"></option><option value="A3.5"></option>
        <option value="A4"></option><option value="B1"></option>
        <option value="B2"></option><option value="B3"></option>
        <option value="B4"></option><option value="C1"></option>
        <option value="C2"></option><option value="C3"></option>
        <option value="C4"></option><option value="D2"></option>
        <option value="D3"></option><option value="D4"></option>
        <option value="BL1"></option><option value="BL2"></option>
        <option value="BL3"></option><option value="BL4"></option>
        <option value="OM1"></option><option value="OM2"></option>
        <option value="OM3"></option>
    </datalist>
</section>

<div id="perde" class="perde hidden" onclick="cekmeceKapat()"></div>
<aside id="cekmece" class="cekmece hidden"></aside>
<div id="toast" class="toast hidden"></div>
<div id="oniz" class="oniz hidden" onmouseenter="onizlemeKalsin()" onmouseleave="onizlemeGizle()"><canvas id="onizTuval" width="648" height="648"></canvas><div id="onizAd"></div></div>

<script>
    const FIRMA = { ad: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(firmaAd)), logo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(firmaLogo)), iletisim: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Firma.IletisimSatiri())) };
    const $ = id => document.getElementById(id);
    const esc = v => String(v == null ? "" : v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const tarih = v => v ? new Date(v).toLocaleDateString("tr-TR") : "-";
    const tarihSaat = v => v ? new Date(v).toLocaleString("tr-TR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) : "-";
    const boyut = b => { b = Number(b || 0); return b >= 1048576 ? (b / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(b / 1024)) + " KB"; };
    let isler = [], teknisyenler = [], durumlar = [], kaynakF = "hepsi", hizliF = "", gorunum = "pano", acikIs = null, yenileZaman = null;

    const SUTUNLAR = [
        { k: "onay", ad: "📥 Onay Bekleyen" },
        { k: "bekliyor", ad: "⏳ Bekliyor" },
        { k: "tasarim", ad: "📐 Tasarımda" },
        { k: "uretim", ad: "🏭 Üretimde" },
        { k: "kontrol", ad: "✅ Admin Onayında" }
    ];
    const KAYNAK = { Hekim: "🦷 Hekim Portalı", Mail: "📧 Mail", Manuel: "✍️ Manuel", Teknisyen: "🛠 Teknisyen" };
    function sutun(x) {
        if (x.onayDurumu === "Gelen Onay") return "onay";
        if (x.durum === "Tamamlandı") return "tamam";
        if (x.durum === "Tamamlama Onayı") return "kontrol";
        if (x.durum === "Tasarımda") return "tasarim";
        if (["Üretimde", "Makyajda", "Devam Ediyor"].includes(x.durum)) return "uretim";
        return "bekliyor";
    }
    function gunFarki(v) { if (!v) return null; const a = new Date(); a.setHours(0,0,0,0); const b = new Date(v); b.setHours(0,0,0,0); return Math.round((b - a) / 864e5); }
    function geciken(x) { const g = gunFarki(x.terminTarihi); return g !== null && g < 0 && sutun(x) !== "tamam"; }

    function toast(t, hata) { const e = $("toast"); e.textContent = t; e.className = "toast" + (hata ? " err" : ""); clearTimeout(e._z); e._z = setTimeout(() => e.classList.add("hidden"), 3200); }

    async function api(url, opt) {
        const r = await fetch(url, Object.assign({ cache: "no-store", credentials: "same-origin" }, opt || {}));
        if (r.status === 401) { girisGoster(); throw new Error("Oturum kapandı, tekrar giriş yapın."); }
        if (!r.ok) throw new Error((await r.text()) || ("İşlem yapılamadı (" + r.status + ")"));
        const t = r.headers.get("content-type") || "";
        return t.includes("json") ? r.json() : r.text();
    }
    const post = (url, govde) => api(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(govde || {}) });

    function girisGoster() { $("uygulama").classList.add("hidden"); $("girisEkrani").classList.remove("hidden"); clearInterval(yenileZaman); }
    async function girisYap(e) {
        e.preventDefault(); $("gMesaj").classList.add("hidden");
        try {
            await post("/api/is-akisi/giris", { kullaniciAdi: $("gKullanici").value, parola: $("gParola").value, hatirla: $("gHatirla").checked });
            $("gParola").value = ""; basla();
        } catch (err) { $("gMesaj").textContent = err.message; $("gMesaj").classList.remove("hidden"); }
    }
    async function cikis() { try { await post("/api/is-akisi/cikis"); } catch {} girisGoster(); }

    async function basla() {
        let ben;
        try { const r = await fetch("/api/is-akisi/ben", { cache: "no-store" }); if (!r.ok) { girisGoster(); return; } ben = await r.json(); }
        catch { girisGoster(); return; }
        durumlar = ben.durumlar || [];
        $("kimAd").textContent = "👤 " + ben.adSoyad;
        $("girisEkrani").classList.add("hidden"); $("uygulama").classList.remove("hidden");
        try { teknisyenler = await api("/api/is-akisi/teknisyenler"); } catch {}
        await yukle();
        clearInterval(yenileZaman);
        yenileZaman = setInterval(() => { if (document.visibilityState === "visible") yukle(true); }, 30000);
    }

    async function yukle(sessiz) {
        try { isler = await api("/api/is-akisi/isler"); ciz(); if (acikIs && !sessiz) cekmeceCiz(); }
        catch (err) { if (!sessiz) toast(err.message, true); }
    }

    function filtrele() {
        const q = $("ara").value.trim().toLocaleLowerCase("tr-TR");
        return isler.filter(x => (kaynakF === "hepsi" || x.kaynak === kaynakF) &&
            sutun(x) !== "tamam" &&
            (!hizliF || (hizliF === "atanmamis" && !x.teknisyenId && !["onay", "tamam"].includes(sutun(x))) ||
                (hizliF === "geciken" && geciken(x)) ||
                (hizliF === "bugun" && gunFarki(x.terminTarihi) === 0 && sutun(x) !== "tamam") ||
                (hizliF === "mesaj" && x.okunmamisMesaj > 0)) &&
            (!q || [x.hastaAdi, x.hekimAdi, x.klinikAdi, x.teknisyenAdi, "#" + x.id, String(x.id), ...(x.kalemler || []).map(k => k.isTuru)]
                .some(v => String(v || "").toLocaleLowerCase("tr-TR").includes(q))));
    }

    function ciplerCiz() {
        const say = k => isler.filter(x => x.kaynak === k).length;
        $("kaynakCipler").innerHTML = [["hepsi", "Tümü", isler.length], ...Object.keys(KAYNAK).map(k => [k, KAYNAK[k], say(k)])]
            .map(([k, ad, n]) => `<button type="button" class="cip ${kaynakF === k ? "on" : ""}" onclick="kaynakF='${k}';ciz()">${ad}<span class="say">${n}</span></button>`).join("");
        const h = [
            ["atanmamis", "👤 Atanmamış", isler.filter(x => !x.teknisyenId && !["onay", "tamam"].includes(sutun(x))).length],
            ["geciken", "⏰ Geciken", isler.filter(geciken).length],
            ["bugun", "📅 Bugün teslim", isler.filter(x => gunFarki(x.terminTarihi) === 0 && sutun(x) !== "tamam").length],
            ["mesaj", "💬 Yeni mesaj", isler.filter(x => x.okunmamisMesaj > 0).length]
        ];
        $("hizliCipler").innerHTML = h.map(([k, ad, n]) => `<button type="button" class="cip ${hizliF === k ? "on" : ""}" onclick="hizliF=hizliF==='${k}'?'':'${k}';ciz()">${ad}<span class="say">${n}</span></button>`).join("");
    }

    function terminRozet(x) {
        if (!x.terminTarihi) return '<span class="rozet">Termin yok</span>';
        const g = gunFarki(x.terminTarihi), tm = sutun(x) === "tamam";
        const cls = tm ? "" : g < 0 ? "kirmizi" : g <= 1 ? "sari" : "";
        const ek = tm ? "" : g < 0 ? ` (${-g} gün gecikti)` : g === 0 ? " (bugün)" : g === 1 ? " (yarın)" : "";
        return `<span class="rozet ${cls}">📅 ${tarih(x.terminTarihi)}${ek}</span>`;
    }
    function dosyaRozet(x) {
        return (x.tarama ? `<span class="rozet">🦷 ${x.tarama}</span>` : "") + (x.tasarim ? `<span class="rozet mavi">📐 ${x.tasarim}</span>` : "") +
            (x.yazici ? `<span class="rozet mor">🖨️ ${x.yazici}</span>` : "") + (x.diger ? `<span class="rozet">📎 ${x.diger}</span>` : "") +
            (x.linkSayisi ? `<span class="rozet mor">🔗 ${x.linkSayisi}</span>` : "") +
            (x.okunmamisMesaj ? `<span class="rozet kirmizi">💬 ${x.okunmamisMesaj} yeni</span>` : x.mesajSayisi ? `<span class="rozet">💬 ${x.mesajSayisi}</span>` : "");
    }
    const kalemMetni = x => (x.kalemler || []).map(k => esc(k.isTuru) + " × " + k.adet).join(", ") || "-";

    function kartCiz(x) {
        const tek = x.teknisyenAdi ? `<span class="rozet yesil">🛠 ${esc(x.teknisyenAdi)}</span>` : (["onay", "tamam"].includes(sutun(x)) ? "" : '<span class="rozet sari">👤 Atanmamış</span>');
        return `<div class="kart ${geciken(x) ? "gec" : ""} ${/acil/i.test(x.oncelik) ? "acil" : ""}" onclick="cekmeceAc(${x.id})">
