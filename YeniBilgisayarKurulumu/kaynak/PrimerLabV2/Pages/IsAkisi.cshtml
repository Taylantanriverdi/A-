    }
    // Simetrik 3x3 matrisin özvektörleri (Jacobi); büyükten küçüğe sıralı.
    function stlOzvektor(A){
        let a=A.map(x=>x.slice()), v=[[1,0,0],[0,1,0],[0,0,1]];
        for(let it=0;it<50;it++){
            let p=0,q=1; if(Math.abs(a[0][2])>Math.abs(a[p][q])){p=0;q=2;} if(Math.abs(a[1][2])>Math.abs(a[p][q])){p=1;q=2;}
            if(Math.abs(a[p][q])<1e-12) break;
            const th=0.5*Math.atan2(2*a[p][q],a[q][q]-a[p][p]), c=Math.cos(th), s=Math.sin(th);
            for(let k=0;k<3;k++){ const akp=a[k][p], akq=a[k][q]; a[k][p]=c*akp-s*akq; a[k][q]=s*akp+c*akq; }
            for(let k=0;k<3;k++){ const apk=a[p][k], aqk=a[q][k]; a[p][k]=c*apk-s*aqk; a[q][k]=s*apk+c*aqk; }
            for(let k=0;k<3;k++){ const vkp=v[k][p], vkq=v[k][q]; v[k][p]=c*vkp-s*vkq; v[k][q]=s*vkp+c*vkq; }
        }
        return [0,1,2].map(i=>({d:a[i][i],v:[v[0][i],v[1][i],v[2][i]]})).sort((x,y)=>y.d-x.d);
