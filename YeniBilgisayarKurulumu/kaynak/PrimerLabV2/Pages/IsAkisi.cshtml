    const STL_RENK_TASARIM=[0.98,0.62,0.12], STL_RENK_MODEL=[0.70,0.72,0.74];
    async function stlGorselleriHazirla(isId){
        const kutu=document.getElementById('anStlGorseller'); if(!kutu) return;
        stlGorselAlaniTemizle();
        // İş Akışı: dosyalar ve linkler panelin kendi ucundan (ana programdaki listeyle aynı kayıtlar).
        const r=await fetch('/api/is-akisi/isler/'+Number(isId)+'/dosyalar',{cache:'no-store',credentials:'same-origin'}); if(!r.ok) return;
        const dj=await r.json();
        const tumDosyalar=dj.dosyalar||[];
        const linkler=dj.linkler||[];
        const tumu=tumDosyalar.filter(f=>/\.(stl|ply|obj)$/i.test(f.orijinalDosyaAdi||''));
        // Görüntü çizilemeyen dosyalar ve hekimin paylaştığı linkler de kâğıtta görünsün.
        const dosyaListesi=()=>(tumDosyalar.length?`<div class="ref-stl-dosyalar"><b>Ekli dosyalar:</b> ${tumDosyalar.map(f=>escapeHtml(f.orijinalDosyaAdi)+(f.dosyaTuru&&f.dosyaTuru!=='Diger'?' ('+escapeHtml(f.dosyaTuru)+')':'')).join(' · ')}</div>`:'')
            +(linkler.length?`<div class="ref-stl-dosyalar" style="word-break:break-all"><b>Dosya linkleri:</b> ${linkler.map(l=>escapeHtml(l.servis)+': '+escapeHtml(l.url)).join(' · ')}</div>`:'');
        if(!tumu.length){ if(tumDosyalar.length||linkler.length){ kutu.innerHTML=dosyaListesi(); kutu.style.display='block'; } return; }
        // Tüm modeller önce okunur; tür etiketine değil gerçek boyuta bakılır: hekim "tasarımı ben
        // gönderiyorum" seçtiğinde ağız içi taramalar da "Tasarım" türüyle kaydedilir. Tam çene büyüklüğündeki
        // model (en uzun kenar ≥ 35 mm) tarama, kron/köprü gibi küçük parçalar tasarım sayılır.
        const hatalar=[];
        const yuklu=[];
        for(const f of tumu.slice(0,12)){
            try{
                const m=await stlHamMesh(Number(f.id)), p=m.p, a=[Infinity,Infinity,Infinity], b=[-Infinity,-Infinity,-Infinity];
                for(let i=0;i<p.length;i+=3) for(let k=0;k<3;k++){ if(p[i+k]<a[k])a[k]=p[i+k]; if(p[i+k]>b[k])b[k]=p[i+k]; }
                yuklu.push({f,m,boy:Math.max(b[0]-a[0],b[1]-a[1],b[2]-a[2])});
            }catch(e){ console.warn(e); hatalar.push(f.orijinalDosyaAdi+': '+(e.message||e)); }
        }
        // Gerçek taramalar (tarama türlü) zaten iki çeneyi karşılıyorsa büyük "Tasarım" dosyası tam çene tasarımıdır.
        const gercekTarama=yuklu.filter(x=>(x.f.dosyaTuru||'')!=='Tasarım').length;
        const tasarimMi=x=>(x.f.dosyaTuru||'')==='Tasarım' && (x.boy<35 || gercekTarama>=2);
        const taramaYuklu=yuklu.filter(x=>!tasarimMi(x)), tasarimYuklu=yuklu.filter(tasarimMi);
        const dosyalar=taramaYuklu.map(x=>x.f);
        const meshBul=f=>yuklu.find(x=>x.f===f)?.m;
        showSuccess('Tarama ve tasarım görüntüleri hazırlanıyor...');
        const tur={ust:null,alt:null,kapanis:null}, diger=[];
        for(const f of dosyalar){ const t=stlTurBul(f.orijinalDosyaAdi); if(t && !tur[t]) tur[t]=f; else diger.push(f); }
        // Adı tanınmayan dosyalar sırayla boş yerlere (üst, alt) yerleşir; ad yine altta yazar.
        for(const f of diger){ if(!tur.ust) tur.ust=f; else if(!tur.alt) tur.alt=f; }
        const mesh={};
        for(const k of ['ust','alt','kapanis']) if(tur[k]) mesh[k]=meshBul(tur[k]);
        const merkez=m=>{ const p=m.p; let c=[0,0,0]; for(let i=0;i<p.length;i+=3){ c[0]+=p[i]; c[1]+=p[i+1]; c[2]+=p[i+2]; } return stlV.sc(c,3/p.length); };
        const sinir=m=>{ const p=m.p, a=[Infinity,Infinity,Infinity], b=[-Infinity,-Infinity,-Infinity]; for(let i=0;i<p.length;i+=3) for(let k=0;k<3;k++){ if(p[i+k]<a[k])a[k]=p[i+k]; if(p[i+k]>b[k])b[k]=p[i+k]; } return {a,b}; };
        const mU=mesh.ust?merkez(mesh.ust):null, mA=mesh.alt?merkez(mesh.alt):null;
        // Çene eksenleri: önce taramaların kapanış konumunda olup olmadığı karşı çeneye göre denetlenir.
        let eu=mesh.ust?stlCeneEksen(mesh.ust,mA):null, ea=mesh.alt?stlCeneEksen(mesh.alt,mU):null;
        const kapanisKonumu=!!(eu&&ea) && stlKapanisKonumunda(mesh.ust,eu,mesh.alt,ea);
        if(eu&&ea&&!kapanisKonumu){ eu=stlCeneEksen(mesh.ust); ea=stlCeneEksen(mesh.alt); }
        const resimler=[];
        const guvenli=(ad,f)=>{ try{ return f(); }catch(e){ console.warn(e); hatalar.push(ad+': '+(e.message||e)); return null; } };
        // Tepeden (okluzal) görünüm, kesici dişler yukarıda.
        if(mesh.ust){ resimler.push({ad:'ÜST ÇENE',dosya:tur.ust.orijinalDosyaAdi,src:guvenli('Üst çene',()=>stlCizer.ciz([{m:mesh.ust,renk:STL_RENK_UST}],stlV.sc(eu.dik,-1),eu.der))}); }
        if(mesh.alt){ resimler.push({ad:'ALT ÇENE',dosya:tur.alt.orijinalDosyaAdi,src:guvenli('Alt çene',()=>stlCizer.ciz([{m:mesh.alt,renk:STL_RENK_ALT}],stlV.sc(ea.dik,-1),ea.der))}); }
        let onYukari=null, onIleri=null;
        if(mesh.ust && mesh.alt){
            // Kapanış: iki çene dişleri birbirine oturmuş, önden; üst çene yukarıda.
            let pu=mesh.ust, pa=mesh.alt, yukari, ileri;
            if(kapanisKonumu){
                yukari=stlV.ny([eu.c[0]-ea.c[0],eu.c[1]-ea.c[1],eu.c[2]-ea.c[2]]);
                ileri=stlV.sc(eu.der,-1); ileri=stlV.ny(stlV.ad(ileri,stlV.sc(yukari,-stlV.dot(ileri,yukari))));
                onYukari=yukari; onIleri=ileri;
            } else {
                const o=stlKapanisaOturt(mesh.ust,eu,mesh.alt,ea); pu=o.ust; pa=o.alt;
                yukari=[0,0,1]; ileri=[0,-1,0];
            }
            resimler.push({ad:'KAPANIŞ',dosya:'Üst + alt çene kapanışta (önden)',src:stlCizer.ciz([{m:pu,renk:STL_RENK_UST},{m:pa,renk:STL_RENK_ALT}],ileri,yukari)});
        } else if(mesh.kapanis){
            const e=stlCeneEksen(mesh.kapanis);
            resimler.push({ad:'KAPANIŞ',dosya:tur.kapanis.orijinalDosyaAdi,src:stlCizer.ciz([{m:mesh.kapanis,renk:STL_RENK_KAPANIS}],stlV.sc(e.der,-1),e.dik)});
        }

        // ---- Tasarım dosyaları: tarama ile aynı koordinatlardaysa kendi çenesinin üzerinde, değilse tek başına.
        const tasarimResimleri=[];
        const tMesh=[];
        try{
        tasarimYuklu.slice(0,8).forEach(x=>tMesh.push({f:x.f,m:x.m}));
        if(tMesh.length){
            const cene={ust:[],alt:[]}, serbest=[];
            const kutuU=mesh.ust?sinir(mesh.ust):null, kutuA=mesh.alt?sinir(mesh.alt):null;
            const icinde=(c,k)=>k&&[0,1,2].every(i=>c[i]>=k.a[i]-6&&c[i]<=k.b[i]+6);
            for(const t of tMesh){
                const c=merkez(t.m), ad=stlTurBul(t.f.orijinalDosyaAdi);
                let hedef=null;
                if(ad==='ust'&&icinde(c,kutuU)) hedef='ust';
                else if(ad==='alt'&&icinde(c,kutuA)) hedef='alt';
                else {
                    const u=icinde(c,kutuU), a=icinde(c,kutuA);
                    if(u&&a) hedef=Math.hypot(...stlV.ad(c,stlV.sc(mU,-1)))<=Math.hypot(...stlV.ad(c,stlV.sc(mA,-1)))?'ust':'alt';
                    else hedef=u?'ust':a?'alt':null;
                }
                if(hedef) cene[hedef].push(t); else serbest.push(t);
            }
            const adlar=l=>l.map(t=>t.f.orijinalDosyaAdi).join(', ');
            const parca=l=>l.map(t=>({m:t.m,renk:STL_RENK_TASARIM}));
            if(cene.ust.length) tasarimResimleri.push({ad:'TASARIM · ÜST ÇENE',dosya:adlar(cene.ust),src:stlCizer.ciz([{m:mesh.ust,renk:STL_RENK_MODEL},...parca(cene.ust)],stlV.sc(eu.dik,-1),eu.der)});
            if(cene.alt.length) tasarimResimleri.push({ad:'TASARIM · ALT ÇENE',dosya:adlar(cene.alt),src:stlCizer.ciz([{m:mesh.alt,renk:STL_RENK_MODEL},...parca(cene.alt)],stlV.sc(ea.dik,-1),ea.der)});
            // Önden: kapanış konumundaki çeneler ya da tasarımın oturduğu çene
            if(cene.ust.length||cene.alt.length){
                let parcalar=[], yukari, ileri;
                if(onYukari){ parcalar=[{m:mesh.ust,renk:STL_RENK_MODEL},{m:mesh.alt,renk:STL_RENK_MODEL}]; yukari=onYukari; ileri=onIleri; }
                else { const k=cene.ust.length?'ust':'alt', e=k==='ust'?eu:ea; parcalar=[{m:mesh[k],renk:STL_RENK_MODEL}];
                    yukari=k==='ust'?e.dik:stlV.sc(e.dik,-1); ileri=stlV.sc(e.der,-1); }
                tasarimResimleri.push({ad:'TASARIM · ÖNDEN',dosya:'Tasarım modelin üzerinde',src:stlCizer.ciz([...parcalar,...parca(cene.ust),...parca(cene.alt)],ileri,yukari)});
            }
            if(serbest.length){
                // Tek başına: tüm tasarım parçalarının ana eksenlerine göre üstten ve yandan.
                const nokta=[]; serbest.forEach(t=>{ const p=t.m.p, ad=Math.max(1,Math.floor(p.length/3/20000)); for(let i=0;i<p.length;i+=3*ad) nokta.push([p[i],p[i+1],p[i+2]]); });
                const c=stlV.sc(nokta.reduce((t,v)=>stlV.ad(t,v),[0,0,0]),1/nokta.length);
                const C=[[0,0,0],[0,0,0],[0,0,0]]; nokta.forEach(v=>{ const d=stlV.ad(v,stlV.sc(c,-1)); for(let a=0;a<3;a++)for(let b=0;b<3;b++)C[a][b]+=d[a]*d[b]; });
                const e=stlOzvektor(C);
                // Çiğneme yüzü: dışa dönük yüzey normallerinin alan ağırlıklı toplamı (kron kabuğu alttan açıktır).
                let n=[0,0,0];
                serbest.forEach(t=>{ const p=t.m.p, ix=t.m.idx; for(let i=0;i<ix.length;i+=3){ const a=ix[i]*3,b=ix[i+1]*3,d=ix[i+2]*3;
                    n=stlV.ad(n,stlV.cr([p[b]-p[a],p[b+1]-p[a+1],p[b+2]-p[a+2]],[p[d]-p[a],p[d+1]-p[a+1],p[d+2]-p[a+2]])); } });
                let ust=Math.hypot(...n)>1e-6?stlV.ny(n):e[2].v;
                // Uzun eksen (köprü boyu) yatay kalsın; yan görünüm uzun eksene ve yukarıya dik yönden.
                let boy=stlV.ny(stlV.ad(e[0].v,stlV.sc(ust,-stlV.dot(e[0].v,ust))));
                if(!isFinite(boy[0])) boy=e[1].v;
                const yan=stlV.ny(stlV.cr(ust,boy));
                const yer=Math.max(0,3-tasarimResimleri.length);
                if(yer>=1) tasarimResimleri.push({ad:'TASARIM · ÜSTTEN',dosya:adlar(serbest),src:stlCizer.ciz(parca(serbest),stlV.sc(ust,-1),yan)});
                if(yer>=2) tasarimResimleri.push({ad:'TASARIM · YANDAN',dosya:adlar(serbest),src:stlCizer.ciz(parca(serbest),yan,ust)});
            }
        }
        }catch(e){ console.warn(e); hatalar.push('Tasarım: '+(e.message||e)); }

        const gecerli=resimler.filter(x=>x.src), tGecerli=tasarimResimleri.filter(x=>x.src);
        if(hatalar.length) showError('Bazı dosyaların görüntüsü çizilemedi: '+hatalar.join(' | '));
        if(!gecerli.length && !tGecerli.length){ kutu.innerHTML=dosyaListesi(); kutu.style.display=tumDosyalar.length?'block':'none'; return; }
        const satir=(baslik,l)=>l.length?`<div class="ref-stl-baslik">${baslik}</div><div class="ref-stl-izgara" style="--stl-adet:3">`+l.map(x=>`<figure><img src="${x.src}" alt="${escapeHtml(x.ad)}" /><figcaption>${escapeHtml(x.ad)}<small>${escapeHtml(x.dosya||'')}</small></figcaption></figure>`).join('')+'</div>':'';
        kutu.innerHTML=satir('TARAMA GÖRÜNTÜLERİ',gecerli)+(gecerli.length&&tGecerli.length?'<div class="ref-stl-ara"></div>':'')+satir('TASARIM GÖRÜNTÜLERİ',tGecerli)+dosyaListesi();
        kutu.style.display='block';
        // Resimler yüklenmeden ölçü alınmasın.
        await Promise.all([...kutu.querySelectorAll('img')].map(i=>i.complete?null:new Promise(ok=>{i.onload=ok;i.onerror=ok;})));
    }

    document.addEventListener("keydown", e => { if (e.key === "Escape" && acikIs) cekmeceKapat(); });
    basla();
</script>
</body>
</html>
