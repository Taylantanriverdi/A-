        gl.bindBuffer(gl.ARRAY_BUFFER, m.bn); gl.enableVertexAttribArray(ln); gl.vertexAttribPointer(ln, 3, gl.FLOAT, false, 0, 0);
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, m.bi); gl.drawElements(gl.TRIANGLES, m.idx.length, gl.UNSIGNED_INT, 0);
    }

    // ---------- Sipariş formları / tamamlananlar ----------
    let tumIsler = [];
    async function formlarAc(durum) {
        $("fDurum").value = durum === "tamam" ? "tamam" : "hepsi";
        $("formlarBaslik").textContent = durum === "tamam" ? "🏁 Tamamlanan İşler" : "📄 Sipariş Formları (tümü)";
        sfGizle(); ["pano", "liste"].forEach(i => $(i).classList.add("hidden")); $("formlar").classList.remove("hidden");
        $("formlarListe").innerHTML = '<div class="bos">Yükleniyor...</div>';
        try { tumIsler = await api("/api/is-akisi/isler?tumu=true"); formlarCiz(); }
        catch (err) { $("formlarListe").innerHTML = `<div class="bos">${esc(err.message)}</div>`; }
    }
    function formlarKapat() { $("formlar").classList.add("hidden"); $(gorunum === "pano" ? "pano" : "liste").classList.remove("hidden"); ciz(); }
    function formlarCiz() {
        const q = $("fAra").value.trim().toLocaleLowerCase("tr-TR"), d = $("fDurum").value, k = $("fKaynak").value;
        const bas = $("fBas").value ? new Date($("fBas").value + "T00:00:00") : null, bit = $("fBit").value ? new Date($("fBit").value + "T23:59:59") : null;
        const l = tumIsler.filter(x => (k === "hepsi" || x.kaynak === k) &&
            (d === "hepsi" || (d === "tamam" && sutun(x) === "tamam") || (d === "onay" && sutun(x) === "onay") || (d === "devam" && !["tamam", "onay"].includes(sutun(x)))) &&
            (!bas || new Date(x.olusturmaTarihi) >= bas) && (!bit || new Date(x.olusturmaTarihi) <= bit) &&
            (!q || [x.hastaAdi, x.hekimAdi, x.klinikAdi, x.teknisyenAdi, "#" + x.id, String(x.id), ...(x.kalemler || []).map(i => i.isTuru)].some(v => String(v || "").toLocaleLowerCase("tr-TR").includes(q))));
        $("formlarListe").innerHTML = `<div style="color:var(--muted);font-size:12px;margin-bottom:6px">${l.length} kayıt</div><table><thead><tr><th>İş</th><th>Tarih</th><th>Hasta / Hekim</th><th>İş türü</th><th>Kaynak</th><th>Durum</th><th>Teknisyen</th><th>Teslim</th><th></th></tr></thead><tbody>${l.slice(0, 1000).map(x =>
            `<tr onclick="cekmeceAc(${x.id})"><td><b>#${x.id}</b></td><td>${tarih(x.olusturmaTarihi)}</td><td><b>${esc(x.hastaAdi)}</b><div style="color:var(--muted)">${esc(x.hekimAdi)}</div></td><td>${kalemMetni(x)}</td><td>${KAYNAK[x.kaynak] || esc(x.kaynak)}</td><td>${esc(x.onayDurumu === "Gelen Onay" ? "Onay bekliyor" : x.durum)}</td><td>${esc(x.teknisyenAdi || "-")}</td><td>${tarih(x.terminTarihi)}</td>
            <td style="white-space:nowrap"><button class="btn btn-light" type="button" style="height:30px" onclick="event.stopPropagation();sfGoruntule(${x.id})">📄 Form</button> <button class="btn btn-light" type="button" style="height:30px" onclick="event.stopPropagation();formYazdir(${x.id})">🖨 Yazdır</button></td></tr>`).join("") || '<tr><td colspan="9" class="bos">Kayıt yok</td></tr>'}</tbody></table>${l.length > 1000 ? '<div class="bos">İlk 1000 kayıt gösteriliyor; aramayı daraltın.</div>' : ""}`;
    }

    // ================= Sipariş Takip Formu (ana programdaki Sipariş Formu ile aynı) =================
    // Kâğıt şablonu, alanlar, diş şeması, kalem satırları, akıllı üye sayısı, "Onaya Gönder" kuralları
    // ve A5 çıktı ana programdakiyle birebir aynıdır. Tek fark: fiyat / para birimi panelde hiç yoktur;
    // sunucu hekimin iş listesinden ekler. Eski formlar aynı şablonla açılıp yeniden yazdırılır.
    const FORM_FIRMA = window.FIRMA_FORM || {};
    const escapeHtml = esc, showSuccess = t => toast(t), showError = t => toast(t, true);
    const sfDisler = new Set();
    let sfHekimler = null, sfIsTurleri = [], sfHekimSecimNo = 0, sfKayitli = false, sfYazdirIsId = null,
        sfSalt = false, sfAcik = false, sfDonus = "pano";

    function sfFirmaUygula() {
        const F = FORM_FIRMA;
        const lg = $("anFirmaLogo");
        if (lg) lg.innerHTML = (F.logo ? `<img class="ref-firma-img" src="${F.logo}" alt="">` : esc(F.kisaltma || "")) +
            `<small class="ref-firma-ad">${esc(F.ad || "")}</small>` + (F.altBaslik ? `<small>${esc(F.altBaslik)}</small>` : "");
        const il = $("anFirmaIletisim");
        if (il) {
            const v = [F.vergiDairesi, F.vergiNo].filter(Boolean).join(" / ");
            il.innerText = [[F.adres, F.telefon, F.eposta, F.web].filter(Boolean).join(" · "), v ? "V.D. / No: " + v : ""].filter(Boolean).join("\n");
        }
        const an = $("anFirmaAltNot");
        if (an) { an.innerText = F.formAltNotu || ""; an.style.display = F.formAltNotu ? "block" : "none"; }
    }

    // ---------- ekran ----------
    function sfGoster(donus) {
        sfDonus = donus || "pano";
        ["pano", "liste", "formlar"].forEach(i => $(i).classList.add("hidden"));
        $("siparisFormu").classList.remove("hidden");
        sfAcik = true;
        window.scrollTo(0, 0);
    }
    function sfGizle() { if (!sfAcik) return; $("siparisFormu").classList.add("hidden"); sfAcik = false; }
    function sfKapat() {
        sfGizle();
        if (sfDonus === "formlar") { $("formlar").classList.remove("hidden"); formlarCiz(); return; }
        $(gorunum === "pano" ? "pano" : "liste").classList.remove("hidden");
        ciz();
    }
    function sfMevcutEkran() {
        if (sfAcik) return sfDonus;
        return $("formlar").classList.contains("hidden") ? "pano" : "formlar";
    }
    function sfButonlar() {
        $("sfYazdirBtn").disabled = !sfKayitli;
        $("sfKaydetBtn").disabled = sfKayitli || sfSalt;
        $("sfKaydetBtn").classList.toggle("hidden", sfSalt);
        $("sfTemizleBtn").classList.toggle("hidden", sfSalt);
    }
    function sfBant(x) {
        const b = $("sfBant");
        if (!x) {
            b.classList.add("hidden"); b.innerHTML = "";
            $("sfAltBaslik").textContent = "Yeni gelen iş için sipariş formu doldurun — onay bekleyen işlere otomatik atanacaktır.";
            return;
        }
        b.innerHTML = `<span>📄 <b>#${x.id}</b> · ${esc(x.hastaAdi)} · ${esc(x.hekimAdi)} · ${tarih(x.olusturmaTarihi)} — kayıtlı sipariş formu (değiştirilemez)</span>
            <span style="display:flex;gap:6px"><button class="btn btn-light" type="button" style="height:32px" onclick="cekmeceAc(${x.id})">İş detayı</button><button class="btn" type="button" style="height:32px" onclick="sfYazdir()">🖨 Yazdır</button></span>`;
        b.classList.remove("hidden");
        $("sfAltBaslik").textContent = "Geçmişte açılmış sipariş formu — aynı şablonla yeniden yazdırabilirsiniz.";
    }
    // Kayıtlı form salt okunur gösterilir (alanlar devre dışı bırakılmaz ki kâğıtta soluk çıkmasın).
    function sfSaltAyarla(acik) {
        sfSalt = !!acik;
        const kagit = document.querySelector("#siparisFormu .ref-order-paper");
        kagit.classList.toggle("sf-salt", sfSalt);
        kagit.querySelectorAll("input,textarea").forEach(e => { e.readOnly = sfSalt; });
        kagit.querySelectorAll("select,input,textarea,button").forEach(e => { if (sfSalt) e.tabIndex = -1; else e.removeAttribute("tabindex"); });
    }

    // ---------- hekim ve iş listesi ----------
    async function sfHekimleriYukle() {
        if (!sfHekimler) sfHekimler = await api("/api/is-akisi/hekimler");
        const sel = $("anHekim"), cur = sel.value;
        sel.innerHTML = '<option value="">Hekim seç...</option>' + sfHekimler.map(h => {
            const hekim = String(h.adSoyad || "").trim(), klinik = String(h.klinikAdi || "").trim();
            let g = hekim || klinik || ("Hekim #" + Number(h.id));
            // Hekim ve klinik aynıysa aynı bilgi iki kez yazılmaz.
            if (hekim && klinik && hekim.toLocaleLowerCase("tr-TR") !== klinik.toLocaleLowerCase("tr-TR")) g = hekim + " — " + klinik;
            return `<option value="${Number(h.id)}">${esc(g)}</option>`;
        }).join("");
        if (cur && sfHekimler.some(h => String(h.id) === cur)) sel.value = cur;
    }
    async function sfHekimDegisti() {
        // Hekim hızlıca değiştirilirse yalnız son seçimin listesi uygulanır.
        const no = ++sfHekimSecimNo, id = Number($("anHekim").value || 0), host = $("anKalemler");
        host.innerHTML = ""; sfIsTurleri = []; $("anKalemNotu")?.remove();
        if (!id) { sfToplamGuncelle(); return; }
        let l = [];
        try { l = await api(`/api/is-akisi/hekimler/${id}/is-turleri`); } catch (e) { toast(e.message, true); }
        if (no !== sfHekimSecimNo) return;
        sfIsTurleri = (l || []).map(x => x.isTuru).filter(Boolean);
        if (!sfIsTurleri.length) {
            const n = document.createElement("div");
            n.id = "anKalemNotu"; n.className = "form-error"; n.style.display = "block";
            n.textContent = "Bu hekime henüz iş listesi tanımlanmamış. Ana programda Hekimler ekranından hekimin iş listesini tanımlayın.";
            host.parentNode.insertBefore(n, host);
        }
        sfKalemEkle(sfIsTurleri[0] ? { isTuru: sfIsTurleri[0] } : null);
    }

    // ---------- kalemler (ana programla aynı satır yapısı; fiyat alanları yok) ----------
    function sfSecenekler(secili) {
        const cur = String(secili || "");
        const l = !cur || sfIsTurleri.includes(cur) ? sfIsTurleri : [cur, ...sfIsTurleri];
        return '<option value="">İş türü seç...</option>' + l.map(v => `<option value="${esc(v)}"${v === cur ? " selected" : ""}>${esc(v)}</option>`).join("");
    }
    function sfAdetTipi(isTuru) {
        const n = String(isTuru || "").toLocaleLowerCase("tr-TR");
        if (n.includes("bar") || n.includes("titanyum bar") || n.includes("ti-bar")) return "cene";
        return "dis";
    }
    function sfCeneAdedi() {
        let ust = false, alt = false;
        sfDisler.forEach(x => { const n = Number(x); if (n >= 11 && n <= 28) ust = true; if (n >= 31 && n <= 48) alt = true; });
        return (ust ? 1 : 0) + (alt ? 1 : 0);
    }
    function sfAkilliAdetler() {
        const dis = sfDisler.size, cene = sfCeneAdedi();
        document.querySelectorAll("#siparisFormu .an-job-line").forEach(row => {
            const mode = row.querySelector(".an-count-mode")?.value || sfAdetTipi(row.querySelector(".an-type")?.value || "");
            const q = row.querySelector(".an-qty"); if (!q) return;
            if (mode === "manuel" || row.dataset.manualOverride === "1") return;
            const v = mode === "cene" ? cene : dis;
            q.value = v > 0 ? String(v) : "";
            q.placeholder = "Belirtilmedi";
        });
        sfToplamGuncelle();
    }
    function sfKalemEkle(prefill) {
        const host = $("anKalemler"); if (!host) return;
        const row = document.createElement("div");
        row.className = "ref-job-row an-job-line";
        row.style.gridTemplateColumns = "minmax(260px,1fr) 110px 38px";
        const mode = sfAdetTipi(prefill?.isTuru || ""), dolu = Number(prefill?.adet || 0) > 0;
        row.innerHTML = `
            <select class="an-type" onchange="sfKalemTurDegisti(this)">${sfSecenekler(prefill?.isTuru || "")}</select>
            <input class="an-count-mode" type="hidden" value="${mode}" />
            <input class="an-qty" type="number" min="1" value="${dolu ? Number(prefill.adet) : ""}" placeholder="Belirtilmedi"
                   title="Adet / üye sayısı — sistem otomatik hesaplar, gerekirse elle düzeltebilirsin"
                   oninput="this.closest('.an-job-line').dataset.manualOverride='1';sfToplamGuncelle()" />
            <button type="button" class="an-kalem-sil" title="Kalemi kaldır"
                    onclick="this.closest('.an-job-line').remove();sfToplamGuncelle();sfDegisti();">×</button>`;
        host.appendChild(row);
        if (!dolu) sfAkilliAdetler(); else sfToplamGuncelle();
    }
    function sfKalemTurDegisti(sel) {
        const row = sel.closest(".an-job-line"), m = row?.querySelector(".an-count-mode");
        if (m) { m.value = sfAdetTipi(sel.value); row.dataset.manualOverride = ""; }
        sfAkilliAdetler();
    }
    function sfToplamGuncelle() {
        let adet = 0;
        document.querySelectorAll("#siparisFormu .an-job-line").forEach(row => {
            const t = row.querySelector(".an-type")?.value || "", q = Number(row.querySelector(".an-qty")?.value || 0);
            if (t && q > 0) adet += q;
        });
        $("anUyeSayisi").innerText = adet > 0 ? String(adet) : "Belirtilmedi";
    }
    function sfKalemleriOku() {
        return [...document.querySelectorAll("#siparisFormu .an-job-line")]
            .map(r => ({ isTuru: r.querySelector(".an-type")?.value.trim() || "", adet: Number(r.querySelector(".an-qty")?.value || 0) }))
            .filter(k => k.isTuru && k.adet > 0);
    }

    // ---------- diş şeması ve materyal ----------
    function sfDisSemasi() {
        const el = $("anDisSemasi"); if (!el) return;
        const q1 = [18, 17, 16, 15, 14, 13, 12, 11], q2 = [21, 22, 23, 24, 25, 26, 27, 28];
        const q4 = [48, 47, 46, 45, 44, 43, 42, 41], q3 = [31, 32, 33, 34, 35, 36, 37, 38];
        const kadran = (dl, yan) => `<div class="ref-tooth-quadrant ${yan}">${dl.map(n =>
            `<div class="ref-tooth-cell"><button type="button" class="tooth-btn${sfDisler.has(String(n)) ? " selected" : ""}" title="Diş ${n}" onclick="sfDisToggle('${n}')">${n}</button></div>`).join("")}</div>`;
        el.innerHTML = kadran(q1, "left") + kadran(q2, "right") + kadran(q4, "left") + kadran(q3, "right");
        $("anSelectedTeeth").innerText = sfDisler.size ? "Seçilen Dişler: " + [...sfDisler].join(", ") : "Seçilen Dişler: —";
        if (sfSalt) sfSaltAyarla(true);
    }
    function sfDisToggle(n) {
        if (sfSalt) return;
        const k = String(n);
        if (sfDisler.has(k)) sfDisler.delete(k); else sfDisler.add(k);
        sfDisSemasi(); sfAkilliAdetler(); sfDegisti();
    }
    function sfMateryalSec(r) { $("anMateryal").value = r?.checked ? String(r.value || "") : ""; }
    function sfMateryalSync() {
        const v = String($("anMateryal").value || "").trim().toLowerCase();
        document.querySelectorAll('input[name="anMateryalRadio"]').forEach(r => { r.checked = String(r.value || "").trim().toLowerCase() === v; });
    }

    // ---------- form durumu: gönderildikten sonra değişirse yeniden onaya gönderilmesi gerekir ----------
    function sfDegisti() { if (sfSalt || !sfKayitli) return; sfKayitli = false; sfButonlar(); }
    document.addEventListener("input", e => { if (e.target?.closest?.("#siparisFormu .ref-order-paper")) sfDegisti(); });
    document.addEventListener("change", e => { if (e.target?.closest?.("#siparisFormu .ref-order-paper")) sfDegisti(); });

    function sfTemizle(yeni) {
        sfKayitli = false; sfYazdirIsId = null; sfSaltAyarla(false); stlGorselAlaniTemizle(); sfBant(null);
        ["anHasta", "anTermin", "anDisRengi", "anMateryal", "anNot"].forEach(i => { $(i).value = ""; });
        document.querySelectorAll('input[name="anMateryalRadio"]').forEach(r => { r.checked = false; });
        sfDisler.clear(); sfDisSemasi();
        $("anKalemler").innerHTML = ""; $("anKalemNotu")?.remove(); sfIsTurleri = [];
        if (yeni) $("anHekim").value = "";
        sfToplamGuncelle(); sfButonlar();
        // Hekim seçili kaldıysa iş listesi yeniden getirilir (boş kalem satırı açılır).
        if (!yeni && $("anHekim").value) sfHekimDegisti();
    }

    async function sfYeni() {
        sfGoster(sfMevcutEkran());
        sfTemizle(true); sfFirmaUygula();
        try { await sfHekimleriYukle(); } catch (e) { toast(e.message, true); }
        sfGecmisYukle();
        $("anHekim").focus();
    }

    async function sfKaydet() {
        if (sfSalt) return;
        const hekimId = Number($("anHekim").value || 0), hastaAdi = $("anHasta").value.trim(), kalemler = sfKalemleriOku();
        if (!hekimId) return toast("Hekim seç.", true);
        if (!hastaAdi) return toast("Hasta adı gerekli.", true);
        if (!kalemler.length) return toast("En az bir iş kalemi ekle.", true);
        const b = $("sfKaydetBtn"); b.disabled = true; b.innerText = "Gönderiliyor...";
        try {
            const d = await post("/api/is-akisi/siparis", {
                hekimId, hastaAdi,
                terminTarihi: $("anTermin").value || null,
                disRengi: $("anDisRengi").value.trim() || null,
                materyal: $("anMateryal").value.trim() || null,
                disSemasi: [...sfDisler].join(","),
                notlar: $("anNot").value.trim() || null,
                kalemler
            });
            const idler = (d.siparisIdler || []).map(Number).filter(Boolean);
            // Yazdırırken bu işin tarama (STL) dosyaları forma resim olarak eklenir.
            sfYazdirIsId = idler[0] || null;
            sfKayitli = true;
            if (sfYazdirIsId) stlGorselleriArkada(sfYazdirIsId);
            toast(idler.length > 1
                ? `Sipariş onaya gönderildi. ${idler.length} farklı para birimi için ${idler.length} ayrı iş kaydı oluşturuldu (#${idler.join(", #")}). Yazdırabilirsin.`
                : `Sipariş onaya gönderildi${sfYazdirIsId ? " (#" + sfYazdirIsId + ")" : ""}. Artık Yazdır butonunu kullanabilirsin.`);
            yukle(true);
            sfGecmisYukle(true);
        } catch (e) {
            toast(e.message || "Sipariş oluşturulamadı.", true);
        } finally {
            b.innerText = "☁ Onaya Gönder";
            sfButonlar();
        }
    }

    // ---------- geçmiş formlar: aynı şablonla açılır, yeniden yazdırılır ----------
    async function sfIsBul(id) {
        let x = isler.find(i => i.id === id) || tumIsler.find(i => i.id === id);
        if (!x) {
            try { tumIsler = await api("/api/is-akisi/isler?tumu=true"); } catch (e) { toast(e.message, true); return null; }
            x = tumIsler.find(i => i.id === id);
        }
        return x || null;
    }
    async function sfGoruntule(id, yazdir) {
        const x = await sfIsBul(Number(id));
        if (!x) { toast("#" + id + " bulunamadı.", true); return; }
        if (acikIs) cekmeceKapat();
        sfGoster(sfMevcutEkran());
        sfTemizle(true); sfFirmaUygula();
        try { await sfHekimleriYukle(); } catch { }
        const sel = $("anHekim");
        // Hekim sonradan pasif yapıldıysa eski formda yine adı görünsün.
        if (x.hekimId && ![...sel.options].some(o => o.value === String(x.hekimId)))
            sel.insertAdjacentHTML("beforeend", `<option value="${Number(x.hekimId)}">${esc(x.hekimAdi + (x.klinikAdi && x.klinikAdi !== x.hekimAdi ? " — " + x.klinikAdi : ""))}</option>`);
        sel.value = String(x.hekimId || "");
        $("anHasta").value = x.hastaAdi && x.hastaAdi !== "-" ? x.hastaAdi : "";
        $("anTermin").value = x.terminTarihi ? String(x.terminTarihi).slice(0, 10) : "";
        $("anDisRengi").value = x.disRengi || "";
        $("anMateryal").value = x.materyal || ""; sfMateryalSync();
        $("anNot").value = x.notlar || "";
        String(x.disSemasi || "").split(",").map(v => v.trim()).filter(Boolean).forEach(v => sfDisler.add(v));
        sfDisSemasi();
        (x.kalemler || []).forEach(k => sfKalemEkle({ isTuru: k.isTuru || "", adet: Number(k.adet || 1) }));
        if (!(x.kalemler || []).length) sfKalemEkle();
        sfSaltAyarla(true);
        sfKayitli = true; sfYazdirIsId = x.id;
        sfButonlar(); sfBant(x); sfGecmisYukle();
        const hazir = stlGorselleriArkada(x.id);
        if (yazdir) { await hazir; await sfYazdir(); }
    }
    async function sfGecmisYukle(yenile) {
        if (yenile || !tumIsler.length) { try { tumIsler = await api("/api/is-akisi/isler?tumu=true"); } catch { } }
        sfGecmisCiz();
    }
    function sfGecmisCiz() {
        const body = $("anFormHistoryBody"); if (!body) return;
        const q = String($("anFormHistorySearch").value || "").trim().toLocaleLowerCase("tr-TR");
        const l = (tumIsler.length ? tumIsler : isler)
            .filter(x => !q || [x.hekimAdi, x.hastaAdi, x.klinikAdi, "#" + x.id, String(x.id)].some(v => String(v || "").toLocaleLowerCase("tr-TR").includes(q)))
            .slice().sort((a, b) => b.id - a.id).slice(0, 20);
        if (!l.length) { body.innerHTML = '<tr><td colspan="7" class="bos">Henüz sipariş formu bulunmuyor.</td></tr>'; return; }
        body.innerHTML = l.map(x => {
            const kl = x.kalemler || [];
            const isText = kl.map(k => k.isTuru).filter(Boolean).join(", ") || "-";
            const uye = kl.reduce((s, k) => s + Number(k.adet || 0), 0) || "-";
            return `<tr onclick="sfGoruntule(${x.id})"><td><b>#${x.id}</b></td><td>${tarih(x.olusturmaTarihi)}</td><td>${esc(x.hekimAdi || "-")}</td><td>${esc(x.hastaAdi || "-")}</td><td>${esc(isText)}</td><td>${esc(String(uye))}</td>
                <td style="white-space:nowrap"><button class="btn btn-light" type="button" style="height:30px" onclick="event.stopPropagation();sfGoruntule(${x.id})">📄 Aç</button>
                <button class="btn btn-light" type="button" style="height:30px" onclick="event.stopPropagation();sfGoruntule(${x.id},true)">🖨 Yazdır</button></td></tr>`;
        }).join("");
    }

    // ---------- A5 çıktı (ana programdaki Yazdır ile aynı) ----------
    async function sfYazdir() {
        if (!sfKayitli) { toast("Yazdırmadan önce siparişi Onaya Gönder.", true); return; }
        const paper = document.querySelector("#siparisFormu .ref-order-paper");
        if (!paper) { window.print(); return; }
        // Hekimin yüklediği taramalar (üst çene / alt çene / kapanış) forma resim olarak eklenir.
        if (sfYazdirIsId) {
            if (stlHazirlaniyor) await stlHazirlaniyor;
            if (stlHazirIsId !== Number(sfYazdirIsId)) await stlGorselleriArkada(sfYazdirIsId);
        }
        document.body.classList.add("a5-olcum");
        // Notlar kâğıtta kaydırma çubuğuyla kesilmesin: alan içeriğe göre uzatılır.
        paper.querySelectorAll("textarea").forEach(t => { t.dataset.eskiYukseklik = t.style.height || ""; t.style.height = Math.max(t.offsetHeight, t.scrollHeight + 4) + "px"; });
        // Çıktı, ekrandaki formun birebir aynısı olarak tek bir A5 (148 x 210 mm) dikey sayfaya basılır.
        const sayfa = document.createElement("style");
        sayfa.id = "a5YazdirmaSayfasi";
        sayfa.textContent = "@@page{size:A5 portrait;margin:5mm}";
        document.head.appendChild(sayfa);
        // Ölçek: formun ekrandaki ölçüleri A5'in yazılabilir alanına (138 x 200 mm) sığacak kadar.
        const mm = 96 / 25.4;
        const genislik = Math.max(1, paper.offsetWidth), yukseklik = Math.max(1, paper.offsetHeight);
        const olcek = Math.min(1, 138 * mm / genislik, 200 * mm / yukseklik) * 0.98;
        paper.style.setProperty("--a5-width", genislik + "px");
        paper.style.setProperty("--a5-zoom", String(olcek));
        // Tarama/tasarım görüntüleri kâğıtta en fazla 7 x 7 cm kare.
        const stlKutu = $("anStlGorseller");
