        const yuzde=(a,q)=>{ if(!a.length) return 0; a.sort((x,y)=>x-y); return a[Math.min(a.length-1,Math.floor(a.length*q))]; };
        if(u1.length&&u2.length && yuzde(u1,0.97) > yuzde(u2,0.97)) der=stlV.sc(der,-1);
