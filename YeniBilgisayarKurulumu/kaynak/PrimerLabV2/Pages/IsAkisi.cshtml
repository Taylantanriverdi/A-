    // ---------- STL / PLY / OBJ 3B önizleme (fareyle üstüne gelince) ----------
    const onizOnbellek = new Map();
    let onizGl = null, onizProg = null, onizMesh = null, onizAci = { x: -0.5, y: 0 }, onizAnim = null, onizGizleZ = null, onizSurukle = null, onizAktif = null;
    function onizlemeKalsin() { clearTimeout(onizGizleZ); }
