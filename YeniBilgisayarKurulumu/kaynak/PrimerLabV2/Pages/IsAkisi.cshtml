    const stlV={ dot:(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2], cr:(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]], sc:(a,k)=>[a[0]*k,a[1]*k,a[2]*k], ad:(a,b)=>[a[0]+b[0],a[1]+b[1],a[2]+b[2]], ny:a=>{const l=Math.hypot(a[0],a[1],a[2])||1;return [a[0]/l,a[1]/l,a[2]/l];} };
