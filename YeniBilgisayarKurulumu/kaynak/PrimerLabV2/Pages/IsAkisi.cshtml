    async function stlHamMesh(fileId){
        const r=await fetch('/api/is-akisi/dosya/'+fileId+'/onizleme',{credentials:'same-origin'});
        if(!r.ok) throw new Error((await r.text())||'Önizleme oluşturulamadı.');
        const buf=await r.arrayBuffer(), dv=new DataView(buf);
        if(String.fromCharCode(dv.getUint8(0),dv.getUint8(1),dv.getUint8(2),dv.getUint8(3))!=='PLM1') throw new Error('Önizleme verisi okunamadı.');
