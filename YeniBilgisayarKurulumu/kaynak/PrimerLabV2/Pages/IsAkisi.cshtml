    function stlKapanisKonumunda(mu,eu,ma,ea){
        if(stlV.dot(eu.dik,ea.dik)>-0.8) return false;
        const d=[ea.c[0]-eu.c[0],ea.c[1]-eu.c[1],ea.c[2]-eu.c[2]];
        if(Math.abs(stlV.dot(d,eu.gen))>8 || Math.abs(stlV.dot(d,eu.der))>12) return false;
        const dd=stlV.dot(d,eu.dik); if(dd<3||dd>45) return false;
