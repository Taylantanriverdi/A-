        gl.bindBuffer(gl.ARRAY_BUFFER, m.bp); gl.enableVertexAttribArray(lp); gl.vertexAttribPointer(lp, 3, gl.FLOAT, false, 0, 0);
        gl.bindBuffer(gl.ARRAY_BUFFER, m.bn); gl.enableVertexAttribArray(ln); gl.vertexAttribPointer(ln, 3, gl.FLOAT, false, 0, 0);
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, m.bi); gl.drawElements(gl.TRIANGLES, m.idx.length, gl.UNSIGNED_INT, 0);
    }

    // ---------- Sipariş formları / tamamlananlar ----------
    let tumIsler = [];
    async function formlarAc(durum) {
        $("fDurum").value = durum === "tamam" ? "tamam" : "hepsi";
        $("formlarBaslik").textContent = durum === "tamam" ? "🏁 Tamamlanan İşler" : "📄 Sipariş Formları (tümü)";
        ["pano", "liste"].forEach(i => $(i).classList.add("hidden")); $("formlar").classList.remove("hidden");
        $("formlarListe").innerHTML = '<div class="bos">Yükleniyor...</div>';
        try { tumIsler = await api("/api/is-akisi/isler?tumu=true"); formlarCiz(); }
        catch (err) { $("formlarListe").innerHTML = `<div class="bos">${esc(err.message)}</div>`; }
    }
    function formlarKapat() { $("formlar").classList.add("hidden"); $(gorunum === "pano" ? "pano" : "liste").classList.remove("hidden"); ciz(); }
    function formlarCiz() {
        const q = $("fAra").value.trim().toLocaleLowerCase("tr-TR"), d = $("fDurum").value, k = $("fKaynak").value;
        const bas = $("fBas").value ? new Date($("fBas").value + "T00:00:00") : null, bit = $("fBit").value ? new Date($("fBit").value + "T23:59:59") : null;
        const l = tumIsler.filter(x => (k === "hepsi" || x.kaynak === k) &&
            (d === "hepsi" || (d === "tamam" && sutun(x) === "tamam") || (d === "onay" && sutun(x) === "onay") || (d === "devam" && !["tamam", "onay"].includes(sutun(x)))) &&
            (!bas || new Date(x.olusturmaTarihi) >= bas) && (!bit || new Date(x.olusturmaTarihi) <= bit) &&
            (!q || [x.hastaAdi, x.hekimAdi, x.klinikAdi, x.teknisyenAdi, "#" + x.id, String(x.id), ...(x.kalemler || []).map(i => i.isTuru)].some(v => String(v || "").toLocaleLowerCase("tr-TR").includes(q))));
        $("formlarListe").innerHTML = `<div style="color:var(--muted);font-size:12px;margin-bottom:6px">${l.length} kayıt</div><table><thead><tr><th>İş</th><th>Tarih</th><th>Hasta / Hekim</th><th>İş türü</th><th>Kaynak</th><th>Durum</th><th>Teknisyen</th><th>Teslim</th><th></th></tr></thead><tbody>${l.slice(0, 1000).map(x =>
            `<tr onclick="cekmeceAc(${x.id})"><td><b>#${x.id}</b></td><td>${tarih(x.olusturmaTarihi)}</td><td><b>${esc(x.hastaAdi)}</b><div style="color:var(--muted)">${esc(x.hekimAdi)}</div></td><td>${kalemMetni(x)}</td><td>${KAYNAK[x.kaynak] || esc(x.kaynak)}</td><td>${esc(x.onayDurumu === "Gelen Onay" ? "Onay bekliyor" : x.durum)}</td><td>${esc(x.teknisyenAdi || "-")}</td><td>${tarih(x.terminTarihi)}</td>
            <td><button class="btn btn-light" type="button" style="height:30px" onclick="event.stopPropagation();formYazdir(${x.id})">🖨 Form</button></td></tr>`).join("") || '<tr><td colspan="9" class="bos">Kayıt yok</td></tr>'}</tbody></table>${l.length > 1000 ? '<div class="bos">İlk 1000 kayıt gösteriliyor; aramayı daraltın.</div>' : ""}`;
    }

    document.addEventListener("keydown", e => { if (e.key === "Escape" && acikIs) cekmeceKapat(); });
    basla();
</script>
</body>
</html>
