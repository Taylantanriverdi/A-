            .catch(e=>{ console.warn('Tarama görüntüleri hazırlanamadı',e); showError('Tarama/tasarım görüntüleri hazırlanamadı: '+(e.message||e)); })
            .finally(()=>{ stlHazirlaniyor=null; });
