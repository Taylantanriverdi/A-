@page "/hekim-portal"
@inject PrimerLabV2.Infrastructure.FirmaServisi Firma
@{
    Layout = null;
    // Firma Bilgileri (ana program > Firma Bilgileri): ad, logo ve iletişim bilgisi.
    var firmaAd = Firma.Ad;
    var firmaBuyuk = firmaAd; // girildiği gibi (Türkçe büyük harf "Studio"yu "STUDİO" yapardı)
    var firmaLogo = Firma.LogoDataUrl();
    var firmaKisa = PrimerLabV2.Infrastructure.FirmaServisi.Kisaltma(firmaAd);
    var firmaIletisim = Firma.IletisimSatiri();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#10233e" />
    <title>@firmaAd — Hekim Portalı</title>
    <style>
        :root{--ink:#10233e;--muted:#64748b;--line:#dbe3ef;--bg:#f3f6fb;--card:#fff;--blue:#1565c0;--blue-soft:#eff6ff;--green:#15803d;--green-soft:#ecfdf5;--red:#dc2626;--red-soft:#fef2f2;--amber:#b45309;--amber-soft:#fffbeb}
        *{box-sizing:border-box}
        html,body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,"Segoe UI",Roboto,Arial,sans-serif;font-size:15px;-webkit-text-size-adjust:100%}
        button,input,select,textarea{font:inherit;color:inherit}
        .hidden{display:none!important}
        .wrap{max-width:860px;margin:0 auto;padding:16px}
        .brand{display:flex;align-items:center;gap:10px}
        .brand-logo{width:38px;height:38px;border-radius:10px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:900;font-size:15px;letter-spacing:.5px}
        .yeni-mesaj{display:inline-block;background:#dc2626;color:#fff;border-radius:99px;padding:1px 8px;font-size:11px;font-weight:900;margin-left:4px}
        .brand-img{height:40px;max-width:150px;object-fit:contain;border-radius:8px;background:#fff;padding:2px}
        .firma-iletisim{margin-top:16px;padding-top:12px;border-top:1px solid var(--line);font-size:11px;color:var(--muted);text-align:center;line-height:1.5}
        .brand-name{font-weight:900;font-size:16px;line-height:1.1}
        .brand-sub{font-size:11px;color:var(--muted);font-weight:700;letter-spacing:.3px}

        /* Giriş */
        .login{min-height:100vh;display:grid;place-items:center;padding:16px}
        .login-card{width:100%;max-width:380px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(16,35,62,.08)}
        .login-card h1{font-size:20px;margin:18px 0 4px}
        .pk-alt{display:flex;justify-content:space-between;gap:10px;margin-top:14px;flex-wrap:wrap}
        .pk-link{background:none;border:0;color:var(--blue);font-weight:800;cursor:pointer;padding:4px 0;font-size:13px}
        .pk-geri{display:block;width:100%;text-align:center;margin-top:12px;color:var(--muted)}
        .pk-bilgi{font-size:13px;color:var(--muted);margin:0 0 12px;line-height:1.45}
        .pk-kod{font-size:24px!important;letter-spacing:6px;text-align:center;font-weight:900}
        .pk-onay{display:flex;gap:9px;align-items:flex-start;font-size:12px;color:#334155;margin:4px 0 14px;line-height:1.4;cursor:pointer}
        .pk-onay input{width:18px;height:18px;flex:none;margin-top:1px;accent-color:var(--blue)}
        .pk-gizli{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}
        .pk-iki{display:grid;grid-template-columns:1fr 1fr;gap:10px}
        .pk-iki .field{margin-bottom:12px}
        .login-card p{margin:0 0 18px;color:var(--muted);font-size:13px}

        /* Üst bar */
        .topbar{position:sticky;top:0;z-index:20;background:var(--ink);color:#fff}
        .topbar .wrap{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-top:10px;padding-bottom:10px}
        .topbar .brand-logo{background:#fff;color:var(--ink)}
        .topbar .brand-sub{color:#b8c4d6}
        .who{font-size:12px;text-align:right;line-height:1.3}
        .who b{display:block;font-size:13px}
        .link-btn{background:none;border:0;color:#b8c4d6;text-decoration:underline;cursor:pointer;padding:0;font-size:12px}
        .tabs{display:flex;gap:6px;background:#0b1a2f}
        .tabs .wrap{display:flex;gap:6px;padding-top:6px;padding-bottom:0}
        .tab{flex:1;border:0;background:transparent;color:#b8c4d6;padding:11px 8px;font-weight:800;cursor:pointer;border-radius:10px 10px 0 0}
        .tab.active{background:var(--bg);color:var(--ink)}

        /* Kartlar */
        .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px}
        .card-title{display:flex;align-items:center;gap:8px;font-weight:900;font-size:15px;margin-bottom:12px}
        .step{width:24px;height:24px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:12px;flex:none}
        .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
        .field{margin-bottom:12px}
        .field:last-child{margin-bottom:0}
        label.lbl{display:block;font-size:12px;font-weight:800;color:#334155;margin-bottom:5px}
        .req{color:var(--red)}
        .inp{width:100%;height:44px;border:1px solid #cbd5e1;border-radius:10px;padding:0 12px;background:#fff;outline:none}
        textarea.inp{height:auto;min-height:90px;padding:10px 12px;resize:vertical}
        .inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(21,101,192,.15)}
        .hint{font-size:12px;color:var(--muted);margin-top:5px}
        .btn{height:46px;border:0;border-radius:12px;padding:0 18px;font-weight:900;cursor:pointer;background:var(--blue);color:#fff}
        .btn:disabled{opacity:.55;cursor:not-allowed}
        .btn-block{width:100%}
        .btn-ghost{background:var(--blue-soft);color:var(--blue);border:1px dashed #93c5fd}
        .btn-light{background:#fff;color:var(--ink);border:1px solid var(--line)}
        .btn-sm{height:34px;padding:0 12px;border-radius:9px;font-size:13px}
        .check{display:flex;align-items:center;gap:9px;font-weight:800;cursor:pointer;user-select:none}
        .check input{width:20px;height:20px;accent-color:var(--blue)}
        .chips{display:flex;flex-wrap:wrap;gap:8px}
        .chip{border:1px solid #cbd5e1;background:#fff;border-radius:999px;padding:9px 13px;font-weight:800;font-size:13px;cursor:pointer}
        .chip.on{background:var(--ink);border-color:var(--ink);color:#fff}
        .msg{border-radius:12px;padding:11px 13px;font-size:13px;font-weight:700;margin-bottom:12px}
        .msg.err{background:var(--red-soft);color:var(--red);border:1px solid #fecaca}
        .msg.ok{background:var(--green-soft);color:var(--green);border:1px solid #bbf7d0}
        .msg.info{background:var(--amber-soft);color:var(--amber);border:1px solid #fde68a}

        /* İş kalemleri */
        .item{border:2px solid var(--line);border-radius:14px;padding:10px;margin-bottom:10px;background:#fff}
        .item.active{border-color:var(--c,var(--blue));box-shadow:0 0 0 3px color-mix(in srgb,var(--c,var(--blue)) 18%,transparent)}
        .item-head{display:grid;grid-template-columns:14px minmax(0,1fr) 74px 40px;gap:8px;align-items:center}
        .dot{width:14px;height:14px;border-radius:50%;background:var(--c)}
        .item-head .inp{height:42px}
        .qty{text-align:center}
        .del{height:42px;border:1px solid #fecaca;background:#fff;color:var(--red);border-radius:10px;font-size:18px;cursor:pointer}
        .item-foot{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;font-size:12px;color:var(--muted);flex-wrap:wrap}
        .item-teeth{font-weight:800;color:var(--ink)}
        .pick{border:0;background:var(--blue-soft);color:var(--blue);border-radius:8px;padding:7px 10px;font-weight:900;font-size:12px;cursor:pointer}
        .item.active .pick{background:var(--c);color:#fff}

        /* Diş şeması */
        .chart{margin-top:6px;border:1px solid var(--line);border-radius:14px;padding:12px 8px;background:#fbfdff}
        .chart-note{font-size:12px;color:var(--muted);text-align:center;margin-bottom:8px}
        .chart-note b{color:var(--ink)}
        .jaw{display:grid;grid-template-columns:repeat(16,minmax(0,1fr));gap:3px}
        .jaw + .jaw{margin-top:10px;padding-top:10px;border-top:1px dashed #cbd5e1}
        .tooth{aspect-ratio:3/4;min-height:34px;border:1px solid #cbd5e1;background:#fff;border-radius:7px;font-size:11px;font-weight:900;cursor:pointer;padding:0;position:relative}
        .tooth:nth-child(8){margin-right:3px}
        .tooth.on{color:#fff;border-color:transparent}
        .tooth.multi::after{content:"";position:absolute;right:2px;top:2px;width:6px;height:6px;border-radius:50%;background:#fff}
        .jaw-btns{display:flex;gap:6px;justify-content:center;margin-top:10px;flex-wrap:wrap}

        /* Dosyalar */
        .drop{border:2px dashed #93c5fd;background:var(--blue-soft);border-radius:14px;padding:18px;text-align:center;cursor:pointer;color:var(--blue);font-weight:800}
        .drop.over{background:#dbeafe}
        .files{margin-top:10px;display:grid;gap:6px}
        .file{display:flex;align-items:center;justify-content:space-between;gap:8px;border:1px solid var(--line);border-radius:10px;padding:8px 10px;font-size:13px}
        .file span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .file small{color:var(--muted);flex:none}
        .file button{border:0;background:none;color:var(--red);font-size:18px;cursor:pointer;flex:none}

        /* Gönder */
        .send-bar{position:sticky;bottom:0;background:linear-gradient(transparent,var(--bg) 30%);padding:18px 0 14px}
        .progress{height:8px;background:#e2e8f0;border-radius:99px;overflow:hidden;margin-bottom:10px}
        .progress div{height:100%;width:0;background:var(--blue);transition:width .2s}
        .summary{font-size:13px;line-height:1.6}
        .summary b{color:#334155}
        .done{text-align:center;padding:30px 16px}
        .done .big{font-size:46px}
        .done h2{margin:8px 0}

        /* İşlerim */
        .toolbar{display:flex;gap:8px;margin-bottom:12px}
        .job{background:#fff;border:1px solid var(--line);border-radius:14px;margin-bottom:10px;overflow:hidden}
        .job-head{display:flex;justify-content:space-between;gap:10px;padding:12px 14px;cursor:pointer;align-items:center}
        .hazir-serit{margin:0 14px 12px;padding:10px 12px;border-radius:12px;background:#eff6ff;border:1px solid #bfdbfe}
        .hazir-serit.yeni{background:#ecfdf5;border-color:#6ee7b7}
        .hazir-baslik{font-size:12px;font-weight:900;color:#1e3a8a;margin-bottom:6px}
        .hazir-serit.yeni .hazir-baslik{color:#065f46}
        .hazir-yeni{background:#059669;color:#fff;border-radius:999px;padding:1px 8px;font-size:10px;margin-right:4px}
        .hazir-liste{display:flex;flex-wrap:wrap;gap:6px}
        .hazir-btn{display:inline-flex;align-items:center;gap:5px;padding:7px 11px;border-radius:9px;background:#fff;border:1px solid #cbd5e1;color:#0f172a;text-decoration:none;font-size:13px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .hazir-btn:hover{border-color:#2563eb;color:#1d4ed8}
        .hazir-btn small{color:#64748b}
        .hazir-nokta{width:8px;height:8px;border-radius:50%;background:#059669;display:inline-block}
        .job-name{font-weight:900}
        .job-sub{font-size:12px;color:var(--muted);margin-top:3px}
        .badge{border-radius:999px;padding:5px 10px;font-size:11px;font-weight:900;white-space:nowrap;background:#e2e8f0;color:#334155}
        .badge.wait{background:var(--amber-soft);color:var(--amber)}
        .badge.prod{background:var(--blue-soft);color:var(--blue)}
        .badge.done{background:var(--green-soft);color:var(--green)}
        .badge.cancel{background:var(--red-soft);color:var(--red)}
        .job-body{border-top:1px solid var(--line);padding:12px 14px;font-size:13px;line-height:1.6;background:#fbfdff}
        .job-body pre{white-space:pre-wrap;font:inherit;margin:4px 0 0;background:#fff;border:1px solid var(--line);border-radius:10px;padding:8px 10px}
        .job-body a{color:var(--blue);font-weight:800}
        .empty{text-align:center;color:var(--muted);padding:30px 10px}
        .stepper{display:flex;gap:4px;margin:4px 0 10px}
        .stepper div{flex:1;text-align:center;font-size:10px;font-weight:800;color:var(--muted);border-top:4px solid #e2e8f0;padding-top:4px}
        .stepper div.on{border-color:var(--blue);color:var(--blue)}
        .stepper div.ok{border-color:var(--green);color:var(--green)}
        .msgs{display:grid;gap:6px;margin:6px 0;max-height:280px;overflow:auto}
        .msg-b{max-width:85%;padding:7px 10px;border-radius:12px;background:#fff;border:1px solid var(--line);white-space:pre-wrap}
        .msg-b.me{margin-left:auto;background:var(--blue-soft);border-color:#bfdbfe}
        .msg-b small{display:block;color:var(--muted);font-size:10px;font-weight:700}
        .msg-form{display:flex;gap:6px}
        .msg-form textarea{flex:1;min-height:42px;height:42px;resize:vertical;border:1px solid #cbd5e1;border-radius:10px;padding:8px 10px}

        @@media (max-width:620px){
            .wrap{padding:12px}
            .grid2{grid-template-columns:1fr}
            .jaw{gap:2px}
            .tooth{font-size:10px;min-height:30px;border-radius:5px}
            .tooth:nth-child(8){margin-right:2px}
        }
    </style>
</head>
<body>

<!-- GİRİŞ -->
<section id="loginScreen" class="login hidden">
    <form class="login-card" onsubmit="girisYap(event)">
        <div class="brand">
            @if (firmaLogo != null) { <img class="brand-img" src="@firmaLogo" alt="@firmaAd" /> } else { <div class="brand-logo">@firmaKisa</div> }
            <div><div class="brand-name">@firmaBuyuk</div><div class="brand-sub">HEKİM PORTALI</div></div>
        </div>
        <h1>Hoş geldiniz</h1>
        <p>Kullanıcı adınız ve şifrenizle giriş yapın. Hesabınız yoksa aşağıdan kendiniz kayıt olabilirsiniz.</p>
        <div id="loginMsg" class="msg err hidden"></div>
        <div id="sifreAdimi">
        <div class="field">
            <label class="lbl" for="loginUser">Kullanıcı adı</label>
            <input id="loginUser" class="inp" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        </div>
        <div class="field">
            <label class="lbl" for="loginPass">Şifre</label>
            <input id="loginPass" class="inp" type="password" autocomplete="current-password" required />
        </div>
        </div>
        <div id="kodAdimi" class="hidden">
            <div id="pkEpostaAlani" class="hidden">
                <p class="pk-bilgi">Güvenliğiniz için girişte e-posta adresinize tek kullanımlık kod gönderiyoruz. Bir kez e-posta adresinizi yazın ve gelen kodla onaylayın.</p>
                <div class="field">
                    <label class="lbl" for="pkGirisEposta">E-posta adresiniz</label>
                    <input id="pkGirisEposta" class="inp" type="email" autocomplete="email" placeholder="ornek@@klinik.com" />
                </div>
            </div>
            <div id="pkKodAlani" class="hidden">
                <p id="pkKodBilgi" class="pk-bilgi"></p>
                <div class="field">
                    <label class="lbl" for="pkGirisKod">E-postadaki 6 haneli kod</label>
                    <input id="pkGirisKod" class="inp pk-kod" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="000000" />
                </div>
                <label id="pkHatirlaSatir" class="pk-onay"><input id="pkHatirla" type="checkbox" /> <span id="pkHatirlaMetin">Bu cihazı hatırla</span></label>
                <button type="button" class="pk-link" onclick="pkKodTekrar()">Kod gelmedi mi? Tekrar gönder</button>
            </div>
        </div>
        <button id="loginBtn" class="btn btn-block" type="submit">Giriş Yap</button>
        <div id="pkAltLinkler" class="pk-alt">
            <button type="button" class="pk-link" id="pkSifreLink" onclick="pkAc('sifre')">Şifremi unuttum</button>
            <button type="button" class="pk-link" id="pkKayitLink" onclick="pkAc('kayit')">Hesabınız yok mu? <b>Kayıt olun</b></button>
        </div>
        <button id="pkGirisGeri" class="pk-link pk-geri hidden" type="button" onclick="pkGirisSifirla();pkMsg('loginMsg','')">&larr; Kullanıcı adı ve şifreye dön</button>
        @if (!string.IsNullOrEmpty(firmaIletisim)) { <div class="firma-iletisim">@firmaIletisim</div> }
    </form>
</section>

<!-- KAYIT OL -->
<section id="kayitScreen" class="login hidden">
    <form class="login-card" onsubmit="pkKayit(event)">
        <div class="brand">
            @if (firmaLogo != null) { <img class="brand-img" src="@firmaLogo" alt="@firmaAd" /> } else { <div class="brand-logo">@firmaKisa</div> }
            <div><div class="brand-name">@firmaBuyuk</div><div class="brand-sub">HEKİM PORTALI</div></div>
        </div>
        <h1>Yeni hesap</h1>
        <p>Bilgilerinizi doldurun; e-postanıza gelen kodla hesabınızı onaylayın. Kullanıcı adınızı ve şifrenizi kendiniz belirlersiniz.</p>
        <div id="kayitMsg" class="msg err hidden"></div>
        <div id="kayitForm">
            <div class="field">
                <label class="lbl" for="kAdSoyad">Ad soyad</label>
                <input id="kAdSoyad" class="inp" autocomplete="name" maxlength="150" required />
            </div>
            <div class="field">
                <label class="lbl" for="kKlinik">Klinik / muayenehane adı</label>
                <input id="kKlinik" class="inp" autocomplete="organization" maxlength="150" />
            </div>
            <div class="pk-iki">
                <div class="field">
                    <label class="lbl" for="kTelefon">Telefon</label>
                    <input id="kTelefon" class="inp" type="tel" autocomplete="tel" maxlength="30" />
                </div>
                <div class="field">
                    <label class="lbl" for="kEposta">E-posta</label>
                    <input id="kEposta" class="inp" type="email" autocomplete="email" maxlength="160" required />
                </div>
            </div>
            <div class="field">
                <label class="lbl" for="kKullanici">Kullanıcı adı</label>
                <input id="kKullanici" class="inp" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="64" pattern="[a-zA-Z0-9._\-]{3,64}" title="3-64 karakter: harf, rakam, nokta, alt çizgi, tire" required />
            </div>
            <div class="pk-iki">
                <div class="field">
                    <label class="lbl" for="kParola">Şifre</label>
                    <input id="kParola" class="inp" type="password" autocomplete="new-password" minlength="8" required />
                </div>
                <div class="field">
                    <label class="lbl" for="kParola2">Şifre (tekrar)</label>
                    <input id="kParola2" class="inp" type="password" autocomplete="new-password" minlength="8" required />
                </div>
            </div>
            <p class="pk-bilgi" style="margin-top:-4px">Şifre en az 8 karakter; en az bir harf ve bir rakam.</p>
            <div class="pk-gizli" aria-hidden="true"><label>Web sitesi <input id="kWebsite" tabindex="-1" autocomplete="off" /></label></div>
            <label class="pk-onay"><input id="kKvkk" type="checkbox" /> <span>Ad, telefon ve e-posta bilgilerimin iş takibi ve iletişim amacıyla @firmaAd tarafından işlenmesini kabul ediyorum.</span></label>
        </div>
        <div id="kayitKodAlani" class="hidden">
            <p id="kayitKodBilgi" class="pk-bilgi"></p>
            <div class="field">
                <label class="lbl" for="kKod">E-postadaki 6 haneli kod</label>
                <input id="kKod" class="inp pk-kod" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="000000" />
            </div>
        </div>
        <button id="kayitBtn" class="btn btn-block" type="submit">Kayıt Ol</button>
        <button type="button" class="pk-link pk-geri" onclick="pkEkran('login')">&larr; Girişe dön</button>
    </form>
</section>

<!-- ŞİFREMİ UNUTTUM -->
<section id="sifreScreen" class="login hidden">
    <form class="login-card" onsubmit="pkSifre(event)">
        <div class="brand">
            @if (firmaLogo != null) { <img class="brand-img" src="@firmaLogo" alt="@firmaAd" /> } else { <div class="brand-logo">@firmaKisa</div> }
            <div><div class="brand-name">@firmaBuyuk</div><div class="brand-sub">HEKİM PORTALI</div></div>
        </div>
        <h1>Şifremi unuttum</h1>
        <p>Kullanıcı adınızı veya kayıtlı e-posta adresinizi yazın; e-postanıza şifre yenileme kodu gönderelim.</p>
        <div id="sifreMsg" class="msg err hidden"></div>
        <div id="sifreAdim1">
            <div class="field">
                <label class="lbl" for="sKimlik">Kullanıcı adı veya e-posta</label>
                <input id="sKimlik" class="inp" autocapitalize="none" spellcheck="false" maxlength="160" />
            </div>
        </div>
        <div id="sifreAdim2" class="hidden">
            <div class="field">
                <label class="lbl" for="sKod">E-postadaki 6 haneli kod</label>
                <input id="sKod" class="inp pk-kod" inputmode="numeric" autocomplete="one-time-code" maxlength="7" placeholder="000000" />
            </div>
            <div class="pk-iki">
                <div class="field">
                    <label class="lbl" for="sYeni">Yeni şifre</label>
                    <input id="sYeni" class="inp" type="password" autocomplete="new-password" />
                </div>
                <div class="field">
                    <label class="lbl" for="sYeni2">Yeni şifre (tekrar)</label>
