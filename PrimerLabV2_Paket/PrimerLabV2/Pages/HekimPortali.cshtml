                </div>
            </div>
        </div>
        <button id="sifreBtn" class="btn btn-block" type="submit">Kod Gönder</button>
        <button type="button" class="pk-link pk-geri" onclick="pkEkran('login')">&larr; Girişe dön</button>
    </form>
</section>


<!-- UYGULAMA -->
<div id="appScreen" class="hidden">
    <header class="topbar">
        <div class="wrap">
            <div class="brand">
                @if (firmaLogo != null) { <img class="brand-img" src="@firmaLogo" alt="@firmaAd" /> } else { <div class="brand-logo">@firmaKisa</div> }
                <div><div class="brand-name">@firmaBuyuk</div><div class="brand-sub">HEKİM PORTALI</div></div>
            </div>
            <div class="who"><b id="whoName">-</b><span id="whoClinic"></span> <button class="link-btn" type="button" onclick="cikisYap()">Çıkış</button></div>
        </div>
        <nav class="tabs"><div class="wrap">
            <button class="tab active" id="tabYeni" type="button" onclick="sekme('yeni')">＋ Yeni İş Gönder</button>
            <button class="tab" id="tabIsler" type="button" onclick="sekme('isler')">📋 İşlerim</button>
        </div></nav>
    </header>

    <main class="wrap">
        <!-- YENİ İŞ -->
        <section id="yeniBolum">
            <div id="formMsg" class="msg err hidden"></div>
            <div id="listeYokMsg" class="msg info hidden">Size tanımlı iş listesi henüz bulunmuyor. Lütfen laboratuvarı arayın; liste tanımlandığında buradan iş gönderebilirsiniz.</div>

            <form id="isFormu" onsubmit="gonder(event)" novalidate>
                <div class="card hidden" id="tekHekimKart">
                    <div class="card-title"><span class="step">0</span> Hekim <span class="req">*</span></div>
                    <div class="field">
                        <label class="lbl" for="tekHekim">Siparişi veren hekim</label>
                        <input id="tekHekimAra" class="inp" autocomplete="off" placeholder="Hekim veya klinik ara" oninput="tekHekimleriCiz()" style="margin-bottom:8px" />
                        <select id="tekHekim" class="inp" onchange="tekHekimSecildi()"></select>
                    </div>
                    <div class="hint">İş türleri ve fiyatlar seçilen hekimin listesinden gelir. Sipariş laboratuvarın onayına (Onay Bekleyen) düşer.</div>
                </div>
                <div class="card">
                    <div class="card-title"><span class="step">1</span> Hasta Bilgisi</div>
                    <div class="grid2">
                        <div class="field">
                            <label class="lbl" for="hastaAdi">Hasta adı soyadı <span class="req">*</span></label>
                            <input id="hastaAdi" class="inp" maxlength="150" autocomplete="off" placeholder="Örn. Ayşe Yılmaz" />
                        </div>
                        <div class="field">
                            <label class="lbl" for="referansNo">Klinik dosya / referans no</label>
                            <input id="referansNo" class="inp" maxlength="60" autocomplete="off" placeholder="İsteğe bağlı" />
                        </div>
                    </div>
                    <label class="check"><input id="acil" type="checkbox" /> Acil iş</label>
                </div>

                <div class="card">
                    <div class="card-title"><span class="step">2</span> Yapılacak İşler ve Dişler <span class="req">*</span></div>
                    <div id="kalemler"></div>
                    <button class="btn btn-ghost btn-sm" type="button" onclick="kalemEkle()">＋ Başka iş türü ekle</button>
                    <div class="chart">
                        <div class="chart-note" id="chartNote">Seçili iş için dişlere dokunun</div>
                        <div class="jaw" id="ustCene"></div>
                        <div class="jaw" id="altCene"></div>
                        <div class="jaw-btns">
                            <button class="btn btn-light btn-sm" type="button" onclick="ceneSec('ust')">Tüm üst çene</button>
                            <button class="btn btn-light btn-sm" type="button" onclick="ceneSec('alt')">Tüm alt çene</button>
                            <button class="btn btn-light btn-sm" type="button" onclick="disTemizle()">Seçimi temizle</button>
                        </div>
                    </div>
                    <div class="hint">Her iş türü için dişleri ayrı seçin. Adet, seçilen diş sayısı kadar otomatik dolar; gece plağı gibi çene işlerinde adedi 1 yapabilirsiniz.</div>
                </div>

                <div class="card">
                    <div class="card-title"><span class="step">3</span> Renk ve Materyal</div>
                    <div class="grid2">
                        <div class="field">
                            <label class="lbl" for="disRengi">Diş rengi <span class="req">*</span></label>
                            <input id="disRengi" class="inp" maxlength="50" list="renkler" autocomplete="off" placeholder="Örn. A2, A3.5, BL2" />
                            <datalist id="renkler"></datalist>
                        </div>
                        <div class="field">
                            <label class="lbl">Materyal <span class="req">*</span></label>
                            <div class="chips" id="materyaller"></div>
                            <input id="materyalDiger" class="inp hidden" style="margin-top:8px" maxlength="100" placeholder="Materyali yazın" />
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title"><span class="step">4</span> İmplant Bilgisi</div>
                    <label class="check"><input id="implantVar" type="checkbox" onchange="implantGoster()" /> Bu işte implant üstü çalışma var</label>
                    <div id="implantAlan" class="hidden" style="margin-top:12px">
                        <div class="grid2">
                            <div class="field">
                                <label class="lbl" for="implantMarka">İmplant markası <span class="req">*</span></label>
                                <input id="implantMarka" class="inp" maxlength="80" list="implantMarkalari" autocomplete="off" placeholder="Örn. Straumann" />
                                <datalist id="implantMarkalari"></datalist>
                            </div>
                            <div class="field">
                                <label class="lbl" for="implantPlatform">Sistem / platform / çap</label>
                                <input id="implantPlatform" class="inp" maxlength="80" autocomplete="off" placeholder="Örn. BLT RC Ø4.1" />
                            </div>
                            <div class="field">
                                <label class="lbl" for="abutmentTipi">Abutment</label>
                                <select id="abutmentTipi" class="inp">
                                    <option value="">Laboratuvar karar versin</option>
                                    <option>Ti-base</option>
                                    <option>Özel (custom) abutment</option>
                                    <option>Stok abutment</option>
                                    <option>Multi-unit</option>
                                    <option>Hekim gönderecek</option>
                                </select>
                            </div>
                            <div class="field">
                                <label class="lbl" for="baglantiTipi">Bağlantı</label>
                                <select id="baglantiTipi" class="inp">
                                    <option value="">Laboratuvar karar versin</option>
                                    <option>Vidalı</option>
                                    <option>Simante</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title"><span class="step">5</span> Ağız İçi Tarama ve Dosyalar</div>
                    <div class="grid2">
                        <div class="field">
                            <label class="lbl" for="taramaCihazi">Tarama cihazı</label>
                            <select id="taramaCihazi" class="inp">
                                <option value="">Seçiniz</option>
                                <option>iTero</option>
                                <option>3Shape TRIOS</option>
                                <option>Medit</option>
                                <option>Primescan / CEREC</option>
                                <option>Carestream</option>
                                <option>Shining 3D</option>
                                <option>Planmeca</option>
                                <option>Diğer</option>
                                <option>Fiziksel ölçü gönderilecek</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="lbl" for="tasarimKaynagi">Tasarım</label>
                            <select id="tasarimKaynagi" class="inp">
                                <option value="lab">Tasarımı laboratuvar yapsın</option>
                                <option value="doctor">Tasarım dosyasını ben gönderiyorum</option>
                            </select>
                        </div>
                    </div>
                    <div class="drop" id="drop" onclick="document.getElementById('dosyaInput').click()">
                        📎 Tarama dosyalarını seçin veya buraya sürükleyin
                        <div class="hint">STL, PLY, OBJ, DCM, ZIP, RAR, 7Z, PDF, fotoğraf · en fazla 8 dosya</div>
                    </div>
                    <input id="dosyaInput" type="file" multiple class="hidden" accept=".stl,.obj,.ply,.dcm,.zip,.rar,.7z,.pdf,.jpg,.jpeg,.png,.webp,.txt" onchange="dosyaEkle(this.files);this.value=''" />
                    <div class="files" id="dosyalar"></div>
                    <div class="hint" id="dosyaUyari"></div>
                    <div style="margin-top:12px">
                        <label class="lbl" for="linkInput">🔗 veya dosya linki paylaşın <span class="hint" style="font-weight:400">(WeTransfer, Google Drive, Dropbox, iCloud, 3Shape...)</span></label>
                        <textarea id="linkInput" class="inp" rows="2" maxlength="6000" autocapitalize="none" spellcheck="false" placeholder="https://we.tl/...   — birden fazla linki alt alta yazın" oninput="ozetCiz()"></textarea>
                        <div class="hint">Dosyaları yüklemek yerine paylaşım linkini yapıştırabilirsiniz. Linkin süresi dolmadan laboratuvar dosyaları indirir.</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title"><span class="step">6</span> Teslim, Prova ve Notlar</div>
                    <div class="grid2">
                        <div class="field">
                            <label class="lbl" for="termin">İstenen teslim tarihi <span class="req">*</span></label>
                            <input id="termin" class="inp" type="date" />
                        </div>
                        <div class="field">
                            <label class="lbl" for="prova">Prova</label>
                            <select id="prova" class="inp">
                                <option value="">Prova istemiyorum (direkt bitim)</option>
                                <option>Altyapı provası</option>
                                <option>Diş dizimi / estetik prova</option>
                                <option>Bisküvi prova</option>
                            </select>
                        </div>
                    </div>
                    <div class="field">
                        <label class="lbl" for="notlar">Laboratuvara notunuz</label>
                        <textarea id="notlar" class="inp" maxlength="4000" placeholder="Form, kontakt, okluzyon, özel istekler..."></textarea>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">Özet</div>
                    <div class="summary" id="ozet"></div>
                </div>

                <div class="send-bar">
                    <div class="progress hidden" id="ilerleme"><div></div></div>
                    <button id="gonderBtn" class="btn btn-block" type="submit">Laboratuvara Gönder</button>
                </div>
            </form>

            <div id="gonderildi" class="card done hidden">
                <div class="big">✅</div>
                <h2>İş laboratuvara ulaştı</h2>
                <p id="gonderildiMsg" class="hint"></p>
                <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px">
                    <button class="btn" type="button" onclick="yeniForm()">Yeni iş gönder</button>
                    <button class="btn btn-light" type="button" onclick="sekme('isler')">İşlerime git</button>
                </div>
            </div>
        </section>

        <!-- İŞLERİM -->
        <section id="islerBolum" class="hidden">
            <div class="toolbar">
                <input id="isAra" class="inp" placeholder="Hasta adı veya iş türü ara" oninput="isleriCiz()" />
                <button class="btn btn-light" type="button" onclick="isleriYukle()">Yenile</button>
            </div>
            <div id="islerListe"><div class="empty">Yükleniyor...</div></div>
        </section>
    </main>
</div>

<script>
    const UST = [18,17,16,15,14,13,12,11,21,22,23,24,25,26,27,28];
    const ALT = [48,47,46,45,44,43,42,41,31,32,33,34,35,36,37,38];
    const RENKLER = ["#1565c0","#15803d","#c2410c","#7c3aed","#be123c","#0f766e","#a16207","#4338ca","#0369a1","#9d174d","#3f6212","#6b21a8"];
    const MATERYALLER = ["Zirkonyum","Metal Destekli Porselen","E.max","Lamine","PMMA","Titanyum","Diğer"];
    const VITA = ["A1","A2","A3","A3.5","A4","B1","B2","B3","B4","C1","C2","C3","C4","D2","D3","D4","BL1","BL2","BL3","BL4","OM1","OM2","OM3"];
    const IMPLANTLAR = ["Straumann","Nobel Biocare","Osstem","Megagen","Dentium","Zimmer Biomet","Astra Tech (Dentsply)","Neodent","BEGO","Bredent","MIS","Alpha-Bio","Hiossen","Medentika","Implance","NucleOSS","Biohorizons","Camlog","Dio","Anthogyr","Implantium"];
    const MAX_DOSYA = 8, MAX_BOYUT = 250 * 1024 * 1024, INTERNET_UYARI = 95 * 1024 * 1024;

    let isTurleri = [];
    let kalemler = [];
    let aktifKalem = null;
    let dosyalar = [];
    let materyal = "";
    let isler = [];
    let acikIs = null;
    let sayac = 0;

    const $ = id => document.getElementById(id);
    const esc = v => String(v == null ? "" : v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    const boyut = b => b >= 1048576 ? (b / 1048576).toFixed(1) + " MB" : Math.max(1, Math.round(b / 1024)) + " KB";
    const tarih = v => { if (!v) return "-"; const d = new Date(v); return isNaN(d) ? "-" : d.toLocaleDateString("tr-TR"); };

    async function api(url, opt) {
        const r = await fetch(url, Object.assign({ cache: "no-store", credentials: "same-origin" }, opt || {}));
        if (r.status === 401) { girisEkrani(); throw new Error("Oturum sona erdi, lütfen tekrar giriş yapın."); }
        if (!r.ok) throw new Error((await r.text()) || ("İşlem başarısız (" + r.status + ")"));
        const t = r.headers.get("content-type") || "";
        return t.includes("json") ? r.json() : r.text();
    }

    function mesaj(el, text, tur) {
        const m = $(el);
        if (!text) { m.classList.add("hidden"); return; }
        m.className = "msg " + (tur || "err");
        m.textContent = text;
        if (el === "formMsg") m.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    // ---------- Oturum ----------
    function girisEkrani() {
        if (TEK) { tekHata("Teknisyen oturumu sona erdi. Teknisyen Paneli'nden tekrar giriş yapın."); return; }
        $("appScreen").classList.add("hidden");
        pkEkran("login");
        setTimeout(() => $("loginUser").focus(), 50);
    }

    async function girisYap(e) {
        e.preventDefault();
        mesaj("loginMsg", "");
        const btn = $("loginBtn");
        btn.disabled = true; btn.textContent = "Giriş yapılıyor...";
        try {
            if (pkGiris) { await pkKodAdimi(); return; }
            const r = await fetch("/api/hekim-portal/login", {
                method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
                body: JSON.stringify({ kullaniciAdi: $("loginUser").value.trim(), parola: $("loginPass").value })
            });
            if (!r.ok) throw new Error((await r.text()) || "Giriş yapılamadı.");
            $("loginPass").value = "";
            await pkGirisCevabi(await r.json().catch(() => ({})));
        } catch (err) {
            mesaj("loginMsg", err.message);
        } finally {
            btn.disabled = false; btn.textContent = pkButon();
        }
    }

    // ---------- Giriş: e-posta kodu, kendi kendine kayıt, şifremi unuttum ----------
    const PK_API = "/api/hekim-portal";
    let pkGiris = null;      // parola sonrası adım: { tur: "eposta-gir" | "eposta-kod", jeton, ... }
    let pkKayitJeton = null; // kayıtta e-posta kodu bekleniyor
    let pkSifreJeton = null; // şifre yenilemede kod bekleniyor
    function pkMsg(id, text, tur) {
        const m = $(id);
        if (!text) { m.classList.add("hidden"); return; }
        m.className = "msg " + (tur || "err");
        m.textContent = text;
    }
    async function pkPost(yol, govde) {
        const r = await fetch(PK_API + yol, {
            method: "POST", headers: { "Content-Type": "application/json" }, credentials: "same-origin",
            body: JSON.stringify(govde || {})
        });
        const metin = await r.text();
        if (!r.ok) {
            const err = new Error(metin || "İşlem başarısız.");
            err.sureDoldu = r.status === 401 && /^(Süre doldu|Çok fazla hatalı kod)/.test(metin);
            throw err;
        }
        try { return JSON.parse(metin); } catch { return {}; }
    }
    function pkEkran(ad) {
        $("loginScreen").classList.toggle("hidden", ad !== "login");
        $("kayitScreen").classList.toggle("hidden", ad !== "kayit");
        $("sifreScreen").classList.toggle("hidden", ad !== "sifre");
        pkMsg("kayitMsg", ""); pkMsg("sifreMsg", "");
        if (ad === "kayit") { pkKayitJeton = null; $("kayitForm").classList.remove("hidden"); $("kayitKodAlani").classList.add("hidden"); $("kayitBtn").textContent = "Kayıt Ol"; setTimeout(() => $("kAdSoyad").focus(), 50); }
        if (ad === "sifre") { pkSifreJeton = null; $("sifreAdim1").classList.remove("hidden"); $("sifreAdim2").classList.add("hidden"); $("sifreBtn").textContent = "Kod Gönder"; setTimeout(() => $("sKimlik").focus(), 50); }
        if (ad === "login") { pkGirisSifirla(); pkDurumYukle(); }
    }
    let pkDurum = null;
    async function pkDurumYukle() {
        try { pkDurum = await (await fetch(PK_API + "/kayit/durum", { cache: "no-store" })).json(); } catch {}
        return pkDurum;
    }
    // Bağlantılar her zaman görünür; kayıt / şifre yenileme kapalıysa nedeni açıklanır.
    async function pkAc(ad) {
        const d = await pkDurumYukle();
        if (ad === "kayit" && d && !d.kayitAcik) {
            pkMsg("loginMsg", d.sifreSifirlama
                ? "Yeni kayıt şu anda kapalı. Hesap açmak için lütfen laboratuvarla görüşün."
                : "Kayıt henüz açılmadı: laboratuvarın e-posta ayarı yapılınca buradan kendiniz kayıt olabileceksiniz. Şimdilik hesap için laboratuvarla görüşün.", "info");
            return;
        }
        if (ad === "sifre" && d && !d.sifreSifirlama) {
            pkMsg("loginMsg", "Şifre yenileme henüz açılmadı (laboratuvarın e-posta ayarı yapılmamış). Yeni şifre için laboratuvarla görüşün.", "info");
            return;
        }
        pkEkran(ad);
    }
    function pkButon() {
        return !pkGiris ? "Giriş Yap" : pkGiris.tur === "eposta-gir" ? "Kodu Gönder" : "Doğrula ve Giriş Yap";
    }
    function pkGirisSifirla() {
        pkGiris = null;
        $("sifreAdimi").classList.remove("hidden");
        $("kodAdimi").classList.add("hidden");
        $("pkGirisGeri").classList.add("hidden");
        $("pkAltLinkler").classList.remove("hidden");
        $("loginUser").required = true; $("loginPass").required = true;
        $("pkGirisKod").value = "";
        $("loginBtn").textContent = pkButon();
    }
    function pkGirisAdim(d) {
        pkGiris = { tur: d.ikiAdim, jeton: d.jeton };
        const kodMu = d.ikiAdim === "eposta-kod";
        $("sifreAdimi").classList.add("hidden");
        $("kodAdimi").classList.remove("hidden");
        $("pkGirisGeri").classList.remove("hidden");
        $("pkAltLinkler").classList.add("hidden");
        $("loginUser").required = false; $("loginPass").required = false;
        $("pkEpostaAlani").classList.toggle("hidden", kodMu);
        $("pkKodAlani").classList.toggle("hidden", !kodMu);
        if (kodMu) {
            $("pkKodBilgi").textContent = (d.eposta || "E-posta") + " adresine 6 haneli giriş kodu gönderdik. Birkaç dakika içinde gelmezse gereksiz (spam) klasörüne bakın.";
            const gun = Number(d.hatirlaGun || 0);
            $("pkHatirlaSatir").classList.toggle("hidden", gun <= 0);
            $("pkHatirlaMetin").textContent = "Bu cihazı " + gun + " gün hatırla (bu süre içinde kod sorulmaz)";
            $("pkGirisKod").value = "";
            setTimeout(() => $("pkGirisKod").focus(), 50);
        } else {
            if (d.oneri) $("pkGirisEposta").value = d.oneri;
            setTimeout(() => $("pkGirisEposta").focus(), 50);
        }
        $("loginBtn").textContent = pkButon();
    }
    async function pkGirisCevabi(d) {
        if (d && (d.ikiAdim === "eposta-kod" || d.ikiAdim === "eposta-gir")) { pkGirisAdim(d); return; }
        pkGirisSifirla();
        await basla();
    }
    async function pkKodAdimi() {
        if (pkGiris.tur === "eposta-gir") {
            const e = $("pkGirisEposta").value.trim();
            if (!e) throw new Error("E-posta adresinizi yazın.");
            try { pkGirisAdim(await pkPost("/login/eposta", { jeton: pkGiris.jeton, eposta: e })); }
            catch (err) { if (/^Süre doldu/.test(err.message)) pkGirisSifirla(); throw err; }
            return;
        }
        const kod = $("pkGirisKod").value.replace(/\D/g, "");
        if (kod.length !== 6) throw new Error("E-postanıza gelen 6 haneli kodu girin.");
        try {
            await pkPost("/login/kod", { jeton: pkGiris.jeton, kod, hatirla: $("pkHatirla").checked });
        } catch (err) {
            if (err.sureDoldu) pkGirisSifirla();
            $("pkGirisKod").value = "";
            throw err;
        }
        pkGirisSifirla();
        await basla();
    }
    async function pkKodTekrar() {
        try { await pkPost("/login/kod-tekrar", { jeton: pkGiris && pkGiris.jeton }); pkMsg("loginMsg", "Yeni kod gönderildi. Son gelen kodu girin.", "ok"); }
        catch (e) { pkMsg("loginMsg", e.message); }
    }

    // Bot engeli (iş kanıtı): sunucunun verdiği metin için SHA-256 özeti belirli sayıda sıfır bitle
    // başlayan bir sayı aranır. Normal bir kişi için yaklaşık 1 saniye sürer.
    const PK_K = new Uint32Array([0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2]);
    const PK_W = new Uint32Array(64);
    function pkSha256Ilk(s) {
        const W = PK_W; W.fill(0);
        const L = s.length;
        for (let i = 0; i < L; i++) W[i >> 2] |= s.charCodeAt(i) << (24 - 8 * (i & 3));
        W[L >> 2] |= 0x80 << (24 - 8 * (L & 3));
        W[15] = L * 8;
        for (let i = 16; i < 64; i++) {
            const x = W[i - 15], y = W[i - 2];
            const s0 = ((x >>> 7) | (x << 25)) ^ ((x >>> 18) | (x << 14)) ^ (x >>> 3);
            const s1 = ((y >>> 17) | (y << 15)) ^ ((y >>> 19) | (y << 13)) ^ (y >>> 10);
            W[i] = (W[i - 16] + s0 + W[i - 7] + s1) | 0;
        }
        let a = 0x6a09e667, b = 0xbb67ae85, c = 0x3c6ef372, d = 0xa54ff53a, e = 0x510e527f, f = 0x9b05688c, g = 0x1f83d9ab, h = 0x5be0cd19;
        for (let i = 0; i < 64; i++) {
            const S1 = ((e >>> 6) | (e << 26)) ^ ((e >>> 11) | (e << 21)) ^ ((e >>> 25) | (e << 7));
            const t1 = (h + S1 + ((e & f) ^ (~e & g)) + PK_K[i] + W[i]) | 0;
            const S0 = ((a >>> 2) | (a << 30)) ^ ((a >>> 13) | (a << 19)) ^ ((a >>> 22) | (a << 10));
            const t2 = (S0 + ((a & b) ^ (a & c) ^ (b & c))) | 0;
            h = g; g = f; f = e; e = (d + t1) | 0; d = c; c = b; b = a; a = (t1 + t2) | 0;
        }
        return (0x6a09e667 + a) >>> 0;
    }
    async function pkZorluk() {
        const r = await fetch(PK_API + "/kayit/zorluk", { cache: "no-store" });
        if (!r.ok) throw new Error((await r.text()) || "Güvenlik kontrolü başlatılamadı.");
        const z = await r.json();
        let n = 0;
        for (;;) {
            for (let i = 0; i < 25000; i++, n++)
                if ((pkSha256Ilk(z.tuz + ":" + n) >>> (32 - z.bit)) === 0) return { zorlukJeton: z.jeton, zorlukCevap: String(n) };
            await new Promise(res => setTimeout(res, 0));
        }
    }

    async function pkKayit(e) {
        e.preventDefault();
        pkMsg("kayitMsg", "");
        const btn = $("kayitBtn"); btn.disabled = true;
        try {
            if (!pkKayitJeton) {
                if ($("kParola").value !== $("kParola2").value) throw new Error("Şifreler aynı değil.");
                if (!$("kKvkk").checked) throw new Error("Devam etmek için bilgilendirme metnini onaylayın.");
                btn.textContent = "Güvenlik kontrolü...";
                const z = await pkZorluk();
                btn.textContent = "Gönderiliyor...";
                const d = await pkPost("/kayit/basla", Object.assign({
                    adSoyad: $("kAdSoyad").value.trim(), klinikAdi: $("kKlinik").value.trim(),
                    telefon: $("kTelefon").value.trim(), eposta: $("kEposta").value.trim(),
                    kullaniciAdi: $("kKullanici").value.trim(), parola: $("kParola").value,
                    kvkk: $("kKvkk").checked, website: $("kWebsite").value
                }, z));
                pkKayitJeton = d.jeton;
                $("kayitForm").classList.add("hidden");
                $("kayitKodAlani").classList.remove("hidden");
                $("kayitKodBilgi").textContent = (d.eposta || "E-posta") + " adresine 6 haneli doğrulama kodu gönderdik (10 dakika geçerli). Gelmezse gereksiz (spam) klasörüne bakın.";
                $("kKod").value = ""; setTimeout(() => $("kKod").focus(), 50);
            } else {
                const kod = $("kKod").value.replace(/\D/g, "");
                if (kod.length !== 6) throw new Error("E-postanıza gelen 6 haneli kodu girin.");
                const d = await pkPost("/kayit/tamamla", { jeton: pkKayitJeton, kod });
                pkKayitJeton = null;
                $("kParola").value = ""; $("kParola2").value = "";
                if (d.onayBekliyor) { pkEkran("login"); pkMsg("loginMsg", d.message || "Kaydınız alındı; laboratuvar onayından sonra giriş yapabilirsiniz.", "ok"); return; }
                $("kayitScreen").classList.add("hidden");
                await basla();
            }
        } catch (err) {
            if (err.sureDoldu || /^Bu kullanıcı adı az önce/.test(err.message)) { pkKayitJeton = null; $("kayitForm").classList.remove("hidden"); $("kayitKodAlani").classList.add("hidden"); }
            pkMsg("kayitMsg", err.message);
        } finally {
            btn.disabled = false; btn.textContent = pkKayitJeton ? "Hesabı Onayla" : "Kayıt Ol";
        }
    }

    async function pkSifre(e) {
        e.preventDefault();
        pkMsg("sifreMsg", "");
        const btn = $("sifreBtn"); btn.disabled = true;
        try {
            if (!pkSifreJeton) {
                const kimlik = $("sKimlik").value.trim();
                if (!kimlik) throw new Error("Kullanıcı adınızı veya e-posta adresinizi yazın.");
                btn.textContent = "Güvenlik kontrolü...";
                const z = await pkZorluk();
                const d = await pkPost("/sifre/basla", Object.assign({ kimlik }, z));
                pkSifreJeton = d.jeton;
                $("sifreAdim1").classList.add("hidden"); $("sifreAdim2").classList.remove("hidden");
                pkMsg("sifreMsg", "Bu bilgilerle kayıtlı bir hesap varsa, hesabın e-posta adresine kod gönderildi. Gelmezse gereksiz (spam) klasörüne bakın.", "ok");
                setTimeout(() => $("sKod").focus(), 50);
            } else {
                const kod = $("sKod").value.replace(/\D/g, "");
                if (kod.length !== 6) throw new Error("E-postanıza gelen 6 haneli kodu girin.");
                if ($("sYeni").value !== $("sYeni2").value) throw new Error("Yeni şifreler aynı değil.");
                await pkPost("/sifre/tamamla", { jeton: pkSifreJeton, kod, yeniParola: $("sYeni").value });
                pkSifreJeton = null; $("sYeni").value = ""; $("sYeni2").value = ""; $("sKod").value = "";
                pkEkran("login");
                pkMsg("loginMsg", "Şifreniz yenilendi. Yeni şifrenizle giriş yapabilirsiniz.", "ok");
            }
        } catch (err) {
            if (err.sureDoldu) { pkSifreJeton = null; $("sifreAdim1").classList.remove("hidden"); $("sifreAdim2").classList.add("hidden"); }
            pkMsg("sifreMsg", err.message);
        } finally {
            btn.disabled = false; btn.textContent = pkSifreJeton ? "Şifreyi Yenile" : "Kod Gönder";
        }
    }

    async function cikisYap() {
        try { await fetch("/api/hekim-portal/logout", { method: "POST", credentials: "same-origin" }); } catch {}
        girisEkrani();
    }

    // ---------- İç teknisyen modu (/hekim-portal?mod=teknisyen) ----------
    // Teknisyen Paneli oturumuyla girilir; hekim seçilir, form aynı, kayıt laboratuvar onayına düşer.
    const TEK = new URLSearchParams(location.search).get("mod") === "teknisyen";
    let tekHekimler = [];
    function tekHata(metin) {
        $("loginScreen").classList.add("hidden"); $("kayitScreen").classList.add("hidden"); $("sifreScreen").classList.add("hidden");
        $("appScreen").classList.add("hidden");
        document.body.insertAdjacentHTML("beforeend", `<section class="login"><div class="login-card"><h1>Sipariş formu açılamadı</h1><div class="msg err">${esc(metin)}</div><a class="btn btn-block" style="display:grid;place-items:center;text-decoration:none" href="/teknisyen">Teknisyen Paneli'ne dön</a></div></section>`);
    }
    async function tekBasla() {
        let d;
        try {
            const r = await fetch("/api/hekim-portal/teknisyen/hekimler", { cache: "no-store", credentials: "same-origin" });
            if (!r.ok) { tekHata((await r.text()) || "Teknisyen Paneli'nden giriş yapın."); return; }
            d = await r.json();
        } catch { tekHata("Bağlantı kurulamadı."); return; }
        tekHekimler = d.hekimler || [];
        document.title = "Primer Lab Sipariş Formu";
        document.querySelector("#appScreen .brand-sub").textContent = "SİPARİŞ FORMU";
        document.querySelector("#appScreen .tabs").classList.add("hidden");
        $("whoName").textContent = (d.teknisyen && d.teknisyen.adSoyad) || "";
        $("whoClinic").innerHTML = '<a class="link-btn" href="/teknisyen">← Teknisyen Paneli</a>';
        document.querySelector("#appScreen .who > button").classList.add("hidden");
        $("tekHekimKart").classList.remove("hidden");
        $("gonderBtn").textContent = "Siparişi Kaydet";
        $("gonderildi").querySelector("h2").textContent = "Sipariş kaydedildi";
        $("gonderildi").querySelector("button.btn-light").classList.add("hidden");
        $("gonderildi").querySelector("button.btn").textContent = "Yeni sipariş aç";
        $("loginScreen").classList.add("hidden");
        $("appScreen").classList.remove("hidden");
        isTurleri = [];
        tekHekimleriCiz();
        yeniForm();
        $("gonderBtn").disabled = true;
    }
    function tekHekimleriCiz() {
        const q = $("tekHekimAra").value.trim().toLocaleLowerCase("tr-TR"), sec = $("tekHekim").value;
        const liste = tekHekimler.filter(h => !q || (h.adSoyad + " " + (h.klinikAdi || "")).toLocaleLowerCase("tr-TR").includes(q));
        $("tekHekim").innerHTML = '<option value="">Hekim seçin...</option>' + liste.map(h =>
            `<option value="${h.id}">${esc(h.adSoyad)}${h.klinikAdi ? " — " + esc(h.klinikAdi) : ""}${h.isTuruSayisi ? "" : " (iş listesi yok)"}</option>`).join("");
        if (liste.some(h => String(h.id) === sec)) $("tekHekim").value = sec;
        else if (liste.length === 1 && q) { $("tekHekim").value = String(liste[0].id); tekHekimSecildi(); }
    }
    async function tekHekimSecildi() {
        const id = Number($("tekHekim").value || 0);
        isTurleri = [];
        if (id) {
            try { const d = await api("/api/hekim-portal/teknisyen/me?hekimId=" + id); isTurleri = (d.isTurleri || []).map(x => x.isTuru).filter(Boolean); }
            catch (err) { mesaj("formMsg", err.message); }
        }
        $("listeYokMsg").textContent = "Bu hekime tanımlı iş listesi yok. Ana programda Hekimler > Fiyat Listesi'nden tanımlanmalı.";
        $("listeYokMsg").classList.toggle("hidden", !id || isTurleri.length > 0);
        $("gonderBtn").disabled = !id || isTurleri.length === 0;
        kalemler = []; sayac = 0; kalemEkle(); ozetCiz();
    }

    async function basla() {
        if (TEK) { await tekBasla(); return; }
        let me;
        try {
            const r = await fetch("/api/hekim-portal/me", { cache: "no-store", credentials: "same-origin" });
            if (!r.ok) { girisEkrani(); return; }
            me = await r.json();
        } catch { girisEkrani(); return; }
        $("loginScreen").classList.add("hidden");
        $("appScreen").classList.remove("hidden");
        $("whoName").textContent = (me.hekim && me.hekim.adSoyad) || "";
        $("whoClinic").textContent = (me.hekim && me.hekim.klinikAdi) || "";
        isTurleri = (me.isTurleri || []).map(x => x.isTuru).filter(Boolean);
        $("listeYokMsg").classList.toggle("hidden", isTurleri.length > 0);
        $("gonderBtn").disabled = isTurleri.length === 0;
        if (!kalemler.length) yeniForm();
        else kalemleriCiz();
        if (!$("islerBolum").classList.contains("hidden")) isleriYukle();
    }

    function sekme(ad) {
        $("tabYeni").classList.toggle("active", ad === "yeni");
        $("tabIsler").classList.toggle("active", ad === "isler");
        $("yeniBolum").classList.toggle("hidden", ad !== "yeni");
        $("islerBolum").classList.toggle("hidden", ad !== "isler");
        if (ad === "isler") isleriYukle();
        window.scrollTo(0, 0);
    }

    // ---------- Form ----------
    function yeniForm() {
        ["hastaAdi","referansNo","disRengi","implantMarka","implantPlatform","notlar","materyalDiger"].forEach(id => $(id).value = "");
        ["abutmentTipi","baglantiTipi","taramaCihazi","prova"].forEach(id => $(id).value = "");
        $("tasarimKaynagi").value = "lab";
        $("acil").checked = false;
        $("implantVar").checked = false;
        materyal = "";
        dosyalar = [];
        if ($("linkInput")) $("linkInput").value = "";
        kalemler = [];
        sayac = 0;
        kalemEkle();
        const d = new Date(); d.setDate(d.getDate() + 5);
        $("termin").value = yerelTarih(d);
        $("termin").min = yerelTarih(new Date());
        implantGoster(); materyalCiz(); dosyalariCiz(); mesaj("formMsg", "");
        $("isFormu").classList.remove("hidden");
        $("gonderildi").classList.add("hidden");
        ozetCiz();
    }

    function yerelTarih(d) {
        return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
    }

    function kalemEkle() {
        if (kalemler.length >= 12) { mesaj("formMsg", "Bir gönderimde en fazla 12 iş türü olabilir."); return; }
        const k = { id: ++sayac, isTuru: "", disler: [], adet: 1, adetElle: false, renk: RENKLER[kalemler.length % RENKLER.length] };
        kalemler.push(k);
        aktifKalem = k.id;
        kalemleriCiz();
    }

    function kalemSil(id) {
        kalemler = kalemler.filter(k => k.id !== id);
        if (!kalemler.length) { kalemEkle(); return; }
        if (aktifKalem === id) aktifKalem = kalemler[kalemler.length - 1].id;
        kalemleriCiz();
    }

    function kalemSec(id) { aktifKalem = id; kalemleriCiz(); }

    function kalemleriCiz() {
        const opts = isTurleri.map(t => `<option value="${esc(t)}">${esc(t)}</option>`).join("");
        $("kalemler").innerHTML = kalemler.map(k => `
            <div class="item ${k.id === aktifKalem ? "active" : ""}" style="--c:${k.renk}" onclick="kalemSec(${k.id})">
                <div class="item-head">
                    <span class="dot"></span>
                    <select class="inp" onchange="kalemTur(${k.id},this.value)" onclick="event.stopPropagation()">
                        <option value="">İş türü seçin...</option>${opts}
                    </select>
                    <input class="inp qty" type="number" min="1" max="99" value="${k.adet}" title="Adet" onclick="event.stopPropagation()" oninput="kalemAdet(${k.id},this.value)" />
                    <button class="del" type="button" title="Kaldır" onclick="event.stopPropagation();kalemSil(${k.id})">×</button>
                </div>
                <div class="item-foot">
                    <span>Dişler: <span class="item-teeth">${k.disler.length ? k.disler.join(", ") : "seçilmedi"}</span></span>
                    <button class="pick" type="button">${k.id === aktifKalem ? "Diş seçiliyor ↓" : "Diş seç"}</button>
                </div>
            </div>`).join("");
        kalemler.forEach((k, i) => { $("kalemler").children[i].querySelector("select").value = k.isTuru; });
        disleriCiz();
        ozetCiz();
    }

    function kalemTur(id, v) {
        const k = kalemler.find(x => x.id === id); if (!k) return;
        k.isTuru = v;
        if (aktifKalem !== id) { aktifKalem = id; kalemleriCiz(); } else disleriCiz();
        if (/implant/i.test(v.toLocaleLowerCase("tr-TR").replace(/ı/g, "i")) && !$("implantVar").checked) {
            $("implantVar").checked = true; implantGoster();
        }
        ozetCiz();
    }

    function kalemAdet(id, v) {
        const k = kalemler.find(x => x.id === id); if (!k) return;
        const n = parseInt(v, 10);
        k.adet = isNaN(n) ? 0 : n;
        k.adetElle = true;
        ozetCiz();
    }

    function disleriCiz() {
        const aktif = kalemler.find(k => k.id === aktifKalem);
        $("chartNote").innerHTML = aktif
            ? `Dişlere dokunun: <b style="color:${aktif.renk}">${esc(aktif.isTuru || "seçili iş")}</b>`
            : "Önce bir iş seçin";
        const ciz = liste => liste.map(n => {
            const sahip = kalemler.filter(k => k.disler.includes(n));
            const on = sahip.find(k => k.id === aktifKalem) || sahip[0];
            const st = on ? `style="background:${on.renk}"` : "";
            return `<button type="button" class="tooth ${on ? "on" : ""} ${sahip.length > 1 ? "multi" : ""}" ${st} onclick="disDegistir(${n})" title="${n}${sahip.length ? " · " + esc(sahip.map(k => k.isTuru || "iş").join(", ")) : ""}">${n}</button>`;
        }).join("");
        $("ustCene").innerHTML = ciz(UST);
        $("altCene").innerHTML = ciz(ALT);
    }

    function disAyarla(k, liste) {
        k.disler = Array.from(new Set(liste)).sort((a, b) => a - b);
        if (!k.adetElle) k.adet = Math.max(1, k.disler.length);
    }

    function disDegistir(n) {
        const k = kalemler.find(x => x.id === aktifKalem); if (!k) return;
        disAyarla(k, k.disler.includes(n) ? k.disler.filter(x => x !== n) : k.disler.concat(n));
        kalemleriCiz();
    }

    function ceneSec(cene) {
        const k = kalemler.find(x => x.id === aktifKalem); if (!k) return;
        const liste = cene === "ust" ? UST : ALT;
        const hepsi = liste.every(n => k.disler.includes(n));
        disAyarla(k, hepsi ? k.disler.filter(n => !liste.includes(n)) : k.disler.concat(liste));
        kalemleriCiz();
    }

    function disTemizle() {
        const k = kalemler.find(x => x.id === aktifKalem); if (!k) return;
        k.adetElle = false;
        disAyarla(k, []);
        kalemleriCiz();
    }

    function materyalCiz() {
        $("materyaller").innerHTML = MATERYALLER.map(m => {
            const on = m === "Diğer" ? (materyal && !MATERYALLER.includes(materyal)) || materyal === "Diğer" : materyal === m;
            return `<button type="button" class="chip ${on ? "on" : ""}" onclick="materyalSec('${m}')">${esc(m)}</button>`;
        }).join("");
    }

    function materyalSec(m) {
        materyal = m;
        $("materyalDiger").classList.toggle("hidden", m !== "Diğer");
        if (m === "Diğer") $("materyalDiger").focus();
        materyalCiz(); ozetCiz();
    }

    function implantGoster() {
        $("implantAlan").classList.toggle("hidden", !$("implantVar").checked);
        ozetCiz();
    }

    // ---------- Dosyalar ----------
    function dosyaEkle(list) {
        mesaj("formMsg", "");
        const izinli = /\.(stl|obj|ply|dcm|zip|rar|7z|pdf|jpe?g|png|webp|txt)$/i;
        for (const f of Array.from(list || [])) {
            if (dosyalar.length >= MAX_DOSYA) { mesaj("formMsg", "En fazla " + MAX_DOSYA + " dosya yüklenebilir. Fazlasını ZIP yapıp tek dosya olarak ekleyin."); break; }
            if (!izinli.test(f.name)) { mesaj("formMsg", "'" + f.name + "' desteklenmeyen dosya türü."); continue; }
            if (f.size <= 0) { mesaj("formMsg", "'" + f.name + "' boş dosya."); continue; }
            if (f.size > MAX_BOYUT) { mesaj("formMsg", "'" + f.name + "' 250 MB sınırını aşıyor."); continue; }
            if (dosyalar.some(x => x.name === f.name && x.size === f.size)) continue;
            dosyalar.push(f);
        }
        dosyalariCiz();
    }

    // Dosya linkleri: satır, boşluk ya da virgülle ayrılmış adresler.
    function linkleriOku() {
        return Array.from(new Set(($("linkInput")?.value || "").split(/[\s,]+/).map(x => x.trim()).filter(Boolean)));
    }
    function linkHatasi(list) {
        if (list.length > 10) return "En fazla 10 link eklenebilir.";
        const kotu = list.find(u => !/^(https?:\/\/)?[^\s\/.]+(\.[^\s\/.]+)+(\/\S*)?$/i.test(u));
        return kotu ? "Geçersiz link: " + kotu + " (https:// ile başlayan bir adres girin)." : null;
    }

    function dosyaSil(i) { dosyalar.splice(i, 1); dosyalariCiz(); }

    function dosyalariCiz() {
        $("dosyalar").innerHTML = dosyalar.map((f, i) =>
            `<div class="file"><span>📄 ${esc(f.name)}</span><small>${boyut(f.size)}</small><button type="button" onclick="dosyaSil(${i})" title="Kaldır">×</button></div>`).join("");
        const toplam = dosyalar.reduce((s, f) => s + f.size, 0);
        $("dosyaUyari").textContent = toplam > INTERNET_UYARI && location.protocol === "https:"
            ? "Toplam " + boyut(toplam) + ". İnternet bağlantısında 100 MB üzeri gönderim reddedilebilir; dosyaları ZIP yapıp küçültün veya iki ayrı iş olarak gönderin."
            : "";
        ozetCiz();
    }

    (function () {
        const d = $("drop");
        ["dragenter","dragover"].forEach(ev => d.addEventListener(ev, e => { e.preventDefault(); d.classList.add("over"); }));
        ["dragleave","drop"].forEach(ev => d.addEventListener(ev, e => { e.preventDefault(); d.classList.remove("over"); }));
        d.addEventListener("drop", e => dosyaEkle(e.dataTransfer.files));
    })();

    // ---------- Özet + gönderim ----------
    function secilenMateryal() {
        return materyal === "Diğer" ? $("materyalDiger").value.trim() : materyal;
    }

    function ozetCiz() {
        const satir = kalemler.filter(k => k.isTuru).map(k =>
            `${esc(k.isTuru)} × ${k.adet}${k.disler.length ? " <span style='color:#64748b'>(" + k.disler.join(", ") + ")</span>" : ""}`);
        $("ozet").innerHTML =
            `<div><b>Hasta:</b> ${esc($("hastaAdi").value.trim() || "-")}${$("acil").checked ? " · <b style='color:#dc2626'>ACİL</b>" : ""}</div>` +
            `<div><b>İşler:</b> ${satir.length ? satir.join("<br>") : "-"}</div>` +
            `<div><b>Renk / materyal:</b> ${esc($("disRengi").value.trim() || "-")} / ${esc(secilenMateryal() || "-")}</div>` +
            ($("implantVar").checked ? `<div><b>İmplant:</b> ${esc($("implantMarka").value.trim() || "-")} ${esc($("implantPlatform").value.trim())}</div>` : "") +
            `<div><b>Dosya:</b> ${dosyalar.length ? dosyalar.length + " dosya" : "yok"}${linkleriOku().length ? " · <b>Link:</b> " + linkleriOku().length : ""} · <b>Teslim:</b> ${esc($("termin").value ? tarih($("termin").value + "T12:00:00") : "-")}</div>` +
            `<div class="hint">Fiyatlandırma, laboratuvarın sizinle anlaştığı fiyat listesine göre otomatik yapılır.</div>`;
    }

    ["hastaAdi","disRengi","implantMarka","implantPlatform","termin","materyalDiger"].forEach(id => $(id).addEventListener("input", ozetCiz));
    $("acil").addEventListener("change", ozetCiz);

    function dogrula() {
        if (!$("hastaAdi").value.trim()) return ["Hasta adı soyadı yazın.", "hastaAdi"];
        const dolu = kalemler.filter(k => k.isTuru);
        if (!dolu.length) return ["En az bir iş türü seçin.", "kalemler"];
        if (kalemler.some(k => !k.isTuru && k.disler.length)) return ["Diş seçtiğiniz satırın iş türünü seçin.", "kalemler"];
        if (dolu.some(k => !(k.adet >= 1 && k.adet <= 99))) return ["Adet 1 ile 99 arasında olmalı.", "kalemler"];
        if (!dolu.some(k => k.disler.length)) return ["Diş şemasından işlem yapılacak dişleri seçin.", "kalemler"];
        if (!$("disRengi").value.trim()) return ["Diş rengini yazın.", "disRengi"];
        if (!secilenMateryal()) return ["Materyal seçin.", "materyaller"];
        if ($("implantVar").checked && !$("implantMarka").value.trim()) return ["İmplant markasını yazın.", "implantMarka"];
        if (!$("termin").value) return ["Teslim tarihini seçin.", "termin"];
        return null;
    }

    function gonder(e) {
        e.preventDefault();
        const hata = dogrula();
        if (hata) {
            mesaj("formMsg", hata[0]);
            const el = $(hata[1]); if (el && el.focus) setTimeout(() => el.focus({ preventScroll: true }), 300);
            return;
        }
        if (TEK && !$("tekHekim").value) { mesaj("formMsg", "Hekim seçin."); $("tekHekim").focus(); return; }
        const linkHata = linkHatasi(linkleriOku());
        if (linkHata) { mesaj("formMsg", linkHata); $("linkInput").focus(); return; }
        mesaj("formMsg", "");
        const dolu = kalemler.filter(k => k.isTuru);
        const payload = {
            hastaAdi: $("hastaAdi").value.trim(),
            referansNo: $("referansNo").value.trim() || null,
            acil: $("acil").checked,
            disRengi: $("disRengi").value.trim(),
            materyal: secilenMateryal(),
            disler: Array.from(new Set(dolu.flatMap(k => k.disler))).sort((a, b) => a - b),
            terminTarihi: $("termin").value,
            notlar: $("notlar").value.trim() || null,
            tasarimKaynagi: $("tasarimKaynagi").value,
            implantVar: $("implantVar").checked,
            implantMarkasi: $("implantVar").checked ? $("implantMarka").value.trim() : null,
            implantPlatform: $("implantVar").checked ? ($("implantPlatform").value.trim() || null) : null,
            abutmentTipi: $("implantVar").checked ? ($("abutmentTipi").value || null) : null,
            baglantiTipi: $("implantVar").checked ? ($("baglantiTipi").value || null) : null,
            taramaCihazi: $("taramaCihazi").value || null,
            provaAsamasi: $("prova").value || null,
            kalemler: dolu.map(k => ({ isTuru: k.isTuru, adet: k.adet, disler: k.disler })),
            linkler: linkleriOku()
        };
        const fd = new FormData();
        fd.append("payload", JSON.stringify(payload));
        dosyalar.forEach(f => fd.append("files", f, f.name));

        const btn = $("gonderBtn"), bar = $("ilerleme"), ic = bar.firstElementChild;
        btn.disabled = true; btn.textContent = "Gönderiliyor...";
        bar.classList.remove("hidden"); ic.style.width = "0%";

        const xhr = new XMLHttpRequest();
        xhr.open("POST", TEK ? "/api/hekim-portal/teknisyen/jobs?hekimId=" + Number($("tekHekim").value) : "/api/hekim-portal/jobs");
        xhr.withCredentials = true;
        xhr.upload.onprogress = ev => {
            if (!ev.lengthComputable) return;
            const y = Math.round(ev.loaded * 100 / ev.total);
            ic.style.width = y + "%";
            btn.textContent = y < 100 ? "Yükleniyor... %" + y : "Kaydediliyor...";
        };
        const bitir = () => { btn.disabled = false; btn.textContent = TEK ? "Siparişi Kaydet" : "Laboratuvara Gönder"; bar.classList.add("hidden"); };
        xhr.onload = () => {
            bitir();
            if (xhr.status === 401 && TEK) { mesaj("formMsg", "Teknisyen oturumu sona erdi. Başka sekmede Teknisyen Paneli'ne giriş yapıp Kaydet'e tekrar basın; form duruyor."); return; }
            if (xhr.status === 401) { girisEkrani(); mesaj("loginMsg", "Oturum sona erdi. Giriş yaptıktan sonra Gönder'e tekrar basın; formunuz duruyor."); return; }
            if (xhr.status === 413) { mesaj("formMsg", "Dosyalar çok büyük. ZIP yapıp küçültün veya ikiye bölerek gönderin."); return; }
            if (xhr.status < 200 || xhr.status >= 300) { mesaj("formMsg", xhr.responseText || ("Gönderilemedi (" + xhr.status + ")")); return; }
            let d = {}; try { d = JSON.parse(xhr.responseText); } catch {}
            $("gonderildiMsg").textContent = (TEK ? "#" + (d.siparisIds || [d.siparisId]).join(", #") + " numaralı sipariş açıldı; laboratuvarın Onay Bekleyen listesine düştü." : (d.message || "İş laboratuvara gönderildi.")) + (d.dosyaSayisi ? " " + d.dosyaSayisi + " dosya yüklendi." : "") + (d.linkSayisi ? " " + d.linkSayisi + " link eklendi." : "");
            $("isFormu").classList.add("hidden");
            $("gonderildi").classList.remove("hidden");
            kalemler = []; dosyalar = []; $("linkInput").value = "";
            window.scrollTo(0, 0);
        };
        xhr.onerror = () => { bitir(); mesaj("formMsg", "Bağlantı koptu, iş gönderilemedi. İnternetinizi kontrol edip tekrar deneyin; formunuz duruyor."); };
        xhr.send(fd);
    }

    // ---------- İşlerim ----------
    async function isleriYukle() {
        $("islerListe").innerHTML = '<div class="empty">Yükleniyor...</div>';
        try {
            isler = await api("/api/hekim-portal/jobs");
            isleriCiz();
            okunmamisOzet();
        } catch (err) {
            $("islerListe").innerHTML = `<div class="msg err">${esc(err.message)}</div>`;
        }
    }

    function durum(j) {
        if (j.onayDurumu === "Gelen Onay") return ["Laboratuvar onayı bekleniyor", "wait"];
        if (j.onayDurumu === "Reddedildi") return ["Reddedildi", "cancel"];
        const d = j.durum || "-";
        if (/teslim|tamam/i.test(d)) return [d, "done"];
        if (/iptal/i.test(d)) return [d, "cancel"];
        if (/bekli/i.test(d)) return [d, "wait"];
        return [d, "prod"];
    }

    function isleriCiz() {
        const q = $("isAra").value.trim().toLocaleLowerCase("tr-TR");
        const liste = isler.filter(j => !q ||
            (j.hastaAdi || "").toLocaleLowerCase("tr-TR").includes(q) ||
            (j.kalemler || []).some(k => (k.isTuru || "").toLocaleLowerCase("tr-TR").includes(q)));
        if (!liste.length) { $("islerListe").innerHTML = `<div class="empty">${isler.length ? "Aramaya uyan iş yok." : "Henüz gönderilmiş işiniz yok."}</div>`; return; }
        $("islerListe").innerHTML = liste.map(j => {
            const [d, c] = durum(j);
            const kal = (j.kalemler || []).map(k => esc(k.isTuru) + " × " + k.adet).join(", ");
            return `<div class="job">
                <div class="job-head" onclick="isAc(${j.id})">
                    <div><div class="job-name">${esc(j.hastaAdi)}</div><div class="job-sub">#${j.id} · ${tarih(j.olusturmaTarihi)} · ${kal || "-"}${j.mesajSayisi ? " · 💬 " + j.mesajSayisi : ""}${j.okunmamisMesaj ? ` <span class="yeni-mesaj">${j.okunmamisMesaj} yeni mesaj</span>` : ""}</div></div>
                    <span class="badge ${c}">${esc(d)}</span>
                </div>
                ${hazirDosyaSerit(j)}
                ${acikIs === j.id ? `<div class="job-body" id="isDetay${j.id}">
                    ${asamaCiz(j)}
                    <div><b>Teslim:</b> ${tarih(j.terminTarihi)} · <b>Renk:</b> ${esc(j.disRengi || "-")} · <b>Materyal:</b> ${esc(j.materyal || "-")}</div>
                    <div><b>Dişler:</b> ${esc(j.disSemasi || "-")}</div>
                    ${j.notlar ? `<div><b>Notlar:</b><pre>${esc(j.notlar)}</pre></div>` : ""}
                    <div><b>Dosyalar:</b> <span id="isDosya${j.id}">${j.dosyaSayisi ? "yükleniyor..." : "yok"}</span></div>
                    <div><b>🔗 Linkler:</b> <span id="isLink${j.id}">${j.linkSayisi ? "yükleniyor..." : "yok"}</span>
                        <div class="msg-form" style="margin-top:6px"><input id="isLinkYaz${j.id}" class="inp" autocapitalize="none" spellcheck="false" placeholder="Dosya linki ekleyin: https://..." />
                        <button class="btn btn-sm" type="button" style="height:42px;white-space:nowrap" onclick="linkEkle(${j.id})">Link Ekle</button></div>
                    </div>
                    <div style="margin-top:10px"><b>💬 Laboratuvarla yazışma</b>
                        <div class="msgs" id="isMesaj${j.id}"><span class="hint">Yükleniyor...</span></div>
                        <div class="msg-form"><textarea id="isMesajYaz${j.id}" maxlength="4000" placeholder="Bu iş hakkında laboratuvara yazın..."></textarea>
                        <button class="btn btn-sm" type="button" style="height:42px" onclick="mesajGonder(${j.id})">Gönder</button></div>
                    </div>
                </div>` : ""}
            </div>`;
        }).join("");
        if (acikIs) { dosyalariGetir(acikIs); linkleriGetir(acikIs); mesajlariGetir(acikIs); }
    }

    // Eski portaldaki aşama göstergesi: Gönderildi → Onaylandı → Tasarım → Üretim → Tamamlandı
    function asamaCiz(j) {
        const adim = ["Gönderildi", "Onaylandı", "Tasarım", "Üretim", "Tamamlandı"];
        const d = j.durum || "";
        let n = 1;
        if (j.onayDurumu === "Gelen Onay" || j.onayDurumu === "Reddedildi") n = 0;
        else if (/teslim|tamamland/i.test(d)) n = 4;
        else if (/üretim|makyaj|tamamlama/i.test(d)) n = 3;
        else if (/tasar/i.test(d)) n = 2;
        return `<div class="stepper">${adim.map((a, i) => `<div class="${i < n ? "ok" : i === n ? "on" : ""}">${a}</div>`).join("")}</div>`;
    }

    async function mesajlariGetir(id) {
        const el = $("isMesaj" + id); if (!el) return;
        try {
            const list = await api(`/api/hekim-portal/jobs/${id}/messages`);
            el.innerHTML = list.length ? list.map(m =>
                `<div class="msg-b ${m.benim ? "me" : ""}"><small>${esc(m.gonderen)} · ${new Date(m.tarih).toLocaleString("tr-TR")}</small>${esc(m.mesaj)}</div>`).join("")
                : '<span class="hint">Henüz mesaj yok.</span>';
            el.scrollTop = el.scrollHeight;
            const j = isler.find(x => x.id === id);
            if (j && j.okunmamisMesaj) { j.okunmamisMesaj = 0; okunmamisOzet(); }
        } catch (err) { el.textContent = err.message; }
    }
    function okunmamisOzet() {
        const n = isler.reduce((t, j) => t + (j.okunmamisMesaj || 0), 0);
        const b = $("tabIsler"); if (b) b.innerHTML = "📋 İşlerim" + (n ? ` <span class="yeni-mesaj">${n}</span>` : "");
    }

    async function mesajGonder(id) {
        const t = $("isMesajYaz" + id); const mesaj = (t.value || "").trim();
        if (!mesaj) return;
        try {
            await api(`/api/hekim-portal/jobs/${id}/messages`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ mesaj }) });
            t.value = "";
            const j = isler.find(x => x.id === id); if (j) j.mesajSayisi = (j.mesajSayisi || 0) + 1;
            await mesajlariGetir(id);
        } catch (err) { alert(err.message); }
    }

    // Laboratuvarın / teknisyenin hazırladığı tasarım ve yazıcı (CTB) dosyaları: iş kartında tek tıkla indir.
    function hazirDosyaSerit(j) {
        const l = j.hazirDosyalar || [];
        if (!l.length) return "";
        const yeni = l.some(f => f.yeni);
        return `<div class="hazir-serit${yeni ? " yeni" : ""}">
            <div class="hazir-baslik">${yeni ? '<span class="hazir-yeni">YENİ</span>' : ""} 📦 Hazır dosyalar — indirip kullanabilirsiniz</div>
            <div class="hazir-liste">${l.map(f => `<a class="hazir-btn" href="/api/hekim-portal/jobs/${j.id}/files/${f.id}" onclick="hazirIndirildi(${j.id},${f.id})" title="${esc(f.orijinalDosyaAdi)} · ${boyut(f.boyut)}">
                ${f.dosyaTuru === "Yazıcı" ? "🖨️ Yazıcı" : "📐 Tasarım"} · <b>${esc(f.orijinalDosyaAdi)}</b> <small>${boyut(f.boyut)}</small>${f.yeni ? ' <span class="hazir-nokta"></span>' : ""} ⬇</a>`).join("")}</div>
        </div>`;
    }
    function hazirIndirildi(isId, dosyaId) {
        const j = isler.find(x => x.id === isId); const f = j && (j.hazirDosyalar || []).find(x => x.id === dosyaId);
        if (f && f.yeni) { f.yeni = false; setTimeout(isleriCiz, 300); }
    }

    function isAc(id) { acikIs = acikIs === id ? null : id; isleriCiz(); }

    async function dosyalariGetir(id) {
        const el = $("isDosya" + id); if (!el) return;
        const j = isler.find(x => x.id === id);
        if (!j || !j.dosyaSayisi) return;
        try {
            const list = await api(`/api/hekim-portal/jobs/${id}/files`);
            el.innerHTML = list.length ? list.map(f =>
                `<div><a href="/api/hekim-portal/jobs/${id}/files/${f.id}">${esc(f.orijinalDosyaAdi)}</a> <span class="hint">${esc(f.dosyaTuru)} · ${boyut(f.boyut)}</span></div>`).join("") : "yok";
        } catch (err) { el.textContent = err.message; }
    }

    async function linkleriGetir(id) {
        const el = $("isLink" + id); if (!el) return;
        const j = isler.find(x => x.id === id);
        if (!j || !j.linkSayisi) { el.textContent = "yok"; return; }
        try {
            const list = await api(`/api/hekim-portal/jobs/${id}/links`);
            el.innerHTML = list.length ? list.map(l =>
                `<div><a href="${esc(l.url)}" target="_blank" rel="noopener noreferrer">${esc(l.servis)} — ${esc(l.url.length > 60 ? l.url.slice(0, 60) + "…" : l.url)}</a> <span class="hint">${esc(l.ekleyen)} · ${tarih(l.tarih)}</span>${l.benim ? ` <button class="btn btn-sm" type="button" style="padding:2px 8px" title="Linki kaldır" onclick="linkSil(${id},${l.id})">×</button>` : ""}</div>`).join("") : "yok";
        } catch (err) { el.textContent = err.message; }
    }
    async function linkEkle(id) {
        const inp = $("isLinkYaz" + id); const list = (inp.value || "").split(/[\s,]+/).map(x => x.trim()).filter(Boolean);
        const hata = list.length ? linkHatasi(list) : "Link girin.";
        if (hata) { alert(hata); inp.focus(); return; }
        try {
            await api(`/api/hekim-portal/jobs/${id}/links`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ linkler: list }) });
            const j = isler.find(x => x.id === id); if (j) j.linkSayisi = (j.linkSayisi || 0) + list.length;
            inp.value = ""; linkleriGetir(id);
        } catch (err) { alert(err.message); }
    }
    async function linkSil(id, linkId) {
        if (!confirm("Bu link kaldırılsın mı?")) return;
        try { await api(`/api/hekim-portal/jobs/${id}/links/${linkId}`, { method: "DELETE" }); const j = isler.find(x => x.id === id); if (j) j.linkSayisi = Math.max(0, (j.linkSayisi || 1) - 1); linkleriGetir(id); }
        catch (err) { alert(err.message); }
    }

    // Renk ve implant önerileri
    $("renkler").innerHTML = VITA.map(v => `<option value="${v}">`).join("");
    $("implantMarkalari").innerHTML = IMPLANTLAR.map(v => `<option value="${esc(v)}">`).join("");

    basla();
</script>
</body>
</html>
