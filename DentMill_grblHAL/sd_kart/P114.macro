; P114.macro - Hava basinci kontrolu (Eding: sub check_pressure)
; Giris P0 = hava basinci sensoru (Eding AUX1 IN "ClampAir1")
M66 P0 L0
o100 if [#5399 EQ 0]
  (print, UYARI: hava basinci dusuk, bekleniyor...)
  M66 P0 L3 Q300
  o101 if [#5399 EQ -1]
    (abort, Hava basinci 300 sn icinde gelmedi. Kompresoru kontrol edin)
  o101 endif
o100 endif
