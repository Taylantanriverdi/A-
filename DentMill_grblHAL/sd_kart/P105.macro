; P105.macro - Takim boyu / asinma kontrolu (Eding: sub m100)
; CAM programindaki M100 satirlari "G65 P105" ile degistirilmelidir.
G65 P100
o100 if [[#4020 EQ 0] OR [#4021 EQ 0] OR [#4003 EQ 0] OR [#4004 EQ 0]]
  (abort, Sensor ayarli degil: P100.macro #4020 #4021 #4003 #4004)
o100 endif
#4099 = 0
M5
M9
G90
G53 G0 Z[#5163]
G53 G0 X[#4020] Y[#4021]
M64 P1
G4 P0.5
M65 P1
G53 G0 Z[#4003]
G91 G38.3 Z[#4004-#4003] F50
G90
o110 if [#5070 EQ 0]
  G53 G0 Z[#5163]
  (abort, Milde takim yok veya kirildi - sensor tetiklenmedi)
o110 endif
G0 Z#5063
#4099 = [#4002 - #5063]
o120 if [#4099 LT 0]
  #4099 = [0 - #4099]
o120 endif
G53 G0 Z[#5163]
o130 if [#4099 GT #4005]
  (abort, T#<_current_tool> boyu #4099 mm degisti, sinir #4005 mm - takimi kontrol edin)
o130 endif
(print, T#<_current_tool> tamam, boy degisimi #4099 mm)
