; P100.macro - KALIBRASYON DEGERLERI (Eding #4000-#4999 karsiligi)
; grblHAL'de #31-#5000 kalici DEGILDIR. Bu dosya kalici depodur:
; degeri degistirmek icin bu dosyayi duzenleyip SD karta geri koyun.
; TUM DEGERLER G53 MAKINE KOORDINATIDIR VE grblHAL'E GECINCE YENIDEN OLCULMELIDIR.
; 0 olan degerler makrolarda "ayarli degil" hatasi verir.
;
; --- Frez magazini (otomatik mod) ---
#4010 = 0      ; yuva X
#4011 = 0      ; T1 yuva Y
#4012 = 0      ; T2 yuva Y
#4013 = 0      ; T3 yuva Y
#4014 = 0      ; T4 yuva Y
#4015 = 0      ; T5 yuva Y
#4016 = 0      ; T6 yuva Y
#4017 = 0      ; yuvada A
#4018 = 0      ; yuvada B
#4000 = 0      ; alma Z (pens kapanir). Birakma Z = #4000+1
#4001 = 0      ; yaklasma Z
; --- Takim boyu sensoru ---
#4020 = 0      ; sensor X
#4021 = 0      ; sensor Y
#4002 = 0      ; sensor yuksekligi (G92 ile atanan Z)
#4003 = 0      ; olcume baslama Z (G53)
#4004 = 0      ; olcum alt siniri Z (G53)
#4005 = 0.05   ; izin verilen boy degisimi mm (M100 asinma kontrolu)
#4006 = 0      ; 1 = birakmadan sonra pensin bos oldugunu sensorle dogrula
; --- Frez degisim modu ---
#4030 = 0      ; 0 = otomatik (magazin), 1 = manuel
#4031 = 0      ; manuel degisim noktasi X
#4032 = 0      ; manuel degisim noktasi Y
#4033 = 0      ; manuel degisim Z (0 = guvenli Z)
; --- Guvenli home oncesi park noktasi ---
#4901 = 0      ; X
#4902 = 0      ; Y
