##DOSYA SIMULASYON.html
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Robot Kol Simülasyonu</title>
<style>
  :root {
    --bg: #e7ebf0; --panel: rgba(255,255,255,.94); --text: #1d2330; --muted: #64708a; --line: #dfe4ec;
    --accent: #2563eb; --accent-text: #fff; --ok: #15803d; --warn: #b45309; --danger: #dc2626; --chip: #eef2f8;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --panel: rgba(24,28,36,.94); --text: #e6e9ef; --muted: #9aa4b6; --line: #2f3644;
      --accent: #4f8cff; --accent-text: #0b1020; --ok: #4ade80; --warn: #fbbf24; --danger: #f87171; --chip: #262d3a;
    }
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--text);
               font: 14px/1.4 system-ui, "Segoe UI", Inter, sans-serif; }
  #sahne { position: fixed; inset: 0 360px 0 0; }
  body.panel-kapali #sahne { right: 0; }
  #sahne canvas { display: block; }
  .etiket-katmani { position: absolute; inset: 0; pointer-events: none; }
  .eksen-etiketi { display: flex; align-items: center; gap: 6px; background: rgba(15,23,42,.82); color: #fff;
                   border-radius: 99px; padding: 2px 10px 2px 3px; font-size: 12px; white-space: nowrap; }
  .eksen-etiketi b { background: #f59e0b; border-radius: 50%; width: 20px; height: 20px; display: grid; place-items: center; font-size: 11px; }

  #panel { position: fixed; top: 0; right: 0; bottom: 0; width: 360px; background: var(--panel); border-left: 1px solid var(--line);
           overflow-y: auto; padding: 16px 16px 30px; backdrop-filter: blur(8px); }
  body.panel-kapali #panel { display: none; }
  #panelAc { position: fixed; top: 12px; right: 372px; z-index: 5; }
  body.panel-kapali #panelAc { right: 12px; }
  h1 { font-size: 18px; margin: 0; }
  h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin: 18px 0 8px; }
  .baslik { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  #mod { font-size: 12px; background: var(--chip); border-radius: 99px; padding: 3px 10px; color: var(--muted); }
  #mod.ikiz { background: var(--ok); color: #fff; }
  button { font: inherit; border: 1px solid var(--line); background: var(--panel); color: var(--text); padding: 7px 12px;
           border-radius: 8px; cursor: pointer; }
  button:hover { border-color: var(--accent); }
  button.ana { background: var(--accent); color: var(--accent-text); border-color: var(--accent); font-weight: 600; }
  button.tehlike { background: var(--danger); color: #fff; border-color: var(--danger); font-weight: 600; }
  button.secili { outline: 2px solid var(--accent); outline-offset: 1px; }
  button:disabled { opacity: .5; cursor: default; }
  .satir { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .genis { width: 100%; }
  .eksen { display: grid; grid-template-columns: 112px minmax(0,1fr) 42px; gap: 8px; align-items: center; padding: 3px 0; }
  .eksen label { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eksen label b { display: inline-grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #f59e0b; color: #fff; font-size: 11px; margin-right: 4px; }
  .eksen output { text-align: right; font-variant-numeric: tabular-nums; }
  input[type=range] { width: 100%; accent-color: var(--accent); }
  .kucuk { font-size: 12px; color: var(--muted); }
  #uc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; text-align: center; }
  #uc div { background: var(--chip); border-radius: 8px; padding: 6px; }
  #uc b { display: block; font-size: 16px; font-variant-numeric: tabular-nums; }
  #uyari { min-height: 18px; margin-top: 6px; font-size: 12px; color: var(--warn); }
  #uyari.tehlike { color: var(--danger); font-weight: 700; }
  #pozListe { list-style: none; margin: 8px 0 0; padding: 0; max-height: 180px; overflow-y: auto; }
  #pozListe li { display: grid; grid-template-columns: 22px minmax(0,1fr) auto auto; gap: 6px; align-items: center; padding: 3px 0; border-bottom: 1px solid var(--line); }
  #pozListe code { font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #pozListe button { padding: 2px 8px; }
  label.secim { display: inline-flex; gap: 5px; align-items: center; margin-right: 10px; font-size: 13px; }
  #log { height: 70px; overflow: auto; background: var(--chip); border-radius: 8px; padding: 6px; font: 11px/1.35 ui-monospace, Consolas, monospace; white-space: pre-wrap; margin: 6px 0 0; }
  #gp { font-size: 12px; color: var(--muted); }
  #gp.acik { color: var(--ok); }

  #yardim { position: fixed; left: 14px; bottom: 14px; width: 300px; background: var(--panel); border: 1px solid var(--line);
            border-radius: 12px; padding: 12px 14px; font-size: 12.5px; box-shadow: 0 6px 24px rgba(0,0,0,.12); }
  #yardim.gizli { display: none; }
  #yardim table { border-collapse: collapse; width: 100%; }
  #yardim td { padding: 2px 4px; }
  kbd { background: var(--chip); border: 1px solid var(--line); border-radius: 4px; padding: 0 5px; font: 11px ui-monospace, Consolas, monospace; }
  #yardimKapat { float: right; padding: 0 7px; }

  body.render #panel, body.render #panelAc, body.render #yardim { display: none !important; }
  body.render #sahne { inset: 0 !important; }

  @media (max-width: 820px) {
    #sahne { inset: 0 0 48vh 0; }
    #panel { top: auto; height: 48vh; width: 100%; border-left: 0; border-top: 1px solid var(--line); }
    #panelAc { display: none; }
    #yardim { display: none; }
  }
</style>
</head>
<body>
<div id="sahne"></div>
<button id="panelAc" title="Paneli aç / kapat">☰</button>

<aside id="panel">
  <div class="baslik"><h1>Robot Kol Simülasyonu</h1><span id="mod">Simülasyon</span></div>
  <p class="kucuk">ESP32'deki kodla aynı hareket mantığı. Gerçek kola bağlanınca 3D model kolun gerçek konumunu gösterir.</p>
  <button id="baglan" class="ana genis">Gerçek kola bağlan (USB)</button>
  <div class="kucuk" style="margin-top:6px">Durum: <span id="durum">Bağlı değil</span></div>

  <h2>Eksenler</h2>
  <div id="eksenler"></div>
  <div class="satir" style="margin-top:8px">
    <button id="home">Başlangıç</button>
    <button id="dur" class="tehlike">DURDUR (Boşluk)</button>
  </div>
  <div class="satir" id="hizlar" style="margin-top:8px">
    <span class="kucuk">Hız:</span><button data-s="0">%25</button><button data-s="1">%50</button><button data-s="2">%100</button>
  </div>

  <h2>Kıskaç ucunun konumu (mm)</h2>
  <div id="uc"><div>X (sağ-sol)<b id="ucX">0</b></div><div>Y (yükseklik)<b id="ucY">0</b></div><div>Z (ileri)<b id="ucZ">0</b></div></div>
  <div id="uyari"></div>

  <h2>Poz kaydedici</h2>
  <div class="satir">
    <button id="pozKaydet">＋ Pozu kaydet</button><button id="pozOynat">▶ Oynat</button>
    <label class="secim"><input type="checkbox" id="pozDongu"> Döngü</label>
    <button id="pozTemizle">Temizle</button>
  </div>
  <div id="pozBos" class="kucuk" style="margin-top:6px">Kolu bir konuma getirip “Pozu kaydet”e basın. Birkaç poz kaydedince “Oynat” kolu sırayla bu konumlara götürür.</div>
  <ul id="pozListe"></ul>

  <h2>Görünüm</h2>
  <div class="satir" id="kameralar">
    <button data-k="serbest" class="secili">Serbest</button><button data-k="on">Ön</button><button data-k="yan">Yan</button><button data-k="ust">Üst</button>
  </div>
  <div style="margin-top:8px">
    <label class="secim"><input type="checkbox" id="etiketGoster" checked> Eksen etiketleri</label>
    <label class="secim"><input type="checkbox" id="izGoster" checked> Uç izi</label>
    <button id="izTemizle">İzi sil</button>
  </div>

  <h2>Oyun kolu ve mesajlar</h2>
  <div id="gp">Oyun kolu yok (takıp bir tuşa basın)</div>
  <pre id="log"></pre>
</aside>

<div id="yardim">
  <button id="yardimKapat" title="Kapat">✕</button>
  <b>Kontroller</b>
  <table>
    <tr><td><kbd>Q</kbd><kbd>A</kbd></td><td>Taban</td><td><kbd>Y</kbd><kbd>H</kbd></td><td>Kıskaç</td></tr>
    <tr><td><kbd>W</kbd><kbd>S</kbd></td><td>Omuz</td><td><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd></td><td>Hız</td></tr>
    <tr><td><kbd>E</kbd><kbd>D</kbd></td><td>Dirsek</td><td><kbd>0</kbd></td><td>Başlangıç</td></tr>
    <tr><td><kbd>R</kbd><kbd>F</kbd></td><td>Bilek eğim</td><td><kbd>Boşluk</kbd></td><td>Durdur</td></tr>
    <tr><td><kbd>T</kbd><kbd>G</kbd></td><td>Bilek dönüş</td><td></td><td></td></tr>
  </table>
